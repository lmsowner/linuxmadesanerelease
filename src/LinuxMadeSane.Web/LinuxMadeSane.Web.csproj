<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\LinuxMadeSane.Application\LinuxMadeSane.Application.csproj" />
    <ProjectReference Include="..\LinuxMadeSane.Infrastructure\LinuxMadeSane.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fido2" Version="4.0.1" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="NetVips" Version="3.2.0" />
    <PackageReference Include="NetVips.Native" Version="8.18.7" />
    <PackageReference Include="TiffLibrary" Version="0.6.65" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <None Update="appsettings*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="../../config/home-lab/*"
          Link="catalog/home-lab/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Always" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources/ThirdParty/*.txt;Resources/ThirdParty/NetVips.Native.NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="Resources/RemoteDesktop/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <EmbeddedResource Include="../../LICENSE.md" LogicalName="Lms.About.LICENSE" />
    <EmbeddedResource Include="Resources/about-*.json" LogicalName="Lms.About.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../LICENSING.md;../../NOTICE;../../THIRD-PARTY-NOTICES.md;../../COMMERCIAL-LICENSE.md;../../TRADEMARKS.md"
                      LogicalName="Lms.About.%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="BuildOptionalConnectClientPlugin" AfterTargets="Build" Condition="Exists('..\LinuxMadeSane.Connect.Client\LinuxMadeSane.Connect.Client.csproj') and '$(LinuxMadeSaneSkipPluginPackaging)' != 'true'">
    <MSBuild Projects="..\LinuxMadeSane.Connect.Client\LinuxMadeSane.Connect.Client.csproj" Targets="Build" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);LinuxMadeSaneSkipPluginPackaging=true" />
    <ItemGroup>
      <OptionalPluginFiles Include="..\LinuxMadeSane.Connect.Client\bin\$(Configuration)\$(TargetFramework)\*.dll" />
      <OptionalPluginFiles Include="..\LinuxMadeSane.Connect.Client\bin\$(Configuration)\$(TargetFramework)\*.json" />
      <OptionalPluginFiles Include="..\LinuxMadeSane.Connect.Client\bin\$(Configuration)\$(TargetFramework)\*.pdb" />
    </ItemGroup>
    <MakeDir Directories="$(OutDir)plugins\LinuxMadeSane.Connect.Client" />
    <Copy SourceFiles="@(OptionalPluginFiles)" DestinationFolder="$(OutDir)plugins\LinuxMadeSane.Connect.Client" SkipUnchangedFiles="true" />
  </Target>

<ItemGroup><EmbeddedResource Include="../../config/licensing/release-licence.json" LogicalName="Lms.Licensing.Release" /></ItemGroup>
</Project>
