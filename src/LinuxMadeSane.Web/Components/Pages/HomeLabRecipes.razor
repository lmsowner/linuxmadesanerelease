@page "/home-lab/recipes"
@rendermode InteractiveServer
@using LinuxMadeSane.Application.Contracts.HomeLab
@using LinuxMadeSane.Application.Contracts.EdgeGateway
@using LinuxMadeSane.Application.Interfaces
@using LinuxMadeSane.Core.Enums
@using LinuxMadeSane.Core.Models.HomeLab
@inject IHomeLabService HomeLabService
@inject IEdgeGatewayService EdgeGatewayService
@inject IJSRuntime JSRuntime

<PageTitle>Home Lab Recipes | Linux Made Sane</PageTitle>

<div class="page-shell home-lab-page">
    <UiHeroPanel Eyebrow="Home Lab"
                  Title="Recipes"
                  Description="Install reusable solutions made from the same catalogued App definitions."
                  Compact="true" />

    <nav class="home-lab-section-tabs" aria-label="Home Lab">
        <a href="/home-lab/apps">Apps</a>
        <a class="active" href="/home-lab/recipes">Recipes</a>
    </nav>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <p class="callout @(error ? "error" : "ready")">@message</p>
    }

    @if (workspace is null)
    {
        <UiPanel><p class="meta-text">Loading Home Lab recipes...</p></UiPanel>
    }
    else
    {
        <TabControl ActiveValue="@activeTab"
                    ActiveValueChanged="HandleTabChangedAsync"
                    Class="home-lab-tabs"
                    PanelClass="home-lab-tab-panel">
            <TabPage Value="recipes" Title="Recipes">
                @if (configuringRecipe is { } recipeToConfigure)
                {
                    var vpn = HomeLabCatalog.GetApp("vpn-gateway");
                    <section class="surface-card home-lab-config-panel">
                        <div class="home-lab-config-heading">
                            <div>
                                <p class="eyebrow">VPN gateway setup</p>
                                <h2>Configure @recipeToConfigure.Name</h2>
                                <p class="meta-text">This recipe installs Gluetun and routes the selected apps through it. Credentials are stored by LMS.</p>
                            </div>
                            <CompactUIButton Label="Cancel" Glyph="UiIconGlyph.Clear" Disabled="@busy" OnClick="CancelConfiguration" />
                        </div>
                        <div class="home-lab-config-grid">
                            @foreach (var field in vpn.ConfigurationSchema.Where(ShouldShowConfigurationField))
                            {
                                <div class="home-lab-config-field">
                                    <label for="recipe-vpn-@field.Id">@field.Label</label>
                                    @if (field.Type.Equals("select", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <select id="recipe-vpn-@field.Id" class="ui-control-input" value="@GetConfigurationValue(field.Id)" @onchange="eventArgs => SetConfigurationValue(field.Id, eventArgs.Value?.ToString())">
                                            <option value="">Choose...</option>
                                            @foreach (var option in field.Options ?? [])
                                            {
                                                <option value="@option">@option</option>
                                            }
                                        </select>
                                    }
                                    else if (field.Type.Equals("secret-textarea", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <textarea id="recipe-vpn-@field.Id" class="ui-control-input ui-control-textarea" rows="8" autocomplete="off" @oninput="eventArgs => SetConfigurationValue(field.Id, eventArgs.Value?.ToString(), true)">@GetSecretConfigurationValue(field.Id)</textarea>
                                    }
                                    else
                                    {
                                        <input id="recipe-vpn-@field.Id" class="ui-control-input" type="@(field.Secret ? "password" : "text")" value="@(field.Secret ? GetSecretConfigurationValue(field.Id) : GetConfigurationValue(field.Id))" autocomplete="@(field.Secret ? "new-password" : "off")" @oninput="eventArgs => SetConfigurationValue(field.Id, eventArgs.Value?.ToString(), field.Secret)" />
                                    }
                                    @if (!string.IsNullOrWhiteSpace(field.Help))
                                    {
                                        <span class="meta-text">@field.Help</span>
                                    }
                                </div>
                            }
                            @if (IsStremioWebtorRecipe(recipeToConfigure))
                            {
                                <div class="home-lab-config-field">
                                    <label for="webtor-hostname">Webtor public hostname</label>
                                    <input id="webtor-hostname" class="ui-control-input" value="@webtorHostname" @oninput="eventArgs => webtorHostname = eventArgs.Value?.ToString() ?? string.Empty" placeholder="webtor" />
                                    <span class="meta-text">The subdomain used by Stremio clients, TVs, and browsers.</span>
                                </div>
                                <div class="home-lab-config-field">
                                    <label for="webtor-domain">Edge Gateway domain</label>
                                    @if (EdgeGatewayDomains.Count > 0)
                                    {
                                        <select id="webtor-domain" class="ui-control-input" value="@webtorDomain" @onchange="eventArgs => webtorDomain = eventArgs.Value?.ToString() ?? string.Empty">
                                            @foreach (var domain in EdgeGatewayDomains)
                                            {
                                                <option value="@domain">@domain</option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        <input id="webtor-domain" class="ui-control-input" value="@webtorDomain" @oninput="eventArgs => webtorDomain = eventArgs.Value?.ToString() ?? string.Empty" placeholder="relay.example.com" />
                                    }
                                    <span class="meta-text">Webtor is published as HTTPS with pass-through access because Stremio clients cannot complete an LMS login challenge.</span>
                                </div>
                            }
                        </div>
                        <div class="home-lab-config-footer">
                            <span class="meta-text">The recipe remains blocked if the VPN gateway is unhealthy.</span>
                            <CompactUIButton Label="Install configured recipe" Glyph="UiIconGlyph.Download" Disabled="@busy" OnClick="InstallConfiguredAsync" />
                        </div>
                    </section>
                }
                <div class="surface-card home-lab-recipe-list">
                    @foreach (var recipe in workspace.Recipes)
                    {
                        <div class="home-lab-recipe-row">
                            <div>
                                <strong>@recipe.Name</strong>
                                <span>@recipe.Description</span>
                            </div>
                            <div class="home-lab-recipe-apps">
                                @foreach (var appId in recipe.AppIds)
                                {
                                    <span>@appId</span>
                                }
                            </div>
                            <CompactUIButton Label="Install" Glyph="UiIconGlyph.Download" Disabled="@busy" OnClick="() => InstallAsync(recipe)" />
                        </div>
                    }
                </div>
                @foreach (var deployment in StremioWebtorDeployments)
                {
                    var status = integrationStatuses.GetValueOrDefault(deployment.Id);
                    <section class="surface-card home-lab-integration-card">
                        <div class="home-lab-config-heading">
                            <div>
                                <p class="eyebrow">Installed integration</p>
                                <h2>@deployment.Name</h2>
                                <p class="meta-text">Webtor supplies the scoped addon catalog and playback streams. Stremio reads them over the Edge Gateway HTTPS URL.</p>
                            </div>
                            <CompactUIButton Label="Refresh status" Glyph="UiIconGlyph.Refresh" Disabled="@busy" OnClick="() => RefreshIntegrationAsync(deployment.Id)" />
                        </div>
                        @if (status is null)
                        {
                            <p class="meta-text">Checking integration...</p>
                        }
                        else
                        {
                            <div class="home-lab-integration-statuses">
                                @IntegrationIndicator("Stremio running", status.StremioRunning)
                                @IntegrationIndicator("Webtor running", status.WebtorRunning)
                                @IntegrationIndicator("Webtor externally reachable", status.WebtorExternallyReachable)
                                @IntegrationIndicator("Webtor Stremio manifest reachable", status.WebtorManifestReachable)
                                @IntegrationIndicator("VPN connected", status.VpnConnected)
                                @IntegrationIndicator("Integration ready", status.IntegrationReady)
                            </div>
                            <p class="meta-text">@status.Detail</p>
                            @if (!string.IsNullOrWhiteSpace(status.AddonUrl))
                            {
                                <code class="home-lab-addon-url">@status.AddonUrl</code>
                            }
                            <div class="home-lab-integration-actions row-action-cluster">
                                @if (!string.IsNullOrWhiteSpace(status.InstallUrl))
                                {
                                    <UiCommandButton Label="Install in Stremio" Glyph="UiIconGlyph.Download" Variant="UiButtonVariant.PrimaryMuted" Href="@status.InstallUrl" />
                                }
                                @if (!string.IsNullOrWhiteSpace(status.AddonUrl))
                                {
                                    <UiCommandButton Label="Copy addon URL" Glyph="UiIconGlyph.Copy" Variant="UiButtonVariant.ActionSubtle" OnClick="() => CopyAddonUrlAsync(status.AddonUrl)" />
                                }
                                @if (!string.IsNullOrWhiteSpace(status.WebtorUrl))
                                {
                                    <UiCommandButton Label="Open Webtor" Glyph="UiIconGlyph.Website" Variant="UiButtonVariant.Action" Href="@status.WebtorUrl" Target="_blank" Rel="noopener" />
                                }
                                @if (!string.IsNullOrWhiteSpace(status.StremioUrl))
                                {
                                    <UiCommandButton Label="Open Stremio" Glyph="UiIconGlyph.Website" Variant="UiButtonVariant.Action" Href="@status.StremioUrl" Target="_blank" Rel="noopener" />
                                }
                            </div>
                        }
                    </section>
                }
            </TabPage>
            <TabPage Value="ai" Title="AI help">
                <section class="surface-subcard home-lab-ai-panel">
                    <div>
                        <p class="eyebrow">Recipe assistant</p>
                        <h2>Choose a stack with AI</h2>
                        <p class="meta-text">Ask AI to compare recipes, check storage requirements, or explain how the applications will communicate before you install.</p>
                    </div>
                    <CompactUIButton Label="Open AI assistant" Glyph="UiIconGlyph.Ai" Href="/ai" />
                </section>
            </TabPage>
        </TabControl>
    }
</div>

@code {
    private HomeLabWorkspace? workspace;
    private string message = string.Empty;
    private bool error;
    private bool busy;
    private string activeTab = "recipes";
    private HomeLabRecipeManifest? configuringRecipe;
    private readonly Dictionary<string, string> configurationValues = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> secretConfigurationValues = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<Guid, HomeLabRecipeIntegrationStatus?> integrationStatuses = [];
    private EdgeGatewayDashboardViewModel? edgeGatewayDashboard;
    private string webtorHostname = "webtor";
    private string webtorDomain = string.Empty;

    private IReadOnlyList<string> EdgeGatewayDomains => edgeGatewayDashboard?.Cloudflare.Domains
        .Select(domain => domain.DomainName)
        .Where(domain => !string.IsNullOrWhiteSpace(domain))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(domain => domain, StringComparer.OrdinalIgnoreCase)
        .ToArray() ?? [];

    private IEnumerable<HomeLabDeployment> StremioWebtorDeployments =>
        workspace?.Deployments.Where(item => item.RecipeId?.Equals("stremio-webtor", StringComparison.OrdinalIgnoreCase) == true)
        ?? Enumerable.Empty<HomeLabDeployment>();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            workspace = await HomeLabService.GetWorkspaceAsync();
            edgeGatewayDashboard = await EdgeGatewayService.GetDashboardAsync();
            webtorDomain = EdgeGatewayDomains.FirstOrDefault() ?? string.Empty;
            await LoadIntegrationStatusesAsync();
        }
        catch (Exception exception)
        {
            SetMessage(exception.Message, true);
        }
    }

    private Task HandleTabChangedAsync(string? value)
    {
        activeTab = value == "ai" ? "ai" : "recipes";
        return Task.CompletedTask;
    }

    private async Task InstallAsync(HomeLabRecipeManifest recipe)
    {
        if (recipe.RequiresVpnGateway)
        {
            configuringRecipe = recipe;
            configurationValues.Clear();
            secretConfigurationValues.Clear();
            configurationValues["gateway-name"] = NextGatewayName();
            configurationValues["configuration-mode"] = "Guided";
            configurationValues["provider"] = "ProtonVPN";
            configurationValues["protocol"] = "WireGuard";
            if (IsStremioWebtorRecipe(recipe))
            {
                webtorHostname = "webtor";
                webtorDomain = EdgeGatewayDomains.FirstOrDefault() ?? webtorDomain;
            }
            return;
        }

        if (busy) return;
        busy = true;
        try
        {
            var storage = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            {
                ["downloads"] = "/mnt/storage/downloads",
                ["movies"] = "/mnt/storage/movies",
                ["tv"] = "/mnt/storage/tv"
            };
            var result = await HomeLabService.InstallRecipeAsync(new HomeLabRecipeInstallRequest(recipe.Id, storage));
            SetMessage($"{result.Summary} {result.Detail}", !result.Succeeded);
            workspace = await HomeLabService.GetWorkspaceAsync();
            await LoadIntegrationStatusesAsync();
        }
        catch (Exception exception)
        {
            SetMessage(exception.Message, true);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task InstallConfiguredAsync()
    {
        if (configuringRecipe is not { } recipe || busy)
        {
            return;
        }

        busy = true;
        try
        {
            var storage = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            {
                ["downloads"] = "/mnt/storage/downloads",
                ["movies"] = "/mnt/storage/movies",
                ["tv"] = "/mnt/storage/tv"
            };
            var result = await HomeLabService.InstallRecipeAsync(new HomeLabRecipeInstallRequest(
                recipe.Id,
                storage,
                configurationValues,
                SecretConfiguration: secretConfigurationValues,
                EdgeGatewayRoutes: BuildEdgeGatewayRoutes(recipe)));
            SetMessage($"{result.Summary} {result.Detail}", !result.Succeeded);
            if (result.Succeeded)
            {
                configuringRecipe = null;
                configurationValues.Clear();
                secretConfigurationValues.Clear();
            }
            workspace = await HomeLabService.GetWorkspaceAsync();
            await LoadIntegrationStatusesAsync();
        }
        catch (Exception exception)
        {
            SetMessage(exception.Message, true);
        }
        finally
        {
            busy = false;
        }
    }

    private void CancelConfiguration()
    {
        configuringRecipe = null;
        configurationValues.Clear();
        secretConfigurationValues.Clear();
    }

    private IReadOnlyDictionary<string, HomeLabEdgeGatewayRequest>? BuildEdgeGatewayRoutes(HomeLabRecipeManifest recipe)
    {
        if (!IsStremioWebtorRecipe(recipe))
        {
            return null;
        }
        if (string.IsNullOrWhiteSpace(webtorHostname) || string.IsNullOrWhiteSpace(webtorDomain))
        {
            throw new InvalidOperationException("Choose the Edge Gateway hostname and configured relay domain for Webtor.");
        }
        return new Dictionary<string, HomeLabEdgeGatewayRequest>(StringComparer.OrdinalIgnoreCase)
        {
            ["webtor"] = new(webtorHostname.Trim(), webtorDomain.Trim(), EdgeGatewayAuthMode.PassThrough)
        };
    }

    private async Task LoadIntegrationStatusesAsync()
    {
        foreach (var deployment in StremioWebtorDeployments)
        {
            integrationStatuses[deployment.Id] = await HomeLabService.GetRecipeIntegrationStatusAsync(deployment.Id);
        }
    }

    private async Task RefreshIntegrationAsync(Guid deploymentId)
    {
        if (busy) return;
        busy = true;
        try
        {
            workspace = await HomeLabService.GetWorkspaceAsync();
            integrationStatuses[deploymentId] = await HomeLabService.GetRecipeIntegrationStatusAsync(deploymentId);
        }
        catch (Exception exception)
        {
            SetMessage(exception.Message, true);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task CopyAddonUrlAsync(string addonUrl)
    {
        var copied = await JSRuntime.InvokeAsync<bool>("lmsClipboard.writeText", addonUrl);
        SetMessage(copied ? "Webtor addon URL copied." : "The browser could not copy the addon URL.", !copied);
    }

    private static bool IsStremioWebtorRecipe(HomeLabRecipeManifest recipe) =>
        recipe.Id.Equals("stremio-webtor", StringComparison.OrdinalIgnoreCase);

    private static RenderFragment IntegrationIndicator(string label, bool ready) => builder =>
    {
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", $"home-lab-integration-indicator {(ready ? "ready" : "pending")}");
        builder.AddContent(2, ready ? $"✓ {label}" : $"○ {label}");
        builder.CloseElement();
    };

    private bool ShouldShowConfigurationField(HomeLabConfigurationField field)
    {
        var setupMode = GetConfigurationValue("configuration-mode");
        if (field.Id.Equals("vpn-config", StringComparison.OrdinalIgnoreCase))
        {
            return setupMode.Equals("Paste provider config", StringComparison.OrdinalIgnoreCase);
        }
        if (field.Id.Equals("provider", StringComparison.OrdinalIgnoreCase))
        {
            return !setupMode.Equals("Paste provider config", StringComparison.OrdinalIgnoreCase);
        }
        if (setupMode.Equals("Paste provider config", StringComparison.OrdinalIgnoreCase) &&
            !field.Id.Equals("configuration-mode", StringComparison.OrdinalIgnoreCase) &&
            !field.Id.Equals("protocol", StringComparison.OrdinalIgnoreCase) &&
            !field.Id.StartsWith("openvpn-", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        var protocol = GetConfigurationValue("protocol");
        if (field.Id.StartsWith("wireguard-", StringComparison.OrdinalIgnoreCase))
        {
            return protocol.Equals("WireGuard", StringComparison.OrdinalIgnoreCase);
        }
        if (field.Id.StartsWith("openvpn-", StringComparison.OrdinalIgnoreCase))
        {
            return protocol.Equals("OpenVPN", StringComparison.OrdinalIgnoreCase);
        }
        return true;
    }

    private string GetConfigurationValue(string key) => configurationValues.TryGetValue(key, out var value) ? value : string.Empty;
    private string GetSecretConfigurationValue(string key) => secretConfigurationValues.TryGetValue(key, out var value) ? value : string.Empty;

    private void SetConfigurationValue(string key, string? value, bool secret = false)
    {
        (secret ? secretConfigurationValues : configurationValues)[key] = value ?? string.Empty;
    }

    private string NextGatewayName()
    {
        var count = workspace?.Installations.Count(item => item.AppId.Equals("vpn-gateway", StringComparison.OrdinalIgnoreCase)) ?? 0;
        return count == 0 ? "VPN Gateway" : $"VPN Gateway {count + 1}";
    }

    private void SetMessage(string text, bool isError)
    {
        message = text;
        error = isError;
    }
}
