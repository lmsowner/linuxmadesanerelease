            await args.File.OpenReadStream(65536, lifetime.Token).CopyToAsync(buffer, lifetime.Token);
            using var certificate = X509CertificateLoader.LoadPkcs12(buffer.ToArray(), certificatePassword, X509KeyStorageFlags.EphemeralKeySet);
            using var key = certificate.GetRSAPrivateKey();
            if (key is null || key.KeySize < 2048 || certificate.NotAfter.ToUniversalTime() <= DateTime.UtcNow || certificate.NotBefore.ToUniversalTime() > DateTime.UtcNow)
