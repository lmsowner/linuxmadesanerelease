    private static string ProviderName(MailRelayOutboundMode value) => value switch { MailRelayOutboundMode.MicrosoftGraph => "Microsoft 365", MailRelayOutboundMode.Gmail => "Gmail", MailRelayOutboundMode.AmazonSes => "Amazon SES", _ => "LMS / Edge Gateway" };
