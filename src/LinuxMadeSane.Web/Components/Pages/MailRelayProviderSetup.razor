            api = api with { CertificateSecretReference = await Secrets.StoreSecretAsync(Convert.ToBase64String(certificate.Export(X509ContentType.Pkcs12)), "Mail Relay Microsoft application certificate", lifetime.Token), ClientSecretReference = null };
            clientSecret = ""; await SaveDraftAsync(); status = "Certificate stored securely. Check connection, then send a test.";
        }
        catch (CryptographicException) { throw new InvalidOperationException("The certificate could not be opened. Check its password and that the file contains the private key."); }
        finally { certificatePassword = ""; }
    });
