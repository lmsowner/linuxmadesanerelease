    private bool TryBuildRiskTrial(
        Guid? entryId,
        string label,
        string addressOrCidr,
        bool targetEnabled,
        bool targetAuthenticationEnabled,
        out string title,
        out string detail,
        out IReadOnlyList<TrustedNetworkEntry> plannedEntries)
    {
        var currentEntries = BuildCurrentTrustedNetworkEntries();
        plannedEntries = BuildPlannedTrustedNetworkEntries(
            entryId,
            label,
            addressOrCidr,
            targetEnabled,
            targetAuthenticationEnabled);
        var currentRule = entryId.HasValue
            ? currentEntries.FirstOrDefault(entry => entry.Id == entryId.Value)
            : null;
        var plannedRule = entryId.HasValue
            ? plannedEntries.FirstOrDefault(entry => entry.Id == entryId.Value)
            : null;
        var configuredRuleAccessReduced = plannedRule is not null &&
                                          TrustedNetworkAccessTrialService.RequiresTrialForRuleChange(
                                              currentRule,
                                              plannedRule);

        PlannedAccessOutcome? currentSessionBefore = null;
        PlannedAccessOutcome? currentSessionOutcome = null;
        if (IPAddress.TryParse(currentAccess.RemoteAddress, out var remoteAddress))
        {
            currentSessionBefore = EvaluatePlannedAccess(currentEntries, remoteAddress);
            currentSessionOutcome = EvaluatePlannedAccess(plannedEntries, remoteAddress);
        }

        var loopbackIpv4Before = EvaluatePlannedAccess(currentEntries, IPAddress.Loopback);
        var loopbackIpv6Before = EvaluatePlannedAccess(currentEntries, IPAddress.IPv6Loopback);
        var loopbackIpv4Outcome = EvaluatePlannedAccess(plannedEntries, IPAddress.Loopback);
        var loopbackIpv6Outcome = EvaluatePlannedAccess(plannedEntries, IPAddress.IPv6Loopback);
        var hadDirectConsoleRecovery =
            loopbackIpv4Before == PlannedAccessOutcome.FullAccess ||
            loopbackIpv6Before == PlannedAccessOutcome.FullAccess;
        var hasDirectConsoleRecovery =
            loopbackIpv4Outcome == PlannedAccessOutcome.FullAccess ||
            loopbackIpv6Outcome == PlannedAccessOutcome.FullAccess;

        var currentSessionAffected =
            currentSessionBefore.HasValue &&
            currentSessionOutcome.HasValue &&
            AccessRank(currentSessionOutcome.Value) < AccessRank(currentSessionBefore.Value);
        var consoleRecoveryAffected = hadDirectConsoleRecovery && !hasDirectConsoleRecovery;

        if (!configuredRuleAccessReduced && !currentSessionAffected && !consoleRecoveryAffected)
        {
            title = string.Empty;
            detail = string.Empty;
            return false;
        }

        title = !targetEnabled
            ? $"Testing {label} disabled"
            : targetAuthenticationEnabled
                ? $"Testing authentication on {label}"
                : $"Testing changes to {label}";

        var detailParts = new List<string>();
        if (configuredRuleAccessReduced)
        {
            detailParts.Add(!targetEnabled
                ? "This enabled access rule is disabled temporarily while you test the result."
                : targetAuthenticationEnabled && currentRule?.IsAuthenticationEnabled == false
                    ? "Sign-in is required temporarily on this access rule while you test the result."
                    : "The changed address coverage is temporary while you test the result.");
        }

        if (currentSessionAffected)
        {
            detailParts.Add(
                $"This browser changes from {DescribePlannedAccess(currentSessionBefore!.Value)} to {DescribePlannedAccess(currentSessionOutcome!.Value)}.");
        }

        if (consoleRecoveryAffected)
        {
            detailParts.Add("Direct localhost recovery is unavailable during the test.");
        }

        detail = string.Join(' ', detailParts);
        return true;
    }

    private IReadOnlyList<TrustedNetworkEntry> BuildCurrentTrustedNetworkEntries()
    {
        var now = DateTimeOffset.UtcNow;
        return page.TrustedNetworks
            .Select(entry => new TrustedNetworkEntry(
                entry.Id,
                entry.Label,
                entry.AddressOrCidr,
                entry.Description,
                entry.IsEnabled,
                entry.IsEnabled && !entry.IsAuthenticationEnabled,
                entry.IsAuthenticationEnabled,
                entry.IsBuiltIn,
                now,
                now,
                entry.DeniedResponseMode))
            .ToArray();
    }

    private IReadOnlyList<TrustedNetworkEntry> BuildPlannedTrustedNetworkEntries(
        Guid? entryId,
        string label,
        string addressOrCidr,
        bool targetEnabled,
        bool targetAuthenticationEnabled)
    {
        var now = DateTimeOffset.UtcNow;
        var plannedEntries = BuildCurrentTrustedNetworkEntries().ToList();

        var plannedRule = new TrustedNetworkEntry(
            entryId ?? Guid.NewGuid(),
            string.IsNullOrWhiteSpace(label) ? "Planned access rule" : label.Trim(),
            addressOrCidr.Trim(),
            string.Empty,
            targetEnabled,
            targetEnabled && !targetAuthenticationEnabled,
            targetAuthenticationEnabled,
            false,
            now,
            now,
            networkEditor.DeniedResponseMode);

        var existingIndex = entryId.HasValue
            ? plannedEntries.FindIndex(entry => entry.Id == entryId.Value)
            : -1;

        if (existingIndex >= 0)
        {
            var existing = plannedEntries[existingIndex];
            plannedEntries[existingIndex] = plannedRule with
            {
                Description = existing.Description,
                IsBuiltIn = existing.IsBuiltIn,
                CreatedAtUtc = existing.CreatedAtUtc,
                DeniedResponseMode = existing.DeniedResponseMode
            };
        }
        else
        {
            plannedEntries.Add(plannedRule);
        }

        return plannedEntries;
    }

    private static PlannedAccessOutcome EvaluatePlannedAccess(
        IReadOnlyList<TrustedNetworkEntry> entries,
        IPAddress address)
    {
        var match = TrustedNetworkMatcher.Match(address, entries);
        if (match is null || !match.IsEnabled)
        {
            return PlannedAccessOutcome.Blocked;
        }

        return match.IsAuthenticationEnabled
            ? PlannedAccessOutcome.LoginRequired
            : PlannedAccessOutcome.FullAccess;
    }

    private static string DescribePlannedAccess(PlannedAccessOutcome outcome) =>
        outcome switch
        {
            PlannedAccessOutcome.FullAccess => "Full access",
            PlannedAccessOutcome.LoginRequired => "Login required",
            _ => "No access"
        };

    private static int AccessRank(PlannedAccessOutcome outcome) => outcome switch
    {
        PlannedAccessOutcome.FullAccess => 2,
        PlannedAccessOutcome.LoginRequired => 1,
        _ => 0
    };

    private async Task StartNetworkTrialAsync(
        string title,
        string detail,
        IReadOnlyList<TrustedNetworkEntry> plannedEntries,
        Func<Task> commitAction)
    {
        if (ActiveFirewallTrial is not null)
        {
            networkMessage = "Keep or revert the current Auto Rollback firewall change before changing network-interface access.";
            networkMessageIsError = true;
            return;
        }

        try
        {
            var trial = NetworkAccessTrialService.Begin(
                plannedEntries,
                title,
                TimeSpan.FromSeconds(NetworkTrialDurationSeconds));
            activeNetworkTrialId = trial.Id;
            networkTrialRemainingSeconds = NetworkTrialDurationSeconds;
            networkTrialTitle = title;
            networkTrialDetail = detail;
            pendingNetworkTrialCommit = commitAction;
            networkMessage = null;
            networkMessageIsError = false;
            await LoadAsync();
            _ = MonitorNetworkTrialAsync(trial.Id);
        }
        catch (Exception exception)
        {
            networkMessage = exception.Message;
            networkMessageIsError = true;
        }
    }

    private async Task MonitorNetworkTrialAsync(Guid trialId)
    {
        try
        {
            while (activeNetworkTrialId == trialId)
            {
                await Task.Delay(TimeSpan.FromSeconds(1));
                await InvokeAsync(async () =>
                {
                    if (activeNetworkTrialId != trialId)
                    {
                        return;
                    }

                    var activeTrial = NetworkAccessTrialService.GetActive();
                    if (activeTrial?.Id != trialId)
                    {
                        await FinishRevertedNetworkTrialAsync("The 30-second test ended and the previous access policy was restored.");
                        return;
                    }

                    networkTrialRemainingSeconds = Math.Max(
                        1,
                        (int)Math.Ceiling((activeTrial.ExpiresAtUtc - DateTimeOffset.UtcNow).TotalSeconds));
                    StateHasChanged();
                });
            }
        }
        catch (ObjectDisposedException)
        {
            // The circuit ended. The server-side trial still expires automatically.
        }
        catch (InvalidOperationException)
        {
            // The circuit ended. The server-side trial still expires automatically.
        }
    }

    private async Task KeepNetworkTrialAsync()
    {
        if (activeNetworkTrialId is not { } trialId ||
            pendingNetworkTrialCommit is not { } commitAction ||
            NetworkAccessTrialService.GetActive()?.Id != trialId)
        {
            await FinishRevertedNetworkTrialAsync("The test had already expired; the previous access policy is active.");
            return;
        }

        networkMessage = null;
        networkMessageIsError = false;
        await commitAction();
        if (networkMessageIsError)
        {
            NetworkAccessTrialService.End(trialId);
            ClearNetworkTrialState();
            await LoadAsync();
            return;
        }

        var successMessage = networkMessage;
        NetworkAccessTrialService.End(trialId);
        ClearNetworkTrialState();
        await LoadAsync();
        networkMessage = string.IsNullOrWhiteSpace(successMessage)
            ? "Network access change kept."
            : $"{successMessage} The change is now permanent.";
        networkMessageIsError = false;
    }

    private async Task RevertNetworkTrialAsync()
    {
        if (activeNetworkTrialId is { } trialId)
        {
            NetworkAccessTrialService.End(trialId);
        }

        await FinishRevertedNetworkTrialAsync("Test reverted. The previous access policy is active.");
    }

    private async Task FinishRevertedNetworkTrialAsync(string message)
    {
        ClearNetworkTrialState();
        await LoadAsync();
        networkMessage = message;
        networkMessageIsError = false;
        StateHasChanged();
    }

    private void ClearNetworkTrialState()
    {
        activeNetworkTrialId = null;
        networkTrialRemainingSeconds = 0;
        networkTrialTitle = string.Empty;
        networkTrialDetail = string.Empty;
        pendingNetworkTrialCommit = null;
    }

