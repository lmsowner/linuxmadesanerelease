@page "/settings"
@page "/attack-surface"
@rendermode InteractiveServer
@using System.Security.Claims
@using System.Net
@using System.Net.NetworkInformation
@using System.Net.Sockets
@using LinuxMadeSane.Application.Interfaces
@using LinuxMadeSane.Application.Services
@using LinuxMadeSane.Core.Abstractions
@using LinuxMadeSane.Core.Models
@using LinuxMadeSane.Core.Models.Shares
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@inject ISecuritySettingsService SecuritySettingsService
@inject IShareManagementService ShareService
@inject ITrustedNetworkAccessService TrustedNetworkAccessService
@inject TrustedNetworkAccessTrialService NetworkAccessTrialService
@inject IFirewallManagementService FirewallService
@inject NavigationManager Navigation

<PageTitle>LMS Security | Linux Made Sane</PageTitle>

<div class="page-shell">
    <UiHeroPanel Title="LMS Security" Compact="true" />

    @if (HasAuthenticatedLmsUser)
    {
        <section class="surface-card security-current-passkey-panel" data-current-user-passkey-action>
            <div class="security-current-passkey-copy">
                <span class="security-current-passkey-icon" aria-hidden="true">
                    <UiGlyphIcon Glyph="UiIconGlyph.Key" />
                </span>
                <div>
                    <p class="eyebrow">Your sign-in security</p>
                    <h2>Set up a passkey</h2>
                    <p>Add a passkey only for the currently signed-in LMS account, <strong>@CurrentAccountEmail</strong>. Other accounts cannot be selected from this workflow.</p>
                </div>
            </div>
            <UiCommandButton Label="Set up passkey"
                             Glyph="UiIconGlyph.Key"
                             Href="@CurrentAccountPasskeySetupHref"
                             data-enhance-nav="false" />
        </section>
    }

    @if (!isLoaded)
    {
        <section class="surface-card">
            <p class="meta-text">Loading LMS account settings...</p>
        </section>
    }
    else
    {
        <TabControl ActiveValue="@activeTab"
                    ActiveValueChanged="HandleTabChangedAsync"
                    Class="page-tab-control security-tab-control"
                    PanelClass="page-tab-panel security-tab-panel">
            <ChildContent>
                <TabPage Value="@TrustedNetworksTabValue" Title="Network Interfaces">
                    <Header>
                        <div class="security-tab-header">
                            <span class="security-tab-title">Network Interfaces</span>
                            <span class="security-tab-count">@networkInterfaces.Count</span>
                        </div>
                    </Header>
                    <ChildContent>
                        <div class="security-tab-content network-interface-content">
                            <div class="section-heading">
                                <div>
                                    <p class="eyebrow">Interface access</p>
                                    <h2>Grouped by NIC</h2>
                                    <p class="meta-text">Each local network interface shows the access rules covering its addresses. A rule can allow direct access, require sign-in, or be disabled.</p>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(networkMessage))
                            {
                                <p class="callout @(networkMessageIsError ? "error" : "success")">@networkMessage</p>
                            }

                            @if (IsNetworkTrialActive)
                            {
                                <section class="surface-subcard security-network-trial" role="status" aria-live="polite">
                                    <div class="security-network-trial-copy">
                                        <div class="security-network-trial-heading">
                                            <span class="status-pill warning">Testing · @networkTrialRemainingSeconds s</span>
                                            <strong>@networkTrialTitle</strong>
                                        </div>
                                        <p>@networkTrialDetail</p>
                                        <small>The previous access policy is still saved. This test automatically reverts unless you keep it.</small>
                                    </div>
                                    <div class="security-network-trial-actions">
                                        <UiCommandButton Label="Keep change"
                                                         Glyph="UiIconGlyph.Save"
                                                         OnClick="KeepNetworkTrialAsync" />
                                        <UiCommandButton Label="Revert now"
                                                         Glyph="UiIconGlyph.Refresh"
                                                         Variant="UiButtonVariant.Ghost"
                                                         OnClick="RevertNetworkTrialAsync" />
                                    </div>
                                </section>
                            }

                            @if (PublicFallbackNetworks.Count > 0)
                            {
                                <section class="surface-subcard security-public-access-panel">
                                    <div class="security-public-access-heading">
                                        <div>
                                            <p class="eyebrow">Internet fallback</p>
                                            <h3>Public IPv4 and IPv6</h3>
                                            <p>These rules control direct public-source access not covered by a more specific LAN, VPN, or Tailscale rule. A correctly configured Edge Gateway using the LMS loopback origin remains separate.</p>
                                        </div>
                                        <span class="status-pill neutral">Default deny</span>
                                    </div>
                                    <div class="trusted-range-list">
                                        @foreach (var entry in PublicFallbackNetworks)
                                        {
                                            <div class="trusted-range-row @(!entry.IsEnabled ? "trusted-range-row-disabled" : string.Empty)">
                                                <div class="trusted-range-main">
                                                    <strong>@entry.Label</strong>
                                                    <code>@entry.AddressOrCidr</code>
                                                    <span class="meta-text">@entry.Description</span>
                                                </div>
                                                <div class="trusted-range-access">
                                                    @if (entry.IsEnabled)
                                                    {
                                                        <div class="trusted-range-pill-row">
                                                            <span class="status-pill @GetTrustedNetworkAccessPillClass(entry)">@GetTrustedNetworkAccessSummary(entry)</span>
                                                            <span class="status-pill success">@GetTrustedNetworkAuthPillText(entry)</span>
                                                        </div>
                                                        <span class="meta-text">@GetTrustedNetworkAccessMeta(entry)</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="status-pill neutral">Direct access blocked</span>
                                                        <span class="meta-text">@GetDeniedResponseSummary(entry)</span>
                                                    }
                                                </div>
                                                <div class="trusted-range-meta">
                                                    <span class="status-pill neutral">Built-in</span>
                                                </div>
                                                <div class="trusted-range-actions">
                                                    <UiCommandButton Label="@(UsesEmptyNotFoundResponse(entry) ? "404 on" : "404 off")"
                                                                     Glyph="UiIconGlyph.Lock"
                                                                     Variant="UiButtonVariant.Action"
                                                                     OnClick="@(() => ToggleDeniedResponseModeAsync(entry))"
                                                                     Disabled="@IsAnySecurityTrialActive" />
                                                    @if (entry.IsEnabled)
                                                    {
                                                        <UiCommandButton Label="@(entry.IsAuthenticationEnabled ? "Auth off" : "Auth on")"
                                                                         Glyph="@(entry.IsAuthenticationEnabled ? UiIconGlyph.Disconnect : UiIconGlyph.Connect)"
                                                                         Variant="UiButtonVariant.Action"
                                                                         OnClick="@(() => ToggleAuthenticationAccessAsync(entry))"
                                                                         Disabled="@IsAnySecurityTrialActive" />
                                                    }
                                                    <UiCommandButton Label="@(entry.IsEnabled ? "Disable" : "Enable")"
                                                                     Glyph="@(entry.IsEnabled ? UiIconGlyph.Disconnect : UiIconGlyph.Connect)"
                                                                     Variant="UiButtonVariant.Action"
                                                                     OnClick="@(() => ToggleTrustedNetworkAsync(entry))"
                                                                     Disabled="@IsAnySecurityTrialActive" />
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </section>
                            }

                            <details class="surface-subcard security-network-editor" open="@IsNetworkEditorOpen">
                                <summary>
                                    <span>
                                        <strong>@(networkEditor.Id.HasValue ? "Edit access rule" : "Add access rule")</strong>
                                        <span class="meta-text">CIDR rules control direct access, email + OTP, or no access for matching networks.</span>
                                    </span>
                                    <span class="status-pill neutral">@(page.TrustedNetworks.Count) rules</span>
                                </summary>

                                <EditForm Model="@networkEditor" OnValidSubmit="SaveNetworkAsync" class="stack-form security-network-editor-form">
                                    <DataAnnotationsValidator />

                                    <div class="field-row">
                                        <UiTextField @bind-Value="networkEditor.Label" Label="Label" />
                                        <UiTextField @bind-Value="networkEditor.AddressOrCidr" Label="Address or CIDR" />
                                    </div>

                                    <UiTextField @bind-Value="networkEditor.Description" Label="Description" />

                                    <div class="field-row">
                                        <UiCheckboxField @bind-Value="networkEditor.IsEnabled" Label="Rule enabled" />
                                        <UiCheckboxField @bind-Value="networkEditor.IsAuthenticationEnabled" Label="Authentication enabled" Helper="Require email plus OTP before allowing access." />
                                    </div>

                                    <UiSelectField TValue="NetworkAccessDeniedResponseMode"
                                                   @bind-Value="networkEditor.DeniedResponseMode"
                                                   Label="Blocked response"
                                                   Helper="Empty 404 returns only the HTTP status with a zero-length body; it does not show an LMS page.">
                                        <option value="@NetworkAccessDeniedResponseMode.AccessDeniedPage">Access denied page</option>
                                        <option value="@NetworkAccessDeniedResponseMode.EmptyNotFound">Empty HTTP 404</option>
                                    </UiSelectField>

                                    <div class="toolbar-row">
                                        <UiCommandButton Label="@(isSavingNetwork ? "Saving..." : networkEditor.Id.HasValue ? "Save rule" : "Add rule")"
                                                         Glyph="@(networkEditor.Id.HasValue ? UiIconGlyph.Connect : UiIconGlyph.Plus)"
                                                         Type="submit"
                                                         Disabled="@(isSavingNetwork || IsAnySecurityTrialActive)" />
                                        @if (networkEditor.Id.HasValue)
                                        {
                                            <UiCommandButton Label="Cancel edit" Glyph="UiIconGlyph.Clear" Variant="UiButtonVariant.Ghost" OnClick="CancelNetworkEditAsync" />
                                        }
                                    </div>
                                </EditForm>
                            </details>

                            @if (networkInterfaces.Count == 0)
                            {
                                <div class="empty-state">
                                    <h3>No network interfaces were reported</h3>
                                    <p>The saved access rule list is still available in the additional ranges section below.</p>
                                </div>
                            }
                            else
                            {
                                <div class="network-interface-list">
                                    @foreach (var networkInterface in networkInterfaces)
                                    {
                                        var interfaceRanges = GetTrustedNetworksForInterface(networkInterface);

                                        <article class="surface-subcard network-interface-card">
                                            <div class="network-interface-header">
                                                <div class="network-interface-heading">
                                                    <span class="network-interface-status-dot @(networkInterface.IsUp ? "up" : "down")" aria-hidden="true"></span>
                                                    <div>
                                                        <h3>@networkInterface.Name</h3>
                                                        <p>@networkInterface.Description</p>
                                                    </div>
                                                </div>

                                                <div class="token-row compact-token-row">
                                                    <span class="status-pill @(networkInterface.IsUp ? "success" : "neutral")">@networkInterface.Status</span>
                                                    <span class="status-pill neutral">@networkInterface.Type</span>
                                                    <span class="status-pill neutral">@interfaceRanges.Count rule(s)</span>
                                                </div>
                                            </div>

                                            <div class="network-address-strip">
                                                @foreach (var address in GetPrimaryAddresses(networkInterface))
                                                {
                                                    <code>@address.Display</code>
                                                }
                                            </div>

                                            @if (interfaceRanges.Count == 0)
                                            {
                                                <p class="meta-text">No access rules currently match this NIC address.</p>
                                            }
                                            else
                                            {
                                                <div class="trusted-range-list">
                                                    @foreach (var entry in interfaceRanges)
                                                    {
                                                        <div class="trusted-range-row @(!entry.IsEnabled ? "trusted-range-row-disabled" : string.Empty)">
                                                            <div class="trusted-range-main">
                                                                <strong>@entry.Label</strong>
                                                                <code>@entry.AddressOrCidr</code>
                                                                @if (!string.IsNullOrWhiteSpace(entry.Description))
                                                                {
                                                                    <span class="meta-text">@entry.Description</span>
                                                                }
                                                            </div>
                                                            <div class="trusted-range-access">
                                                                @if (entry.IsEnabled)
                                                                {
                                                                    <div class="trusted-range-pill-row">
                                                                        <span class="status-pill @GetTrustedNetworkAccessPillClass(entry)">@GetTrustedNetworkAccessSummary(entry)</span>
                                                                        <span class="status-pill success">@GetTrustedNetworkAuthPillText(entry)</span>
                                                                    </div>
                                                                }
                                                                else
                                                                {
                                                                    <span class="status-pill @GetTrustedNetworkAccessPillClass(entry)">@GetTrustedNetworkAccessSummary(entry)</span>
                                                                    <span class="meta-text">@GetDeniedResponseSummary(entry)</span>
                                                                }
                                                                @if (!string.IsNullOrWhiteSpace(GetTrustedNetworkAccessMeta(entry)))
                                                                {
                                                                    <span class="meta-text">@GetTrustedNetworkAccessMeta(entry)</span>
                                                                }
                                                            </div>
                                                            @if (entry.IsEnabled)
                                                            {
                                                                <div class="trusted-range-meta">
                                                                    <span class="status-pill neutral">@(entry.IsBuiltIn ? "Built-in" : "Custom")</span>
                                                                </div>
                                                            }
                                                            <div class="trusted-range-actions">
                                                                @if (!entry.IsEnabled)
                                                                {
                                                                    <UiCommandButton Label="@(UsesEmptyNotFoundResponse(entry) ? "404 on" : "404 off")"
                                                                                     Glyph="UiIconGlyph.Lock"
                                                                                     Variant="UiButtonVariant.Action"
                                                                                     OnClick="@(() => ToggleDeniedResponseModeAsync(entry))"
                                                                                     Disabled="@IsAnySecurityTrialActive" />
                                                                }
                                                                @if (!entry.IsBuiltIn && entry.IsEnabled)
                                                                {
                                                                    <UiCommandButton Label="Edit"
                                                                                     Glyph="UiIconGlyph.Edit"
                                                                                     Variant="UiButtonVariant.Action"
                                                                                     OnClick="@(() => BeginNetworkEdit(entry))"
                                                                                     Disabled="@(!entry.IsEnabled || IsAnySecurityTrialActive)" />
                                                                }
                                                                @if (entry.IsEnabled)
                                                                {
                                                                    <UiCommandButton Label="@(entry.IsAuthenticationEnabled ? "Auth off" : "Auth on")"
                                                                                     Glyph="@(entry.IsAuthenticationEnabled ? UiIconGlyph.Disconnect : UiIconGlyph.Connect)"
                                                                                     Variant="UiButtonVariant.Action"
                                                                                     OnClick="@(() => ToggleAuthenticationAccessAsync(entry))"
                                                                                     Disabled="@(!entry.IsEnabled || IsAnySecurityTrialActive)" />
                                                                }
                                                                <UiCommandButton Label="@(entry.IsEnabled ? "Disable" : "Enable")"
                                                                                 Glyph="@(entry.IsEnabled ? UiIconGlyph.Disconnect : UiIconGlyph.Connect)"
                                                                                 Variant="UiButtonVariant.Action"
                                                                                 OnClick="@(() => ToggleTrustedNetworkAsync(entry))"
                                                                                 Disabled="@IsAnySecurityTrialActive" />
                                                                @if (!entry.IsBuiltIn && entry.IsEnabled)
                                                                {
                                                                    <UiCommandButton Label="Delete"
                                                                                     Glyph="UiIconGlyph.Delete"
                                                                                     Variant="UiButtonVariant.Danger"
                                                                                     OnClick="@(() => DeleteTrustedNetworkAsync(entry))"
                                                                                     Disabled="@(!entry.IsEnabled || IsAnySecurityTrialActive)" />
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }

                                            <details class="network-interface-details">
                                                <summary>
                                                    <span>Interface details</span>
                                                    <span class="meta-text">addresses, DNS, gateway, MAC, speed</span>
                                                </summary>

                                                <dl class="network-interface-detail-grid">
                                                    <div>
                                                        <dt>Interface ID</dt>
                                                        <dd>@networkInterface.Id</dd>
                                                    </div>
                                                    <div>
                                                        <dt>MAC</dt>
                                                        <dd>@networkInterface.MacAddress</dd>
                                                    </div>
                                                    <div>
                                                        <dt>Speed</dt>
                                                        <dd>@networkInterface.Speed</dd>
                                                    </div>
                                                    <div>
                                                        <dt>Addresses</dt>
                                                        <dd>@FormatAddressList(networkInterface.Addresses)</dd>
                                                    </div>
                                                    <div>
                                                        <dt>Gateways</dt>
                                                        <dd>@FormatStringList(networkInterface.Gateways)</dd>
                                                    </div>
                                                    <div>
                                                        <dt>DNS</dt>
                                                        <dd>@FormatStringList(networkInterface.DnsServers)</dd>
                                                    </div>
                                                </dl>
                                            </details>
                                        </article>
                                    }
                                </div>
                            }

                        </div>
                    </ChildContent>
                </TabPage>

                <TabPage Value="@AttackSurfaceTabValue" Title="Attack Surface">
                    <Header>
                        <div class="security-tab-header">
                            <span class="security-tab-title">Attack Surface</span>
                            <span class="security-tab-count">Audit</span>
                        </div>
                    </Header>
                    <ChildContent>
                        <div class="security-tab-content">
                            <AttackSurfaceAudit />
                        </div>
                    </ChildContent>
                </TabPage>

                <TabPage Value="@FirewallTabValue" Title="Firewall">
                    <Header>
                        <div class="security-tab-header">
                            <span class="security-tab-title">Firewall</span>
                            <span class="security-tab-count">@GetFirewallTabStatus()</span>
                        </div>
                    </Header>
                    <ChildContent>
                        <div class="security-tab-content firewall-content">
                            <div class="section-heading">
                                <div>
                                    <p class="eyebrow">Host firewall</p>
                                    <h2>UFW inbound access</h2>
                                    <p class="meta-text">A small host-firewall UI for incoming allow rules. This does not replace a router, pfSense, or advanced nftables policy.</p>
                                </div>
                                <UiCommandButton Label="@(isLoadingFirewall ? "Refreshing..." : "Refresh")"
                                                 Glyph="UiIconGlyph.Refresh"
                                                 Variant="UiButtonVariant.Action"
                                                 Disabled="@(isLoadingFirewall || isChangingFirewall)"
                                                 OnClick="LoadFirewallAsync" />
                            </div>

                            @if (isLoadingFirewall && firewallStatus is null)
                            {
                                <section class="surface-subcard"><p class="meta-text">Reading UFW status and current listening ports...</p></section>
                            }
                            else if (firewallStatus is null)
                            {
                                <section class="surface-subcard firewall-status-unavailable">
                                    <div>
                                        <h3>Firewall status has not been loaded</h3>
                                        <p>Refresh to inspect UFW without changing the server.</p>
                                    </div>
                                    <UiCommandButton Label="Load firewall"
                                                     Glyph="UiIconGlyph.Refresh"
                                                     OnClick="LoadFirewallAsync" />
                                </section>
                            }
                            else
                            {
                                @if (!string.IsNullOrWhiteSpace(firewallMessage))
                                {
                                    <p class="callout @(firewallMessageIsError ? "error" : "success")">@firewallMessage</p>
                                }

                                @if (!string.IsNullOrWhiteSpace(firewallStatus.Warning))
                                {
                                    <p class="callout warning">@firewallStatus.Warning</p>
                                }

                                <section class="surface-subcard firewall-auto-rollback-panel @(firewallAutoRollbackEnabled ? "is-enabled" : "is-disabled")">
                                    <div>
                                        <strong>Auto Rollback</strong>
                                        <p>@(firewallAutoRollbackEnabled
                                               ? "Firewall changes get a 30-second Keep/Revert window. They revert automatically unless you keep them."
                                               : "Firewall changes are permanent immediately. You could lock yourself out of this host.")</p>
                                    </div>
                                    <div class="firewall-auto-rollback-control">
                                        <span class="status-pill @(firewallAutoRollbackEnabled ? "success" : "warning")">@(firewallAutoRollbackEnabled ? "On" : "Off · At your own risk")</span>
                                        <UiSwitchField Label="Auto Rollback"
                                                       @bind-Value="firewallAutoRollbackEnabled"
                                                       Title="@(firewallAutoRollbackEnabled ? "Turn off to apply UFW changes immediately" : "Turn on the 30-second Keep/Revert safety window")"
                                                       Disabled="@(isChangingFirewall || IsAnySecurityTrialActive)" />
                                    </div>
                                </section>

                                @if (ActiveFirewallTrial is not null)
                                {
                                    <section class="surface-subcard security-network-trial firewall-trial" role="status" aria-live="polite">
                                        <div class="security-network-trial-copy">
                                            <div class="security-network-trial-heading">
                                                <span class="status-pill warning">Auto rollback · @firewallTrialRemainingSeconds s</span>
                                                <strong>@ActiveFirewallTrial.Title</strong>
                                            </div>
                                            <p>@ActiveFirewallTrial.Detail</p>
                                            <small>The exact pre-change UFW configuration is saved. This change automatically reverts unless you keep it.</small>
                                        </div>
                                        <div class="security-network-trial-actions">
                                            <UiCommandButton Label="Keep change"
                                                             Glyph="UiIconGlyph.Save"
                                                             Disabled="@isChangingFirewall"
                                                             OnClick="KeepFirewallTrialAsync" />
                                            <UiCommandButton Label="Revert now"
                                                             Glyph="UiIconGlyph.Refresh"
                                                             Variant="UiButtonVariant.Ghost"
                                                             Disabled="@isChangingFirewall"
                                                             OnClick="RevertFirewallTrialAsync" />
                                        </div>
                                    </section>
                                }

                                <section class="surface-subcard firewall-status-panel">
                                    <div class="firewall-status-heading">
                                        <div>
                                            <p class="eyebrow">UFW state</p>
                                            <h3>@(firewallStatus.IsActive ? "Firewall active" : firewallStatus.IsInstalled ? "Firewall inactive" : "UFW unavailable")</h3>
                                            <p>@GetFirewallStateSummary()</p>
                                        </div>
                                        <span class="status-pill @(firewallStatus.IsActive ? "success" : "warning")">
                                            @(firewallStatus.IsActive ? "Protected" : "Not filtering")
                                        </span>
                                    </div>

                                    <div class="firewall-policy-grid">
                                        <ServiceMetricComponent TagName="div" Label="Incoming" Value="@firewallStatus.IncomingPolicy" />
                                        <ServiceMetricComponent TagName="div" Label="Outgoing" Value="@firewallStatus.OutgoingPolicy" />
                                        <ServiceMetricComponent TagName="div" Label="Routed" Value="@firewallStatus.RoutedPolicy" />
                                        <ServiceMetricComponent TagName="div" Label="Logging" Value="@firewallStatus.Logging" />
                                    </div>

                                    @if (firewallStatus.IsInstalled && firewallStatus.CanManage)
                                    {
                                        <div class="toolbar-row">
                                            <UiCommandButton Label="@(firewallStatus.IsActive ? "Disable firewall" : "Enable firewall")"
                                                             Glyph="@(firewallStatus.IsActive ? UiIconGlyph.Unlock : UiIconGlyph.Lock)"
                                                             Variant="@(firewallStatus.IsActive ? UiButtonVariant.Danger : UiButtonVariant.Primary)"
                                                             Disabled="@(isChangingFirewall || IsAnySecurityTrialActive || (!firewallStatus.IsActive && firewallStatus.Rules.Count == 0 && firewallStatus.ListeningPorts.Count == 0))"
                                                             OnClick="ToggleFirewallAsync" />
                                            @if (firewallStatus.IsActive && firewallStatus.Rules.Any(static rule => rule.IsEnabled && rule.Number.HasValue))
                                            {
                                                <UiCommandButton Label="Remove all rules"
                                                                 Glyph="UiIconGlyph.Lock"
                                                                 Variant="UiButtonVariant.Danger"
                                                                 Disabled="@(isChangingFirewall || IsAnySecurityTrialActive)"
                                                                 OnClick="RemoveAllFirewallRulesAsync" />
                                            }
                                        </div>
                                    }
                                    else if (!firewallStatus.IsInstalled)
                                    {
                                        <div class="toolbar-row">
                                            <UiCommandButton Label="@(isChangingFirewall ? "Installing..." : "Install UFW")"
                                                             Glyph="UiIconGlyph.Download"
                                                             Disabled="@(isChangingFirewall || IsAnySecurityTrialActive)"
                                                             OnClick="InstallFirewallAsync" />
                                        </div>
                                    }
                                </section>

                                @if (firewallStatus.IsInstalled && firewallStatus.CanManage && firewallStatus.IsActive)
                                {
                                    <details class="surface-subcard firewall-rule-editor" open>
                                        <summary>
                                            <span>
                                                <strong>Add incoming allow rule</strong>
                                                <span class="meta-text">Source and destination default to any. @GetFirewallChangeModeSummary()</span>
                                            </span>
                                            <span class="status-pill neutral">Allow only</span>
                                        </summary>

                                        <EditForm Model="@firewallEditor" OnValidSubmit="AddFirewallRuleAsync" class="stack-form firewall-rule-editor-form">
                                            <DataAnnotationsValidator />
                                            <div class="field-row firewall-rule-primary-fields">
                                                <UiTextField @bind-Value="firewallEditor.Port"
                                                             Label="Port or range"
                                                             Placeholder="443 or 8000:8010" />
                                                <UiSelectField TValue="FirewallProtocol"
                                                               @bind-Value="firewallEditor.Protocol"
                                                               Label="Protocol">
                                                    <option value="@FirewallProtocol.Tcp">TCP</option>
                                                    <option value="@FirewallProtocol.Udp">UDP</option>
                                                    <option value="@FirewallProtocol.Any">TCP + UDP</option>
                                                </UiSelectField>
                                            </div>
                                            <div class="field-row">
                                                <UiTextField @bind-Value="firewallEditor.Source"
                                                             Label="Allow from"
                                                             Placeholder="any"
                                                             Helper="Client IP or CIDR. Blank means any source." />
                                                <UiTextField @bind-Value="firewallEditor.Destination"
                                                             Label="Allow to"
                                                             Placeholder="any"
                                                             Helper="Local server IP. Blank means every local destination." />
                                            </div>
                                            <UiTextField @bind-Value="firewallEditor.Comment"
                                                         Label="Comment"
                                                         Placeholder="Optional description" />
                                            <div class="toolbar-row">
                                                <UiCommandButton Label="Add allow rule"
                                                                 Glyph="UiIconGlyph.Plus"
                                                                 Type="submit"
                                                                 Disabled="@(isChangingFirewall || IsAnySecurityTrialActive)" />
                                            </div>
                                        </EditForm>
                                    </details>
                                }

                                <section class="surface-subcard firewall-rules-panel">
                                    <div class="firewall-panel-heading">
                                        <div>
                                            <p class="eyebrow">Existing policy</p>
                                            <h3>UFW rules</h3>
                                            <p>@(firewallStatus.IsActive ? $"Toggle, edit, or remove supported incoming allow rules. {GetFirewallChangeModeSummary()}" : "Configured rules are preserved and will load when UFW is enabled.")</p>
                                        </div>
                                        <span class="status-pill neutral">@GetFirewallRuleCountSummary()</span>
                                    </div>

                                    @if (firewallStatus.Rules.Count == 0)
                                    {
                                        <div class="empty-state compact-empty-state">
                                            <h3>No UFW rules configured</h3>
                                            <p>Enabling the firewall first imports the server's current non-loopback listeners so access is not removed all at once.</p>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="firewall-rule-list">
                                            @foreach (var rule in firewallStatus.Rules)
                                            {
                                                <div class="firewall-rule-row @(!rule.IsEnabled ? "is-disabled" : string.Empty)">
                                                    <span class="firewall-rule-number">@(rule.IsEnabled ? rule.Number?.ToString() ?? "·" : "Off")</span>
                                                    <div class="firewall-rule-destination">
                                                        <strong>@rule.Destination</strong>
                                                        @if (!string.IsNullOrWhiteSpace(rule.Comment))
                                                        {
                                                            <span>@rule.Comment</span>
                                                        }
                                                    </div>
                                                    <span class="status-pill @(!rule.IsEnabled ? "neutral" : rule.Action.StartsWith("ALLOW", StringComparison.OrdinalIgnoreCase) ? "success" : "warning")">@(rule.IsEnabled ? rule.Action : "Disabled")</span>
                                                    <div class="firewall-rule-source">
                                                        <span>from @rule.Source</span>
                                                        @if (rule.IsIpv6)
                                                        {
                                                            <small>IPv6</small>
                                                        }
                                                    </div>
                                                    <div class="firewall-rule-actions">
                                                        <UiSwitchField Label="@(rule.IsEnabled ? "On" : "Off")"
                                                                       Value="@rule.IsEnabled"
                                                                       ValueChanged="@((bool enabled) => ToggleFirewallRuleAsync(rule, enabled))"
                                                                       Compact="true"
                                                                       Class="firewall-rule-toggle"
                                                                       Title="@GetFirewallRuleToggleTitle(rule)"
                                                                       Disabled="@(!firewallStatus.IsActive || !rule.CanToggle || isChangingFirewall || IsAnySecurityTrialActive)" />
                                                        @if (rule.Number.HasValue || rule.DisabledRuleId.HasValue)
                                                        {
                                                            @if (rule.EditableAllowRule is not null)
                                                            {
                                                                <UiCommandButton Label="Edit"
                                                                                 Glyph="UiIconGlyph.Edit"
                                                                                 Variant="UiButtonVariant.Ghost"
                                                                                 Disabled="@(isChangingFirewall || IsAnySecurityTrialActive)"
                                                                                 OnClick="@(() => OpenFirewallRuleEditorAsync(rule))" />
                                                            }
                                                            <UiCommandButton Label="Delete"
                                                                             Glyph="UiIconGlyph.Delete"
                                                                             Variant="UiButtonVariant.Danger"
                                                                             Disabled="@(isChangingFirewall || IsAnySecurityTrialActive)"
                                                                             OnClick="@(() => RemoveFirewallRuleAsync(rule))" />
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </section>

                                <details class="surface-subcard firewall-listeners-panel">
                                    <summary>
                                        <span>
                                            <strong>Detected listening ports</strong>
                                            <span class="meta-text">Non-loopback TCP and UDP listeners that will be imported before first enablement.</span>
                                        </span>
                                        <span class="status-pill neutral">@firewallStatus.ListeningPorts.Count</span>
                                    </summary>
                                    @if (firewallStatus.ListeningPorts.Count == 0)
                                    {
                                        <p class="callout warning">No safe listener inventory is available. LMS will not enable UFW automatically because that could cut off access.</p>
                                    }
                                    else
                                    {
                                        <div class="firewall-listener-list">
                                            @foreach (var listener in firewallStatus.ListeningPorts)
                                            {
                                                <span><strong>@listener.Port</strong>/@listener.Protocol <small>to @listener.Destination</small></span>
                                            }
                                        </div>
                                    }
                                </details>
                            }
                        </div>
                    </ChildContent>
                </TabPage>

                <TabPage Value="@SshAdminTabValue" Title="SSH Server">
                    <Header>
                        <div class="security-tab-header">
                            <span class="security-tab-title">SSH Server</span>
                            <span class="security-tab-count">Admin</span>
                        </div>
                    </Header>
                    <ChildContent>
                        <div class="security-tab-content">
                            <SshAdminPanel CanAdminister="@HasAdministratorAccess" />
                        </div>
                    </ChildContent>
                </TabPage>

                <TabPage Value="@RemoteAccessUsersTabValue" Title="LMS Accounts">
                    <Header>
                        <div class="security-tab-header">
                            <span class="security-tab-title">LMS Accounts</span>
                            <span class="security-tab-count">@(page.Users.Count)</span>
                        </div>
                    </Header>
                    <ChildContent>
                        <div class="security-tab-content remote-access-content">
                            <div class="section-heading">
                                <div>
                                    <p class="eyebrow">LMS accounts</p>
                                    <h2>Accounts and authenticator access</h2>
                                    <p class="meta-text">Create LMS accounts with email-based sign-in and authenticator OTP. These accounts identify the operator; dedicated runner access controls what LMS can execute on a machine.</p>
                                </div>
                            </div>

                            <section class="surface-subcard security-runner-access-panel">
                                <div class="security-runner-access-copy">
                                    <p class="eyebrow">Automation trust model</p>
                                    <h3>Privileged automation is explicit</h3>
                                    <p>LMS is a control plane. If you want terminals, runbooks, patching, service management, and repair workflows to run without password prompts, the target machine needs a dedicated LMS runner account with key-based login and passwordless sudo.</p>
                                    <p>LMS treats that as an intentional grant of elevated control. Secrets are stored through the protected secret store, sudo automation is non-interactive, and privileged workflows should be traceable back to the signed-in LMS account that requested them.</p>
                                </div>

                                <div class="security-runner-access-pills">
                                    <span class="status-pill neutral">Dedicated runner</span>
                                    <span class="status-pill neutral">Public key login</span>
                                    <span class="status-pill warning">sudo -n</span>
                                    <span class="status-pill neutral">Operator traceability</span>
                                </div>
                            </section>

                            @if (!string.IsNullOrWhiteSpace(userMessage))
                            {
                                <p class="callout @(userMessageIsError ? "error" : "success")">@userMessage</p>
                            }

                            <section class="surface-subcard remote-access-create-panel">
                                <div class="remote-access-panel-heading">
                                    <div>
                                        <h3>Create LMS account</h3>
                                        <p>Create an LMS account and issue the authenticator QR for app access.</p>
                                    </div>
                                    <span class="status-pill @(page.Messaging.CanSendLoginSetupEmail ? "success" : "neutral")">
                                        @(page.Messaging.CanSendLoginSetupEmail ? "Email + OTP" : "OTP only")
                                    </span>
                                </div>

                                <EditForm Model="@userEditor" OnValidSubmit="CreateUserAsync" class="stack-form">
                                    <DataAnnotationsValidator />

                                    <UiTextField @bind-Value="userEditor.Email"
                                                 Label="Email"
                                                 Type="email"
                                                 Helper="Used for Linux Made Sane sign-in and OTP verification." />

                                    <UiComboboxField TValue="string"
                                                     Label="Associated Linux user"
                                                     Value="@userEditor.LinuxUsername"
                                                     ValueChanged="SetNewUserLinuxUsernameAsync"
                                                     ValueExpression="@(() => userEditor.LinuxUsername)"
                                                     Helper="Choose an existing local account, or leave this blank so LMS creates a managed Linux user from the email address.">
                                        <option value="">Create LMS-managed Linux user</option>
                                        @if (ShouldRenderCurrentLinuxUserOption(userEditor.LinuxUsername))
                                        {
                                            <option value="@userEditor.LinuxUsername">@FormatSavedLinuxUserOptionLabel(userEditor.LinuxUsername)</option>
                                        }
                                        @if (GetInteractiveLinuxUsers().Count > 0)
                                        {
                                            <optgroup label="Interactive users">
                                                @foreach (var linuxUser in GetInteractiveLinuxUsers())
                                                {
                                                    <option value="@linuxUser.UserName">@FormatLinuxUserOptionLabel(linuxUser)</option>
                                                }
                                            </optgroup>
                                        }
                                        @if (GetSystemLinuxUsers().Count > 0)
                                        {
                                            <optgroup label="System users">
                                                @foreach (var linuxUser in GetSystemLinuxUsers())
                                                {
                                                    <option value="@linuxUser.UserName">@FormatLinuxUserOptionLabel(linuxUser)</option>
                                                }
                                            </optgroup>
                                        }
                                    </UiComboboxField>

                                    @if (page.Messaging.CanSendLoginSetupEmail)
                                    {
                                        <p class="callout success">Verified Messaging is available. LMS will email the setup QR code and login link to the account email.</p>
                                    }
                                    else
                                    {
                                        <p class="meta-text">Messaging must be saved and pass a test email before LMS can email login setup QR codes. The QR code will still be shown here.</p>
                                    }

                                    <div class="remote-access-session-duration">
                                        <span class="ui-field-label">Login session</span>
                                        <span class="meta-text">How long this LMS account stays signed in before OTP is required again.</span>
                                        <div class="remote-access-session-duration-grid">
                                            <UiNumberField TValue="int"
                                                           Value="@GetSessionLifetimePart(userEditor.SessionLifetimeMinutes, SessionLifetimePart.Days)"
                                                           ValueChanged="@((int value) => SetNewUserSessionLifetimePart(SessionLifetimePart.Days, value))"
                                                           ValueExpression="@(() => userEditor.SessionLifetimeMinutes)"
                                                           Label="Days"
                                                           min="0"
                                                           max="@MaxSessionLifetimeDays"
                                                           step="1"
                                                           Compact="true" />
                                            <UiNumberField TValue="int"
                                                           Value="@GetSessionLifetimePart(userEditor.SessionLifetimeMinutes, SessionLifetimePart.Hours)"
                                                           ValueChanged="@((int value) => SetNewUserSessionLifetimePart(SessionLifetimePart.Hours, value))"
                                                           ValueExpression="@(() => userEditor.SessionLifetimeMinutes)"
                                                           Label="Hours"
                                                           min="0"
                                                           max="23"
                                                           step="1"
                                                           Compact="true" />
                                            <UiNumberField TValue="int"
                                                           Value="@GetSessionLifetimePart(userEditor.SessionLifetimeMinutes, SessionLifetimePart.Minutes)"
                                                           ValueChanged="@((int value) => SetNewUserSessionLifetimePart(SessionLifetimePart.Minutes, value))"
                                                           ValueExpression="@(() => userEditor.SessionLifetimeMinutes)"
                                                           Label="Minutes"
                                                           min="0"
                                                           max="59"
                                                           step="5"
                                                           Compact="true" />
                                        </div>
                                        <span class="meta-text">@FormatSessionLifetimeMinutes(userEditor.SessionLifetimeMinutes)</span>
                                    </div>

                                    <div class="toolbar-row">
                                        <UiCommandButton Label="@(isSavingUser ? "Registering..." : "Register account")"
                                                         Glyph="UiIconGlyph.Plus"
                                                         Type="submit"
                                                         Disabled="@isSavingUser" />
                                    </div>
                                </EditForm>
                            </section>

                            @if (provisioningResult is not null)
                            {
                                <div class="surface-subcard otp-provisioning-panel remote-access-provisioning-panel">
                                    <UiQrCode Payload="@provisioningResult.OtpUri"
                                              Class="otp-provisioning-qr"
                                              Title="Authenticator setup QR"
                                              AriaLabel="Authenticator setup QR"
                                              Caption="Scan this in your authenticator app" />

                                    <div class="stack-list">
                                        <ServiceMetricComponent TagName="div" Label="Provisioned email" Value="@provisioningResult.Email" />
                                        <ServiceMetricComponent TagName="div" Label="Manual key" Value="@provisioningResult.ManualEntryKey" />
                                        <ServiceMetricComponent TagName="div" Label="OTP URI" Value="@provisioningResult.OtpUri" />
                                        @if (provisioningResult.EmailSucceeded)
                                        {
                                            <p class="callout success">Setup email sent to @provisioningResult.Email.</p>
                                        }
                                        else if (provisioningResult.EmailAttempted)
                                        {
                                            <p class="callout warning">Account setup succeeded, but the setup email was not sent. @provisioningResult.EmailMessage</p>
                                        }
                                        else if (!page.Messaging.CanSendLoginSetupEmail)
                                        {
                                            <p class="callout warning">Setup email was not sent because Messaging is not verified. Send a successful test email from the Messaging tab to enable this.</p>
                                        }
                                        <p class="meta-text">Scan the QR code or enter the manual key in your authenticator app. If you reset OTP, the new QR is shown here again.</p>
                                    </div>
                                </div>
                            }

                            @if (page.Users.Count == 0)
                            {
                                <div class="empty-state">
                                    <h3>No LMS accounts</h3>
                                    <p>Create at least one LMS account before enabling authenticated access on interfaces that should require sign-in.</p>
                                </div>
                            }
                            else
                            {
                                <table class="remote-access-user-table">
                                    <thead>
                                        <tr>
                                            <th>Account</th>
                                            <th>Linux user</th>
                                            <th>Status</th>
                                            <th>Login session</th>
                                            <th>Last login</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var user in page.Users)
                                        {
                                            <tr>
                                                <td class="remote-access-account-cell">
                                                    <strong>@user.Email</strong>
                                                    @if (!user.HasOtpSecret)
                                                    {
                                                        <div class="meta-text">Authenticator secret missing</div>
                                                    }
                                                </td>
                                                <td>
                                                    <div class="remote-access-linux-editor">
                                                        <div class="ui-combobox-shell ui-select-shell remote-access-linux-combobox">
                                                            <select class="ui-combobox-input ui-select-input"
                                                                    value="@GetLinuxUsernameEditor(user)"
                                                                    aria-label="@($"Associated Linux user for {user.Email}")"
                                                                    @onchange="@((ChangeEventArgs args) => SetLinuxUsernameEditor(user.Id, args))">
                                                                @if (ShouldRenderCurrentLinuxUserOption(GetLinuxUsernameEditor(user)))
                                                                {
                                                                    <option value="@GetLinuxUsernameEditor(user)">@FormatSavedLinuxUserOptionLabel(GetLinuxUsernameEditor(user))</option>
                                                                }
                                                                @if (GetInteractiveLinuxUsers().Count > 0)
                                                                {
                                                                    <optgroup label="Interactive users">
                                                                        @foreach (var linuxUser in GetInteractiveLinuxUsers())
                                                                        {
                                                                            <option value="@linuxUser.UserName">@FormatLinuxUserOptionLabel(linuxUser)</option>
                                                                        }
                                                                    </optgroup>
                                                                }
                                                                @if (GetSystemLinuxUsers().Count > 0)
                                                                {
                                                                    <optgroup label="System users">
                                                                        @foreach (var linuxUser in GetSystemLinuxUsers())
                                                                        {
                                                                            <option value="@linuxUser.UserName">@FormatLinuxUserOptionLabel(linuxUser)</option>
                                                                        }
                                                                    </optgroup>
                                                                }
                                                            </select>
                                                            <span class="ui-combobox-indicator ui-select-indicator" aria-hidden="true">
                                                                <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                                                    <path d="m2.5 4.5 3.5 3 3.5-3" />
                                                                </svg>
                                                            </span>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="remote-access-status-text">
                                                        <span>@(user.IsEnabled ? "Enabled" : "Disabled")</span>
                                                        <span>@(user.HasOtpSecret ? "OTP ready" : "OTP missing")</span>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="remote-access-session-editor">
                                                        <label class="remote-access-session-part">
                                                            <span>Days</span>
                                                            <input class="remote-access-session-input"
                                                                   type="number"
                                                                   min="0"
                                                                   max="@MaxSessionLifetimeDays"
                                                                   step="1"
                                                                   value="@GetSessionLifetimePart(GetSessionLifetimeEditor(user), SessionLifetimePart.Days)"
                                                                   @onchange="@((ChangeEventArgs args) => SetSessionLifetimeEditorPart(user.Id, SessionLifetimePart.Days, args))" />
                                                        </label>
                                                        <label class="remote-access-session-part">
                                                            <span>Hours</span>
                                                            <input class="remote-access-session-input"
                                                                   type="number"
                                                                   min="0"
                                                                   max="23"
                                                                   step="1"
                                                                   value="@GetSessionLifetimePart(GetSessionLifetimeEditor(user), SessionLifetimePart.Hours)"
                                                                   @onchange="@((ChangeEventArgs args) => SetSessionLifetimeEditorPart(user.Id, SessionLifetimePart.Hours, args))" />
                                                        </label>
                                                        <label class="remote-access-session-part">
                                                            <span>Minutes</span>
                                                            <input class="remote-access-session-input"
                                                                   type="number"
                                                                   min="0"
                                                                   max="59"
                                                                   step="5"
                                                                   value="@GetSessionLifetimePart(GetSessionLifetimeEditor(user), SessionLifetimePart.Minutes)"
                                                                   @onchange="@((ChangeEventArgs args) => SetSessionLifetimeEditorPart(user.Id, SessionLifetimePart.Minutes, args))" />
                                                        </label>
                                                        <span class="meta-text">@FormatSessionLifetimeMinutes(GetSessionLifetimeEditor(user))</span>
                                                    </div>
                                                </td>
                                                <td>@FormatTimestamp(user.LastLoginAtUtc, "Never")</td>
                                                <td class="actions-cell">
                                                    <UiCommandButton Label="@(IsSavingUserSettings(user.Id) ? "Saving..." : "Save")"
                                                                     Glyph="UiIconGlyph.Save"
                                                                     Variant="UiButtonVariant.Action"
                                                                     Disabled="@IsSavingUserSettings(user.Id)"
                                                                     OnClick="@(() => SaveUserSettingsAsync(user))" />
                                                    <UiCommandButton Label="@(user.IsEnabled ? "Disable" : "Enable")"
                                                                     Glyph="@(user.IsEnabled ? UiIconGlyph.Disconnect : UiIconGlyph.Connect)"
                                                                     Variant="UiButtonVariant.Action"
                                                                     OnClick="@(() => ToggleUserAsync(user))" />
                                                    <UiCommandButton Label="Reset OTP" Glyph="UiIconGlyph.Refresh" Variant="UiButtonVariant.Action" OnClick="@(() => ResetUserOtpAsync(user))" />
                                                    <UiCommandButton Label="Delete" Glyph="UiIconGlyph.Delete" Variant="UiButtonVariant.Danger" OnClick="@(() => DeleteUserAsync(user))" />
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </div>
                    </ChildContent>
                </TabPage>

                <TabPage Value="@MessagingTabValue" Title="Messaging">
                    <Header>
                        <div class="security-tab-header">
                            <span class="security-tab-title">Messaging</span>
                            <span class="security-tab-count">@FormatMessagingProvider(page.Messaging.Provider)</span>
                        </div>
                    </Header>
                    <ChildContent>
                        <div class="security-tab-content remote-access-content">
                            <div class="section-heading">
                                <div>
                                    <p class="eyebrow">Email delivery</p>
                                    <h2>SMTP or Microsoft Graph</h2>
                                    <p class="meta-text">Configure local LMS email for passkey setup, account workflows, and future notifications. Secrets are stored in the protected LMS secret store, not appsettings.</p>
                                </div>
                                <UiCommandButton Label="Graph setup help"
                                                 Glyph="UiIconGlyph.Info"
                                                 Variant="UiButtonVariant.Action"
                                                 OnClick="OpenGraphHelpModal" />
                            </div>

                            @if (!string.IsNullOrWhiteSpace(messagingMessage))
                            {
                                <p class="callout @(messagingMessageIsError ? "error" : "success")">@messagingMessage</p>
                            }

                            <section class="surface-subcard remote-access-create-panel">
                                <EditForm Model="@messagingEditor" OnValidSubmit="SaveMessagingAsync" class="stack-form">
                                    <DataAnnotationsValidator />

                                    <div class="field-row">
                                        <UiCheckboxField @bind-Value="messagingEditor.IsEnabled"
                                                         Label="Email enabled"
                                                         Helper="Turn this on after the provider details are saved and tested." />
                                        <UiSelectField TValue="MessagingEmailProvider"
                                                       @bind-Value="messagingEditor.Provider"
                                                       Label="Provider">
                                            <option value="@MessagingEmailProvider.Disabled">Disabled</option>
                                            <option value="@MessagingEmailProvider.Smtp">SMTP</option>
                                            <option value="@MessagingEmailProvider.MicrosoftGraph">Microsoft Graph</option>
                                        </UiSelectField>
                                    </div>

                                    <div class="field-row">
                                        <UiTextField @bind-Value="messagingEditor.SenderAddress"
                                                     Label="Sender email"
                                                     Type="email"
                                                     Placeholder="serviceaccount@example.com" />
                                        <UiTextField @bind-Value="messagingEditor.SenderDisplayName"
                                                     Label="Sender name"
                                                     Placeholder="Linux Made Sane" />
                                    </div>

                                    @if (messagingEditor.Provider == MessagingEmailProvider.Smtp)
                                    {
                                        <div class="field-row">
                                            <UiTextField @bind-Value="messagingEditor.SmtpHost"
                                                         Label="SMTP host"
                                                         Placeholder="smtp.example.com" />
                                            <UiNumberField TValue="int"
                                                           @bind-Value="messagingEditor.SmtpPort"
                                                           Label="SMTP port"
                                                           min="1"
                                                           max="65535"
                                                           step="1" />
                                        </div>
                                        <div class="field-row">
                                            <UiTextField @bind-Value="messagingEditor.SmtpUsername"
                                                         Label="SMTP username"
                                                         Placeholder="serviceaccount@example.com"
                                                         Autocomplete="off" />
                                            <UiTextField @bind-Value="messagingEditor.SmtpPassword"
                                                         Label="SMTP password"
                                                         Type="password"
                                                         Helper="Leave blank to keep the stored password."
                                                         Autocomplete="new-password" />
                                        </div>
                                        <div class="field-row">
                                            <UiCheckboxField @bind-Value="messagingEditor.SmtpUseStartTls"
                                                             Label="Use TLS"
                                                             Helper="Most SMTP providers expect this on port 587." />
                                            <span class="meta-text">Stored password: @(messagingEditor.HasSmtpPassword ? "yes" : "no")</span>
                                        </div>
                                        <p class="meta-text">If the SMTP username belongs to an LMS Mail Relay user, LMS automatically uses the protected local relay connection and its pinned certificate. The host field is then only retained for compatibility.</p>
                                    }
                                    else if (messagingEditor.Provider == MessagingEmailProvider.MicrosoftGraph)
                                    {
                                        <div class="field-row">
                                            <UiTextField @bind-Value="messagingEditor.GraphTenantId"
                                                         Label="Tenant ID"
                                                         Autocomplete="off" />
                                            <UiTextField @bind-Value="messagingEditor.GraphClientId"
                                                         Label="Client ID"
                                                         Autocomplete="off" />
                                        </div>
                                        <div class="field-row">
                                            <UiTextField @bind-Value="messagingEditor.GraphClientSecret"
                                                         Label="Client secret"
                                                         Type="password"
                                                         Helper="Leave blank to keep the stored client secret."
                                                         Autocomplete="new-password" />
                                            <UiCheckboxField @bind-Value="messagingEditor.GraphSaveToSentItems"
                                                             Label="Save to Sent Items" />
                                        </div>
                                        <div class="field-row">
                                            <UiTextField @bind-Value="messagingEditor.GraphAuthority"
                                                         Label="Authority"
                                                         Placeholder="https://login.microsoftonline.com/" />
                                            <UiTextField @bind-Value="messagingEditor.GraphBaseUrl"
                                                         Label="Graph base URL"
                                                         Placeholder="https://graph.microsoft.com/v1.0" />
                                        </div>
                                        <p class="meta-text">Stored client secret: @(messagingEditor.HasGraphClientSecret ? "yes" : "no"). The Entra app needs Microsoft Graph application permission for Mail.Send and admin consent.</p>
                                    }

                                    <div class="toolbar-row">
                                        <UiCommandButton Label="@(isSavingMessaging ? "Saving..." : "Save messaging")"
                                                         Glyph="UiIconGlyph.Save"
                                                         Type="submit"
                                                         Disabled="@isSavingMessaging" />
                                    </div>
                                </EditForm>
                            </section>

                            <section class="surface-subcard remote-access-create-panel">
                                <div class="remote-access-panel-heading">
                                    <div>
                                        <h3>Send test email</h3>
                                        <p>Use this after saving SMTP or Graph settings.</p>
                                    </div>
                                    <span class="status-pill @(page.Messaging.IsEnabled ? "success" : "neutral")">@(page.Messaging.IsEnabled ? "Enabled" : "Disabled")</span>
                                    <span class="status-pill @(page.Messaging.CanSendLoginSetupEmail ? "success" : "warning")">@(page.Messaging.CanSendLoginSetupEmail ? "Verified" : "Not verified")</span>
                                </div>
                                @if (page.Messaging.LastVerifiedAtUtc is not null)
                                {
                                    <p class="meta-text">Last verified @FormatTimestamp(page.Messaging.LastVerifiedAtUtc, "Never"). LMS account QR emails are enabled.</p>
                                }
                                else
                                {
                                    <p class="meta-text">Send a successful test email to verify Messaging before LMS account QR emails become available.</p>
                                }
                                <div class="field-row">
                                    <UiTextField @bind-Value="messagingTestRecipient"
                                                 Label="Test recipient"
                                                 Type="email"
                                                 Placeholder="you@example.com" />
                                    <div class="toolbar-row">
                                        <UiCommandButton Label="@(isSendingMessagingTest ? "Sending..." : "Send test")"
                                                         Glyph="UiIconGlyph.Send"
                                                         Disabled="@isSendingMessagingTest"
                                                         OnClick="SendMessagingTestAsync" />
                                    </div>
                                </div>
                            </section>
                        </div>
                    </ChildContent>
                </TabPage>
            </ChildContent>
    </TabControl>
    }
</div>

<UiModal IsOpen="@IsEditingFirewallRule"
         Title="@FirewallRuleEditorTitle"
         Subtitle="@GetFirewallEditSubtitle()"
         Class="firewall-rule-edit-modal"
         CloseOnBackdrop="false"
         OnClose="CloseFirewallRuleEditorAsync">
    <ChildContent>
        <EditForm Model="@firewallEditEditor" OnValidSubmit="EditFirewallRuleAsync" class="stack-form firewall-rule-editor-form">
            <DataAnnotationsValidator />
            <div class="field-row firewall-rule-primary-fields">
                <UiTextField @bind-Value="firewallEditEditor.Port"
                             Label="Port or range"
                             Placeholder="443 or 8000:8010" />
                <UiSelectField TValue="FirewallProtocol"
                               @bind-Value="firewallEditEditor.Protocol"
                               Label="Protocol">
                    <option value="@FirewallProtocol.Tcp">TCP</option>
                    <option value="@FirewallProtocol.Udp">UDP</option>
                    <option value="@FirewallProtocol.Any">TCP + UDP</option>
                </UiSelectField>
            </div>
            <div class="field-row">
                <UiTextField @bind-Value="firewallEditEditor.Source"
                             Label="Allow from"
                             Placeholder="any"
                             Helper="Client IP or CIDR. Blank means any source." />
                <UiTextField @bind-Value="firewallEditEditor.Destination"
                             Label="Allow to"
                             Placeholder="any"
                             Helper="Local server IP or CIDR. Blank means every local destination." />
            </div>
            <UiTextField @bind-Value="firewallEditEditor.Comment"
                         Label="Comment"
                         Placeholder="Optional description" />
            <p class="callout warning">Verify access from a new connection. Existing connections can remain open because UFW tracks connection state.</p>
            <div class="toolbar-row">
                <UiCommandButton Label="Save rule"
                                 Glyph="UiIconGlyph.Edit"
                                 Type="submit"
                                 Disabled="@(isChangingFirewall || IsAnySecurityTrialActive)" />
                <UiCommandButton Label="Cancel"
                                 Glyph="UiIconGlyph.Clear"
                                 Variant="UiButtonVariant.Ghost"
                                 Disabled="@isChangingFirewall"
                                 OnClick="CloseFirewallRuleEditorAsync" />
            </div>
        </EditForm>
    </ChildContent>
</UiModal>

<UiModal IsOpen="@showGraphHelpModal"
         Title="Microsoft Graph email setup"
         Subtitle="Create a small Entra app registration for LMS email delivery."
         Class="security-graph-help-modal"
         OnClose="CloseGraphHelpModal">
    <ChildContent>
        <div class="security-graph-help-body">
            <p class="callout warning">Use a dedicated mailbox for LMS. Microsoft Graph <code>Mail.Send</code> as an application permission is broad until your Microsoft 365 admin restricts it to the LMS sender mailbox.</p>

            <section class="surface-subcard security-graph-help-section">
                <h3>1. Create the Entra app</h3>
                <ol class="security-graph-help-steps">
                    <li>Open Microsoft Entra admin center.</li>
                    <li>Go to <strong>Applications -> App registrations -> New registration</strong>.</li>
                    <li>Name it something obvious, for example <strong>Linux Made Sane Mail</strong>.</li>
                    <li>Set supported account type to <strong>Accounts in this organizational directory only</strong>.</li>
                    <li>Leave redirect URI blank. LMS uses client credentials, not an interactive Microsoft login.</li>
                    <li>After creation, copy <strong>Application (client) ID</strong> and <strong>Directory (tenant) ID</strong>.</li>
                </ol>
            </section>

            <section class="surface-subcard security-graph-help-section">
                <h3>2. Add the Graph permission</h3>
                <ol class="security-graph-help-steps">
                    <li>Open the app registration, then <strong>API permissions -> Add a permission -> Microsoft Graph</strong>.</li>
                    <li>Choose <strong>Application permissions</strong>. Do not choose delegated permissions.</li>
                    <li>Add <strong>Mail.Send</strong>.</li>
                    <li>Click <strong>Grant admin consent</strong> for the tenant.</li>
                </ol>
            </section>

            <section class="surface-subcard security-graph-help-section">
                <h3>3. Create the secret</h3>
                <ol class="security-graph-help-steps">
                    <li>Open <strong>Certificates & secrets -> Client secrets -> New client secret</strong>.</li>
                    <li>Use a clear name, for example <strong>LMS email delivery</strong>.</li>
                    <li>Copy the secret <strong>Value</strong> immediately. Do not copy the Secret ID.</li>
                    <li>Paste the value into LMS. It is stored in the protected LMS secret store.</li>
                </ol>
            </section>

            <section class="surface-subcard security-graph-help-section">
                <h3>4. Fill in LMS</h3>
                <div class="security-graph-help-points">
                    <div class="security-graph-help-point">
                        <strong>Provider</strong>
                        <span>Microsoft Graph</span>
                    </div>
                    <div class="security-graph-help-point">
                        <strong>Sender email</strong>
                        <span>The mailbox LMS sends from, for example <code>serviceaccount@example.com</code>.</span>
                    </div>
                    <div class="security-graph-help-point">
                        <strong>Tenant ID</strong>
                        <span>Directory (tenant) ID from the app overview.</span>
                    </div>
                    <div class="security-graph-help-point">
                        <strong>Client ID</strong>
                        <span>Application (client) ID from the app overview.</span>
                    </div>
                    <div class="security-graph-help-point">
                        <strong>Client secret</strong>
                        <span>The secret Value, not the Secret ID.</span>
                    </div>
                    <div class="security-graph-help-point">
                        <strong>Authority</strong>
                        <span><code>https://login.microsoftonline.com/</code></span>
                    </div>
                    <div class="security-graph-help-point">
                        <strong>Graph base URL</strong>
                        <span><code>https://graph.microsoft.com/v1.0</code></span>
                    </div>
                </div>
            </section>

            <section class="surface-subcard security-graph-help-section">
                <h3>5. Restrict the mailbox</h3>
                <p class="meta-text">Strongly recommended: restrict the app so it can only send as the LMS mailbox. The simplest Exchange Online route is an application access policy scoped to a mail-enabled security group containing the LMS sender mailbox.</p>
                <pre class="security-graph-help-code"><code>Connect-ExchangeOnline
New-ApplicationAccessPolicy -AppId &lt;client-id&gt; -PolicyScopeGroupId &lt;mail-enabled-security-group&gt; -AccessRight RestrictAccess -Description "Restrict Linux Made Sane mail sender"
Test-ApplicationAccessPolicy -Identity serviceaccount@example.com -AppId &lt;client-id&gt;</code></pre>
                <p class="meta-text">If your tenant uses newer Exchange application RBAC instead, use the tenant standard. The important bit is the same: LMS should only be able to send from the LMS sender mailbox.</p>
            </section>

            <section class="surface-subcard security-graph-help-section">
                <h3>Common failures</h3>
                <div class="security-graph-help-points">
                    <div class="security-graph-help-point">
                        <strong>401 / invalid_client</strong>
                        <span>Wrong tenant, wrong client ID, expired secret, or Secret ID copied instead of secret Value.</span>
                    </div>
                    <div class="security-graph-help-point">
                        <strong>403 / access denied</strong>
                        <span>Admin consent is missing, Mail.Send was added as delegated instead of application, or mailbox restriction blocks the sender.</span>
                    </div>
                    <div class="security-graph-help-point">
                        <strong>404 / resource not found</strong>
                        <span>The sender email is not a valid Exchange Online mailbox in that tenant.</span>
                    </div>
                    <div class="security-graph-help-point">
                        <strong>Test hangs or times out</strong>
                        <span>Check outbound HTTPS from the LMS host to Microsoft login and Graph endpoints.</span>
                    </div>
                </div>
            </section>
        </div>
    </ChildContent>
    <Footer>
        <UiCommandButton Label="Close"
                         Glyph="UiIconGlyph.Clear"
                         Variant="UiButtonVariant.Ghost"
                         OnClick="CloseGraphHelpModal" />
    </Footer>
</UiModal>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "tab")]
    public string? RequestedTab { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private SecuritySettingsPageViewModel page = new([], [], BuildDefaultMessagingViewModel());
    private IReadOnlyList<LocalNetworkInterfaceView> networkInterfaces = [];
    private IReadOnlyList<LinuxShareUser> localLinuxUsers = [];
    private TrustedNetworkAccessResult currentAccess = new("unknown", "unknown", false, null, false, false, false, false, false);
    private TrustedNetworkEntryEditor networkEditor = new();
    private SecurityUserEditor userEditor = new();
    private SecurityMessagingSettingsEditor messagingEditor = new();
    private FirewallAllowRuleEditor firewallEditor = new();
    private FirewallAllowRuleEditor firewallEditEditor = new();
    private FirewallStatusViewModel? firewallStatus;
    private SecurityUserProvisioningViewModel? provisioningResult;
    private bool isLoaded;
    private bool isSavingNetwork;
    private bool isSavingUser;
    private bool isSavingMessaging;
    private bool isSendingMessagingTest;
    private bool isLoadingFirewall;
    private bool isChangingFirewall;
    private bool firewallAutoRollbackEnabled = true;
    private string? networkMessage;
    private bool networkMessageIsError;
    private string? userMessage;
    private bool userMessageIsError;
    private string? messagingMessage;
    private bool messagingMessageIsError;
    private string? firewallMessage;
    private bool firewallMessageIsError;
    private int firewallTrialRemainingSeconds;
    private int? editingFirewallRuleNumber;
    private Guid? editingDisabledFirewallRuleId;
    private ClaimsPrincipal? currentPrincipal;
    private string messagingTestRecipient = string.Empty;
    private readonly Dictionary<Guid, int> sessionLifetimeEditors = new();
    private readonly Dictionary<Guid, string> linuxUsernameEditors = new();
    private readonly HashSet<Guid> savingSessionLifetimes = [];
    private readonly HashSet<Guid> savingLinuxUsernames = [];
    private string activeTab = TrustedNetworksTabValue;
    private bool showGraphHelpModal;
    private Guid? activeNetworkTrialId;
    private int networkTrialRemainingSeconds;
    private string networkTrialTitle = string.Empty;
    private string networkTrialDetail = string.Empty;
    private Func<Task>? pendingNetworkTrialCommit;

    private const string TrustedNetworksTabValue = "trusted-networks";
    private const string AttackSurfaceTabValue = "attack-surface";
    private const string FirewallTabValue = "firewall";
    private const string SshAdminTabValue = "ssh-admin";
    private const string RemoteAccessUsersTabValue = "remote-access-users";
    private const string MessagingTabValue = "messaging";
    private const int NetworkTrialDurationSeconds = 30;
    private const int MinutesPerHour = 60;
    private const int MinutesPerDay = 24 * MinutesPerHour;
    private const int MaxSessionLifetimeDays = SecuritySessionPolicy.MaximumSessionLifetimeMinutes / MinutesPerDay;

    private bool HasAuthenticatedLmsUser =>
        currentPrincipal?.Identity?.IsAuthenticated == true &&
        Guid.TryParse(currentPrincipal.FindFirstValue(ClaimTypes.NameIdentifier), out _);

    private bool HasAdministratorAccess =>
        HasAuthenticatedLmsUser || currentAccess.IsTrusted;

    private string CurrentAccountEmail =>
        currentPrincipal?.FindFirstValue(ClaimTypes.Email) ??
        currentPrincipal?.Identity?.Name ??
        "the current account";

    private static string CurrentAccountPasskeySetupHref =>
        $"/auth/setup-passkey?returnUrl={Uri.EscapeDataString("/settings")}";

    private bool IsNetworkTrialActive => activeNetworkTrialId.HasValue;

    private FirewallTrialViewModel? ActiveFirewallTrial => firewallStatus?.ActiveTrial;

    private bool IsAnySecurityTrialActive => IsNetworkTrialActive || ActiveFirewallTrial is not null;

    private IReadOnlyList<TrustedNetworkEntryViewModel> PublicFallbackNetworks =>
        page.TrustedNetworks
            .Where(IsPublicFallbackNetwork)
            .OrderBy(entry => entry.AddressOrCidr, StringComparer.Ordinal)
            .ToArray();

    private bool IsNetworkEditorOpen =>
        networkEditor.Id.HasValue || page.TrustedNetworks.Count == 0;

    protected override async Task OnInitializedAsync()
    {
        if (new Uri(Navigation.Uri).AbsolutePath.EndsWith("/attack-surface", StringComparison.OrdinalIgnoreCase))
        {
            activeTab = AttackSurfaceTabValue;
        }
        else if (IsKnownSecurityTab(RequestedTab))
        {
            activeTab = RequestedTab!;
        }

        var authenticationState = AuthenticationStateTask is null
            ? null
            : await AuthenticationStateTask;
        currentPrincipal = authenticationState?.User ?? HttpContext?.User;
        await LoadAsync();
        if (activeTab == FirewallTabValue && HasAdministratorAccess)
        {
            await LoadFirewallAsync();
        }
        isLoaded = true;
    }

    private static bool IsKnownSecurityTab(string? value) => value is
        TrustedNetworksTabValue or
        AttackSurfaceTabValue or
        FirewallTabValue or
        SshAdminTabValue or
        RemoteAccessUsersTabValue or
        MessagingTabValue;

    private async Task LoadAsync()
    {
        page = await SecuritySettingsService.GetPageAsync();
        messagingEditor = await SecuritySettingsService.GetMessagingEditorAsync();
        localLinuxUsers = await LoadLocalLinuxUsersAsync();
        SyncSessionLifetimeEditors();
        SyncLinuxUsernameEditors();
        networkInterfaces = LoadNetworkInterfaces();
        if (HttpContext?.Items.TryGetValue("LmsTrustedNetworkAccess", out var cachedAccess) == true &&
            cachedAccess is TrustedNetworkAccessResult authorizedAccess)
        {
            currentAccess = authorizedAccess;
        }
        else
        {
            currentAccess = await TrustedNetworkAccessService.EvaluateAsync(
                HttpContext?.Connection.RemoteIpAddress,
                HttpContext?.Request.Host.Host);
        }
    }

    private async Task<IReadOnlyList<LinuxShareUser>> LoadLocalLinuxUsersAsync()
    {
        try
        {
            var identities = await ShareService.GetUsersGroupsManagerAsync();
            return identities.Users;
        }
        catch
        {
            return [];
        }
    }

    private void SyncSessionLifetimeEditors()
    {
        var currentUserIds = page.Users.Select(user => user.Id).ToHashSet();
        foreach (var staleUserId in sessionLifetimeEditors.Keys.Where(userId => !currentUserIds.Contains(userId)).ToArray())
        {
            sessionLifetimeEditors.Remove(staleUserId);
        }

        foreach (var user in page.Users)
        {
            sessionLifetimeEditors[user.Id] = SecuritySessionPolicy.NormalizeSessionLifetimeMinutes(user.SessionLifetimeMinutes);
        }
    }

    private void SyncLinuxUsernameEditors()
    {
        var currentUserIds = page.Users.Select(user => user.Id).ToHashSet();
        foreach (var staleUserId in linuxUsernameEditors.Keys.Where(userId => !currentUserIds.Contains(userId)).ToArray())
        {
            linuxUsernameEditors.Remove(staleUserId);
        }

        foreach (var user in page.Users)
        {
            linuxUsernameEditors[user.Id] = user.LinuxUsername;
        }
    }

    private async Task HandleTabChangedAsync(string? value)
    {
        activeTab = string.IsNullOrWhiteSpace(value) ? TrustedNetworksTabValue : value;
        if (activeTab == FirewallTabValue && HasAdministratorAccess && firewallStatus is null)
        {
            await LoadFirewallAsync();
        }
    }

    private async Task LoadFirewallAsync()
    {
        if (!HasAdministratorAccess)
        {
            firewallMessage = "This request has not passed the LMS administrator access boundary.";
            firewallMessageIsError = true;
            return;
        }

        isLoadingFirewall = true;
        try
        {
            firewallStatus = await FirewallService.GetStatusAsync();
            if (firewallStatus.ActiveTrial is { } trial)
            {
                UpdateFirewallTrialCountdown(trial);
                _ = MonitorFirewallTrialAsync(trial.Id);
            }
            else
            {
                firewallTrialRemainingSeconds = 0;
            }
        }
        catch (Exception exception)
        {
            firewallMessage = exception.Message;
            firewallMessageIsError = true;
        }
        finally
        {
            isLoadingFirewall = false;
        }
    }

    private async Task ToggleFirewallAsync()
    {
        if (firewallStatus is null)
        {
            return;
        }

        await StartFirewallChangeAsync(async () =>
            firewallStatus.IsActive
                ? await FirewallService.StartDisableTrialAsync()
                : await FirewallService.StartEnableTrialAsync());
    }

    private async Task InstallFirewallAsync()
    {
        if (!HasAdministratorAccess || isChangingFirewall || IsAnySecurityTrialActive)
        {
            return;
        }

        isChangingFirewall = true;
        firewallMessage = null;
        firewallMessageIsError = false;
        try
        {
            await FirewallService.InstallAsync();
            firewallMessage = "UFW installed. It remains inactive until you enable the firewall.";
        }
        catch (Exception exception)
        {
            firewallMessage = exception.Message;
            firewallMessageIsError = true;
        }
        finally
        {
            await RefreshFirewallAfterChangeAsync();
            isChangingFirewall = false;
        }
    }

    private async Task AddFirewallRuleAsync()
    {
        await StartFirewallChangeAsync(() => FirewallService.StartAllowRuleTrialAsync(firewallEditor));
        if (!firewallMessageIsError)
        {
            firewallEditor = new FirewallAllowRuleEditor();
        }
    }

    private Task RemoveFirewallRuleAsync(FirewallRuleViewModel rule)
    {
        if (rule.DisabledRuleId is { } disabledRuleId)
        {
            return StartFirewallChangeAsync(() => FirewallService.StartRemoveDisabledRuleTrialAsync(disabledRuleId));
        }

        return rule.Number is { } ruleNumber
            ? StartFirewallChangeAsync(() => FirewallService.StartRemoveRuleTrialAsync(ruleNumber))
            : Task.CompletedTask;
    }

    private Task RemoveAllFirewallRulesAsync() =>
        StartFirewallChangeAsync(() => FirewallService.StartRemoveAllRulesTrialAsync());

    private Task ToggleFirewallRuleAsync(FirewallRuleViewModel rule, bool enabled)
    {
        if (enabled == rule.IsEnabled)
        {
            return Task.CompletedTask;
        }

        if (enabled && rule.DisabledRuleId is { } disabledRuleId)
        {
            return StartFirewallChangeAsync(() => FirewallService.StartEnableAllowRuleTrialAsync(disabledRuleId));
        }

        if (!enabled && rule.Number is { } ruleNumber)
        {
            return StartFirewallChangeAsync(() => FirewallService.StartDisableAllowRuleTrialAsync(ruleNumber));
        }

        return Task.CompletedTask;
    }

    private Task OpenFirewallRuleEditorAsync(FirewallRuleViewModel rule)
    {
        if ((rule.Number is null && rule.DisabledRuleId is null) ||
            rule.EditableAllowRule is null ||
            isChangingFirewall ||
            IsAnySecurityTrialActive)
        {
            return Task.CompletedTask;
        }

        editingFirewallRuleNumber = rule.Number;
        editingDisabledFirewallRuleId = rule.DisabledRuleId;
        firewallEditEditor = CloneFirewallEditor(rule.EditableAllowRule);
        return Task.CompletedTask;
    }

    private async Task EditFirewallRuleAsync()
    {
        Func<Task<FirewallTrialViewModel>> startAction;
        if (editingDisabledFirewallRuleId is { } disabledRuleId)
        {
            startAction = () => FirewallService.StartEditDisabledAllowRuleTrialAsync(disabledRuleId, firewallEditEditor);
        }
        else if (editingFirewallRuleNumber is { } ruleNumber)
        {
            startAction = () => FirewallService.StartEditAllowRuleTrialAsync(ruleNumber, firewallEditEditor);
        }
        else
        {
            return;
        }

        await StartFirewallChangeAsync(startAction);
        if (!firewallMessageIsError)
        {
            await CloseFirewallRuleEditorAsync();
        }
    }

    private Task CloseFirewallRuleEditorAsync()
    {
        if (isChangingFirewall)
        {
            return Task.CompletedTask;
        }

        editingFirewallRuleNumber = null;
        editingDisabledFirewallRuleId = null;
        firewallEditEditor = new FirewallAllowRuleEditor();
        return Task.CompletedTask;
    }

    private bool IsEditingFirewallRule =>
        editingFirewallRuleNumber.HasValue || editingDisabledFirewallRuleId.HasValue;

    private string FirewallRuleEditorTitle => editingFirewallRuleNumber is { } ruleNumber
        ? $"Edit UFW rule {ruleNumber}"
        : "Edit disabled UFW rule";

    private static FirewallAllowRuleEditor CloneFirewallEditor(FirewallAllowRuleEditor editor) =>
        new()
        {
            Port = editor.Port,
            Protocol = editor.Protocol,
            Source = editor.Source,
            Destination = editor.Destination,
            Comment = editor.Comment
