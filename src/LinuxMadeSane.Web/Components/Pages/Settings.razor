    private async Task StartFirewallChangeAsync(Func<Task<FirewallTrialViewModel>> startAction)
    {
        if (!HasAdministratorAccess || isChangingFirewall || IsAnySecurityTrialActive)
        {
            return;
        }

        isChangingFirewall = true;
        firewallMessage = null;
        firewallMessageIsError = false;
        var useAutoRollback = firewallAutoRollbackEnabled;
        try
        {
            var trial = await startAction();
            if (useAutoRollback)
            {
                firewallMessage = "Firewall change applied with Auto Rollback. Confirm that you can still reach this LMS host before keeping it.";
                await RefreshFirewallAfterChangeAsync();
                UpdateFirewallTrialCountdown(trial);
                _ = MonitorFirewallTrialAsync(trial.Id);
            }
            else
            {
                await FirewallService.ConfirmTrialAsync(trial.Id);
                firewallMessage = "Firewall change applied immediately. Auto Rollback is off.";
                await RefreshFirewallAfterChangeAsync();
            }
        }
        catch (Exception exception)
        {
            firewallMessage = exception.Message;
            firewallMessageIsError = true;
            await RefreshFirewallAfterChangeAsync();
            if (ActiveFirewallTrial is { } activeTrial)
            {
                firewallMessage = $"{exception.Message} The change is still protected by Auto Rollback; keep it or let it revert.";
                UpdateFirewallTrialCountdown(activeTrial);
                _ = MonitorFirewallTrialAsync(activeTrial.Id);
            }
        }
        finally
        {
            isChangingFirewall = false;
        }
    }

    private async Task KeepFirewallTrialAsync()
    {
        if (ActiveFirewallTrial is not { } trial)
        {
            return;
        }

        isChangingFirewall = true;
        try
        {
            await FirewallService.ConfirmTrialAsync(trial.Id);
            firewallMessage = "Firewall change kept. The new UFW state is permanent.";
            firewallMessageIsError = false;
        }
        catch (Exception exception)
        {
            firewallMessage = exception.Message;
            firewallMessageIsError = true;
        }
        finally
        {
            await RefreshFirewallAfterChangeAsync();
            isChangingFirewall = false;
        }
    }

    private async Task RevertFirewallTrialAsync()
    {
        if (ActiveFirewallTrial is not { } trial)
        {
            return;
        }

        isChangingFirewall = true;
        try
        {
            await FirewallService.RevertTrialAsync(trial.Id);
            firewallMessage = "Firewall change reverted. The exact previous UFW state is active again.";
            firewallMessageIsError = false;
        }
        catch (Exception exception)
        {
            firewallMessage = exception.Message;
            firewallMessageIsError = true;
        }
        finally
        {
            await RefreshFirewallAfterChangeAsync();
            isChangingFirewall = false;
        }
    }

    private async Task MonitorFirewallTrialAsync(Guid trialId)
    {
        try
        {
            while (ActiveFirewallTrial?.Id == trialId)
            {
                await Task.Delay(TimeSpan.FromSeconds(1));
                await InvokeAsync(async () =>
                {
                    if (ActiveFirewallTrial?.Id != trialId)
                    {
                        return;
                    }

                    if (ActiveFirewallTrial.ExpiresAtUtc <= DateTimeOffset.UtcNow)
                    {
                        await RefreshFirewallAfterChangeAsync();
                        firewallMessage = "Auto Rollback restored the exact previous UFW state after 30 seconds.";
                        firewallMessageIsError = false;
                        StateHasChanged();
                        return;
                    }

                    UpdateFirewallTrialCountdown(ActiveFirewallTrial);
                    StateHasChanged();
                });
            }
        }
        catch (ObjectDisposedException)
        {
            // The circuit ended. The singleton firewall service still owns the rollback timer.
        }
        catch (InvalidOperationException)
        {
            // The circuit ended. The singleton firewall service still owns the rollback timer.
        }
    }

    private async Task RefreshFirewallAfterChangeAsync()
    {
        try
        {
            firewallStatus = await FirewallService.GetStatusAsync();
            if (firewallStatus.ActiveTrial is { } trial)
            {
                UpdateFirewallTrialCountdown(trial);
            }
            else
            {
                firewallTrialRemainingSeconds = 0;
            }
        }
        catch (Exception exception)
        {
            firewallMessage = $"The firewall operation completed, but LMS could not refresh UFW status: {exception.Message}";
            firewallMessageIsError = true;
        }
    }

    private void UpdateFirewallTrialCountdown(FirewallTrialViewModel trial)
    {
        firewallTrialRemainingSeconds = Math.Max(
            0,
            (int)Math.Ceiling((trial.ExpiresAtUtc - DateTimeOffset.UtcNow).TotalSeconds));
    }

    private string GetFirewallTabStatus()
    {
        if (!HasAdministratorAccess)
        {
            return "Unavailable";
        }

        return firewallStatus is null
            ? "UFW"
            : firewallStatus.IsActive
                ? "On"
                : firewallStatus.IsInstalled
                    ? "Off"
                    : "Unavailable";
    }

    private string GetFirewallStateSummary()
    {
        if (firewallStatus is null)
        {
            return string.Empty;
        }

        if (!firewallStatus.IsInstalled)
        {
            return "Install the ufw package on this Linux host before configuring firewall rules.";
        }

        if (!firewallStatus.CanManage)
        {
            return "UFW is installed, but the LMS service account cannot use it through non-interactive sudo.";
        }

        return firewallStatus.IsActive
            ? "UFW is filtering inbound host traffic using the rules below."
            : firewallStatus.Rules.Count == 0
                ? $"UFW is not filtering traffic. First-time enablement will import {firewallStatus.ListeningPorts.Count} current listener rule(s), then use deny incoming and allow outgoing defaults."
                : "UFW is not filtering traffic. Enabling it will preserve the configured On/Off rule choices below.";
    }

    private string GetFirewallRuleCountSummary()
    {
        if (firewallStatus is null)
        {
            return "0 rules";
        }

        var enabledCount = firewallStatus.Rules.Count(static rule => rule.IsEnabled);
        var disabledCount = firewallStatus.Rules.Count - enabledCount;
        return disabledCount == 0
            ? $"{enabledCount} rule(s) on"
            : $"{enabledCount} on · {disabledCount} off";
    }

    private string GetFirewallRuleToggleTitle(FirewallRuleViewModel rule)
    {
        if (!rule.CanToggle)
        {
            return "This advanced UFW rule cannot be safely reconstructed by the simple rule editor.";
        }

        var action = rule.IsEnabled ? "Disable" : "Enable";
        return firewallAutoRollbackEnabled
            ? $"{action} this rule with a 30-second Auto Rollback window"
            : $"{action} this rule immediately. Auto Rollback is off.";
    }

    private string GetFirewallChangeModeSummary() =>
        firewallAutoRollbackEnabled
            ? "Auto Rollback is on, so changes get a 30-second Keep/Revert window."
            : "Auto Rollback is off, so changes are permanent immediately at your own risk.";

