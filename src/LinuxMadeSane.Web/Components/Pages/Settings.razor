    private void SetSessionLifetimeEditorPart(
        Guid userId,
        SessionLifetimePart part,
        ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var value))
        {
            return;
        }

        var currentMinutes = sessionLifetimeEditors.TryGetValue(userId, out var minutes)
            ? minutes
            : SecuritySessionPolicy.DefaultSessionLifetimeMinutes;
        sessionLifetimeEditors[userId] = BuildSessionLifetimeMinutes(currentMinutes, part, value);
    }

    private void SetNewUserSessionLifetimePart(SessionLifetimePart part, int value)
    {
        userEditor.SessionLifetimeMinutes = BuildSessionLifetimeMinutes(
            userEditor.SessionLifetimeMinutes,
            part,
            value);
    }

    private Task SetNewUserLinuxUsernameAsync(string? value)
    {
        userEditor.LinuxUsername = value?.Trim() ?? string.Empty;
        return Task.CompletedTask;
    }

    private string GetLinuxUsernameEditor(SecurityUserViewModel user)
    {
        if (linuxUsernameEditors.TryGetValue(user.Id, out var linuxUsername))
        {
            return linuxUsername;
        }

        linuxUsernameEditors[user.Id] = user.LinuxUsername;
        return user.LinuxUsername;
    }

    private void SetLinuxUsernameEditor(Guid userId, ChangeEventArgs args)
    {
        linuxUsernameEditors[userId] = args.Value?.ToString()?.Trim() ?? string.Empty;
    }

    private async Task SaveUserSettingsAsync(SecurityUserViewModel user)
    {
        var linuxUsername = GetLinuxUsernameEditor(user).Trim();
        if (string.IsNullOrWhiteSpace(linuxUsername))
        {
            userMessage = "Enter the Linux user this LMS account should use.";
            userMessageIsError = true;
            return;
        }

        if (!sessionLifetimeEditors.TryGetValue(user.Id, out var minutes))
        {
            minutes = user.SessionLifetimeMinutes;
        }

        savingLinuxUsernames.Add(user.Id);
        savingSessionLifetimes.Add(user.Id);
        userMessage = null;

        try
        {
            var normalizedMinutes = SecuritySessionPolicy.NormalizeSessionLifetimeMinutes(minutes);
            var editor = await SecuritySettingsService.GetUserEditorAsync(user.Id);
            editor.LinuxUsername = linuxUsername;
            editor.SessionLifetimeMinutes = normalizedMinutes;
            await SecuritySettingsService.SaveUserAsync(editor);
            sessionLifetimeEditors[user.Id] = normalizedMinutes;
            userMessage = $"Saved account settings for {user.Email}.";
            userMessageIsError = false;
            await LoadAsync();
        }
        catch (Exception exception)
        {
            userMessage = exception.Message;
            userMessageIsError = true;
        }
        finally
        {
            savingLinuxUsernames.Remove(user.Id);
            savingSessionLifetimes.Remove(user.Id);
        }
    }

    private bool IsSavingUserSettings(Guid userId) =>
        savingLinuxUsernames.Contains(userId) ||
        savingSessionLifetimes.Contains(userId);

    private IReadOnlyList<LinuxShareUser> GetInteractiveLinuxUsers() =>
        localLinuxUsers
