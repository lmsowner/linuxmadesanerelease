        var selected = SelectedTestClient ?? dashboard.Clients.FirstOrDefault(item => item.Enabled);
        if (selected is null)
        {
            selectedTestClientId = string.Empty;
            return;
        }

        selectedTestClientId = selected.Id.ToString("D");
        var allowedDomain = selected.AllowedSenderDomains.FirstOrDefault();
        if (!string.IsNullOrWhiteSpace(allowedDomain) &&
            (string.IsNullOrWhiteSpace(testFromAddress) ||
             !selected.AllowedSenderDomains.Any(domain => testFromAddress.EndsWith('@' + domain, StringComparison.OrdinalIgnoreCase))))
        {
            testFromAddress = $"lms-test@{allowedDomain}";
        }
    }

