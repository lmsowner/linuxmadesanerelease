    private async Task SaveLegacyAsync()
    {
        if (isSavingLegacy)
        {
            return;
        }

        isSavingLegacy = true;
        legacyResult = null;
        legacyProgress = "Validating the restricted listener…";
        var progress = new Progress<string>(message =>
        {
            legacyProgress = message;
            _ = InvokeAsync(StateHasChanged);
        });
        try
        {
            legacyResult = await MailRelayService.ConfigureLegacySubmissionAsync(
                new MailRelayLegacySubmissionRequest(
                    legacyEnabled,
                    SplitNetworkEntries(legacyListenAddresses),
                    SplitNetworkEntries(legacyAllowedNetworks)),
                progress);
            if (legacyResult.Success)
            {
                dashboard = await MailRelayService.GetDashboardAsync();
            }
        }
        catch (Exception exception)
        {
            legacyResult = new MailRelayLegacySubmissionResult(
                false,
                dashboard?.Configuration,
                $"Legacy device access was not changed: {exception.Message}");
        }
        finally
        {
            isSavingLegacy = false;
        }
    }

