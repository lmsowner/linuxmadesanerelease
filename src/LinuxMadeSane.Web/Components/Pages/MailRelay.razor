    private async Task ProvisionAsync()
    {
        if (!setupConfirmed || isProvisioning)
        {
            return;
        }

        isProvisioning = true;
        setupResult = null;
        errorMessage = null;
        setupProgress.Clear();

        try
        {
            var job = await MailRelayService.StartProvisioningAsync(BuildSetupRequest());
            await ApplyProvisioningJobAsync(job);
            StartProvisioningPoll(job.Id);
        }
        catch (Exception exception)
        {
            errorMessage = $"Mail Relay setup stopped: {exception.Message}";
            isProvisioning = false;
        }
    }

    private void StartProvisioningPoll(Guid jobId)
    {
        provisioningPollCancellation?.Cancel();
        provisioningPollCancellation?.Dispose();
        provisioningPollCancellation = new CancellationTokenSource();
        _ = PollProvisioningJobAsync(jobId, provisioningPollCancellation.Token);
    }

    private async Task PollProvisioningJobAsync(Guid jobId, CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                var job = MailRelayService.GetProvisioningJob(jobId);
                if (job is null)
                {
                    await InvokeAsync(() =>
                    {
                        isProvisioning = false;
                        errorMessage = "The background Mail Relay setup job could not be found.";
                        StateHasChanged();
                    });
                    return;
                }

                await InvokeAsync(async () =>
                {
                    await ApplyProvisioningJobAsync(job);
                    StateHasChanged();
                });
                if (job.IsTerminal)
                {
                    return;
                }

                await Task.Delay(TimeSpan.FromSeconds(1), cancellationToken);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            await InvokeAsync(() =>
            {
                isProvisioning = false;
                errorMessage = $"Mail Relay progress could not be refreshed: {exception.Message}";
                StateHasChanged();
            });
        }
    }

    private async Task ApplyProvisioningJobAsync(MailRelayProvisioningJobSnapshot job)
    {
        provisioningJob = job;
        isProvisioning = !job.IsTerminal;
        setupProgress.Clear();
        setupProgress.AddRange(job.Steps);

        if (!job.IsTerminal)
        {
            return;
        }

        setupResult = job.Result;
        if (job.Status == MailRelayProvisioningJobStatus.Failed && setupResult is null)
        {
            errorMessage = $"Mail Relay setup stopped: {job.Summary}";
        }

        if (job.Status == MailRelayProvisioningJobStatus.Succeeded && refreshedProvisioningJobId != job.Id)
        {
            refreshedProvisioningJobId = job.Id;
            dashboard = await MailRelayService.GetDashboardAsync();
            selectedCloudflareZoneId = job.Request.CloudflareZoneId;
            editingDomainId = dashboard.Domains.FirstOrDefault(item =>
                item.DomainName.Equals(job.Request.SendingDomain, StringComparison.OrdinalIgnoreCase))?.Id;
            var provisionedClient = dashboard.Clients.FirstOrDefault(item =>
                item.Username.Equals(job.Request.ApplicationUsername, StringComparison.OrdinalIgnoreCase));
            if (provisionedClient is not null)
            {
                selectedTestClientId = provisionedClient.Id.ToString("D");
                ApplyTestDefaults();
            }
        }
    }

    private void RestoreSetupRequest(MailRelaySetupRequest request)
    {
        selectedCloudflareZoneId = request.CloudflareZoneId;
        relayHostname = request.RelayHostname;
        sendingDomain = request.SendingDomain;
        dkimSelector = request.DkimSelector;
        applicationName = request.ApplicationName;
        applicationUsername = request.ApplicationUsername;
        var restoredClient = dashboard?.Clients.FirstOrDefault(item =>
            item.Username.Equals(request.ApplicationUsername, StringComparison.OrdinalIgnoreCase));
        if (restoredClient is not null)
        {
            selectedSetupClientId = restoredClient.Id.ToString("D");
        }
        allowTailscale = request.AllowTailscale;
        allowTrustedLan = request.AllowTrustedLan;
    }

