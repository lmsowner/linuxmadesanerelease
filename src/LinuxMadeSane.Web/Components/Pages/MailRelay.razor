    private async Task SavePublicIpMonitorAsync()
    {
        if (isSavingPublicIpMonitor || dashboard?.Configuration is null)
        {
            return;
        }

        isSavingPublicIpMonitor = true;
        publicIpMonitorMessage = null;
        publicIpMonitorSaveFailed = false;
        try
        {
            var configuration = await MailRelayService.SavePublicIpMonitorSettingsAsync(
                new MailRelayPublicIpMonitorSettingsRequest(
                    publicIpMonitorEnabled,
                    publicIpMonitorIntervalMinutes));
            dashboard = dashboard with { Configuration = configuration };
            publicIpMonitorMessage = publicIpMonitorEnabled
                ? "Automatic public IP protection is enabled. Running the first check now…"
                : "Automatic public IP checks are disabled. Check now remains available.";
            if (publicIpMonitorEnabled)
            {
                publicIpSyncResult = await MailRelayService.CheckPublicIpNowAsync();
                dashboard = await MailRelayService.GetDashboardAsync();
                publicIpMonitorMessage = publicIpSyncResult.Summary;
                publicIpMonitorSaveFailed = !publicIpSyncResult.Success;
            }
        }
        catch (Exception exception)
        {
            publicIpMonitorSaveFailed = true;
            publicIpMonitorMessage = $"Public IP protection could not be saved: {exception.Message}";
        }
        finally
        {
            isSavingPublicIpMonitor = false;
        }
    }

