    private async Task SaveHomeLabStorageAndContinueAsync()
    {
        if (!ThreadId.HasValue || !CanSaveHomeLabStorage)
        {
            return;
        }

        isSavingHomeLabStorage = true;
        homeLabStorageError = string.Empty;
        try
        {
            foreach (var role in requiredHomeLabStorageRoles)
            {
                await HomeLabService.SaveStorageRoleAsync(role, selectedHomeLabStoragePaths[role]);
            }

            await ChatService.SendUserMessageAsync(
                ThreadId.Value,
                new AiChatMessageComposer
                {
                    Content = "I selected and saved all required shared storage roles using the LMS folder controls. Continue this same Home Lab setup now."
                });
            requiredHomeLabStorageRoles = [];
            selectedHomeLabStoragePaths.Clear();
            storagePickerRole = null;
            await RefreshThreadsAsync();
            await RefreshWorkspaceAsync();
        }
        catch (Exception exception)
        {
            homeLabStorageError = exception.Message;
        }
        finally
        {
            isSavingHomeLabStorage = false;
        }
    }

    private void ReturnToHomeLabWhenApprovedChangeCompletes()
    {
        if (returnToHomeLabActionId is not { } proposedActionId || workspace is null)
        {
            return;
        }

        var invocation = workspace.Timeline
            .OfType<AiChatToolExecutionTimelineItemViewModel>()
            .FirstOrDefault(item => item.ProposedActionId == proposedActionId);
        if (invocation is null)
        {
            if (LatestRun?.IsTerminal == true)
            {
                returnToHomeLabActionId = null;
            }

            return;
        }

        if (invocation.Status != AiInvocationStatus.Succeeded)
        {
            if (invocation.Status is AiInvocationStatus.Failed or AiInvocationStatus.Cancelled)
            {
                returnToHomeLabActionId = null;
            }

            return;
        }

        if (LatestRun?.IsTerminal != true)
        {
            return;
        }

        returnToHomeLabActionId = null;
        NavigationManager.NavigateTo("/home-lab/apps?tab=apps", replace: true);
    }

    private static bool IsHomeLabMutation(string toolName) =>
        toolName.Equals(AiToolNames.ApplyHomeLabPromptRecipe, StringComparison.OrdinalIgnoreCase) ||
        toolName.Equals(AiToolNames.RepairHomeLabApplicationConfig, StringComparison.OrdinalIgnoreCase) ||
        toolName.Equals(AiToolNames.RepairHomeLabInstallation, StringComparison.OrdinalIgnoreCase);

