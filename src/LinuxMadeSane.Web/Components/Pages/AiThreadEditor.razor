    private void ScheduleTimelineScroll()
    {
        if (workspace is null || workspace.Timeline.Count == 0)
        {
            return;
        }

        var key = $"{workspace.Timeline.Count}:{LatestRun?.UpdatedAtUtc.UtcTicks ?? 0}";
        if (timelineScrollThreadId == workspace.Thread.Id &&
            key.Equals(lastTimelineScrollKey, StringComparison.Ordinal))
        {
            return;
        }

        smoothTimelineScroll = timelineScrollThreadId == workspace.Thread.Id &&
                               !string.IsNullOrEmpty(lastTimelineScrollKey);
        timelineScrollThreadId = workspace.Thread.Id;
        lastTimelineScrollKey = key;
        scrollTimelineToEnd = true;
    }

    private void UpdateWorkspaceRefreshLoop()
    {
        if (ThreadId.HasValue && ShouldPollRun)
        {
            if (workspaceRefreshCancellationTokenSource is not null)
            {
                return;
            }

            workspaceRefreshCancellationTokenSource = new CancellationTokenSource();
            workspaceRefreshTask = RunWorkspaceRefreshLoopAsync(ThreadId.Value, workspaceRefreshCancellationTokenSource.Token);
            return;
        }

        StopWorkspaceRefreshLoop();
    }

    private async Task RunWorkspaceRefreshLoopAsync(Guid threadId, CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));

        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    if (!ThreadId.HasValue || ThreadId.Value != threadId)
                    {
                        StopWorkspaceRefreshLoop();
                        return;
                    }

                    try
                    {
                        await RefreshThreadsAsync();
                        workspace = await ChatService.GetWorkspaceAsync(threadId);
                        SyncApprovalDrafts();
                        await SyncRequiredHomeLabStorageAsync();
                        await SyncRequiredHomeLabVpnGatewayChoiceAsync();
                        ScheduleTimelineScroll();
                        ReturnToHomeLabWhenApprovedChangeCompletes();
                        UpdateWorkspaceRefreshLoop();
                    }
                    catch (Exception exception)
                    {
                        workspaceError = $"Workspace refresh failed: {exception.Message}";
                        StopWorkspaceRefreshLoop();
                    }

                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void StopWorkspaceRefreshLoop()
    {
        if (workspaceRefreshCancellationTokenSource is null)
        {
            return;
        }

        workspaceRefreshCancellationTokenSource.Cancel();
        workspaceRefreshCancellationTokenSource.Dispose();
        workspaceRefreshCancellationTokenSource = null;
        workspaceRefreshTask = null;
    }

    public async ValueTask DisposeAsync()
    {
        var refreshTask = workspaceRefreshTask;
        StopWorkspaceRefreshLoop();

        if (refreshTask is not null)
        {
            try
            {
                await refreshTask;
            }
            catch (OperationCanceledException)
            {
            }
        }
    }

    private void SyncApprovalDrafts()
    {
        var pendingIds = PendingApprovalRequests
            .Select(request => request.Id)
            .ToHashSet();
        submittingApprovalIds.RemoveWhere(id => !pendingIds.Contains(id));
    }

    private async Task SyncRequiredHomeLabStorageAsync()
    {
        if (workspace is null)
        {
            return;
        }

        var invocation = workspace.Timeline
            .OfType<AiChatToolExecutionTimelineItemViewModel>()
            .Where(item => item.ToolName.Equals(AiToolNames.ApplyHomeLabPromptRecipe, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(item => item.StartedAtUtc)
            .FirstOrDefault();
        if (invocation is null || processedStorageSetupInvocationId == invocation.InvocationId)
        {
            return;
        }

        processedStorageSetupInvocationId = invocation.InvocationId;
        var requestedRoles = invocation.Status == AiInvocationStatus.Failed
            ? GetRequiredStorageRoles(invocation.PayloadText)
            : [];
        if (requestedRoles.Count == 0)
        {
            requiredHomeLabStorageRoles = [];
            selectedHomeLabStoragePaths.Clear();
            storagePickerRole = null;
            homeLabStorageError = string.Empty;
            return;
        }

        var homeLabWorkspace = await HomeLabService.GetWorkspaceAsync();
        requiredHomeLabStorageRoles = requestedRoles
            .Where(role => homeLabWorkspace.StorageRoles.All(saved =>
                !saved.Role.Equals(role, StringComparison.OrdinalIgnoreCase) ||
                string.IsNullOrWhiteSpace(saved.HostPath)))
            .ToArray();
        selectedHomeLabStoragePaths.Clear();
        storagePickerRole = null;
        homeLabStorageError = string.Empty;
    }

    private async Task SyncRequiredHomeLabVpnGatewayChoiceAsync()
    {
        if (workspace is null)
        {
            requiredHomeLabVpnGateways = [];
            requiredHomeLabVpnGatewayInvocationId = null;
            return;
        }

        var invocation = workspace.Timeline
            .OfType<AiChatToolExecutionTimelineItemViewModel>()
            .Where(item => item.ToolName.Equals(AiToolNames.ApplyHomeLabPromptRecipe, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(item => item.StartedAtUtc)
            .FirstOrDefault();
        if (invocation is null ||
            invocation.Status != AiInvocationStatus.Failed ||
            invocation.InvocationId == dismissedVpnGatewayChoiceInvocationId)
        {
            requiredHomeLabVpnGateways = [];
            requiredHomeLabVpnGatewayInvocationId = invocation?.InvocationId;
            return;
        }

        if (invocation.InvocationId == requiredHomeLabVpnGatewayInvocationId &&
            requiredHomeLabVpnGateways.Count > 0)
        {
            return;
        }

        ApplyHomeLabPromptRecipeToolResponse? response = null;
        try
        {
            response = JsonSerializer.Deserialize<ApplyHomeLabPromptRecipeToolResponse>(
                invocation.PayloadText,
                ToolPayloadSerializerOptions);
        }
        catch (JsonException)
        {
        }

        var choices = response?.RequiredVpnGateways;
        var needsGatewayChoice = response?.Details.Any(detail =>
                detail.Contains("Several VPN Gateways", StringComparison.OrdinalIgnoreCase)) == true ||
            invocation.OutputText.Contains("Several VPN Gateways", StringComparison.OrdinalIgnoreCase);
        if ((choices is null || choices.Count == 0) && needsGatewayChoice)
        {
            var homeLabWorkspace = await HomeLabService.GetWorkspaceAsync();
            choices = homeLabWorkspace.Installations
                .Where(item => item.AppId.Equals("vpn-gateway", StringComparison.OrdinalIgnoreCase))
                .Select(item => new HomeLabAiGateway(
                    item.Id,
                    item.DisplayName,
                    item.HealthState.ToString(),
                    item.HealthDetail))
                .ToArray();
        }

        requiredHomeLabVpnGateways = choices ?? [];
        requiredHomeLabVpnGatewayInvocationId = invocation.InvocationId;
    }

    private async Task SelectHomeLabVpnGatewayAsync(HomeLabAiGateway gateway)
    {
        if (!ThreadId.HasValue ||
            isSendingMessage ||
            isSelectingHomeLabVpnGateway ||
            HasActiveRun)
        {
            return;
        }

        isSelectingHomeLabVpnGateway = true;
        messageError = string.Empty;
        dismissedVpnGatewayChoiceInvocationId = requiredHomeLabVpnGatewayInvocationId;

        try
        {
            await ChatService.SendUserMessageAsync(
                ThreadId.Value,
                new AiChatMessageComposer
                {
                    Content = $"Use the existing VPN Gateway \"{gateway.Name}\" with installation ID {gateway.InstallationId} for the requested Home Lab installation and continue now."
                });
            requiredHomeLabVpnGateways = [];
            await RefreshThreadsAsync();
            await RefreshWorkspaceAsync();
        }
        catch (Exception exception)
        {
            messageError = exception.Message;
        }
        finally
        {
            isSelectingHomeLabVpnGateway = false;
        }
    }

    private static IReadOnlyList<string> GetRequiredStorageRoles(string payloadText)
    {
        ApplyHomeLabPromptRecipeToolResponse? response = null;
        try
        {
            response = JsonSerializer.Deserialize<ApplyHomeLabPromptRecipeToolResponse>(
                payloadText,
                ToolPayloadSerializerOptions);
        }
        catch (JsonException)
        {
        }

        var explicitRoles = response?.RequiredStorageRoles?
            .Where(role => KnownHomeLabStorageRoles.Contains(role, StringComparer.OrdinalIgnoreCase))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray() ?? [];
        if (explicitRoles.Length > 0)
        {
            return explicitRoles;
        }

        var details = response?.Details ?? [];
        return KnownHomeLabStorageRoles
            .Where(role => details.Any(detail =>
                detail.Contains($"'{role}'", StringComparison.OrdinalIgnoreCase)))
            .ToArray();
    }

