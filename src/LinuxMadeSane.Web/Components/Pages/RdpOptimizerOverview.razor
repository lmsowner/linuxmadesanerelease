    private bool HasDesktopHelperSession =>
        desktopChatWorkspace?.IsReady ?? (viewModel?.Inspection.DesktopSessionBroker.BestAvailableSession is not null);

    private bool IsDesktopHelperConfiguredOff =>
        desktopHelperSetup is { IsManaged: true, IsEnabled: false };

    private bool CanApplyDesktopHelperSetup =>
        desktopHelperSetup?.IsManaged == true &&
        !isDesktopHelperSetupBusy &&
        desktopHelperEnabledEditor != desktopHelperSetup.IsEnabled;

    private Task SetDesktopHelperEnabledEditorAsync(bool enabled)
    {
        desktopHelperEnabledEditor = enabled;
        desktopHelperSetupMessage = string.Empty;
        desktopHelperSetupMessageIsError = false;
        return Task.CompletedTask;
    }

    private async Task ApplyDesktopHelperSetupAsync()
    {
        if (!CanApplyDesktopHelperSetup)
        {
            return;
        }

        isDesktopHelperSetupBusy = true;
        desktopHelperSetupMessage = string.Empty;
        desktopHelperSetupMessageIsError = false;
        try
        {
            var setupResult = await DesktopHelperSetupService.SetEnabledAsync(desktopHelperEnabledEditor);
            desktopHelperSetup = setupResult.Status;
            desktopHelperEnabledEditor = setupResult.Status.IsEnabled;
            desktopHelperSetupMessage = setupResult.Message;
            desktopHelperSetupMessageIsError = !setupResult.Succeeded;
            UpdateDesktopHelperAutoRefreshLoop();
            if (setupResult.Succeeded && setupResult.Status.IsEnabled)
            {
                await RefreshWorkspaceAsync();
            }
        }
        catch (Exception exception)
        {
            desktopHelperSetupMessage = exception.Message;
            desktopHelperSetupMessageIsError = true;
        }
        finally
        {
            isDesktopHelperSetupBusy = false;
        }
    }

    private bool GraphicalDesktopIsEnabled =>
        graphicalDesktopStatus is { IsManaged: true } status &&
        (status.StartsOnBoot || status.DisplayManagerActive);

    private UiPillTone GetGraphicalDesktopTone() =>
        graphicalDesktopStatus?.IsManaged != true
            ? UiPillTone.Warning
            : GraphicalDesktopIsEnabled ? UiPillTone.Warning : UiPillTone.Success;

    private Task OpenDisableGraphicalDesktopModal()
    {
        if (graphicalDesktopStatus?.IsManaged == true && !isGraphicalDesktopBusy)
        {
            showDisableGraphicalDesktopModal = true;
            graphicalDesktopMessage = string.Empty;
            graphicalDesktopMessageIsError = false;
        }

        return Task.CompletedTask;
    }

    private Task CloseDisableGraphicalDesktopModal()
    {
        if (!isGraphicalDesktopBusy)
        {
            showDisableGraphicalDesktopModal = false;
        }

        return Task.CompletedTask;
    }

    private async Task ApplyGraphicalDesktopModeAsync(bool enabled)
    {
        if (graphicalDesktopStatus?.IsManaged != true || isGraphicalDesktopBusy)
        {
            return;
        }

        isGraphicalDesktopBusy = true;
        graphicalDesktopMessage = string.Empty;
        graphicalDesktopMessageIsError = false;
        try
        {
            var setupResult = await DesktopHelperSetupService.SetGraphicalDesktopEnabledAsync(enabled);
            graphicalDesktopStatus = setupResult.Status;
            graphicalDesktopMessage = setupResult.Message;
            graphicalDesktopMessageIsError = !setupResult.Succeeded;
            if (!enabled)
            {
                desktopHelperSetup = await DesktopHelperSetupService.GetStatusAsync();
                desktopHelperEnabledEditor = desktopHelperSetup.IsEnabled;
                UpdateDesktopHelperAutoRefreshLoop();
            }
            if (setupResult.Succeeded)
            {
                showDisableGraphicalDesktopModal = false;
            }
        }
        catch (Exception exception)
        {
            graphicalDesktopMessage = exception.Message;
            graphicalDesktopMessageIsError = true;
        }
        finally
        {
            isGraphicalDesktopBusy = false;
        }
    }

