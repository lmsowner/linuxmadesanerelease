@page "/InitialSetup"
@page "/initial-setup"
@page "/setup"
@layout AuthLayout
@using System.Net
@using System.Net.NetworkInformation
@using LinuxMadeSane.Application.Contracts.Security
@using LinuxMadeSane.Application.Interfaces
@using LinuxMadeSane.Application.Services
@inject ISecuritySettingsService SecuritySettingsService
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor
@inject TemporarySetupAuthorizationService SetupAuthorization

<PageTitle>@(IsSetupRoute ? "Setup | Linux Made Sane" : "Initial Setup | Linux Made Sane")</PageTitle>

<div class="initial-setup-shell">
    <section class="initial-setup-showcase">
        <img class="initial-setup-art" src="/images/lms-auth-panel.png" alt="Linux Made Sane secure access artwork" />
    </section>

    <section class="initial-setup-panel">
        <div class="initial-setup-heading">
            <p class="eyebrow">Linux Made Sane</p>
            <h1>@(IsSetupRoute ? "Initial setup." : "First access.")</h1>
            <p>@(IsSetupRoute ? "Enter the Temporary Setup Code printed by the command-line installer, then create the first LMS login." : "Create the first LMS login, prove the MFA code works, then LMS turns authentication on for the built-in interfaces.")</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <p class="initial-setup-callout error">@Error</p>
        }

        @if (!string.IsNullOrWhiteSpace(NetworkMessage))
        {
            <p class="initial-setup-callout @(NetworkError ? "error" : string.Empty)">@NetworkMessage</p>
        }

        @if (IsSetupRoute && !IsSetupAuthorized)
        {
            <div class="initial-setup-card">
                <h2>Enter your Temporary Setup Code</h2>
                <p>This one-time code is printed only after a fresh command-line installation. It expires when used or when its lifetime ends.</p>
                <form method="post" action="/auth/setup/authorize" class="initial-setup-form">
                    <label class="initial-setup-field">
                        <span>Temporary Setup Code</span>
                        <input name="temporarySetupCode"
                               type="text"
                               inputmode="text"
                               autocomplete="one-time-code"
                               placeholder="ABCD-1234"
                               required />
                    </label>
                    <button class="initial-setup-primary" type="submit">Continue setup</button>
                </form>
                <p class="initial-setup-footnote">If the code has expired, run the installer again from the Linux command line to mint a new one.</p>
            </div>
        }
        else if (setupState is null)
        {
            <p class="initial-setup-callout">Loading setup state...</p>
        }
        else
        {
            @if (setupState.IsComplete)
            {
                <div class="initial-setup-card">
                    <h2>Initial setup is complete.</h2>
                    <p>Use the normal LMS login screen with your email and MFA code.</p>
                    <a class="initial-setup-primary" href="/login">Open login</a>
                </div>
            }
            else if (setupState.AwaitingFirstLogin)
            {
                <div class="initial-setup-card">
                    <h2>Complete your first login.</h2>
                    <p>Your LMS account and MFA setup are ready. Sign in through the normal LMS login to confirm access. This setup page remains available until that login succeeds.</p>
                    <a class="initial-setup-primary" href="/login">Open login</a>
                </div>
            }
            else if (setupState.CanStart)
            {
                @if (setupState.HasInstallerIdentity)
                {
                    <div class="initial-setup-card">
                        <h2>Installer identity detected.</h2>
                        <p>LMS was installed by Linux user <strong>@setupState.InstallerLinuxUsername</strong>@FormatInstallerHome(setupState.InstallerHomeDirectory). This first LMS login will use that Linux identity by default.</p>
                    </div>
                }

                <form method="post" action="/auth/initial-setup/start" class="initial-setup-form">
                    <input type="hidden" name="returnUrl" value="@NormalizedReturnUrl" />

                    <label class="initial-setup-field">
                        <span>Email</span>
                        <input name="email" type="email" value="@Email" autocomplete="email" placeholder="you@example.com" required />
                    </label>

                    <label class="initial-setup-field">
                        <span>Default Linux user</span>
                        <input name="linuxUsername"
                               type="text"
                               value="@LinuxUsernameValue"
                               autocomplete="username"
                               placeholder="linuxuser"
                               required />
                    </label>

                    <button class="initial-setup-primary" type="submit">Register LMS login</button>
                    <p class="initial-setup-footnote">Use an email address you control. LMS links this login to the Linux user above for terminals, file access, MFA setup, passkeys, and recovery workflows.</p>
                </form>
            }
            else if (setupState.CanVerify && provisioning is not null)
            {
                <div class="initial-setup-card">
                    <div class="initial-setup-account">
                        <div>
                            <span>Account</span>
                            <strong>@provisioning.Email</strong>
                        </div>
                        <div>
                            <span>Linux user</span>
                            <strong>@provisioning.LinuxUsername</strong>
                        </div>
                    </div>

                    <div class="initial-setup-qr-row">
                        <div class="initial-setup-qr-box">
                            <UiQrCode Payload="@provisioning.OtpUri"
                                      AriaLabel="Linux Made Sane MFA setup QR code" />
                        </div>
                        <div class="initial-setup-manual-key">
                            <span>Manual key</span>
                            <code>@provisioning.ManualEntryKey</code>
                        </div>
                    </div>

                    <form method="post" action="/auth/initial-setup/verify" class="initial-setup-form compact">
                        <input type="hidden" name="returnUrl" value="@NormalizedReturnUrl" />
                        <input type="hidden" name="userId" value="@provisioning.UserId" />
                        <input type="hidden" name="email" value="@provisioning.Email" />

                        <label class="initial-setup-field">
                            <span>MFA code</span>
                            <input name="otpCode"
                                   type="text"
                                   inputmode="numeric"
                                   autocomplete="one-time-code"
                                   maxlength="6"
                                   pattern="[0-9]{6}"
                                   placeholder="123456"
                                   required />
                        </label>

                        <button class="initial-setup-primary" type="submit">Confirm MFA and enable authentication</button>
                    </form>

                    <form method="post" action="/auth/initial-setup/reset" class="initial-setup-reset-form">
                        <input type="hidden" name="returnUrl" value="@NormalizedReturnUrl" />
                        <button class="initial-setup-secondary" type="submit">Rotate setup QR</button>
                    </form>
                </div>
            }

            @if (securityPage is not null)
            {
                <section class="initial-setup-card initial-setup-network-recovery">
                    <div>
                        <h2>Recover interface access</h2>
                        <p>The Temporary Setup Code gives you a short recovery session. Use these controls if a network interface was disabled or made to require authentication before you could log in.</p>
                    </div>

                    @if (RecoverableTrustedNetworks.Count == 0)
                    {
                        <p class="initial-setup-footnote">No saved access rules match addresses currently reported by this machine. Saved rules for unavailable networks are hidden.</p>
                    }
                    else
                    {
                        <div class="initial-setup-network-list">
                            @foreach (var entry in RecoverableTrustedNetworks)
                            {
                                <article class="initial-setup-network-row">
                                    <div>
                                        <strong>@entry.Label</strong>
                                        <code>@entry.AddressOrCidr</code>
                                        <span>@DescribeNetworkAccess(entry)</span>
                                    </div>
                                    <div class="initial-setup-network-actions">
                                        @if (!entry.IsEnabled)
                                        {
                                            <form method="post" action="/auth/setup/network">
                                                <input type="hidden" name="entryId" value="@entry.Id" />
                                                <input type="hidden" name="action" value="enable" />
                                                <button class="initial-setup-secondary" type="submit">Enable access</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form method="post" action="/auth/setup/network">
                                                <input type="hidden" name="entryId" value="@entry.Id" />
                                                <input type="hidden" name="action" value="toggle-authentication" />
                                                <button class="initial-setup-secondary" type="submit">@(entry.IsAuthenticationEnabled ? "Allow direct access" : "Require LMS login")</button>
                                            </form>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    }
                    <p class="initial-setup-footnote">Changes apply immediately. Sign in normally once access is restored; that closes this recovery page.</p>
                </section>
            }
        }
    </section>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    [SupplyParameterFromQuery]
    public string? LinuxUsername { get; set; }

    [SupplyParameterFromQuery]
    public string? NetworkMessage { get; set; }

    [SupplyParameterFromQuery]
    public bool NetworkError { get; set; }

    private InitialSetupViewModel? setupState;
    private SecurityUserProvisioningViewModel? provisioning;
    private SecuritySettingsPageViewModel? securityPage;

    private IReadOnlyList<TrustedNetworkEntryViewModel> RecoverableTrustedNetworks =>
        securityPage?.TrustedNetworks
            .Where(MatchesCurrentMachineAddress)
            .ToArray() ?? [];

    private bool IsSetupRoute =>
        new Uri(Navigation.Uri).AbsolutePath.Equals("/setup", StringComparison.OrdinalIgnoreCase);

    private bool IsSetupAuthorized =>
        HttpContextAccessor.HttpContext is { } context && SetupAuthorization.IsAuthorized(context.Request);

    private string NormalizedReturnUrl => NormalizeReturnUrl(ReturnUrl);

    private string LinuxUsernameValue =>
        !string.IsNullOrWhiteSpace(LinuxUsername)
            ? LinuxUsername.Trim()
            : setupState?.SuggestedLinuxUsername ?? string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (!IsSetupRoute && !IsSetupAuthorized)
        {
            Navigation.NavigateTo("/setup", forceLoad: true);
            return;
        }

        if (IsSetupRoute && !IsSetupAuthorized)
        {
            return;
        }

        setupState = await SecuritySettingsService.GetInitialSetupAsync();
        if (setupState.CanVerify)
        {
            provisioning = await SecuritySettingsService.GetInitialSetupProvisioningAsync(BuildLmsLoginUrl(setupState.PendingEmail));
        }

        securityPage = await SecuritySettingsService.GetPageAsync();
    }

    private static string NormalizeReturnUrl(string? returnUrl)
    {
        if (string.IsNullOrWhiteSpace(returnUrl))
        {
            return "/";
        }

        var trimmed = returnUrl.Trim();
        return trimmed.StartsWith("/", StringComparison.Ordinal) &&
               !trimmed.StartsWith("//", StringComparison.Ordinal) &&
               !trimmed.StartsWith("/\\", StringComparison.Ordinal) &&
               !trimmed.StartsWith("/InitialSetup", StringComparison.OrdinalIgnoreCase) &&
               !trimmed.StartsWith("/initial-setup", StringComparison.OrdinalIgnoreCase)
            ? trimmed
            : "/";
    }

    private static string FormatInstallerHome(string homeDirectory) =>
        string.IsNullOrWhiteSpace(homeDirectory)
            ? string.Empty
            : $" ({homeDirectory})";

    private string BuildLmsLoginUrl(string? email)
    {
        var loginUri = new Uri(new Uri(Navigation.BaseUri), "login");
        if (string.IsNullOrWhiteSpace(email))
        {
            return loginUri.ToString();
        }

        var builder = new UriBuilder(loginUri)
        {
            Query = $"email={Uri.EscapeDataString(email.Trim())}"
        };
        return builder.Uri.ToString();
    }

    private static string DescribeNetworkAccess(TrustedNetworkEntryViewModel entry)
    {
        if (!entry.IsEnabled)
        {
            return "Access disabled";
        }

        return entry.IsAuthenticationEnabled
            ? "LMS login required"
            : "Direct access allowed";
    }

    private static bool MatchesCurrentMachineAddress(TrustedNetworkEntryViewModel entry)
    {
        // Public fallback rules describe source policy, not a local interface. They must
        // never be presented as if the machine actually has such an interface.
        if (entry.IsBuiltIn && entry.AddressOrCidr is "0.0.0.0/0" or "::/0")
        {
            return false;
        }

        try
        {
            return NetworkInterface.GetAllNetworkInterfaces()
                .SelectMany(networkInterface =>
                {
                    try
                    {
                        return networkInterface.GetIPProperties().UnicastAddresses.AsEnumerable();
                    }
                    catch
                    {
                        return Enumerable.Empty<UnicastIPAddressInformation>();
                    }
                })
                .Any(address => TrustedNetworkMatcher.ContainsAddress(entry.AddressOrCidr, address.Address));
        }
        catch
        {
            return false;
        }
    }
}
