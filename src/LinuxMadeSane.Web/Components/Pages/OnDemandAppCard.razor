@using LinuxMadeSane.Core.Models.Cloudflare

<article class="on-demand-app @(IsFavourite ? "is-favourite" : null)"
         @oncontextmenu="OnOpenSettings"
         @oncontextmenu:preventDefault="true"
         @oncontextmenu:stopPropagation="true">
    <EdgeGatewayHttpServiceLookupStamp Service="Service"
                                       Href="@Href"
                                       Target="_blank"
                                       Rel="noopener"
                                       Disabled="@(!CanOpen)"
                                       OnClientClick="return window.lmsOnDemandApps?.openTracked(this, event) ?? false;" />
    <button type="button"
            class="on-demand-app-favourite @(IsFavourite ? "is-selected" : null)"
            title="@(IsFavourite ? "Remove from favourites" : "Add to favourites")"
            aria-label="@(IsFavourite ? $"Remove {Label} from favourites" : $"Add {Label} to favourites")"
            aria-pressed="@(IsFavourite ? "true" : "false")"
            disabled="@FavouriteDisabled"
            @onclick="OnToggleFavourite">@(IsFavourite ? "★" : "☆")</button>
    @if (IsFavourite)
    {
        <button type="button"
                class="on-demand-app-settings"
                title="Favourite connection settings"
                aria-label="Configure connection settings for @Label"
                @onclick="OnOpenSettings">⚙</button>
    }
</article>

@code {
    [Parameter, EditorRequired] public LocalHttpServiceEndpoint Service { get; set; } = default!;
    [Parameter] public string? Href { get; set; }
    [Parameter] public bool CanOpen { get; set; }
    [Parameter] public bool IsFavourite { get; set; }
    [Parameter] public bool FavouriteDisabled { get; set; }
    [Parameter] public EventCallback OnToggleFavourite { get; set; }
    [Parameter] public EventCallback OnOpenSettings { get; set; }

    private string Label => LocalHttpServiceDiscoveryRanking.PickerLabel(Service);
}
