    [JSInvokable]
    public async Task OnTerminalData(string data)
    {
        var targetTab = tab;
        if (targetTab is not { ConnectionDesired: true, SessionId: not null, IsSessionActive: true, IsBusy: false } ||
            string.IsNullOrEmpty(data))
        {
            return;
        }

        var isReturn = data.Contains('\r') || data.Contains('\n');
        var inputStarted = isReturn ? System.Diagnostics.Stopwatch.StartNew() : null;
        if (isReturn)
        {
            Logger.LogInformation("Terminal Return input started for host {HostId} session {SessionId}", targetTab.HostId, targetTab.SessionId);
        }

        try
        {
            await SendInputToTerminalAsync(targetTab, data, CancellationToken.None);
            targetTab.ErrorMessage = string.Empty;
            if (isReturn)
            {
                Logger.LogInformation("Terminal Return input completed for host {HostId} session {SessionId} after {ElapsedMs} ms",
                    targetTab.HostId, targetTab.SessionId, inputStarted!.Elapsed.TotalMilliseconds);
            }
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Terminal input failed for host {HostId} session {SessionId} after {ElapsedMs} ms",
                targetTab.HostId, targetTab.SessionId, inputStarted?.Elapsed.TotalMilliseconds);
            targetTab.ErrorMessage = exception.Message;
            await InvokeAsync(StateHasChanged);
        }
    }

