    private async Task ConnectFromConnectionPanelAsync()
    {
        if (tab is null || tab.IsBusy)
        {
            return;
        }

        tab.ErrorMessage = string.Empty;
        await InvokeAsync(StateHasChanged);
        if (tab.IsSessionActive)
        {
            await DisconnectAsync();
        }

        await ConnectAsync();
        if (!tab.IsSessionActive)
        {
            tab.ConnectionOptionsOpen = true;
            if (string.IsNullOrWhiteSpace(tab.ErrorMessage))
            {
                tab.ErrorMessage = "The connection did not start. Check the selected user and host, then try again.";
            }

            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ConnectAsProfileAsync(string connectionProfileKey)
    {
        if (tab is null || tab.IsBusy)
        {
            return;
        }

        var switchStarted = System.Diagnostics.Stopwatch.StartNew();
        var traceId = tab.BeginConnectionTrace("Loading selected connection profile");
        await InvokeAsync(StateHasChanged);
        Logger.LogInformation("Terminal profile switch started for host {HostId} profile {ProfileKey}", tab.HostId, connectionProfileKey);
        await SelectConnectionProfileAsync(tab, connectionProfileKey);
        if (!string.IsNullOrWhiteSpace(tab.ErrorMessage))
        {
            tab.AppendConnectionTrace(traceId, $"Profile lookup failed: {tab.ErrorMessage}");
            tab.FinishConnectionTrace(traceId);
            Logger.LogWarning("Terminal profile switch failed while loading profile for host {HostId} after {ElapsedMs} ms: {Error}",
                tab.HostId, switchStarted.Elapsed.TotalMilliseconds, tab.ErrorMessage);
            await OpenConnectionPanelAsync();
            return;
        }

        Logger.LogInformation("Terminal profile resolved for host {HostId} as {Username} after {ElapsedMs} ms",
            tab.HostId, tab.Username, switchStarted.Elapsed.TotalMilliseconds);
        tab.AppendConnectionTrace(traceId, $"Selected profile for {tab.Username}");
        await InvokeAsync(StateHasChanged);

        // The connection core replaces the old session under the gate.
        tab.RequestConnection();
        Logger.LogInformation("Terminal replacing previous session for host {HostId} as {Username}", tab.HostId, tab.Username);
        await ReconnectAsync();
        if (tab is { IsSessionActive: true, SessionId: Guid })
        {
            Logger.LogInformation("Terminal profile switch completed for host {HostId} as {Username} in {ElapsedMs} ms",
                tab.HostId, tab.ConnectedUsername, switchStarted.Elapsed.TotalMilliseconds);
        }
        else
        {
            Logger.LogWarning("Terminal profile switch failed for host {HostId} as {Username} after {ElapsedMs} ms: {Error}",
                tab.HostId, tab.Username, switchStarted.Elapsed.TotalMilliseconds, tab.ErrorMessage);
            await OpenConnectionPanelAsync();
        }
    }

