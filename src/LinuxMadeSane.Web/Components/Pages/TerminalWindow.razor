    private async Task RunCommandAsync(string commandText, CancellationToken cancellationToken)
    {
        var normalizedCommand = commandText.TrimEnd();
        if (string.IsNullOrWhiteSpace(normalizedCommand))
        {
            return;
        }

        var terminalInput = normalizedCommand + Environment.NewLine;
        await TerminalCommandTransportRecovery.SendWithReconnectAsync(
            () => SendCommandAsync(terminalInput, cancellationToken),
            async () =>
            {
                return await ReconnectAsync(cancellationToken);
            },
            cancellationToken);
        await FocusTerminalAsync();
    }

