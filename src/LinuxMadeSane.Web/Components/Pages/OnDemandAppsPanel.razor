@using System.Security.Claims
@using LinuxMadeSane.Application.Contracts.EdgeGateway
@using LinuxMadeSane.Application.Services.EdgeGateway
@using LinuxMadeSane.Core.Abstractions
@using LinuxMadeSane.Core.Models.Cloudflare
@using Microsoft.AspNetCore.Components.Authorization
@implements IDisposable
@inject ILocalHttpServiceDiscoveryService HttpServiceDiscovery
@inject OnDemandAppService OnDemandApps
@inject HttpServiceDiscoveryCoordinator DiscoveryCoordinator
@inject NavigationManager Navigation

<div class="on-demand-apps">
    <section class="surface-card on-demand-apps-toolbar">
        <div>
            <p class="eyebrow">Published server access</p>
            <h2>On-Demand Apps</h2>
            <p class="meta-text">Discover web apps on this network, then open a favourite through a temporary LMS-authenticated address. Right-click an app to save its connection defaults.</p>
        </div>
        <div class="on-demand-apps-scan-controls">
            <UiCheckboxField @bind-Value="includeDocker" Label="Docker" Compact="true" />
            <UiCheckboxField @bind-Value="includeLan" Label="LAN" Compact="true" />
            <UiCheckboxField @bind-Value="includeTailnet" Label="Tailscale" Compact="true" />
            <UiSelectField TValue="int"
                           Value="refreshIntervalMinutes"
                           ValueChanged="SetRefreshIntervalAsync"
                           ValueExpression="@(() => refreshIntervalMinutes)"
                           Label="Refresh"
                           Compact="true"
                           Inline="true">
                <option value="0">Manual only</option>
                <option value="60">Every hour</option>
                <option value="180">Every 3 hours</option>
                <option value="360">Every 6 hours</option>
                <option value="720">Every 12 hours</option>
                <option value="1440">Daily</option>
            </UiSelectField>
            <UiCommandButton Label="@(isScanning ? "Scanning in background..." : "Scan now")"
                             Glyph="UiIconGlyph.Search"
                             Variant="UiButtonVariant.Primary"
                             Disabled="@isScanning"
                             OnClick="ScanAsync" />
        </div>
    </section>

    @if (availability is null)
    {
        <p class="callout info">Checking the published LMS address and Edge Gateway relay…</p>
    }
    else if (!availability.IsAvailable)
    {
        <p class="callout warning"><strong>Opening apps is unavailable.</strong> @availability.Message Discovery and favourites remain available.</p>
    }
    else
    {
        <p class="callout success"><strong>Ready.</strong> @availability.Message Temporary routes are removed when their window closes or becomes stale.</p>
    }

    @if (isScanning)
    {
        <section class="surface-subcard on-demand-apps-progress" role="status" aria-live="polite">
            <span class="on-demand-apps-progress-bar"><span></span></span>
            <span>@BuildScanSummary()</span>
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <p class="meta-text on-demand-apps-message">@message</p>
    }

    @if (services.Count == 0 && !isScanning)
    {
        <section class="empty-state">
            <h3>No cached HTTP/S apps</h3>
            <p>Run Scan to search localhost, exposed Docker containers and the private LAN. Enable Tailscale only when you want tailnet peers included.</p>
        </section>
    }
    else
    {
        <div class="on-demand-apps-grid" role="list">
            @foreach (var service in SortedServices)
            {
                var key = LocalHttpServiceDiscoveryRanking.StableKey(service);
                var isFavourite = favouriteProfiles.ContainsKey(key);
                <article class="on-demand-app @(isFavourite ? "is-favourite" : null)"
                         @oncontextmenu="@(_ => OpenFavouriteSettings(service))"
                         @oncontextmenu:preventDefault="true"
                         @oncontextmenu:stopPropagation="true">
                    <EdgeGatewayHttpServiceLookupStamp Service="service"
                                                       Href="@(CanOpen ? BuildOpenUrl(key) : null)"
                                                       Target="_blank"
                                                       Rel="noopener"
                                                       Disabled="@(!CanOpen)"
                                                       OnClientClick="return window.lmsOnDemandApps?.openTracked(this, event) ?? false;" />
                    <button type="button"
                            class="on-demand-app-favourite @(isFavourite ? "is-selected" : null)"
                            title="@(isFavourite ? "Remove from favourites" : "Add to favourites")"
                            aria-label="@(isFavourite ? $"Remove {LocalHttpServiceDiscoveryRanking.PickerLabel(service)} from favourites" : $"Add {LocalHttpServiceDiscoveryRanking.PickerLabel(service)} to favourites")"
                            aria-pressed="@(isFavourite ? "true" : "false")"
                            disabled="@(string.IsNullOrWhiteSpace(userId) || favouriteChangeInProgress.Contains(key))"
                            @onclick="@(() => ToggleFavouriteAsync(service))">@(isFavourite ? "★" : "☆")</button>
                    @if (isFavourite)
                    {
                        <button type="button"
                                class="on-demand-app-settings"
                                title="Favourite connection settings"
                                aria-label="Configure connection settings for @LocalHttpServiceDiscoveryRanking.PickerLabel(service)"
                                @onclick="@(() => OpenFavouriteSettings(service))">⚙</button>
                    }
                </article>
            }
        </div>
    }

    <UiModal IsOpen="@showFavouriteSettings"
             Title="Favourite connection settings"
             Subtitle="@favouriteSettingsTitle"
             Class="on-demand-favourite-settings-modal"
             OnClose="CloseFavouriteSettings">
        <ChildContent>
            @if (favouriteSettingsService is not null)
            {
                <p class="meta-text">These settings apply only to this saved favourite. Automatic header choices are still tested against the real service before the temporary route is created.</p>
                <div class="on-demand-favourite-settings-grid">
                    <UiSelectField TValue="OnDemandAppTargetAddressPreference"
                                   @bind-Value="favouriteSettingsEditor.TargetAddress"
                                   Label="Connect using"
                                   Helper="The discovered IP avoids DNS selecting another interface or an external address."
                                   Compact="true">
                        <option value="@OnDemandAppTargetAddressPreference.DiscoveredIp">Discovered IP (recommended)</option>
                        <option value="@OnDemandAppTargetAddressPreference.DiscoveredHostname">Discovered hostname</option>
                    </UiSelectField>
                    <UiSelectField TValue="OnDemandAppSchemePreference"
                                   @bind-Value="favouriteSettingsEditor.Scheme"
                                   Label="Protocol"
                                   Compact="true">
                        <option value="@OnDemandAppSchemePreference.Automatic">Automatic</option>
                        <option value="@OnDemandAppSchemePreference.Http">HTTP</option>
                        <option value="@OnDemandAppSchemePreference.Https">HTTPS</option>
                    </UiSelectField>
                    <UiSelectField TValue="OnDemandAppHostHeaderPreference"
                                   @bind-Value="favouriteSettingsEditor.HostHeader"
                                   Label="Host header"
                                   Compact="true">
                        <option value="@OnDemandAppHostHeaderPreference.Automatic">Automatic</option>
                        <option value="@OnDemandAppHostHeaderPreference.Upstream">Target address</option>
                        <option value="@OnDemandAppHostHeaderPreference.Public">Temporary public address</option>
                    </UiSelectField>
                    <UiSelectField TValue="OnDemandAppForwardedForPreference"
                                   @bind-Value="favouriteSettingsEditor.ForwardedFor"
                                   Label="Client IP header"
                                   Compact="true">
                        <option value="@OnDemandAppForwardedForPreference.Automatic">Automatic</option>
                        <option value="@OnDemandAppForwardedForPreference.Strip">Strip X-Forwarded-For</option>
                        <option value="@OnDemandAppForwardedForPreference.Preserve">Forward client IP</option>
                    </UiSelectField>
                </div>
                <div class="on-demand-favourite-endpoint">
                    <span>Discovered IP</span><strong>@(favouriteSettingsService.IpAddress ?? "Unavailable")</strong>
                    <span>Discovered hostname</span><strong>@favouriteSettingsService.Host</strong>
                    <span>Port</span><strong>@favouriteSettingsService.Port</strong>
                </div>
                @if (!string.IsNullOrWhiteSpace(favouriteSettingsMessage))
                {
                    <p class="meta-text on-demand-apps-message">@favouriteSettingsMessage</p>
                }
            }
        </ChildContent>
        <Footer>
            <UiCommandButton Label="Save favourite settings"
                             Glyph="UiIconGlyph.Save"
                             Variant="UiButtonVariant.Primary"
                             Disabled="@isSavingFavouriteSettings"
                             OnClick="SaveFavouriteSettingsAsync" />
        </Footer>
    </UiModal>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private readonly CancellationTokenSource lifetime = new();
    private readonly HashSet<string> favouriteChangeInProgress = new(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<LocalHttpServiceEndpoint> services = [];
    private Dictionary<string, OnDemandAppFavourite> favouriteProfiles = new(StringComparer.OrdinalIgnoreCase);
    private OnDemandAppsAvailability? availability;
    private string userId = string.Empty;
    private string message = string.Empty;
    private string scanStatus = string.Empty;
    private bool includeDocker = true;
    private bool includeLan = true;
    private bool includeTailnet;
    private bool isScanning;
    private bool showFavouriteSettings;
    private bool isSavingFavouriteSettings;
    private int probedCount;
    private int totalProbeCount;
    private int foundCount;
    private int refreshIntervalMinutes = 180;
    private DateTimeOffset? observedCompletionUtc;
    private LocalHttpServiceEndpoint? favouriteSettingsService;
    private FavouriteSettingsEditor favouriteSettingsEditor = new();
    private string favouriteSettingsTitle = string.Empty;
    private string favouriteSettingsMessage = string.Empty;

    private bool CanOpen => availability?.IsAvailable == true && !string.IsNullOrWhiteSpace(userId);

    private IEnumerable<LocalHttpServiceEndpoint> SortedServices => services
        .Where(service => !LocalHttpServiceDiscoveryRanking.IsHiddenFromPicker(service))
        .DistinctBy(LocalHttpServiceDiscoveryRanking.StableKey, StringComparer.OrdinalIgnoreCase)
        .OrderByDescending(service => favouriteProfiles.ContainsKey(LocalHttpServiceDiscoveryRanking.StableKey(service)))
        .ThenBy(LocalHttpServiceDiscoveryRanking.PresentationRank)
        .ThenBy(LocalHttpServiceDiscoveryRanking.PickerLabel, StringComparer.OrdinalIgnoreCase)
        .ThenBy(service => service.Host, StringComparer.OrdinalIgnoreCase)
        .ThenBy(service => service.Port);

    protected override async Task OnInitializedAsync()
    {
        var preferences = DiscoveryCoordinator.GetPreferences();
        includeDocker = preferences.IncludeDocker;
        includeLan = preferences.IncludeLan;
        includeTailnet = preferences.IncludeTailnet;
        refreshIntervalMinutes = preferences.RefreshIntervalMinutes;

        try
        {
            var uri = new Uri(Navigation.Uri);
            availability = await OnDemandApps.GetAvailabilityAsync(uri.Host, uri.Scheme == Uri.UriSchemeHttps, lifetime.Token);
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested)
        {
            return;
        }
        catch (Exception exception)
        {
            availability = new OnDemandAppsAvailability(false, $"Edge Gateway readiness could not be checked: {exception.Message}");
        }

        try
        {
            if (AuthenticationStateTask is not null)
            {
                var authenticationState = await AuthenticationStateTask;
                userId = authenticationState.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
                if (!string.IsNullOrWhiteSpace(userId))
                {
                    favouriteProfiles = (await OnDemandApps.GetFavouritesAsync(userId, lifetime.Token))
                        .ToDictionary(item => item.ServiceKey, StringComparer.OrdinalIgnoreCase);
                }
            }

            SetServices(await HttpServiceDiscovery.GetCachedAsync(lifetime.Token));
            message = services.Count == 0
                ? "No cached apps yet. Run Scan to discover them."
                : $"Showing {VisibleServiceCount} cached app(s).";

            await RefreshBackgroundStateAsync();
            _ = ObserveBackgroundDiscoveryAsync();
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            message = $"Apps could not be loaded: {exception.Message}";
        }
    }

    private async Task ScanAsync()
    {
        if (isScanning)
        {
            return;
        }

        try
        {
            var preferences = CurrentPreferences();
            await DiscoveryCoordinator.SavePreferencesAsync(preferences, lifetime.Token);
            if (DiscoveryCoordinator.TryStartScan(preferences.ToRequest()))
            {
                message = "Discovery is running in the background. You can open an app or leave this page without stopping it.";
            }

            await RefreshBackgroundStateAsync();
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            message = $"HTTP/S discovery could not be started: {exception.Message}";
        }
    }

    private async Task SetRefreshIntervalAsync(int value)
    {
        refreshIntervalMinutes = value;
        try
        {
            await DiscoveryCoordinator.SavePreferencesAsync(CurrentPreferences(), lifetime.Token);
            message = value == 0
                ? "Automatic discovery is off. Cached apps remain available until you scan again."
                : $"Automatic discovery will refresh the cache {FormatRefreshInterval(value)}.";
            await RefreshBackgroundStateAsync();
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            message = $"The discovery refresh setting could not be saved: {exception.Message}";
        }
    }

    private async Task ObserveBackgroundDiscoveryAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (await timer.WaitForNextTickAsync(lifetime.Token))
            {
                await InvokeAsync(async () =>
                {
                    await RefreshBackgroundStateAsync();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested)
        {
        }
    }

    private async Task RefreshBackgroundStateAsync()
    {
        var background = DiscoveryCoordinator.GetStatus();
        isScanning = background.IsActive;
        scanStatus = background.Message;
        probedCount = background.ProbedCount;
        totalProbeCount = background.TotalProbeCount;
        foundCount = background.FoundCount;
        refreshIntervalMinutes = background.RefreshIntervalMinutes;

        if (background.IsActive)
        {
            SetServices(await HttpServiceDiscovery.GetCachedAsync(lifetime.Token));
            message = "Discovery is running in the background. Cached apps remain available while results arrive.";
        }
        else if (!string.IsNullOrWhiteSpace(background.Error))
        {
            message = $"HTTP/S discovery failed: {background.Error}";
        }
        else if (background.CompletedUtc.HasValue && background.CompletedUtc != observedCompletionUtc)
        {
            observedCompletionUtc = background.CompletedUtc;
            SetServices(await HttpServiceDiscovery.GetCachedAsync(lifetime.Token));
            message = VisibleServiceCount == 0
                ? "Background discovery completed. No HTTP/S apps responded."
                : $"Background discovery completed. {VisibleServiceCount} app(s) are cached.";
        }
    }

    private async Task ToggleFavouriteAsync(LocalHttpServiceEndpoint service)
    {
        var serviceKey = LocalHttpServiceDiscoveryRanking.StableKey(service);
        if (string.IsNullOrWhiteSpace(userId) || !favouriteChangeInProgress.Add(serviceKey))
        {
            return;
        }

        try
        {
            if (favouriteProfiles.ContainsKey(serviceKey))
            {
                await OnDemandApps.RemoveFavouriteAsync(userId, serviceKey, lifetime.Token);
                favouriteProfiles.Remove(serviceKey);
            }
            else
            {
                var preferences = new OnDemandAppProxyPreferences();
                await OnDemandApps.SaveFavouriteAsync(userId, service, preferences, lifetime.Token);
                favouriteProfiles[serviceKey] = new OnDemandAppFavourite(
                    serviceKey,
                    service,
                    preferences,
                    DateTimeOffset.UtcNow);
            }
        }
        catch (Exception exception)
        {
            message = $"Favourite could not be updated: {exception.Message}";
        }
        finally
        {
            favouriteChangeInProgress.Remove(serviceKey);
        }
    }

    private void OpenFavouriteSettings(LocalHttpServiceEndpoint service)
    {
        if (string.IsNullOrWhiteSpace(userId))
        {
            message = "Sign in with an LMS account to save favourite settings.";
            return;
        }

        var key = LocalHttpServiceDiscoveryRanking.StableKey(service);
        var preferences = favouriteProfiles.TryGetValue(key, out var favourite)
            ? favourite.ProxyPreferences
            : new OnDemandAppProxyPreferences();
        favouriteSettingsService = service;
        favouriteSettingsEditor = FavouriteSettingsEditor.From(preferences);
        favouriteSettingsTitle = LocalHttpServiceDiscoveryRanking.PickerLabel(service);
        favouriteSettingsMessage = string.Empty;
        showFavouriteSettings = true;
    }

    private async Task SaveFavouriteSettingsAsync()
    {
        if (favouriteSettingsService is null || string.IsNullOrWhiteSpace(userId) || isSavingFavouriteSettings)
        {
            return;
        }

        isSavingFavouriteSettings = true;
        favouriteSettingsMessage = string.Empty;
        try
        {
            var preferences = favouriteSettingsEditor.ToPreferences();
            await OnDemandApps.SaveFavouriteAsync(userId, favouriteSettingsService, preferences, lifetime.Token);
            var key = LocalHttpServiceDiscoveryRanking.StableKey(favouriteSettingsService);
            favouriteProfiles[key] = new OnDemandAppFavourite(
                key,
                favouriteSettingsService,
                preferences,
                DateTimeOffset.UtcNow);
            showFavouriteSettings = false;
            message = $"Saved connection settings for {LocalHttpServiceDiscoveryRanking.PickerLabel(favouriteSettingsService)}.";
        }
        catch (Exception exception)
        {
            favouriteSettingsMessage = $"Favourite settings could not be saved: {exception.Message}";
        }
        finally
        {
            isSavingFavouriteSettings = false;
        }
    }

    private void CloseFavouriteSettings()
    {
        showFavouriteSettings = false;
        favouriteSettingsMessage = string.Empty;
    }

    private void SetServices(IReadOnlyList<LocalHttpServiceEndpoint> cached)
    {
        services = favouriteProfiles.Values
            .Select(item => item.Endpoint)
            .OfType<LocalHttpServiceEndpoint>()
            .Concat(cached)
            .GroupBy(LocalHttpServiceDiscoveryRanking.StableKey, StringComparer.OrdinalIgnoreCase)
            .Select(group => group.Last())
            .ToArray();
    }

    private int VisibleServiceCount => SortedServices.Count();

    private HttpServiceDiscoveryPreferences CurrentPreferences() =>
        new(refreshIntervalMinutes, includeDocker, includeLan, includeTailnet);

    private static string FormatRefreshInterval(int minutes) => minutes switch
    {
        60 => "every hour",
        180 => "every 3 hours",
        360 => "every 6 hours",
        720 => "every 12 hours",
        1440 => "daily",
        _ => "on the selected schedule"
    };

    private string BuildOpenUrl(string serviceKey) =>
        $"/on-demand-apps/open?service={Uri.EscapeDataString(serviceKey)}";

    private string BuildScanSummary()
    {
        var progress = totalProbeCount > 0 ? $"{probedCount}/{totalProbeCount} checked" : "Preparing";
        return $"{scanStatus} {progress}, {foundCount} found.";
    }

    public void Dispose()
    {
        lifetime.Cancel();
        lifetime.Dispose();
    }

    private sealed class FavouriteSettingsEditor
    {
        public OnDemandAppTargetAddressPreference TargetAddress { get; set; } = OnDemandAppTargetAddressPreference.DiscoveredIp;
        public OnDemandAppSchemePreference Scheme { get; set; } = OnDemandAppSchemePreference.Automatic;
        public OnDemandAppHostHeaderPreference HostHeader { get; set; } = OnDemandAppHostHeaderPreference.Automatic;
        public OnDemandAppForwardedForPreference ForwardedFor { get; set; } = OnDemandAppForwardedForPreference.Automatic;

        public static FavouriteSettingsEditor From(OnDemandAppProxyPreferences preferences) => new()
        {
            TargetAddress = preferences.TargetAddress,
            Scheme = preferences.Scheme,
            HostHeader = preferences.HostHeader,
            ForwardedFor = preferences.ForwardedFor
        };

        public OnDemandAppProxyPreferences ToPreferences() =>
            new(TargetAddress, Scheme, HostHeader, ForwardedFor);
    }
}
