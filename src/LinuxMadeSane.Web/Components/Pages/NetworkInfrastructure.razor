@page "/network"
@page "/network/{Section}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using LinuxMadeSane.Application.Contracts.Infrastructure
@using LinuxMadeSane.Application.Interfaces
@using LinuxMadeSane.Web.Components.Infrastructure
@inject IInfrastructureDiagnosticsService Diagnostics
@inject NavigationManager Navigation
<PageTitle>Network | Linux Made Sane</PageTitle>
<div class="page-shell infrastructure-page">
    <header><h1>Network</h1><p>Devices visible to this host, DHCP and service exposure.</p></header>
    <TabControl ActiveValue="@(Section ?? "devices")" ActiveValueChanged="Navigate" Class="page-tab-control" PanelClass="page-tab-panel">
        <ChildContent>
            <TabPage Value="devices" Title="Devices"><ChildContent>
                <UiCommandButton Label="@(busy ? "Discovering devices…" : "Refresh devices")" Disabled="@busy" OnClick="Load" />
                @if (inventory is null) { @ActionFeedback }
                @if (inventory is not null)
                {
                    <div class="network-discovery-controls">
                        <UiSelectField TValue="string" Label="Existing private subnet" @bind-Value="probeNetwork" Compact="true" Disabled="@busy">
                            <option value="">Select a host interface and subnet</option>
                            @foreach (var network in inventory.InterfaceNetworks) { <option value="@(network.Interface + "|" + network.Network)">@network.Interface · @network.Network (host @network.Address)</option> }
                        </UiSelectField>
                        <UiCommandButton Label="Scan subnet & cache devices" HideIcon="true" Disabled="@(busy || probeNetwork.Length == 0)" OnClick="(() => Probe(false))" />
                        @if (probePackage is { Installed: false })
                        {
                            <div class="network-discovery-package">
                                <p>Subnet scanning requires fping. @probePackage.Explanation</p>
                                <UiCommandButton Label="Install fping & scan" HideIcon="true" Disabled="@(busy || !probePackage.CanInstall || probeNetwork.Length == 0)" OnClick="(() => Probe(true))" />
                            </div>
                        }
                    </div>
                    @ActionFeedback
                    <p class="network-discovery-hint">Uses the selected NIC's actual address and mask. ICMP discovery only; no port scan. Names are resolved through this host's DNS.</p>
                    @foreach (var notice in inventory.Notices) { <p class="callout">@notice</p> }
                    @foreach (var group in NetworkDevicePresentation.Group(inventory))
                    {
                        <section class="device-interface-group">
                            <h2>@group.Interface <span class="meta-text">@string.Join(" · ", group.Subnets) · @group.Devices.Count devices</span></h2>
                            <div class="infrastructure-table device-table"><table><thead><tr><th>Device</th><th>IP address</th><th>MAC address</th><th>Vendor</th><th>State</th><th>Last observed</th><th></th></tr></thead><tbody>
                            @foreach (var device in group.Devices)
                            {
                                <tr><td title="@device.NameLookupStatus"><strong>@NetworkDevicePresentation.Name(device)</strong></td>
                                    <td title="@string.Join(", ", device.Addresses)">@NetworkDevicePresentation.PrimaryAddress(device)@if (device.Addresses.Count > 1) { <span class="meta-text"> · +@(device.Addresses.Count - 1)</span> }</td>
                                    <td>@device.Mac</td><td title="@device.Vendor">@(device.Vendor.StartsWith("Unknown") || device.Vendor.Length == 0 ? "—" : device.Vendor)</td>
                                    <td>@device.State</td><td>@device.LastSeenUtc.ToLocalTime().ToString("g")</td>
                                    <td><CompactUIButton Label="Inspect" HideIcon="true" OnClick="(() => selected = device)" /></td>
                                </tr>
                            }
                            </tbody></table></div>
                        </section>
                    }
                    @if (inventory.Devices.Count == 0) { <p>No devices have been observed yet. Discovery does not require LMS DHCP.</p> }
                }
            </ChildContent></TabPage>
            <TabPage Value="dhcp" Title="DHCP"><ChildContent><DhcpPanel /></ChildContent></TabPage>
            <TabPage Value="exposure" Title="Exposure"><ChildContent>
                <UiCommandButton Label="@(busy ? "Reading exposure…" : "Refresh exposure")" Disabled="@busy" OnClick="Load" />
                @ActionFeedback
                @if (exposure is not null)
                {
                    <p class="network-discovery-hint">Grouped by service. A listening port does not prove Internet access. Inspect a service for its bindings, firewall evidence and Docker configuration.</p>
                    @foreach (var notice in exposure.Notices) { <p class="callout">@notice</p> }
                    <div class="infrastructure-table exposure-table"><table><thead><tr><th>Service</th><th>Listening addresses / ports</th><th>Edge Gateway routes</th><th>Access summary</th><th></th></tr></thead><tbody>
                    @foreach (var group in ExposurePresentation.Group(exposure))
                    {
                        <tr><td><strong>@group.Service</strong></td>
                            <td title="@string.Join(", ", group.Bindings)">@string.Join(", ", group.Bindings.Take(3))@if (group.Bindings.Count > 3) { <span> · +@(group.Bindings.Count - 3) more</span> }</td>
                            <td>@if (group.Routes.Count == 0) { <span class="meta-text">None configured</span> } else { @string.Join(", ", group.Routes.Take(2))@if (group.Routes.Count > 2) { <span> · +@(group.Routes.Count - 2) more</span> } }</td>
                            <td>@group.AccessSummary</td>
                            <td><CompactUIButton Label="Inspect" HideIcon="true" OnClick="(() => selectedExposure = group)" /></td>
                        </tr>
                    }
                    </tbody></table></div>
                    @if (exposure.Entries.Count == 0) { <p>No listening services or configured Edge Gateway routes were found.</p> }
                }
            </ChildContent></TabPage>
        </ChildContent>
    </TabControl>
</div>
<UiModal IsOpen="@(selected is not null)" Title="Device" OnClose="(() => selected = null)">
    <ChildContent>
        @if (selected is not null)
        {
            <UiTextField Label="Friendly name" @bind-Value="selected.FriendlyName" />
            <p>@selected.Hostname · @string.Join(", ", selected.Addresses) · @selected.Mac</p>
            <p>@selected.NameLookupStatus @if (selected.LastDnsLookupUtc is { } lookup) { <span class="meta-text">Last lookup: @lookup.ToLocalTime().ToString("g")</span> }</p>
            <p>First observed: @selected.FirstSeenUtc.ToLocalTime().ToString("g")<br />Sources: @string.Join(", ", selected.Sources)<br />DHCP: @selected.DhcpState</p>
            <p>@string.Join(" · ", selected.Services)</p>
            @foreach (var service in selected.ServiceUrls) { <UiCommandButton Label="@("Open " + service.Key)" Href="@service.Value" Target="_blank" Rel="noopener noreferrer" /> }
            <UiTextField Label="Tags" @bind-Value="selected.Tags" />
            <UiTextAreaField Label="Notes" @bind-Value="selected.Notes" />
            <div class="infrastructure-actions">
                <UiCommandButton Label="Save details" Disabled="@busy" OnClick="SaveDevice" />
                <UiCommandButton Label="Wake-on-LAN" Disabled="@(busy || selected.Mac.Length == 0)" OnClick="Wake" />
                <UiCommandButton Label="Reserve IP" OnClick="Reserve" />
            </div>
            @if (error is not null) { <p class="callout error">@error</p> }
        }
    </ChildContent>
</UiModal>
<UiModal IsOpen="@(selectedExposure is not null)" Title="@(selectedExposure is null ? "Service exposure" : selectedExposure.Service + " exposure")" OnClose="(() => selectedExposure = null)">
    <ChildContent>
        @if (selectedExposure is { } group)
        {
            <p><strong>@group.AccessSummary</strong></p>
            <h3>Listening addresses and ports</h3>
            <p>@string.Join(" · ", group.Bindings)</p>
            <h3>Edge Gateway routes</h3>
            <p>@(group.Routes.Count == 0 ? "None configured in LMS." : string.Join(" · ", group.Routes))</p>
            <h3>What LMS observed</h3>
            <p>@string.Join(" · ", group.Entries.Select(x => x.Method).Distinct())</p>
            <ul>@foreach (var reason in group.Entries.SelectMany(x => x.Reasoning).Distinct()) { <li>@reason</li> }</ul>
        }
    </ChildContent>
</UiModal>
@code {
    private RenderFragment ActionFeedback => @<div class="network-action-feedback">
        @if (busy) { <p class="callout info" role="status" aria-live="polite" aria-busy="true">@progress</p> }
        @if (error is not null) { <p class="callout error" role="alert">@error</p> }
    </div>;
    [Parameter] public string? Section { get; set; }
    private DeviceInventory? inventory;
    private ExposureSnapshot? exposure;
    private ExposureServiceGroup? selectedExposure;
    private NetworkDevice? selected;
    private bool busy;
    private string? error;
    private string probeNetwork = "", progress = "Reading network information…";
    private FeaturePackageStatus? probePackage;
    protected override async Task OnParametersSetAsync() { await Task.Yield(); await Load(); }
    private void Navigate(string value) => Navigation.NavigateTo("/network/" + value);
    private async Task Load()
    {
        busy = true; error = null; progress = "Reading network information…"; await InvokeAsync(StateHasChanged); await Task.Yield();
        try
        {
            if (Section == "exposure") exposure = await Diagnostics.GetExposureAsync();
            else if (Section is null or "devices") inventory = await Diagnostics.DiscoverDevicesAsync();
        }
        catch (Exception e) { error = e.Message; }
        finally { busy = false; }
    }
    private async Task Probe(bool install)
    {
        busy = true; error = null; progress = "Scanning the selected subnet and resolving device names…"; await InvokeAsync(StateHasChanged); await Task.Yield();
        try
        {
            var parts = probeNetwork.Split('|');
            if (parts.Length != 2) throw new InvalidOperationException("Select an existing private subnet.");
            probePackage = await Diagnostics.GetPackageStatusAsync("Discovery");
            if (!probePackage.Installed)
            {
                if (!install) return;
                progress = "Installing fping…"; await InvokeAsync(StateHasChanged);
                await Diagnostics.InstallPackagesAsync("Discovery");
                probePackage = await Diagnostics.GetPackageStatusAsync("Discovery");
            }
            progress = $"Scanning {parts[1]} on {parts[0]} and caching device names…"; await InvokeAsync(StateHasChanged);
            inventory = await Diagnostics.ProbeSubnetAsync(parts[0], parts[1]);
        }
        catch (Exception e) { error = e.Message; }
        finally { busy = false; }
    }
    private void Reserve() => Navigation.NavigateTo("/network/dhcp?device=" + selected!.Id);
    private async Task SaveDevice() { try { await Diagnostics.SaveDeviceAsync(selected!); selected = null; } catch (Exception e) { error = e.Message; } }
    private async Task Wake() { try { await Diagnostics.WakeAsync(selected!.Id); error = "Wake packet sent. The device must support Wake-on-LAN."; } catch (Exception e) { error = e.Message; } }
}
