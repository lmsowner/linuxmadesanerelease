    protected override async Task OnInitializedAsync()
    {
        try
        {
            dashboard = await MailRelayService.GetDashboardAsync();
            var configuredZoneId = dashboard.Domains
                .Select(item => item.CloudflareZoneId)
                .FirstOrDefault(zoneId => !string.IsNullOrWhiteSpace(zoneId) &&
                                          dashboard.Preflight.AvailableZones.Any(zone =>
                                              zone.ZoneId.Equals(zoneId, StringComparison.Ordinal)));
            if (!string.IsNullOrWhiteSpace(configuredZoneId) &&
                !configuredZoneId.Equals(dashboard.Preflight.CloudflareZoneId, StringComparison.Ordinal))
            {
                try
                {
                    var preflight = await MailRelayService.InspectPreflightAsync(configuredZoneId);
                    dashboard = dashboard with { Preflight = preflight };
                }
                catch
                {
                    // Keep the dashboard usable if the configured zone cannot be refreshed during page load.
                }
            }
            selectedCloudflareZoneId = dashboard.Preflight.CloudflareZoneId;
            var latestJob = MailRelayService.GetLatestProvisioningJob();
            if (latestJob is not null)
            {
                RestoreSetupRequest(latestJob.Request);
                await ApplyProvisioningJobAsync(latestJob);
                if (!latestJob.IsTerminal)
                {
                    domainEditorOpen = true;
                    StartProvisioningPoll(latestJob.Id);
                }
            }
            else
            {
                ApplySetupDefaults(force: true);
            }
            ApplyTestDefaults();
        }
        catch
        {
            errorMessage = "Mail Relay status could not be loaded.";
        }
    }

    private async Task ConfigureDirectProviderAsync()
    {
        if (dashboard?.Preflight.CloudflareZonesAvailable != true) { errorMessage = "Configure Edge Gateway DNS access before setting up direct SMTP. HTTPS providers can send without it."; return; }
        outboundMode = MailRelayOutboundMode.DirectPort25;
        await ConfigureSelectedZoneAsync();
    }
    private async Task ReloadProviderAsync() { dashboard = await MailRelayService.GetDashboardAsync(); StateHasChanged(); }

    private string? preflightFeedback;

    private async Task RunPreflightAsync()
    {
        if (dashboard is null || isRunningPreflight || isChangingZone)
        {
            return;
        }

        isRunningPreflight = true;
        preflightFeedback = "Checking relay prerequisites…";
        errorMessage = null;
        try
        {
            var result = await MailRelayService.RunPreflightAsync(selectedCloudflareZoneId);
            dashboard = dashboard with { Preflight = result };
            var findings = result.Checks.Where(check => check.State is MailRelayPreflightCheckState.Failed or MailRelayPreflightCheckState.Warning).Select(check => $"{check.Label}: {check.Value}");
            preflightFeedback = "Preflight complete. " + string.Join(" · ", findings);
        }
        catch
        {
            preflightFeedback = "Preflight could not complete. No relay configuration was changed.";
        }
        finally
        {
            isRunningPreflight = false;
        }
    }

    private async Task SelectCloudflareZoneAsync(string zoneId)
    {
        if (dashboard is null || isRunningPreflight || isChangingZone || string.IsNullOrWhiteSpace(zoneId))
        {
            return;
        }

        selectedCloudflareZoneId = zoneId;
        isChangingZone = true;
        errorMessage = null;
        try
        {
            var result = await MailRelayService.InspectPreflightAsync(selectedCloudflareZoneId);
            dashboard = dashboard with { Preflight = result };
            selectedCloudflareZoneId = result.CloudflareZoneId;
            setupPreview = null;
            setupConfirmed = false;
            ApplySetupDefaults(force: true);
        }
        catch
        {
            errorMessage = "The selected Cloudflare domain could not be inspected.";
        }
        finally
        {
            isChangingZone = false;
        }
    }

    private void ApplySetupDefaults(bool force)
    {
        if (dashboard is null)
        {
            return;
        }

        if (force && dashboard.Configuration is { } savedConfiguration)
        {
            outboundMode = savedConfiguration.Outbound.Mode is MailRelayOutboundMode.DirectPort25 or MailRelayOutboundMode.DirectPort587 or MailRelayOutboundMode.AutomaticDirect
                ? savedConfiguration.Outbound.Mode : MailRelayOutboundMode.AutomaticDirect;
            setupDevicesEnabled = savedConfiguration.AllowLegacyPort25;
            setupDeviceAddress = savedConfiguration.LegacyListenAddresses.FirstOrDefault() ?? "";
            setupDeviceSources = string.Join(", ", savedConfiguration.LegacyAllowedNetworks);
        }
        if (string.IsNullOrEmpty(setupDeviceAddress)) setupDeviceAddress = DeviceInterfaceAddresses().FirstOrDefault().Address ?? "";
        if (force || string.IsNullOrWhiteSpace(relayHostname))
        {
            relayHostname = dashboard.Configuration?.RelayHostname is { Length: > 0 } configuredHostname
                ? configuredHostname
                : dashboard.Preflight.SuggestedRelayHostname;
        }
        if (force || string.IsNullOrWhiteSpace(sendingDomain))
        {
            var savedDomain = dashboard.Domains.FirstOrDefault(item =>
                item.CloudflareZoneId.Equals(dashboard.Preflight.CloudflareZoneId, StringComparison.Ordinal) ||
                string.IsNullOrWhiteSpace(item.CloudflareZoneId) &&
                (item.DomainName.Equals(dashboard.Preflight.CloudflareZoneName, StringComparison.OrdinalIgnoreCase) ||
                 item.DomainName.EndsWith('.' + dashboard.Preflight.CloudflareZoneName, StringComparison.OrdinalIgnoreCase)));
            sendingDomain = savedDomain?.DomainName ?? dashboard.Preflight.CloudflareZoneName;
            dkimSelector = savedDomain?.CurrentDkimSelector ?? dkimSelector;
        }
    }

    private async Task ConfigureSelectedZoneAsync()
    {
        if (dashboard is null)
        {
            return;
        }

        if (SelectedZoneDomain is { } configuredDomain)
        {
            await EditDomainAsync(configuredDomain);
            return;
        }

        editingDomainId = null;
        sendingDomain = SelectedCloudflareZone?.ZoneName ?? dashboard.Preflight.CloudflareZoneName;
        relayHostname = dashboard.Configuration?.Enabled == true
            ? dashboard.Configuration.RelayHostname
            : dashboard.Preflight.SuggestedRelayHostname;
        dkimSelector = $"lms{DateTime.UtcNow.Year}";
        setupPreview = null;
        setupResult = null;
        setupConfirmed = false;
        ApplyClientToSetup(dashboard.Clients.FirstOrDefault(item => item.Enabled));
        domainEditorOpen = true;
    }

