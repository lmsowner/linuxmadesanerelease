    private async Task SaveClientAsync()
    {
        if (isSavingClient)
        {
            return;
        }

        isSavingClient = true;
        clientSaveResult = null;
        errorMessage = null;
        var submittedPassword = clientEditorPassword ?? string.Empty;
        try
        {
            clientSaveResult = await MailRelayService.SaveClientAsync(new MailRelayClientSaveRequest(
                editingClientId,
                clientEditorName ?? string.Empty,
                clientEditorUsername ?? string.Empty,
                submittedPassword,
                clientEditorDomainIds.ToArray()));
            if (clientSaveResult.Success && clientSaveResult.Client is { } savedClient)
            {
                editingClientId = savedClient.Id;
                dashboard = await MailRelayService.GetDashboardAsync();
                selectedTestClientId = savedClient.Id.ToString("D");
                ApplyTestDefaults();
                if (!string.IsNullOrEmpty(submittedPassword)) await SaveClientCredentialAsync(savedClient, submittedPassword);
                clientEditorPassword = string.Empty;
                showClientPassword = false;
            }
        }
        catch (Exception exception)
        {
            clientSaveResult = new MailRelayClientSaveResult(false, null, false, $"SMTP user could not be saved: {exception.Message}");
        }
        finally
        {
            isSavingClient = false;
        }
    }

    private void ApplyTestDefaults()
    {
        if (dashboard is null)
        {
            return;
        }

        var selected = SelectedTestClient ?? dashboard.Clients.FirstOrDefault(item => item.Enabled);
        if (selected is null)
        {
            selectedTestClientId = string.Empty;
            return;
        }

        selectedTestClientId = selected.Id.ToString("D");
        var allowedDomain = selected.AllowedSenderDomains.FirstOrDefault();
        if (!string.IsNullOrWhiteSpace(allowedDomain) &&
            (string.IsNullOrWhiteSpace(testFromAddress) ||
             !selected.AllowedSenderDomains.Any(domain => testFromAddress.EndsWith('@' + domain, StringComparison.OrdinalIgnoreCase))))
        {
            testFromAddress = $"lms-test@{allowedDomain}";
        }
    }

    private void SelectTestClient(string clientId)
    {
        selectedTestClientId = clientId;
        testResult = null;
        ApplyTestDefaults();
    }

    private async Task SendTestAsync()
    {
        if (!CanSendTest || !Guid.TryParse(selectedTestClientId, out var clientId))
        {
            return;
        }

        isSendingTest = true;
        testResult = null;
        errorMessage = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            testResult = await MailRelayService.SendTestAsync(new MailRelayTestRequest(
                clientId,
                testFromAddress ?? string.Empty,
                testRecipientAddress ?? string.Empty));
            dashboard = await MailRelayService.GetDashboardAsync();
        }
        catch (Exception exception)
        {
            errorMessage = $"Mail Relay test could not complete: {exception.Message}";
        }
        finally
        {
            isSendingTest = false;
        }
    }

    private MailRelayLegacySubmissionRequest BuildDeviceSubmissionRequest()
    {
        if (!setupDevicesEnabled) return new(false, [], []);
        // Reopening the compact form must not discard additional configured listeners.
        var configured = dashboard?.Configuration?.EffectiveLegacyListenAddresses ?? [];
        IReadOnlyList<string> addresses = configured.Count > 1 && configured[0] == setupDeviceAddress
            ? configured : string.IsNullOrWhiteSpace(setupDeviceAddress) ? [] : [setupDeviceAddress];
        return new(true, addresses, SplitNetworkEntries(setupDeviceSources)) { BlockedNetworks = dashboard?.Configuration?.LegacyBlockedNetworks ?? [] };
    }

    private Task<MailRelaySetupRequest> BuildSetupRequestAsync() => Task.FromResult(new MailRelaySetupRequest(
        selectedCloudflareZoneId, relayHostname ?? string.Empty, sendingDomain ?? string.Empty,
        dkimSelector ?? string.Empty, applicationName ?? string.Empty, applicationUsername ?? string.Empty,
        allowTailscale, allowTrustedLan) { Outbound = new() { Mode = outboundMode }, LocalDevices = BuildDeviceSubmissionRequest() });

    private async Task PreviewSetupAsync()
    {
        if (SetupBusy)
        {
            return;
        }

        isReviewingSetup = true;
        setupConfirmed = false;
        setupResult = null;
        errorMessage = null;
        try
        {
            setupPreview = await MailRelayService.PreviewSetupAsync(await BuildSetupRequestAsync());
        }
        catch (Exception exception)
        {
            errorMessage = $"Setup review failed: {exception.Message}";
        }
        finally
        {
            isReviewingSetup = false;
        }
    }

    private async Task ProvisionAsync()
    {
        if (!setupConfirmed || isProvisioning)
        {
            return;
        }

        isProvisioning = true;
        setupResult = null;
        errorMessage = null;
        setupProgress.Clear();

        try
        {
            var job = await MailRelayService.StartProvisioningAsync((await BuildSetupRequestAsync()) with { ReviewedDeliveryMode = MailRelayDeliveryMode.DirectInternet, ReviewedDestinationPort = setupPreview?.Request.Outbound?.DestinationPort });
            await ApplyProvisioningJobAsync(job);
            StartProvisioningPoll(job.Id);
        }
        catch (Exception exception)
        {
            errorMessage = $"Mail Relay setup stopped: {exception.Message}";
            isProvisioning = false;
        }
    }

    private void StartProvisioningPoll(Guid jobId)
    {
        provisioningPollCancellation?.Cancel();
        provisioningPollCancellation?.Dispose();
        provisioningPollCancellation = new CancellationTokenSource();
        _ = PollProvisioningJobAsync(jobId, provisioningPollCancellation.Token);
    }

    private async Task PollProvisioningJobAsync(Guid jobId, CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                var job = MailRelayService.GetProvisioningJob(jobId);
                if (job is null)
                {
                    await InvokeAsync(() =>
                    {
                        isProvisioning = false;
                        errorMessage = "The background Mail Relay setup job could not be found.";
                        StateHasChanged();
                    });
                    return;
                }

                await InvokeAsync(async () =>
                {
                    await ApplyProvisioningJobAsync(job);
                    StateHasChanged();
                });
                if (job.IsTerminal)
                {
                    return;
                }

                await Task.Delay(TimeSpan.FromSeconds(1), cancellationToken);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            await InvokeAsync(() =>
            {
                isProvisioning = false;
                errorMessage = $"Mail Relay progress could not be refreshed: {exception.Message}";
                StateHasChanged();
            });
        }
    }

    private async Task ApplyProvisioningJobAsync(MailRelayProvisioningJobSnapshot job)
    {
        provisioningJob = job;
        isProvisioning = !job.IsTerminal;
        setupProgress.Clear();
        setupProgress.AddRange(job.Steps);

        if (!job.IsTerminal)
        {
            return;
        }

        setupResult = job.Result;
        if (job.Status == MailRelayProvisioningJobStatus.Failed && setupResult is null)
        {
            errorMessage = $"Mail Relay setup stopped: {job.Summary}";
        }

        if (job.Status == MailRelayProvisioningJobStatus.Succeeded && refreshedProvisioningJobId != job.Id)
        {
            refreshedProvisioningJobId = job.Id;
            dashboard = await MailRelayService.GetDashboardAsync();
            selectedCloudflareZoneId = job.Request.CloudflareZoneId;
            editingDomainId = dashboard.Domains.FirstOrDefault(item =>
                item.DomainName.Equals(job.Request.SendingDomain, StringComparison.OrdinalIgnoreCase))?.Id;
            var provisionedClient = dashboard.Clients.FirstOrDefault(item =>
                item.Username.Equals(job.Request.ApplicationUsername, StringComparison.OrdinalIgnoreCase));
            if (provisionedClient is not null)
            {
                selectedTestClientId = provisionedClient.Id.ToString("D");
                ApplyTestDefaults();
                if (!string.IsNullOrEmpty(job.Result?.GeneratedPassword)) await SaveClientCredentialAsync(provisionedClient, job.Result.GeneratedPassword);
            }
        }
    }

    private void RestoreSetupRequest(MailRelaySetupRequest request)
    {
        if (request.Outbound is { } outbound)
            outboundMode = outbound.Mode is MailRelayOutboundMode.DirectPort25 or MailRelayOutboundMode.DirectPort587 or MailRelayOutboundMode.AutomaticDirect ? outbound.Mode : MailRelayOutboundMode.AutomaticDirect;
        if (request.LocalDevices is { } devices)
        {
            setupDevicesEnabled = devices.Enabled;
            setupDeviceAddress = devices.ListenAddresses.FirstOrDefault() ?? "";
            setupDeviceSources = string.Join(", ", devices.AllowedNetworks);
        }
        selectedCloudflareZoneId = request.CloudflareZoneId;
        relayHostname = request.RelayHostname;
        sendingDomain = request.SendingDomain;
        dkimSelector = request.DkimSelector;
        applicationName = request.ApplicationName;
        applicationUsername = request.ApplicationUsername;
        var restoredClient = dashboard?.Clients.FirstOrDefault(item =>
            item.Username.Equals(request.ApplicationUsername, StringComparison.OrdinalIgnoreCase));
        if (restoredClient is not null)
        {
            selectedSetupClientId = restoredClient.Id.ToString("D");
        }
        allowTailscale = request.AllowTailscale;
        allowTrustedLan = request.AllowTrustedLan;
    }

    private async Task CopyGeneratedPasswordAsync()
    {
        if (!string.IsNullOrWhiteSpace(setupResult?.GeneratedPassword))
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", setupResult.GeneratedPassword);
        }
    }

