    private string BuildZoneOptionLabel(MailRelayCloudflareZoneOption zone)
    {
        var domain = dashboard?.Domains.FirstOrDefault(item =>
            item.DomainName.Equals(zone.ZoneName, StringComparison.OrdinalIgnoreCase) &&
            (string.IsNullOrWhiteSpace(item.CloudflareZoneId) ||
             item.CloudflareZoneId.Equals(zone.ZoneId, StringComparison.Ordinal)));
        var markers = new List<string>();
        if (domain?.Enabled == true)
        {
            markers.Add("configured");
        }
        else if (domain is not null)
        {
            markers.Add("setup pending");
        }
        if (zone.IsSavedDefault)
        {
            markers.Add("Edge Gateway default");
        }
        if (zone.Paused)
        {
            markers.Add("paused");
        }
        return markers.Count == 0
            ? zone.ZoneName
            : $"{zone.ZoneName} · {string.Join(" · ", markers)}";
    }

