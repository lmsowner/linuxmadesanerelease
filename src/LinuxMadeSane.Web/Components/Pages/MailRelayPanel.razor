    private Task SetLegacyListenAddressesAsync(string value)
    {
        legacyListenAddresses = value;
        return Task.CompletedTask;
    }

    private async Task SaveLegacyAsync()
    {
        if (isSavingLegacy)
        {
            return;
        }

        isSavingLegacy = true;
        legacyResult = null;
        legacyProgress = "Checking interfaces and access rules…";
        var progress = new Progress<string>(message =>
        {
            legacyProgress = message;
            _ = InvokeAsync(StateHasChanged);
        });
        try
        {
            legacyResult = await MailRelayService.ConfigureLegacySubmissionAsync(
                new MailRelayLegacySubmissionRequest(
                    legacyEnabled,
                    SplitNetworkEntries(legacyListenAddresses),
                    SplitNetworkEntries(legacyAllowedNetworks)) { BlockedNetworks = SplitNetworkEntries(legacyBlockedNetworks), SubmissionListenAddresses = submissionInterfaces == initialSubmissionInterfaces ? null : SplitNetworkEntries(submissionInterfaces) },
                progress);
            if (legacyResult.Success)
            {
                dashboard = await MailRelayService.GetDashboardAsync();
            }
        }
        catch (Exception exception)
        {
            legacyResult = new MailRelayLegacySubmissionResult(
                false,
                dashboard?.Configuration,
                $"Could not apply listener settings: {exception.Message}");
        }
        finally
        {
            isSavingLegacy = false;
        }
    }

