    private async Task EditDomainAsync(MailRelayDomain domain)
    {
        if (dashboard is null || SetupBusy)
        {
            return;
        }

        editingDomainId = domain.Id;
        setupPreview = null;
        setupResult = null;
        setupConfirmed = false;
        sendingDomain = domain.DomainName;
        dkimSelector = domain.CurrentDkimSelector;
        relayHostname = dashboard.Configuration?.RelayHostname ?? relayHostname;
        var domainClient = dashboard.Clients.FirstOrDefault(item =>
            item.Enabled && item.AllowedSenderDomains.Contains(domain.DomainName, StringComparer.OrdinalIgnoreCase));
        ApplyClientToSetup(domainClient ?? dashboard.Clients.FirstOrDefault(item => item.Enabled));
        domainEditorOpen = true;
        await InvokeAsync(StateHasChanged);

        var zone = dashboard.Preflight.AvailableZones.SingleOrDefault(item =>
                       item.ZoneId.Equals(domain.CloudflareZoneId, StringComparison.Ordinal)) ??
                   dashboard.Preflight.AvailableZones
            .Where(item =>
                domain.DomainName.Equals(item.ZoneName, StringComparison.OrdinalIgnoreCase) ||
                domain.DomainName.EndsWith('.' + item.ZoneName, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(item => item.ZoneName.Length)
            .FirstOrDefault();

        if (zone is not null && !selectedCloudflareZoneId.Equals(zone.ZoneId, StringComparison.Ordinal))
        {
            isChangingZone = true;
            try
            {
                var preflight = await MailRelayService.InspectPreflightAsync(zone.ZoneId);
                dashboard = dashboard with { Preflight = preflight };
                selectedCloudflareZoneId = preflight.CloudflareZoneId;
            }
            catch
            {
                errorMessage = $"Cloudflare settings for {domain.DomainName} could not be loaded.";
            }
            finally
            {
                isChangingZone = false;
            }
        }

    }

    private void OpenLegacyEditor()
    {
        if (dashboard?.Configuration is not { } configuration)
        {
            return;
        }

        var addresses = configuration.SubmissionListenAddresses.Count > 0
            ? configuration.SubmissionListenAddresses : dashboard.Listeners?.Where(item => item.Port == 587).Select(item => item.Address).ToArray() ?? [];
        initialSubmissionInterfaces = submissionInterfaces = string.Join(", ", addresses.Where(ip => ip != "127.0.0.1"));
        legacyEnabled = configuration.AllowLegacyPort25;
        legacyListenAddresses = configuration.EffectiveLegacyListenAddresses.Count > 0
            ? string.Join(", ", configuration.EffectiveLegacyListenAddresses)
            : "127.0.0.1";
        legacyBlockedNetworks = string.Join(", ", configuration.LegacyBlockedNetworks);
        legacyAllowedNetworks = string.Join(
            Environment.NewLine,
            configuration.EffectiveLegacyAllowedNetworks.Count > 0
                ? configuration.EffectiveLegacyAllowedNetworks
                : DefaultLegacyAllowedNetworks);
        legacyProgress = null;
        legacyResult = null;
        legacyEditorOpen = true;
    }

