@page "/home-lab/apps"
@rendermode InteractiveServer
@using LinuxMadeSane.Application.Contracts.Ai
@using LinuxMadeSane.Application.Contracts.HomeLab
@using LinuxMadeSane.Application.Interfaces
@using LinuxMadeSane.Core.Enums
@using LinuxMadeSane.Core.Models.HomeLab
@inject IHomeLabService HomeLabService
@inject IHomeLabPromptRecipeProvider PromptRecipeProvider
@inject IAiThreadService AiThreadService
@inject IAiChatService AiChatService
@inject NavigationManager Navigation

<PageTitle>Home Lab | Linux Made Sane</PageTitle>

<div class="page-shell home-lab-page">
    <UiHeroPanel Eyebrow="Home Lab"
                  Title="Home Lab"
                  Description="Set up services with guided prompts, manage their Docker containers, and troubleshoot each container with AI."
                  Compact="true">
        <Actions>
            <UiCommandButton Label="Refresh"
                             Glyph="UiIconGlyph.Refresh"
                             Variant="UiButtonVariant.Ghost"
                             Disabled="@busy"
                             OnClick="LoadAsync" />
        </Actions>
    </UiHeroPanel>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <p class="callout @(error ? "error" : "ready")">@message</p>
    }

    @if (workspace is null)
    {
        <UiPanel><p class="meta-text">Loading Home Lab...</p></UiPanel>
    }
    else
    {
        @if (renamingGateway is { } gatewayToRename)
        {
            <UiModal IsOpen="true"
                     Title="Rename VPN gateway"
                     Subtitle="This changes the name shown in Linux Made Sane. Docker networking and routed apps stay connected to the same gateway."
                     Class="home-lab-rename-modal"
                     OnClose="CancelGatewayRename">
                <ChildContent>
                    <section class="home-lab-rename-panel">
                        <div class="home-lab-config-field">
                            <label for="home-lab-gateway-name">Gateway name</label>
                            <input id="home-lab-gateway-name"
                                   class="ui-control-input"
                                   maxlength="160"
                                   value="@gatewayRenameValue"
                                   @oninput="eventArgs => gatewayRenameValue = eventArgs.Value?.ToString() ?? string.Empty"
                                   autofocus />
                            <span class="meta-text">Currently shown as @gatewayToRename.DisplayName.</span>
                        </div>
                        <div class="home-lab-rename-actions">
                            <UiCommandButton Label="Cancel"
                                             Glyph="UiIconGlyph.Clear"
                                             Variant="UiButtonVariant.Ghost"
                                             Disabled="@busy"
                                             OnClick="CancelGatewayRename" />
                            <UiCommandButton Label="Rename gateway"
                                             Glyph="UiIconGlyph.Edit"
                                             Variant="UiButtonVariant.PrimaryMuted"
                                             Disabled="@(busy || !CanRenameGateway)"
                                             OnClick="RenameGatewayAsync" />
                        </div>
                    </section>
                </ChildContent>
            </UiModal>
        }

        @if (pendingRemoval is { } installationToRemove)
        {
            <UiModal IsOpen="true"
                     Title="@($"Remove {installationToRemove.DisplayName}?")"
                     Subtitle="The Docker container and its LMS access routes will be removed. Persistent host data will be left in place."
                     Class="home-lab-confirm-modal"
                     OnClose="CancelRemoval">
                <ChildContent>
                    <section class="home-lab-confirm-panel">
                        <p>This action stops and removes <strong>@installationToRemove.DisplayName</strong>.</p>
                        <div class="home-lab-confirm-actions">
                            <UiCommandButton Label="Cancel" Glyph="UiIconGlyph.Clear" Variant="UiButtonVariant.Ghost" Disabled="@busy" OnClick="CancelRemoval" />
                            <UiCommandButton Label="Remove container" Glyph="UiIconGlyph.Delete" Variant="UiButtonVariant.Danger" Disabled="@busy" OnClick="ConfirmRemovalAsync" />
                        </div>
                    </section>
                </ChildContent>
            </UiModal>
        }

        <TabControl ActiveValue="@activeTab"
                    ActiveValueChanged="HandleTabChangedAsync"
                    Class="home-lab-tabs"
                    PanelClass="home-lab-tab-panel">
            <TabPage Value="apps" Title="Docker">
                @if (configuringApp is { } appToConfigure)
                {
                    <UiModal IsOpen="true"
                             Title="@(configuringInstallation is null ? $"Configure {appToConfigure.Name}" : $"Edit {configuringInstallation.DisplayName}")"
                             Subtitle="Container settings are applied by LMS. Secrets are stored securely and are not shown again."
                             Class="home-lab-settings-modal"
                             Resizable="true"
                             CloseOnBackdrop="false"
                             OnClose="CancelConfiguration">
                        <ChildContent>
                    <section class="home-lab-config-panel">
                        <div class="home-lab-config-heading">
                            <div>
                                <p class="eyebrow">Installation settings</p>
                                <h2>@(configuringInstallation is null ? $"Configure {appToConfigure.Name}" : $"Edit {configuringInstallation.DisplayName}")</h2>
                                <p class="meta-text">These values are applied to the Docker container. Secret fields are stored by LMS and are not shown again.</p>
                            </div>
                            <UiCommandButton Label="Cancel" Glyph="UiIconGlyph.Clear" Variant="UiButtonVariant.Ghost" Disabled="@busy" OnClick="CancelConfiguration" />
                        </div>
                        <div class="home-lab-config-grid">
                            @foreach (var field in appToConfigure.ConfigurationSchema.Where(ShouldShowConfigurationField))
                            {
                                <div class="@GetConfigurationFieldClass(field)">
                                    <label for="home-lab-@field.Id">@field.Label</label>
                                    @if (field.Type.Equals("select", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <select id="home-lab-@field.Id" class="ui-control-input" value="@GetConfigurationValue(field.Id)" @onchange="eventArgs => SetConfigurationValue(field.Id, eventArgs.Value?.ToString())">
                                            <option value="">Choose...</option>
                                            @if (field.Id.Equals("vpn-gateway", StringComparison.OrdinalIgnoreCase))
                                            {
                                                @foreach (var gateway in InstalledVpnGateways)
                                                {
                                                    <option value="@gateway.Id">@gateway.DisplayName (@gateway.HealthState)</option>
                                                }
                                            }
                                            else
                                            {
                                                @foreach (var option in GetConfigurationFieldOptions(field))
                                                {
                                                    <option value="@option">@option</option>
                                                }
                                            }
                                        </select>
                                    }
                                    else if (field.Type.Equals("secret-textarea", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <textarea id="home-lab-@field.Id"
                                                  class="ui-control-input ui-control-textarea"
                                                  rows="8"
                                                  autocomplete="off"
                                                  @oninput="eventArgs => SetConfigurationValue(field.Id, eventArgs.Value?.ToString(), true)">@GetSecretConfigurationValue(field.Id)</textarea>
                                    }
                                    else
                                    {
                                        <input id="home-lab-@field.Id"
                                               class="ui-control-input"
                                               type="@(field.Secret ? "password" : "text")"
                                               value="@(field.Secret ? GetSecretConfigurationValue(field.Id) : GetConfigurationValue(field.Id))"
                                               autocomplete="@(field.Secret ? "new-password" : "off")"
                                               @oninput="eventArgs => SetConfigurationValue(field.Id, eventArgs.Value?.ToString(), field.Secret)" />
                                    }
                                    @if (!string.IsNullOrWhiteSpace(field.Help))
                                    {
                                        <span class="meta-text">@GetConfigurationFieldHelp(field)</span>
                                    }
                                </div>
                            }
                        </div>
                        <div class="home-lab-config-footer">
                            <span class="meta-text">VPN routing and the kill switch are applied by the selected gateway.</span>
                            <UiCommandButton Label="@(configuringInstallation is null ? "Install configured app" : "Save gateway")" Glyph="UiIconGlyph.Save" Variant="UiButtonVariant.Primary" Disabled="@busy" OnClick="InstallConfiguredAsync" />
                        </div>
                    </section>
                        </ChildContent>
                    </UiModal>
                }

                @if (selectedInstallation is not null && effectiveConfiguration is not null)
                {
                    var selectedDetails = effectiveConfiguration.Containers.FirstOrDefault(item => item.AppId.Equals(selectedInstallation.AppId, StringComparison.OrdinalIgnoreCase));
                    if (selectedDetails is not null)
                    {
                        <UiModal IsOpen="true"
                                 Title="@($"Settings · {selectedInstallation.DisplayName}")"
                                 Subtitle="View and edit this LMS-managed Docker container. Secrets remain protected."
                                 Class="home-lab-settings-modal"
                                 Resizable="true"
                                 CloseOnBackdrop="false"
                                 OnClose="CloseDetails">
                            <ChildContent>
                                <section class="home-lab-details-panel">
                                    <div class="home-lab-details-heading">
                                        <div>
                                            <p class="eyebrow">Container settings</p>
                                            <h2>@selectedInstallation.DisplayName</h2>
                                        </div>
                                        <UiCommandButton Label="Close" Glyph="UiIconGlyph.Clear" Variant="UiButtonVariant.Ghost" Disabled="@busy" OnClick="CloseDetails" />
                                    </div>

                                    <TabControl ActiveValue="@settingsTab"
                                                ActiveValueChanged="HandleSettingsTabChangedAsync"
                                                Class="home-lab-settings-tabs"
                                                PanelClass="home-lab-settings-tab-panel">
                                        <TabPage Value="overview" Title="Overview">
                                            <div class="home-lab-settings-overview">
                                                <div class="home-lab-detail-block">
                                                    <h3>Health</h3>
                                                    <dl class="home-lab-detail-list home-lab-detail-definition-list">
                                                        <dt>Status</dt><dd><UiPill Tone="@GetHealthTone(selectedInstallation.HealthState)">@selectedInstallation.HealthState</UiPill></dd>
                                                        <dt>Detail</dt><dd>@selectedInstallation.HealthDetail</dd>
                                                        <dt>Container</dt><dd><code>@selectedDetails.ContainerName</code></dd>
                                                        <dt>Definition</dt><dd><code>@GetApp(selectedDetails.AppId).DefinitionVersion</code></dd>
                                                        <dt>Health check</dt><dd>@DescribeHealthCheck(GetApp(selectedDetails.AppId))</dd>
                                                    </dl>
                                                </div>
                                                <div class="home-lab-detail-block">
                                                    <h3>Access</h3>
                                                    <ul class="home-lab-detail-list">
                                                        @foreach (var item in selectedDetails.Access)
                                                        {
                                                            <li><code>@item</code></li>
                                                        }
                                                    </ul>
                                                </div>
                                                <div class="home-lab-detail-block">
                                                    <h3>Connections</h3>
                                                    <ul class="home-lab-detail-list">
                                                        @foreach (var item in selectedDetails.Connections)
                                                        {
                                                            <li>@item</li>
                                                        }
                                                    </ul>
                                                </div>
                                                <div class="home-lab-detail-block">
                                                    <h3>Dependencies</h3>
                                                    @if (selectedDetails.Dependencies.Count == 0)
                                                    {
                                                        <p class="meta-text">None.</p>
                                                    }
                                                    else
                                                    {
                                                        <ul class="home-lab-detail-list">
                                                            @foreach (var dependency in selectedDetails.Dependencies)
                                                            {
                                                                <li>@GetApp(dependency).Name</li>
                                                            }
                                                        </ul>
                                                    }
                                                </div>
                                            </div>
                                        </TabPage>

                                        <TabPage Value="network" Title="Network">
                                            <div class="home-lab-settings-stack">
                                                <div class="home-lab-setting-card">
                                                    <div class="home-lab-details-heading">
                                                        <div>
                                                            <h3>Network status</h3>
                                                            <p class="meta-text">Live routing information for this container.</p>
                                                        </div>
                                                        <UiPill Tone="@GetCompactNetworkTone(selectedInstallation)">@GetCompactNetworkState(selectedInstallation)</UiPill>
                                                    </div>
                                                    @if (networkSecurity is { } security)
                                                    {
                                                        <dl class="home-lab-detail-list home-lab-detail-definition-list">
                                                            <dt>Route</dt><dd>@GetNetworkRouteLabel(selectedInstallation)</dd>
                                                            <dt>Public IP</dt><dd><code>@(security.PublicIp ?? "Unavailable")</code></dd>
                                                            <dt>Gateway health</dt><dd>@security.GatewayHealth</dd>
                                                            @if (selectedDetails.AppId.Equals("qbittorrent", StringComparison.OrdinalIgnoreCase))
                                                            {
                                                                <dt>Incoming peer port</dt><dd>@(security.PortForwardingStatus ?? "Unverified")@(security.ForwardedPort is int forwardedPort ? $" · {forwardedPort}" : string.Empty)</dd>
                                                            }
                                                            <dt>Checked</dt><dd>@security.CheckedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</dd>
                                                        </dl>
                                                    }
                                                    <UiCommandButton Label="Check now"
                                                                     Glyph="UiIconGlyph.Refresh"
                                                                     Variant="UiButtonVariant.ActionSubtle"
                                                                     Disabled="@busy"
                                                                     OnClick="VerifySecurityAsync" />
                                                </div>

                                                @if (IsVpnGateway(selectedInstallation))
                                                {
                                                    <div class="home-lab-setting-card">
                                                        <h3>VPN gateway</h3>
                                                        <dl class="home-lab-detail-list home-lab-detail-definition-list">
                                                            <dt>Name</dt><dd>@selectedInstallation.DisplayName</dd>
                                                            <dt>Provider</dt><dd>@FormatProvider(GetEffectiveEnvironmentValue(selectedDetails, "VPN_SERVICE_PROVIDER"))</dd>
                                                            <dt>Protocol</dt><dd>@FormatProtocol(GetEffectiveEnvironmentValue(selectedDetails, "VPN_TYPE"))</dd>
                                                        </dl>
                                                        <div class="home-lab-action-row">
                                                            <UiCommandButton Label="Edit VPN settings" Glyph="UiIconGlyph.Edit" Variant="UiButtonVariant.ActionSubtle" Disabled="@busy" OnClick="BeginVpnReconfiguration" />
                                                            <UiCommandButton Label="Rename gateway" Glyph="UiIconGlyph.Edit" Variant="UiButtonVariant.Ghost" Disabled="@busy" OnClick="() => BeginGatewayRename(selectedInstallation)" />
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </TabPage>

                                        <TabPage Value="container" Title="Container">
                                            <div class="home-lab-container-editor">
                                                <div class="home-lab-config-field">
                                                    <label for="home-lab-container-image">Docker image</label>
                                                    <input id="home-lab-container-image" class="ui-control-input" @bind="containerImageDraft" @bind:event="oninput" />
                                                </div>
                                                <div class="home-lab-config-field">
                                                    <label for="home-lab-container-environment">Environment</label>
                                                    <textarea id="home-lab-container-environment" class="ui-control-textarea home-lab-code-editor" @bind="containerEnvironmentDraft" @bind:event="oninput"></textarea>
                                                    <span class="meta-text">One KEY=value entry per line. Protected secrets and LMS-managed routing values are excluded.</span>
                                                </div>
                                                <div class="home-lab-config-field">
                                                    <label for="home-lab-container-volumes">Volume mappings</label>
                                                    <textarea id="home-lab-container-volumes" class="ui-control-textarea home-lab-code-editor" @bind="containerVolumesDraft" @bind:event="oninput"></textarea>
                                                    <span class="meta-text">One absolute host:container mapping per line. Add :ro for read-only mounts.</span>
                                                </div>
                                                <div class="home-lab-setting-card">
                                                    <h3>Published ports</h3>
                                                    <code>@(selectedDetails.Ports.Count == 0 ? "None" : string.Join(Environment.NewLine, selectedDetails.Ports))</code>
                                                    <p class="meta-text">LMS manages published ports and checks every shared VPN namespace for collisions.</p>
                                                </div>
                                                <div class="home-lab-config-footer">
                                                    <span class="meta-text">Saving recreates the container with these values. Use AI Help if an edited container does not start.</span>
                                                    <div class="home-lab-action-row">
                                                        @if (selectedDetails.HasCustomSettings)
                                                        {
                                                            <UiCommandButton Label="Restore pre-edit settings" Glyph="UiIconGlyph.Repair" Variant="UiButtonVariant.ActionSubtle" Disabled="@busy" OnClick="RestoreContainerSettingsAsync" />
                                                        }
                                                        <UiCommandButton Label="Reset edits" Glyph="UiIconGlyph.Refresh" Variant="UiButtonVariant.Ghost" Disabled="@busy" OnClick="ResetContainerSettingsDraft" />
                                                        <UiCommandButton Label="Save and recreate" Glyph="UiIconGlyph.Save" Variant="UiButtonVariant.Primary" Disabled="@busy" OnClick="SaveContainerSettingsAsync" />
                                                    </div>
                                                </div>
                                            </div>
                                        </TabPage>

                                        <TabPage Value="logs" Title="Logs">
                                            <div class="home-lab-settings-stack">
                                                @if (selectedDetails.AppId.Equals("qbittorrent", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <div class="home-lab-setting-card">
                                                        <h3>qBittorrent direct login</h3>
                                                        <p class="meta-text">Username: <code>admin</code>. The LMS Open link uses the trusted local route.</p>
                                                        @if (TryGetTemporaryPassword() is { } temporaryPassword)
                                                        {
                                                            <label class="home-lab-password-label" for="qbittorrent-temporary-password">Current temporary password</label>
                                                            <input id="qbittorrent-temporary-password" class="ui-control-input home-lab-password-field" value="@temporaryPassword" readonly />
                                                        }
                                                        <UiCommandButton Label="Reset to temporary password" Glyph="UiIconGlyph.Restart" Variant="UiButtonVariant.ActionSubtle" Disabled="@busy" OnClick="ResetSelectedCredentialsAsync" />
                                                    </div>
                                                }
                                                <div class="home-lab-setting-card">
                                                    <div class="home-lab-logs-heading">
                                                        <div>
                                                            <h3>Container logs</h3>
                                                            <p class="meta-text">Startup, health, and application output.</p>
                                                        </div>
                                                        <UiCommandButton Label="Refresh logs" Glyph="UiIconGlyph.Terminal" Variant="UiButtonVariant.Ghost" Disabled="@busy" OnClick="LoadSelectedLogsAsync" />
                                                    </div>
                                                    @if (selectedLogs is null)
                                                    {
                                                        <p class="meta-text">Select Refresh logs to load the latest output.</p>
                                                    }
                                                    else
                                                    {
                                                        <pre class="home-lab-detail-code home-lab-logs">@selectedLogs</pre>
                                                    }
                                                </div>
                                            </div>
                                        </TabPage>
                                    </TabControl>
                                </section>
                            </ChildContent>
                        </UiModal>
                    }
                }

                <section class="surface-subcard home-lab-docker-heading">
                    <div>
                        <p class="eyebrow">Managed Docker</p>
                        <h2>Installed containers</h2>
                        <p class="meta-text">Use AI Help on a container to inspect its health, LMS Caddy route, dependencies, and Docker networking, then approve a repair if one is needed.</p>
                    </div>
                    <UiCommandButton Label="Add VPN Gateway"
                                     Title="Install another independently configured VPN gateway"
                                     Glyph="UiIconGlyph.Plus"
                                     Variant="UiButtonVariant.PrimaryMuted"
                                     Disabled="@busy"
                                     OnClick='() => InstallAsync(GetApp("vpn-gateway"))' />
                </section>

                <div class="surface-card home-lab-app-list">
                    <div class="home-lab-app-list-header">
                        <span>Container</span>
                        <span>VPN</span>
                        <span>Status</span>
                        <span>Actions</span>
                    </div>
                    @if (workspace.Installations.Count == 0)
                    {
                        <div class="home-lab-empty-state">
                            <strong>No Docker containers have been set up yet.</strong>
                            <span>Use a guided prompt recipe, enter your own request, or add a VPN Gateway.</span>
                        </div>
                    }
                    @foreach (var group in BuildInstallationGroups())
                    {
                        var expanded = !collapsedInstallationGroups.Contains(group.Key);
                        <button type="button"
                                class="home-lab-installation-group-heading"
                                aria-expanded="@expanded"
                                aria-controls="@($"home-lab-installation-group-{group.Key}")"
                                @onclick="() => ToggleInstallationGroup(group.Key)">
                            <span class="home-lab-installation-group-toggle" aria-hidden="true">@(expanded ? "−" : "+")</span>
                            <span class="home-lab-installation-group-name">
                                <strong>@group.Name</strong>
                                <span>@group.Detail</span>
                            </span>
                            <span class="home-lab-installation-group-count">@FormatContainerCount(group.Installations.Count)</span>
                        </button>
                        @if (expanded)
                        {
                            <div id="@($"home-lab-installation-group-{group.Key}")" class="home-lab-installation-group-rows">
                            @foreach (var installation in group.Installations)
                            {
                                var app = GetApp(installation.AppId);
                                <div class="home-lab-app-row">
                                    <div class="home-lab-app-name">
                                        <strong>@installation.DisplayName</strong>
                                        <span>@app.Description</span>
                                    </div>
                                    <div class="home-lab-network-compact">
                                        @if (app.SupportsVpnGateway)
                                        {
                                            <select class="ui-control-input home-lab-route-select"
                                                    aria-label="Internet route for @installation.DisplayName"
                                                    value="@GetRouteSelection(installation)"
                                                    disabled="@busy"
                                                    @onchange="eventArgs => ChangeSummaryRouteAsync(installation, eventArgs.Value?.ToString())">
                                                <option value="direct" disabled="@app.RequiresVpnGateway">Direct (no VPN)</option>
                                                @foreach (var gateway in InstalledVpnGateways)
                                                {
                                                    <option value="@gateway.Id">@gateway.DisplayName</option>
                                                }
                                            </select>
                                            <UiPill Tone="@GetCompactNetworkTone(installation)">@GetCompactNetworkState(installation)</UiPill>
                                        }
                                        else if (IsVpnGateway(installation))
                                        {
                                            <UiPill Tone="@GetCompactNetworkTone(installation)">VPN Gateway</UiPill>
                                        }
                                        else
                                        {
                                            <UiPill Tone="@UiPillTone.Neutral">Direct</UiPill>
                                        }
                                    </div>
                                    <UiPill Tone="@GetHealthTone(installation.HealthState)">@installation.HealthState</UiPill>
                                    <div class="home-lab-row-actions">
                                        @if (BuildLocalUrl(installation) is { } localUrl)
                                        {
                                            <UiCommandButton Label="Open"
                                                             Glyph="UiIconGlyph.Website"
                                                             Variant="UiButtonVariant.Action"
                                                             Href="@localUrl"
                                                             Target="_blank"
                                                             Rel="noopener"
                                                             referrerpolicy="@(installation.AppId.Equals("qbittorrent", StringComparison.OrdinalIgnoreCase) ? "no-referrer" : null)" />
                                        }
                                        <UiCommandButton Label="AI Help"
                                                         Title="Open a troubleshooting chat for this Docker container"
                                                         Glyph="UiIconGlyph.Ai"
                                                         Variant="UiButtonVariant.PrimaryMuted"
                                                         Disabled="@(busy || startingPromptRecipeId is not null)"
                                                         OnClick="() => StartContainerHelpAsync(installation)" />
                                        <UiCommandButton Label="Settings"
                                                         Glyph="UiIconGlyph.Edit"
                                                         Variant="UiButtonVariant.Ghost"
                                                         Disabled="@busy"
                                                         OnClick="() => ManageAsync(installation)" />
                                        <select class="ui-control-input home-lab-action-select"
                                                aria-label="Actions for @installation.DisplayName"
                                                value=""
                                                disabled="@busy"
                                                @onchange="eventArgs => HandleContainerActionAsync(installation, eventArgs.Value?.ToString())">
                                            <option value="">Actions...</option>
                                            <option value="start">Start</option>
                                            <option value="stop">Stop</option>
                                            <option value="restart">Restart</option>
                                            @if (CanRepair(installation))
                                            {
                                                <option value="repair">Repair</option>
                                            }
                                            <option value="update">Update</option>
                                            @if (IsVpnGateway(installation))
                                            {
                                                <option value="rename">Rename</option>
                                                <option value="vpn-settings">VPN settings</option>
                                            }
                                            <option value="remove">Remove...</option>
                                        </select>
                                    </div>
                                </div>
                            }
                            </div>
                        }
                    }
                </div>
            </TabPage>

            <TabPage Value="prompts" Title="Prompt recipes">
                <section class="surface-subcard home-lab-prompt-intro">
                    <div>
                        <p class="eyebrow">Guided AI deployments</p>
                        <h2>Start with a proven prompt, then make it yours</h2>
                        <p class="meta-text">Choose a recipe from the public Linux Made Sane GitHub catalog. New compatible recipes appear here automatically, and the packaged catalog remains available if GitHub cannot be reached.</p>
                    </div>
                </section>
                <section class="surface-card home-lab-recipe-selector">
                    <div class="home-lab-recipe-choice">
                        <label for="home-lab-prompt-recipe">Prompt recipe</label>
                        <select id="home-lab-prompt-recipe"
                                class="ui-control-input"
                                value="@selectedPromptRecipeId"
                                @onchange="SelectPromptRecipe">
                            <option value="">Choose a recipe...</option>
                            @foreach (var promptRecipe in promptRecipes)
                            {
                                <option value="@promptRecipe.Id">@promptRecipe.Name</option>
                            }
                            <option value="custom">Enter your own</option>
                        </select>
                    </div>

                    @if (customizingPromptRecipe is { } selectedRecipe)
                    {
                        <div class="home-lab-selected-recipe">
                            <div>
                                <p class="eyebrow">@selectedRecipe.Name</p>
                                <p class="meta-text">@selectedRecipe.Description</p>
                            </div>
                            <strong class="home-lab-recipe-field-label">Apps being deployed</strong>
                            <div class="home-lab-recipe-apps" aria-label="Apps being deployed">
                                @foreach (var appId in selectedRecipe.AppIds)
                                {
                                    <span>@HomeLabCatalog.GetApp(appId).Name</span>
                                }
                                @if (selectedRecipe.RequiresVpnGateway)
                                {
                                    <span>Existing VPN Gateway</span>
                                }
                            </div>
                            <label for="home-lab-recipe-prompt">Base recipe prompt</label>
                            <textarea id="home-lab-recipe-prompt"
                                      class="ui-control-textarea"
                                      @bind="recipePromptDraft"
                                      @bind:event="oninput"></textarea>
                            <p class="meta-text">Add versions, variants, databases, admin tools, domains, storage, or other requirements. The AI will explain unsupported details before proposing changes.</p>
                            <div class="home-lab-prompt-actions">
                                <UiCommandButton Label="Reset base prompt"
                                                 Glyph="UiIconGlyph.Refresh"
                                                 Variant="UiButtonVariant.ActionSubtle"
                                                 Disabled="@(startingPromptRecipeId is not null)"
                                                 OnClick="ResetPromptRecipeDraft" />
                                <UiCommandButton Label="Start guided AI task"
                                                 Glyph="UiIconGlyph.Ai"
                                                 Variant="UiButtonVariant.PrimaryMuted"
                                                 Disabled="@(startingPromptRecipeId is not null || string.IsNullOrWhiteSpace(recipePromptDraft))"
                                                 OnClick="StartPromptRecipeAsync" />
                            </div>
                        </div>
                    }
                    else if (selectedPromptRecipeId.Equals("custom", StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="home-lab-selected-recipe">
                            <div>
                                <p class="eyebrow">Enter your own</p>
                                <h2>Enter the apps you would like made available by LMS</h2>
                            </div>
                            <textarea id="home-lab-custom-prompt"
                                      class="ui-control-textarea"
                                      @bind="customPrompt"
                                      @bind:event="oninput"
                                      placeholder="For example: WordPress, a database, and a database administration tool"></textarea>
                            <UiCommandButton Label="Start custom AI task"
                                             Glyph="UiIconGlyph.Ai"
                                             Variant="UiButtonVariant.PrimaryMuted"
                                             Disabled="@(busy || startingPromptRecipeId is not null || string.IsNullOrWhiteSpace(customPrompt))"
                                             OnClick="StartCustomPromptAsync" />
                        </div>
                    }
                </section>
            </TabPage>

            <TabPage Value="storage" Title="Storage">
                <section class="surface-subcard home-lab-storage-panel">
                    <div>
                        <p class="eyebrow">Shared storage roles</p>
                        <h2>Choose host locations once</h2>
                        <p class="meta-text">Apps and guided AI setups reuse these paths when mounting shared data into participating containers.</p>
                    </div>
                    <div class="home-lab-storage-grid">
                        @foreach (var role in StorageRoles)
                        {
                            <div class="home-lab-storage-row">
                                <label for="storage-@role">@role</label>
                                <input id="storage-@role" class="ui-control-input" @bind="storagePaths[role]" placeholder="/mnt/storage/@role" />
                                <UiCommandButton Label="Save" Glyph="UiIconGlyph.Save" Variant="UiButtonVariant.ActionSubtle" Disabled="@busy" OnClick="() => SaveStorageRoleAsync(role)" />
                            </div>
                        }
                    </div>
                </section>
            </TabPage>

        </TabControl>
    }
</div>

@code {
    private static readonly string[] StorageRoles = ["downloads", "movies", "tv", "photos"];
    private readonly Dictionary<string, string> storagePaths = new(StringComparer.OrdinalIgnoreCase)
    {
        ["downloads"] = "/mnt/storage/downloads",
        ["movies"] = "/mnt/storage/movies",
        ["tv"] = "/mnt/storage/tv",
        ["photos"] = "/mnt/storage/photos"
    };
    private HomeLabWorkspace? workspace;
    private string message = string.Empty;
    private bool error;
    private bool busy;
    private string activeTab = "apps";
    private string? startingPromptRecipeId;
    private string selectedPromptRecipeId = string.Empty;
    private string customPrompt = string.Empty;
    private IReadOnlyList<HomeLabPromptRecipe> promptRecipes = HomeLabPromptRecipeCatalog.All;
    private HomeLabPromptRecipe? customizingPromptRecipe;
    private string recipePromptDraft = string.Empty;
    private HomeLabAppManifest? configuringApp;
    private HomeLabAppInstallation? configuringInstallation;
    private HomeLabAppInstallation? renamingGateway;
    private HomeLabAppInstallation? pendingRemoval;
    private string gatewayRenameValue = string.Empty;
    private readonly Dictionary<string, string> configurationValues = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> secretConfigurationValues = new(StringComparer.OrdinalIgnoreCase);
    private HomeLabAppInstallation? selectedInstallation;
    private HomeLabEffectiveConfiguration? effectiveConfiguration;
    private HomeLabNetworkSecurity? networkSecurity;
    private readonly Dictionary<Guid, HomeLabNetworkSecurity> summaryNetworkSecurity = [];
    private readonly HashSet<string> collapsedInstallationGroups = new(StringComparer.Ordinal);
    private string? selectedLogs;
    private string settingsTab = "overview";
    private string containerImageDraft = string.Empty;
    private string containerEnvironmentDraft = string.Empty;
    private string containerVolumesDraft = string.Empty;

    [SupplyParameterFromQuery(Name = "tab")]
    public string? RequestedTab { get; set; }

    private IEnumerable<HomeLabAppInstallation> InstalledVpnGateways =>
        workspace?.Installations
            .Where(item => item.AppId.Equals("vpn-gateway", StringComparison.OrdinalIgnoreCase))
            .OrderBy(item => item.DisplayName, StringComparer.OrdinalIgnoreCase)
        ?? Enumerable.Empty<HomeLabAppInstallation>();

    private IReadOnlyList<HomeLabInstallationGroup> BuildInstallationGroups()
    {
        if (workspace is null)
        {
            return [];
        }

        var groups = new List<HomeLabInstallationGroup>();
        var recipeGroups = new List<HomeLabInstallationGroup>();
        var assignedInstallationIds = new HashSet<Guid>();
        var gateways = workspace.Installations
            .Where(IsVpnGateway)
            .OrderBy(item => item.DisplayName, StringComparer.OrdinalIgnoreCase)
            .ToArray();
        if (gateways.Length > 0)
        {
            assignedInstallationIds.UnionWith(gateways.Select(item => item.Id));
            groups.Add(new("vpn-gateways", "VPN Gateways", "VPN infrastructure", gateways, DateTimeOffset.MaxValue));
        }

        foreach (var recipeRun in workspace.Deployments
                     .Where(item => item.RecipeRunId.HasValue || !string.IsNullOrWhiteSpace(item.RecipeId))
                     .GroupBy(item => item.RecipeRunId ?? item.Id)
                     .OrderByDescending(items => items.Max(item => item.RecipeRunId.HasValue ? item.UpdatedAtUtc : item.CreatedAtUtc)))
        {
            var deployment = recipeRun.OrderByDescending(item => item.UpdatedAtUtc).First();
            var deploymentIds = recipeRun.Select(item => item.Id).ToHashSet();
            var installations = workspace.Installations
                .Where(item => deploymentIds.Contains(item.DeploymentId) && !assignedInstallationIds.Contains(item.Id))
                .OrderBy(item => item.DisplayName, StringComparer.OrdinalIgnoreCase)
                .ToArray();
            if (installations.Length == 0)
            {
                continue;
            }

            assignedInstallationIds.UnionWith(installations.Select(item => item.Id));
            var runDate = deployment.RecipeRunId.HasValue
                ? recipeRun.Max(item => item.UpdatedAtUtc)
                : recipeRun.Min(item => item.CreatedAtUtc);
            recipeGroups.Add(new(
                $"recipe-{recipeRun.Key:N}",
                ResolveRecipeName(deployment),
                FormatRecipeRunDetail(runDate),
                installations,
                runDate));
        }

        // Prompt recipes originally installed each app as a standalone deployment. Match those
        // legacy installs by the published recipe app list so existing systems gain useful groups.
        foreach (var recipe in promptRecipes
                     .OrderByDescending(item => item.AppIds.Count)
                     .ThenBy(item => item.Name, StringComparer.OrdinalIgnoreCase))
        {
            var runNumber = 0;
            while (TryMatchRecipeInstallations(recipe, assignedInstallationIds, out var installations))
            {
                runNumber++;
                assignedInstallationIds.UnionWith(installations.Select(item => item.Id));
                var createdAt = installations.Min(item => item.CreatedAtUtc);
                recipeGroups.Add(new(
                    $"prompt-recipe-{recipe.Id}-{runNumber}",
                    recipe.Name,
                    FormatRecipeRunDetail(createdAt),
                    installations,
                    createdAt));
            }
        }

        groups.AddRange(recipeGroups.OrderByDescending(item => item.SortDate));

        var standalone = workspace.Installations
            .Where(item => !assignedInstallationIds.Contains(item.Id))
            .OrderBy(item => item.DisplayName, StringComparer.OrdinalIgnoreCase)
            .ToArray();
        if (standalone.Length > 0)
        {
            groups.Add(new("individual", "Individually installed", "Added outside a recipe", standalone, DateTimeOffset.MinValue));
        }

        return groups;
    }

    private bool TryMatchRecipeInstallations(
        HomeLabPromptRecipe recipe,
        IReadOnlySet<Guid> assignedInstallationIds,
        out HomeLabAppInstallation[] installations)
    {
        var matched = new List<HomeLabAppInstallation>();
        foreach (var appId in recipe.AppIds)
        {
            var installation = workspace!.Installations
                .Where(item => !assignedInstallationIds.Contains(item.Id) &&
                               !matched.Any(match => match.Id == item.Id) &&
                               item.AppId.Equals(appId, StringComparison.OrdinalIgnoreCase))
                .OrderBy(item => item.CreatedAtUtc)
                .FirstOrDefault();
            if (installation is null)
            {
                installations = [];
                return false;
            }

            matched.Add(installation);
        }

        var deploymentIds = matched.Select(item => item.DeploymentId).ToHashSet();
        installations = workspace!.Installations
            .Where(item => deploymentIds.Contains(item.DeploymentId) &&
                           !assignedInstallationIds.Contains(item.Id) &&
                           !IsVpnGateway(item))
            .OrderBy(item => item.DisplayName, StringComparer.OrdinalIgnoreCase)
            .ToArray();
        return installations.Length > 0;
    }

    private string ResolveRecipeName(HomeLabDeployment deployment) =>
        promptRecipes.FirstOrDefault(item => item.Id.Equals(deployment.PromptRecipeId ?? deployment.RecipeId, StringComparison.OrdinalIgnoreCase))?.Name
        ?? workspace?.Recipes.FirstOrDefault(item => item.Id.Equals(deployment.RecipeId, StringComparison.OrdinalIgnoreCase))?.Name
        ?? deployment.Name;

    private void ToggleInstallationGroup(string key)
    {
        if (!collapsedInstallationGroups.Add(key))
        {
            collapsedInstallationGroups.Remove(key);
        }
    }

    private static string FormatRecipeRunDetail(DateTimeOffset createdAt) =>
        $"Recipe run · {createdAt.ToLocalTime():d MMM yyyy, HH:mm}";

    private static string FormatContainerCount(int count) => $"{count} {(count == 1 ? "container" : "containers")}";

    private sealed record HomeLabInstallationGroup(
        string Key,
        string Name,
        string Detail,
        IReadOnlyList<HomeLabAppInstallation> Installations,
        DateTimeOffset SortDate);

    protected override Task OnInitializedAsync() => LoadAsync();

    protected override void OnParametersSet()
    {
        activeTab = RequestedTab is "prompts" or "storage" ? RequestedTab : "apps";
    }

    private async Task LoadAsync()
    {
        busy = true;
        try
        {
            workspace = await HomeLabService.GetWorkspaceAsync();
            promptRecipes = await PromptRecipeProvider.GetRecipesAsync();
            foreach (var role in workspace.StorageRoles)
            {
                storagePaths[role.Role] = role.HostPath;
            }
            await RefreshSummaryNetworkSecurityAsync();
        }
        catch (Exception exception)
        {
            SetMessage(exception.Message, true);
        }
        finally
        {
            busy = false;
        }
    }

    private Task HandleTabChangedAsync(string? value)
    {
        activeTab = value is "prompts" or "storage" ? value : "apps";
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("tab", activeTab), replace: true);
        return Task.CompletedTask;
    }

    private Task HandleSettingsTabChangedAsync(string? value)
    {
        settingsTab = value is "network" or "container" or "logs" ? value : "overview";
        return Task.CompletedTask;
    }

    private async Task SaveStorageRoleAsync(string role)
    {
        await RunUiOperationAsync(async () =>
        {
            await HomeLabService.SaveStorageRoleAsync(role, storagePaths[role]);
            SetMessage($"Storage role '{role}' saved.", false);
        });
    }

    private void SelectPromptRecipe(ChangeEventArgs eventArgs)
    {
        selectedPromptRecipeId = eventArgs.Value?.ToString()?.Trim() ?? string.Empty;
        if (selectedPromptRecipeId.Equals("custom", StringComparison.OrdinalIgnoreCase))
        {
            customizingPromptRecipe = null;
            recipePromptDraft = string.Empty;
            return;
        }

        var promptRecipe = promptRecipes.FirstOrDefault(recipe =>
            recipe.Id.Equals(selectedPromptRecipeId, StringComparison.OrdinalIgnoreCase));
        customizingPromptRecipe = promptRecipe;
        recipePromptDraft = promptRecipe?.StarterPrompt ?? string.Empty;
    }

    private void ResetPromptRecipeDraft()
    {
        if (customizingPromptRecipe is { } promptRecipe)
        {
            recipePromptDraft = promptRecipe.StarterPrompt;
        }
    }

    private async Task StartPromptRecipeAsync()
    {
        if (customizingPromptRecipe is not { } promptRecipe || string.IsNullOrWhiteSpace(recipePromptDraft))
        {
            return;
        }

        await StartAiPromptAsync(
            promptRecipe.Id,
            promptRecipe.Name,
            HomeLabPromptRecipeCatalog.BuildRecipePrompt(promptRecipe, recipePromptDraft));
    }

    private async Task StartCustomPromptAsync()
    {
        if (string.IsNullOrWhiteSpace(customPrompt))
        {
            return;
        }

        await StartAiPromptAsync("custom", "Custom setup", HomeLabPromptRecipeCatalog.BuildCustomPrompt(customPrompt));
    }

    private async Task StartContainerHelpAsync(HomeLabAppInstallation installation)
    {
        await StartAiPromptAsync(
            $"help-{installation.Id}",
            $"Help with {installation.DisplayName}",
            HomeLabPromptRecipeCatalog.BuildTroubleshootingPrompt(installation));
    }

    private async Task StartAiPromptAsync(string promptId, string title, string prompt)
    {
        if (startingPromptRecipeId is not null)
        {
            return;
        }

        startingPromptRecipeId = promptId;
        message = string.Empty;
        error = false;
        try
        {
            var context = await AiThreadService.GetEditorAsync();
            if (string.IsNullOrWhiteSpace(context.Editor.ProviderKey))
            {
                throw new InvalidOperationException("Configure an AI provider before starting a Home Lab AI task.");
            }

            context.Editor.Title = $"Home Lab · {title}";
            var threadId = await AiThreadService.SaveThreadAsync(context.Editor);
            await AiChatService.SendUserMessageAsync(
                threadId,
                new AiChatMessageComposer { Content = prompt });
            Navigation.NavigateTo($"/home-lab/assist/{threadId}");
        }
        catch (Exception exception)
        {
            message = exception.Message;
            error = true;
        }
        finally
        {
            startingPromptRecipeId = null;
        }
    }

    private async Task InstallAsync(HomeLabAppManifest app)
    {
        if (app.ConfigurationSchema.Count > 0 || app.SupportsVpnGateway)
        {
            configuringApp = app;
            configuringInstallation = null;
            configurationValues.Clear();
            secretConfigurationValues.Clear();
            if (app.SupportsVpnGateway)
            {
                configurationValues["network-route"] = "VPN Gateway (Gluetun)";
                var gateways = InstalledVpnGateways.ToArray();
                if (gateways.Length == 1)
                {
                    configurationValues["vpn-gateway"] = gateways[0].Id.ToString();
                }
            }
            if (app.Id.Equals("vpn-gateway", StringComparison.OrdinalIgnoreCase))
            {
                configurationValues["gateway-name"] = NextGatewayName();
                configurationValues["configuration-mode"] = "Paste provider config";
                configurationValues["provider"] = "ProtonVPN";
                configurationValues["protocol"] = "WireGuard";
                configurationValues["port-forwarding"] = HomeLabVpnPortForwardingPlan.RequiredSelection;
            }
            activeTab = "apps";
            return;
        }

        await RunUiOperationAsync(async () =>
        {
            var paths = storagePaths
                .Where(item => app.Volumes.Any(volume => volume.SharedRole?.Equals(item.Key, StringComparison.OrdinalIgnoreCase) == true))
                .ToDictionary(item => item.Key, item => item.Value, StringComparer.OrdinalIgnoreCase);
            var result = await HomeLabService.InstallAppAsync(new HomeLabInstallRequest(app.Id, StoragePaths: paths));
            SetMessage($"{result.Summary} {result.Detail}", !result.Succeeded);
        });
    }

    private async Task InstallConfiguredAsync()
    {
        if (configuringApp is not { } app)
        {
            return;
        }

        await RunUiOperationAsync(async () =>
        {
            var paths = storagePaths
                .Where(item => app.Volumes.Any(volume => volume.SharedRole?.Equals(item.Key, StringComparison.OrdinalIgnoreCase) == true))
                .ToDictionary(item => item.Key, item => item.Value, StringComparer.OrdinalIgnoreCase);
            var result = configuringInstallation is { } gateway
                ? await HomeLabService.ReconfigureVpnGatewayAsync(
                    gateway.Id,
                    configurationValues,
                    secretConfigurationValues)
                : await HomeLabService.InstallAppAsync(new HomeLabInstallRequest(
                    app.Id,
                    StoragePaths: paths,
                    Configuration: configurationValues,
                    SecretConfiguration: secretConfigurationValues));
            SetMessage($"{result.Summary} {result.Detail}", !result.Succeeded);
            if (result.Succeeded)
            {
                configuringApp = null;
                configuringInstallation = null;
                configurationValues.Clear();
                secretConfigurationValues.Clear();
            }
        });
    }

    private async Task ManageAsync(HomeLabAppInstallation installation)
    {
        if (busy)
        {
            return;
        }
        busy = true;
        try
        {
            selectedInstallation = installation;
            effectiveConfiguration = await HomeLabService.GetEffectiveConfigurationAsync(installation.DeploymentId);
            networkSecurity = await HomeLabService.GetNetworkSecurityAsync(installation.Id);
            selectedLogs = null;
            settingsTab = "overview";
            ResetContainerSettingsDraft();
            activeTab = "apps";
        }
        catch (Exception exception)
        {
            SetMessage(exception.Message, true);
        }
        finally
        {
            busy = false;
        }
    }

    private void CloseDetails()
    {
        selectedInstallation = null;
        effectiveConfiguration = null;
        networkSecurity = null;
        selectedLogs = null;
        settingsTab = "overview";
        containerImageDraft = string.Empty;
        containerEnvironmentDraft = string.Empty;
        containerVolumesDraft = string.Empty;
    }

    private void ResetContainerSettingsDraft()
    {
        if (selectedInstallation is null || effectiveConfiguration is null)
        {
            return;
        }

        var details = effectiveConfiguration.Containers.FirstOrDefault(item =>
            item.ContainerName.Equals(selectedInstallation.ContainerName, StringComparison.OrdinalIgnoreCase));
        if (details is null)
        {
            return;
        }

        var app = GetApp(details.AppId);
        var managedKeys = app.Ports
            .Select(port => port.VpnEnvironmentVariable)
            .Where(key => !string.IsNullOrWhiteSpace(key))
            .Cast<string>()
            .Append(app.PublicUrlEnvironmentVariable ?? string.Empty)
            .Where(key => key.Length > 0)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        containerImageDraft = details.Image;
        containerEnvironmentDraft = string.Join(
            Environment.NewLine,
            details.Environment.Where(item => IsEditableEnvironmentEntry(item, managedKeys)));
        containerVolumesDraft = string.Join(Environment.NewLine, details.Volumes);
    }

    private async Task SaveContainerSettingsAsync()
    {
        if (selectedInstallation is null || busy)
        {
            return;
        }

        IReadOnlyDictionary<string, string> environment;
        IReadOnlyList<HomeLabContainerVolumeSetting> volumes;
        try
        {
            environment = ParseEnvironmentDraft(containerEnvironmentDraft);
            volumes = ParseVolumeDraft(containerVolumesDraft);
        }
        catch (InvalidOperationException exception)
        {
            SetMessage(exception.Message, true);
            return;
        }

        await RunUiOperationAsync(async () =>
        {
            var result = await HomeLabService.UpdateContainerSettingsAsync(
                selectedInstallation.Id,
                new HomeLabContainerSettingsUpdate(containerImageDraft, environment, volumes));
            SetMessage($"{result.Summary} {result.Detail}", !result.Succeeded);
        });
    }

    private async Task RestoreContainerSettingsAsync()
    {
        if (selectedInstallation is null || busy)
        {
            return;
        }

        await RunUiOperationAsync(async () =>
        {
            var result = await HomeLabService.RestoreContainerSettingsAsync(selectedInstallation.Id);
            SetMessage($"{result.Summary} {result.Detail}", !result.Succeeded);
        });
    }

    private static bool IsEditableEnvironmentEntry(string entry, IReadOnlySet<string> managedKeys)
    {
        var separator = entry.IndexOf('=');
        if (separator <= 0 || entry.Contains("<redacted", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        var key = entry[..separator];
        return !managedKeys.Contains(key) &&
               (char.IsAsciiLetter(key[0]) || key[0] == '_') &&
               key.All(character => char.IsAsciiLetterOrDigit(character) || character == '_');
    }

    private static IReadOnlyDictionary<string, string> ParseEnvironmentDraft(string draft)
    {
        var values = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var line in draft.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            if (line.StartsWith('#'))
            {
                continue;
            }

            var separator = line.IndexOf('=');
            if (separator <= 0)
            {
                throw new InvalidOperationException($"Environment entry '{line}' must use KEY=value.");
            }

            var key = line[..separator].Trim();
            if (!values.TryAdd(key, line[(separator + 1)..]))
            {
                throw new InvalidOperationException($"Environment variable '{key}' is listed more than once.");
            }
        }

        return values;
    }

    private static IReadOnlyList<HomeLabContainerVolumeSetting> ParseVolumeDraft(string draft)
    {
        var volumes = new List<HomeLabContainerVolumeSetting>();
        foreach (var line in draft.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            if (line.StartsWith('#'))
            {
                continue;
            }

            var readOnly = line.EndsWith(":ro", StringComparison.OrdinalIgnoreCase);
            var mapping = readOnly ? line[..^3] : line;
            var separator = mapping.IndexOf(':');
            if (separator <= 0 || separator == mapping.Length - 1)
            {
                throw new InvalidOperationException($"Volume mapping '{line}' must use /host/path:/container/path[:ro].");
            }

            volumes.Add(new HomeLabContainerVolumeSetting(
                mapping[..separator].Trim(),
                mapping[(separator + 1)..].Trim(),
                readOnly));
        }

        return volumes;
    }

    private async Task RefreshSummaryNetworkSecurityAsync()
    {
        summaryNetworkSecurity.Clear();
        if (workspace is null)
        {
            return;
        }

        foreach (var installation in workspace.Installations)
        {
            try
            {
                summaryNetworkSecurity[installation.Id] = await HomeLabService.GetNetworkSecurityAsync(installation.Id);
            }
            catch
            {
                // A stopped or unavailable container is represented in the summary as unverified.
            }
        }
    }

    private HomeLabNetworkSecurity? GetSummaryNetworkSecurity(HomeLabAppInstallation installation) =>
        summaryNetworkSecurity.TryGetValue(installation.Id, out var security) ? security : null;

    private string GetCompactNetworkState(HomeLabAppInstallation installation)
    {
        var security = GetSummaryNetworkSecurity(installation);
        if (IsVpnGateway(installation))
        {
            return "VPN Gateway";
        }

        return security is null
            ? IsVpnRoute(installation.NetworkMode) ? "Checking" : "Direct"
            : security.IsSecured
                ? "VPN Secured"
                : security.Status.Equals("DIRECT", StringComparison.OrdinalIgnoreCase)
                    ? "Direct"
                    : "VPN Issue";
    }

    private string GetNetworkRouteLabel(HomeLabAppInstallation installation)
    {
        if (!IsVpnRoute(installation.NetworkMode))
        {
            return "Direct Internet";
        }

        var gatewayId = GetGatewayIdFromNetworkMode(installation.NetworkMode);
        return Guid.TryParse(gatewayId, out var parsedGatewayId)
            ? InstalledVpnGateways.FirstOrDefault(item => item.Id == parsedGatewayId)?.DisplayName ?? "VPN Gateway"
            : "VPN Gateway";
    }

    private UiPillTone GetCompactNetworkTone(HomeLabAppInstallation installation)
    {
        var security = GetSummaryNetworkSecurity(installation);
        if (IsVpnGateway(installation))
        {
            return installation.HealthState == HomeLabHealthState.Healthy
                ? UiPillTone.Success
                : GetHealthTone(installation.HealthState);
        }

        if (security is null)
        {
            return IsVpnRoute(installation.NetworkMode) ? UiPillTone.Warning : UiPillTone.Neutral;
        }

        return security.IsSecured
            ? UiPillTone.Success
            : security.Status.Equals("DIRECT", StringComparison.OrdinalIgnoreCase)
                ? UiPillTone.Neutral
                : UiPillTone.Failure;
    }

    private string GetRouteSelection(HomeLabAppInstallation installation) =>
        GetGatewayIdFromNetworkMode(installation.NetworkMode) is { Length: > 0 } gatewayId
            ? gatewayId
            : "direct";

    private async Task ChangeSummaryRouteAsync(HomeLabAppInstallation installation, string? selection)
    {
        var value = selection?.Trim() ?? string.Empty;
        var useVpnGateway = !value.Equals("direct", StringComparison.OrdinalIgnoreCase);
        Guid? gatewayInstallationId = Guid.TryParse(value, out var parsedGatewayId) ? parsedGatewayId : null;
        if (useVpnGateway && gatewayInstallationId is null)
        {
            return;
        }

        await RunUiOperationAsync(async () =>
        {
            var result = await HomeLabService.SetNetworkRouteAsync(
                installation.Id,
                useVpnGateway,
                gatewayInstallationId);
            SetMessage($"{result.Summary} {result.Detail}", !result.Succeeded);
        });
    }

    private async Task LoadSelectedLogsAsync()
    {
        if (selectedInstallation is null || busy)
        {
            return;
        }

        busy = true;
        try
        {
            var result = await HomeLabService.GetLogsAsync(selectedInstallation.Id);
            selectedLogs = result.Succeeded
                ? result.Logs
                : $"Could not read container logs: {result.Error}";
            if (!result.Succeeded)
            {
                SetMessage(result.Error, true);
            }
        }
        catch (Exception exception)
        {
            SetMessage(exception.Message, true);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ResetSelectedCredentialsAsync()
    {
        if (selectedInstallation is null || busy)
        {
            return;
        }

        await RunUiOperationAsync(async () =>
        {
            var result = await HomeLabService.ResetCredentialsAsync(selectedInstallation.Id);
            SetMessage($"{result.Summary} {result.Detail}", !result.Succeeded);
            if (result.Succeeded)
            {
                var logs = await HomeLabService.GetLogsAsync(selectedInstallation.Id);
                selectedLogs = logs.Succeeded ? logs.Logs : $"Could not read container logs: {logs.Error}";
            }
        });
    }

    private string? TryGetTemporaryPassword()
    {
        if (string.IsNullOrWhiteSpace(selectedLogs))
        {
            return null;
        }

        var lines = selectedLogs.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries);
        for (var index = lines.Length - 1; index >= 0; index--)
        {
            var line = lines[index];
            var passwordIndex = line.IndexOf("temporary password", StringComparison.OrdinalIgnoreCase);
            var sessionMarker = "for this session:";
            var sessionIndex = passwordIndex >= 0
                ? line.IndexOf(sessionMarker, passwordIndex, StringComparison.OrdinalIgnoreCase)
                : -1;
            if (sessionIndex >= 0)
            {
                var password = line[(sessionIndex + sessionMarker.Length)..]
                    .Trim()
                    .Split([' ', '\t'], StringSplitOptions.RemoveEmptyEntries)
                    .FirstOrDefault()
                    ?.TrimEnd('.', '\r');
                return string.IsNullOrWhiteSpace(password) ? null : password;
            }
        }

        return null;
    }

    private void CancelConfiguration()
    {
        configuringApp = null;
        configuringInstallation = null;
        configurationValues.Clear();
        secretConfigurationValues.Clear();
    }

    private void BeginVpnReconfiguration()
    {
        if (selectedInstallation is not { } gateway || !gateway.AppId.Equals("vpn-gateway", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        BeginVpnReconfiguration(gateway);
    }

    private void BeginVpnReconfiguration(HomeLabAppInstallation gateway)
    {
        if (!gateway.AppId.Equals("vpn-gateway", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        configuringInstallation = gateway;
        configuringApp = GetApp("vpn-gateway");
        configurationValues.Clear();
        secretConfigurationValues.Clear();
        configurationValues["gateway-name"] = gateway.DisplayName;
        configurationValues["configuration-mode"] = "Paste provider config";
        configurationValues["provider"] = "ProtonVPN";
        configurationValues["protocol"] = "WireGuard";
        configurationValues["port-forwarding"] = HomeLabVpnPortForwardingPlan.RequiredSelection;
        CloseDetails();
    }

    private void BeginGatewayRename(HomeLabAppInstallation gateway)
    {
        if (!IsVpnGateway(gateway))
        {
            return;
        }

        renamingGateway = gateway;
        gatewayRenameValue = gateway.DisplayName;
        CloseDetails();
    }

    private bool CanRenameGateway =>
        renamingGateway is { } gateway &&
        !string.IsNullOrWhiteSpace(gatewayRenameValue) &&
        gatewayRenameValue.Trim().Length <= 160 &&
        !gateway.DisplayName.Equals(gatewayRenameValue.Trim(), StringComparison.Ordinal);

    private void CancelGatewayRename()
    {
        renamingGateway = null;
        gatewayRenameValue = string.Empty;
    }

    private async Task RenameGatewayAsync()
    {
        if (renamingGateway is not { } gateway || !CanRenameGateway)
        {
            return;
        }

        var renamed = false;
        await RunUiOperationAsync(async () =>
        {
            var configuration = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            {
                ["gateway-name"] = gatewayRenameValue.Trim(),
                ["configuration-mode"] = "Paste provider config"
            };
            var result = await HomeLabService.ReconfigureVpnGatewayAsync(
                gateway.Id,
                configuration,
                new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase));
            renamed = result.Succeeded;
            SetMessage($"{result.Summary} {result.Detail}", !result.Succeeded);
        });

        if (renamed)
        {
            CancelGatewayRename();
        }
    }

    private bool ShouldShowConfigurationField(HomeLabConfigurationField field)
    {
        if (field.Id.Equals("vpn-gateway", StringComparison.OrdinalIgnoreCase))
        {
            return GetConfigurationValue("network-route").Equals("VPN Gateway (Gluetun)", StringComparison.OrdinalIgnoreCase);
        }

        if (configuringApp is null || !configuringApp.Id.Equals("vpn-gateway", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        var setupMode = GetConfigurationValue("configuration-mode");
        if (field.Id.Equals("vpn-config", StringComparison.OrdinalIgnoreCase))
        {
            return setupMode.Equals("Paste provider config", StringComparison.OrdinalIgnoreCase);
        }
        if (setupMode.Equals("Paste provider config", StringComparison.OrdinalIgnoreCase) &&
            !field.Id.Equals("configuration-mode", StringComparison.OrdinalIgnoreCase) &&
            !field.Id.Equals("protocol", StringComparison.OrdinalIgnoreCase) &&
            !field.Id.Equals("provider", StringComparison.OrdinalIgnoreCase) &&
            !field.Id.Equals("port-forwarding", StringComparison.OrdinalIgnoreCase) &&
            !field.Id.StartsWith("openvpn-", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        var protocol = GetConfigurationValue("protocol");
        if (field.Id.StartsWith("wireguard-", StringComparison.OrdinalIgnoreCase))
        {
            return protocol.Equals("WireGuard", StringComparison.OrdinalIgnoreCase);
        }
        if (field.Id.StartsWith("openvpn-", StringComparison.OrdinalIgnoreCase))
        {
            return protocol.Equals("OpenVPN", StringComparison.OrdinalIgnoreCase);
        }
        return true;
    }

    private string GetConfigurationValue(string key) =>
        configurationValues.TryGetValue(key, out var value) ? value : string.Empty;

    private string GetSecretConfigurationValue(string key) =>
        secretConfigurationValues.TryGetValue(key, out var value) ? value : string.Empty;

    private void SetConfigurationValue(string key, string? value, bool secret = false)
    {
        var target = secret ? secretConfigurationValues : configurationValues;
        target[key] = value ?? string.Empty;
        if (!secret && key.Equals("provider", StringComparison.OrdinalIgnoreCase))
        {
            configurationValues["port-forwarding"] = HomeLabVpnPortForwardingPlan.SupportsAutomaticPortForwarding(value)
                ? HomeLabVpnPortForwardingPlan.RequiredSelection
                : HomeLabVpnPortForwardingPlan.OffSelection;
        }
    }

    private static string GetConfigurationFieldClass(HomeLabConfigurationField field) =>
        field.Type.Equals("secret-textarea", StringComparison.OrdinalIgnoreCase)
            ? "home-lab-config-field home-lab-config-field-wide"
            : "home-lab-config-field";

    private IEnumerable<string> GetConfigurationFieldOptions(HomeLabConfigurationField field)
    {
        if (!field.Id.Equals("port-forwarding", StringComparison.OrdinalIgnoreCase) ||
            HomeLabVpnPortForwardingPlan.SupportsAutomaticPortForwarding(GetConfigurationValue("provider")))
        {
            return field.Options ?? [];
        }

        return [HomeLabVpnPortForwardingPlan.OffSelection];
    }

    private string? GetConfigurationFieldHelp(HomeLabConfigurationField field)
    {
        if (!field.Id.Equals("port-forwarding", StringComparison.OrdinalIgnoreCase))
        {
            return field.Help;
        }

        var provider = GetConfigurationValue("provider");
        return HomeLabVpnPortForwardingPlan.SupportsAutomaticPortForwarding(provider)
            ? field.Help
            : $"{provider} can carry P2P traffic but does not provide an inbound forwarded port. LMS will install this gateway with incoming port forwarding off; qBittorrent will still work, with reduced inbound peer reachability.";
    }

    private static HomeLabAppManifest GetApp(string appId) => HomeLabCatalog.GetApp(appId);

    private static string GetEffectiveEnvironmentValue(HomeLabEffectiveContainer container, string key)
    {
        var prefix = key + "=";
        var value = container.Environment
            .FirstOrDefault(item => item.StartsWith(prefix, StringComparison.OrdinalIgnoreCase));
        return value is null ? "Not set" : value[prefix.Length..];
    }

    private static string FormatProvider(string value) =>
        string.IsNullOrWhiteSpace(value) || value.Equals("custom", StringComparison.OrdinalIgnoreCase)
            ? "Custom provider configuration"
            : value;

    private static string FormatProtocol(string value) =>
        value.Equals("wireguard", StringComparison.OrdinalIgnoreCase)
            ? "WireGuard"
            : value.Equals("openvpn", StringComparison.OrdinalIgnoreCase)
                ? "OpenVPN"
                : string.IsNullOrWhiteSpace(value) ? "Not set" : value;

    private static bool IsVpnRoute(string networkMode) =>
        networkMode.StartsWith("container:", StringComparison.OrdinalIgnoreCase);

    private string NextGatewayName()
    {
        var existingNames = InstalledVpnGateways
            .Select(item => item.DisplayName)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        if (!existingNames.Contains("VPN Gateway"))
        {
            return "VPN Gateway";
        }

        for (var suffix = 2; ; suffix++)
        {
            var candidate = $"VPN Gateway {suffix}";
            if (!existingNames.Contains(candidate))
            {
                return candidate;
            }
        }
    }

    private string GetGatewayIdFromNetworkMode(string networkMode)
    {
        if (!IsVpnRoute(networkMode))
        {
            return string.Empty;
        }

        var containerName = networkMode["container:".Length..];
        return InstalledVpnGateways.FirstOrDefault(item => item.ContainerName.Equals(containerName, StringComparison.OrdinalIgnoreCase))?.Id.ToString() ?? string.Empty;
    }

    private static string DescribeHealthCheck(HomeLabAppManifest app)
    {
        if (app.HealthCheck is null)
        {
            return "Container state fallback";
        }

        if (!string.IsNullOrWhiteSpace(app.HealthCheck.HttpPath))
        {
            return $"HTTP {app.HealthCheck.HttpPath} on port {app.HealthCheck.Port}";
        }

        if (!string.IsNullOrWhiteSpace(app.HealthCheck.DockerCommand))
        {
            return $"Docker command: {app.HealthCheck.DockerCommand}";
        }

        return "Container state fallback";
    }

    private async Task RunAsync(Guid installationId, HomeLabLifecycleAction action)
    {
        await RunUiOperationAsync(async () =>
        {
            var result = await HomeLabService.ExecuteAsync(installationId, action);
            SetMessage($"{result.Summary} {result.Detail}", !result.Succeeded);
        });
    }

    private async Task HandleContainerActionAsync(HomeLabAppInstallation installation, string? selection)
    {
        switch (selection?.Trim().ToLowerInvariant())
        {
            case "start":
                await RunAsync(installation.Id, HomeLabLifecycleAction.Start);
                break;
            case "stop":
                await RunAsync(installation.Id, HomeLabLifecycleAction.Stop);
                break;
            case "restart":
                await RunAsync(installation.Id, HomeLabLifecycleAction.Restart);
                break;
            case "repair":
                await RunAsync(installation.Id, HomeLabLifecycleAction.Repair);
                break;
            case "update":
                await RunAsync(installation.Id, HomeLabLifecycleAction.Update);
                break;
            case "rename":
                BeginGatewayRename(installation);
                break;
            case "vpn-settings":
                BeginVpnReconfiguration(installation);
                break;
            case "remove":
                pendingRemoval = installation;
                break;
        }
    }

    private void CancelRemoval()
    {
        if (!busy)
        {
            pendingRemoval = null;
        }
    }

    private async Task ConfirmRemovalAsync()
    {
        if (pendingRemoval is not { } installation || busy)
        {
            return;
        }

        pendingRemoval = null;
        await RunAsync(installation.Id, HomeLabLifecycleAction.Remove);
    }

    private static bool IsVpnGateway(HomeLabAppInstallation installation) =>
        installation.AppId.Equals("vpn-gateway", StringComparison.OrdinalIgnoreCase);

    private async Task VerifySecurityAsync()
    {
        if (selectedInstallation is null || busy)
        {
            return;
        }

        busy = true;
        try
        {
            networkSecurity = await HomeLabService.GetNetworkSecurityAsync(selectedInstallation.Id);
            summaryNetworkSecurity[selectedInstallation.Id] = networkSecurity;
        }
        catch (Exception exception)
        {
            SetMessage(exception.Message, true);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task RunUiOperationAsync(Func<Task> operation)
    {
        if (busy) return;
        busy = true;
        try
        {
            await operation();
            workspace = await HomeLabService.GetWorkspaceAsync();
            await RefreshSummaryNetworkSecurityAsync();
            if (selectedInstallation is { } openInstallation)
            {
                selectedInstallation = workspace.Installations.FirstOrDefault(item => item.Id == openInstallation.Id);
                if (selectedInstallation is null)
                {
                    CloseDetails();
                }
                else
                {
                    networkSecurity = GetSummaryNetworkSecurity(selectedInstallation);
                    effectiveConfiguration = await HomeLabService.GetEffectiveConfigurationAsync(selectedInstallation.DeploymentId);
                    ResetContainerSettingsDraft();
                    if (selectedInstallation.AppId.Equals("qbittorrent", StringComparison.OrdinalIgnoreCase))
                    {
                        var logs = await HomeLabService.GetLogsAsync(selectedInstallation.Id);
                        selectedLogs = logs.Succeeded ? logs.Logs : $"Could not read container logs: {logs.Error}";
                    }
                }
            }
        }
        catch (Exception exception)
        {
            SetMessage(exception.Message, true);
        }
        finally
        {
            busy = false;
        }
    }

    private void SetMessage(string text, bool isError)
    {
        message = text;
        error = isError;
    }

    private static UiPillTone GetHealthTone(HomeLabHealthState state) => state switch
    {
        HomeLabHealthState.Healthy => UiPillTone.Success,
        HomeLabHealthState.Starting => UiPillTone.Warning,
        HomeLabHealthState.Stopped => UiPillTone.Neutral,
        _ => UiPillTone.Failure
    };

    private bool CanRepair(HomeLabAppInstallation installation)
    {
        if (installation.HealthState is HomeLabHealthState.Degraded or HomeLabHealthState.Failed)
        {
            return true;
        }

        if (installation.HealthState != HomeLabHealthState.Blocked || !IsVpnRoute(installation.NetworkMode))
        {
            return false;
        }

        var gatewayContainer = installation.NetworkMode["container:".Length..];
        var gateway = InstalledVpnGateways.FirstOrDefault(item =>
            item.ContainerName.Equals(gatewayContainer, StringComparison.OrdinalIgnoreCase));
        return gateway?.HealthState is HomeLabHealthState.Healthy or HomeLabHealthState.Degraded or HomeLabHealthState.Failed;
    }

    private string? BuildLocalUrl(HomeLabAppInstallation installation)
    {
        if (installation.CaddySourcePort is not int caddyPort || caddyPort <= 0)
        {
            return null;
        }

        if (!Uri.TryCreate(Navigation.BaseUri, UriKind.Absolute, out var baseUri) ||
            string.IsNullOrWhiteSpace(baseUri.Host))
        {
            return null;
        }

        return $"http://{baseUri.Host}:{caddyPort}";
    }
