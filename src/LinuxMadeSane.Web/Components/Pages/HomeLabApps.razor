    private string GetCompactNetworkState(HomeLabAppInstallation installation)
    {
        var security = GetSummaryNetworkSecurity(installation);
        if (IsVpnGateway(installation))
        {
            return "VPN Gateway";
        }

        return security is null
            ? IsVpnRoute(installation.NetworkMode) ? "Checking" : "Direct"
            : security.IsSecured
                ? "VPN Secured"
                : security.Status.Equals("DIRECT", StringComparison.OrdinalIgnoreCase)
                    ? "Direct"
                    : "VPN Issue";
    }

    private string GetNetworkRouteLabel(HomeLabAppInstallation installation)
    {
        if (!IsVpnRoute(installation.NetworkMode))
        {
            return "Direct Internet";
        }

        var gatewayId = GetGatewayIdFromNetworkMode(installation.NetworkMode);
        return Guid.TryParse(gatewayId, out var parsedGatewayId)
            ? InstalledVpnGateways.FirstOrDefault(item => item.Id == parsedGatewayId)?.DisplayName ?? "VPN Gateway"
            : "VPN Gateway";
    }

    private UiPillTone GetCompactNetworkTone(HomeLabAppInstallation installation)
    {
        var security = GetSummaryNetworkSecurity(installation);
        if (IsVpnGateway(installation))
        {
            return installation.HealthState == HomeLabHealthState.Healthy
                ? UiPillTone.Success
                : GetHealthTone(installation.HealthState);
        }

        if (security is null)
        {
            return IsVpnRoute(installation.NetworkMode) ? UiPillTone.Warning : UiPillTone.Neutral;
        }

        return security.IsSecured
            ? UiPillTone.Success
            : security.Status.Equals("DIRECT", StringComparison.OrdinalIgnoreCase)
                ? UiPillTone.Neutral
                : UiPillTone.Failure;
    }

