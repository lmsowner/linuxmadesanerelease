    private void StartBackgroundRefresh()
    {
        if (disposed || backgroundRefreshInProgress)
        {
            return;
        }

        backgroundRefreshInProgress = true;
        backgroundRefreshTask = RefreshBackgroundStateAsync(healthMonitorCancellation.Token);
    }

    private async Task RefreshBackgroundStateAsync(CancellationToken cancellationToken)
    {
        await Task.Yield();
        try
        {
            await using var scope = ServiceScopeFactory.CreateAsyncScope();
            var homeLabService = scope.ServiceProvider.GetRequiredService<IHomeLabService>();
            var promptRecipeProvider = scope.ServiceProvider.GetRequiredService<IHomeLabPromptRecipeProvider>();
            var edgeGatewayService = scope.ServiceProvider.GetRequiredService<IEdgeGatewayService>();

            var recipeTask = promptRecipeProvider.GetRecipesAsync(cancellationToken);
            var refreshedWorkspace = await homeLabService.GetWorkspaceAsync(cancellationToken);
            var refreshedSecurity = new Dictionary<Guid, HomeLabNetworkSecurity>();
            foreach (var installation in refreshedWorkspace.Installations)
            {
                try
                {
                    refreshedSecurity[installation.Id] = await homeLabService.GetNetworkSecurityAsync(
                        installation.Id,
                        cancellationToken);
                }
                catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
                {
                    throw;
                }
                catch
                {
                    // Stopped or unavailable containers remain unverified in the saved snapshot.
                }
            }

            IReadOnlyList<EdgeGatewayRouteListItem>? refreshedRoutes = null;
            EdgeGatewayDashboardViewModel? refreshedDashboard = null;
            try
            {
                refreshedRoutes = await edgeGatewayService.ListRoutesAsync(cancellationToken);
                refreshedDashboard = await edgeGatewayService.GetDashboardAsync(cancellationToken);
            }
            catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
            {
                throw;
            }
            catch
            {
                // Keep the currently displayed Edge Gateway state if its refresh is unavailable.
            }

            var refreshedRecipes = await recipeTask;
            await InvokeAsync(() =>
            {
                if (disposed)
                {
                    return;
                }

                workspace = refreshedWorkspace;
                promptRecipes = refreshedRecipes;
                if (refreshedRoutes is not null)
                {
                    edgeGatewayRoutes = refreshedRoutes;
                    edgeGatewayDashboard = refreshedDashboard;
                }

                summaryNetworkSecurity.Clear();
                foreach (var entry in refreshedSecurity)
                {
                    summaryNetworkSecurity[entry.Key] = entry.Value;
                }

                foreach (var role in refreshedWorkspace.StorageRoles)
                {
                    storagePaths[role.Role] = role.HostPath;
                }

                StateHasChanged();
            });
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch
        {
            // Keep the fast saved snapshot visible; a manual refresh can retry live discovery.
        }
        finally
        {
            backgroundRefreshInProgress = false;
            if (!disposed)
            {
                try
                {
                    await InvokeAsync(StateHasChanged);
                }
                catch (InvalidOperationException) when (disposed) { }
            }
        }
    }

    private async Task MonitorRuntimeHealthAfterInitialRefreshAsync(CancellationToken cancellationToken)
    {
        if (backgroundRefreshTask is not null)
        {
            await backgroundRefreshTask;
        }

        await MonitorRuntimeHealthAsync(cancellationToken);
    }

    private async Task MonitorRuntimeHealthAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
            var stableTicks = 0;
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    if (disposed || busy || backgroundRefreshInProgress || healthRefreshInProgress || workspace is null)
                    {
                        return;
                    }

                    var hasTransitionalState = workspace.Installations.Any(item =>
                        item.HealthState is HomeLabHealthState.Starting or HomeLabHealthState.Degraded or HomeLabHealthState.Blocked);
                    if (!hasTransitionalState && ++stableTicks < 8)
                    {
                        return;
                    }

                    stableTicks = 0;
                    healthRefreshInProgress = true;
                    try
                    {
                        var health = await HomeLabService.RefreshRuntimeHealthAsync(cancellationToken);
                        ApplyRuntimeHealth(health);
                        StateHasChanged();
                    }
                    catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
                    catch
                    {
                        // Keep the current snapshot and try again on the next interval.
                    }
                    finally
                    {
                        healthRefreshInProgress = false;
                    }
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    }

    private void ApplyRuntimeHealth(IReadOnlyList<HomeLabRuntimeHealth> health)
    {
        if (workspace is null || health.Count == 0)
        {
            return;
        }

        var healthByInstallation = health.ToDictionary(item => item.InstallationId);
        var installations = workspace.Installations.Select(installation =>
        {
            if (!healthByInstallation.TryGetValue(installation.Id, out var current))
            {
                return installation;
            }

            return installation with
            {
                HealthState = current.HealthState,
                HealthDetail = current.HealthDetail,
                UpdatedAtUtc = current.UpdatedAtUtc
            };
        }).ToArray();
        workspace = workspace with { Installations = installations };

        if (selectedInstallation is { } selected)
        {
            selectedInstallation = installations.FirstOrDefault(item => item.Id == selected.Id);
        }
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        await healthMonitorCancellation.CancelAsync();
        if (healthMonitorTask is not null)
        {
            try { await healthMonitorTask; }
            catch (OperationCanceledException) { }
        }
        if (backgroundRefreshTask is not null)
        {
            try { await backgroundRefreshTask; }
            catch (OperationCanceledException) { }
        }
        healthMonitorCancellation.Dispose();
    }

