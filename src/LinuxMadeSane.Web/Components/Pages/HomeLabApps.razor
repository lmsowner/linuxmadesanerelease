@page "/home-lab/apps"
@rendermode InteractiveServer
@using LinuxMadeSane.Application.Contracts.HomeLab
@using LinuxMadeSane.Application.Interfaces
@using LinuxMadeSane.Core.Enums
@using LinuxMadeSane.Core.Models.HomeLab
@inject IHomeLabService HomeLabService
@inject NavigationManager Navigation

<PageTitle>Home Lab Apps | Linux Made Sane</PageTitle>

<div class="page-shell home-lab-page">
    <UiHeroPanel Eyebrow="Home Lab"
                  Title="Apps"
                  Description="Compose established Docker applications on private LMS-managed networks."
                  Compact="true">
        <Actions>
            <UiCommandButton Label="Refresh"
                             Glyph="UiIconGlyph.Refresh"
                             Variant="UiButtonVariant.Ghost"
                             Disabled="@busy"
                             OnClick="LoadAsync" />
        </Actions>
    </UiHeroPanel>

    <nav class="home-lab-section-tabs" aria-label="Home Lab">
        <a class="active" href="/home-lab/apps">Apps</a>
        <a href="/home-lab/recipes">Recipes</a>
    </nav>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <p class="callout @(error ? "error" : "ready")">@message</p>
    }

    @if (workspace is null)
    {
        <UiPanel><p class="meta-text">Loading Home Lab...</p></UiPanel>
    }
    else
    {
        <TabControl ActiveValue="@activeTab"
                    ActiveValueChanged="HandleTabChangedAsync"
                    Class="home-lab-tabs"
                    PanelClass="home-lab-tab-panel">
            <TabPage Value="apps" Title="Apps">
                @if (configuringApp is { } appToConfigure)
                {
                    <section class="surface-card home-lab-config-panel">
                        <div class="home-lab-config-heading">
                            <div>
                                <p class="eyebrow">Installation settings</p>
                                <h2>Configure @appToConfigure.Name</h2>
                                <p class="meta-text">These values are applied to the Docker container. Secret fields are stored by LMS and are not shown again.</p>
                            </div>
                            <UiCommandButton Label="Cancel" Glyph="UiIconGlyph.Clear" Variant="UiButtonVariant.Ghost" Disabled="@busy" OnClick="CancelConfiguration" />
                        </div>
                        <div class="home-lab-config-grid">
                            @foreach (var field in appToConfigure.ConfigurationSchema.Where(ShouldShowConfigurationField))
                            {
                                <div class="home-lab-config-field">
                                    <label for="home-lab-@field.Id">@field.Label</label>
                                    @if (field.Type.Equals("select", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <select id="home-lab-@field.Id" class="ui-control-input" value="@GetConfigurationValue(field.Id)" @onchange="eventArgs => SetConfigurationValue(field.Id, eventArgs.Value?.ToString())">
                                            <option value="">Choose...</option>
                                            @if (field.Id.Equals("vpn-gateway", StringComparison.OrdinalIgnoreCase))
                                            {
                                                @foreach (var gateway in InstalledVpnGateways)
                                                {
                                                    <option value="@gateway.Id">@gateway.DisplayName (@gateway.HealthState)</option>
                                                }
                                            }
                                            else
                                            {
                                                @foreach (var option in field.Options ?? [])
                                                {
                                                    <option value="@option">@option</option>
                                                }
                                            }
                                        </select>
                                    }
                                    else if (field.Type.Equals("secret-textarea", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <textarea id="home-lab-@field.Id"
                                                  class="ui-control-input ui-control-textarea"
                                                  rows="8"
                                                  autocomplete="off"
                                                  @oninput="eventArgs => SetConfigurationValue(field.Id, eventArgs.Value?.ToString(), true)">@GetSecretConfigurationValue(field.Id)</textarea>
                                    }
                                    else
                                    {
                                        <input id="home-lab-@field.Id"
                                               class="ui-control-input"
                                               type="@(field.Secret ? "password" : "text")"
                                               value="@(field.Secret ? GetSecretConfigurationValue(field.Id) : GetConfigurationValue(field.Id))"
                                               autocomplete="@(field.Secret ? "new-password" : "off")"
                                               @oninput="eventArgs => SetConfigurationValue(field.Id, eventArgs.Value?.ToString(), field.Secret)" />
                                    }
                                    @if (!string.IsNullOrWhiteSpace(field.Help))
                                    {
                                        <span class="meta-text">@field.Help</span>
                                    }
                                </div>
                            }
                        </div>
                        <div class="home-lab-config-footer">
                            <span class="meta-text">VPN routing and the kill switch are applied by Gluetun and the LMS dependency state.</span>
                            <UiCommandButton Label="Install configured app" Glyph="UiIconGlyph.Download" Variant="UiButtonVariant.Primary" Disabled="@busy" OnClick="InstallConfiguredAsync" />
                        </div>
                    </section>
                }

                @if (selectedInstallation is not null && effectiveConfiguration is not null)
                {
                    var selectedDetails = effectiveConfiguration.Containers.FirstOrDefault(item => item.AppId.Equals(selectedInstallation.AppId, StringComparison.OrdinalIgnoreCase));
                    if (selectedDetails is not null)
                    {
                        <UiModal IsOpen="true"
                                 Title="@($"Docker settings · {GetApp(selectedDetails.AppId).Name}")"
                                 Subtitle="Effective LMS configuration for this Home Lab container. Secrets remain redacted."
                                 Class="home-lab-settings-modal"
                                 Resizable="true"
                                 CloseOnBackdrop="false"
                                 OnClose="CloseDetails">
                            <ChildContent>
                        <section class="home-lab-details-panel">
                            <div class="home-lab-details-heading">
                                <div>
                                    <p class="eyebrow">Docker settings</p>
                                    <h2>@GetApp(selectedDetails.AppId).Name</h2>
                                    <p class="meta-text">This is the effective Docker configuration LMS created. Secrets are shown as redacted and are never included here.</p>
                                </div>
                                <UiCommandButton Label="Close" Glyph="UiIconGlyph.Clear" Variant="UiButtonVariant.Ghost" Disabled="@busy" OnClick="CloseDetails" />
                            </div>

                            <section class="home-lab-important-settings" aria-label="Important Docker settings">
                                @if (selectedDetails.AppId.Equals("vpn-gateway", StringComparison.OrdinalIgnoreCase))
                                {
                                    <div class="home-lab-credential-panel home-lab-security-summary">
                                        <p class="eyebrow">Infrastructure configuration</p>
                                        <h3>VPN Gateway</h3>
                                        <dl class="home-lab-detail-list home-lab-detail-definition-list">
                                            <dt>Gateway name</dt><dd>@selectedInstallation.DisplayName</dd>
                                            <dt>Provider</dt><dd>@FormatProvider(GetEffectiveEnvironmentValue(selectedDetails, "VPN_SERVICE_PROVIDER"))</dd>
                                            <dt>Protocol</dt><dd>@FormatProtocol(GetEffectiveEnvironmentValue(selectedDetails, "VPN_TYPE"))</dd>
                                            <dt>Public IP</dt><dd><code>@(networkSecurity?.PublicIp ?? "Checking…")</code></dd>
                                        </dl>
                                    </div>
                                }

                                @if (networkSecurity is { } security)
                                {
                                    <div class="home-lab-credential-panel home-lab-security-summary">
                                        <div class="home-lab-details-heading">
                                            <div>
                                                <p class="eyebrow">Network protection</p>
                                                <h3>VPN security</h3>
                                                <p class="meta-text">This is the live route LMS verified for this container.</p>
                                            </div>
                                            <UiPill Tone="@GetSecurityTone(security.Status)">@security.Status</UiPill>
                                        </div>
                                        <dl class="home-lab-detail-list home-lab-detail-definition-list">
                                            <dt>Route</dt><dd><strong>@security.Route</strong></dd>
                                            <dt>Gluetun gateway</dt><dd><code>@FormatGatewayLabel(security.GatewayContainer)</code></dd>
                                            <dt>Gateway health</dt><dd>@security.GatewayHealth</dd>
                                            <dt>Public IP</dt><dd><code>@(security.PublicIp ?? "Unavailable")</code></dd>
                                            <dt>Checked</dt><dd>@security.CheckedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</dd>
                                        </dl>
                                        <p class="meta-text">@security.Detail</p>
                                        <UiCommandButton Label="Check VPN now"
                                                         Title="Re-check the live Docker route, Gluetun health, and public egress IP"
                                                         Glyph="UiIconGlyph.Refresh"
                                                         Variant="UiButtonVariant.ActionSubtle"
                                                         Disabled="@busy"
                                                         OnClick="VerifySecurityAsync" />
                                    </div>
                                }

                                @if (GetApp(selectedDetails.AppId).SupportsVpnGateway && !selectedInstallation.IsRecipeInstallation)
                                {
                                    <div class="home-lab-credential-panel">
                                        <h3>Internet route</h3>
                                        <p class="meta-text">
                                            Current route:
                                            <strong>@(IsVpnRoute(selectedInstallation.NetworkMode) ? "VPN Gateway (Gluetun)" : "Direct (NO VPN)")</strong>.
                                            This selection applies immediately and recreates the container with the selected route.
                                        </p>
                                        @if (IsVpnRoute(selectedInstallation.NetworkMode))
                                        {
                                            <p class="meta-text">The container shares the selected Gluetun network namespace. If the gateway is unhealthy, LMS blocks this app and does not fall back to direct Internet access.</p>
                                        }
                                        else if (GetApp(selectedDetails.AppId).RequiresVpnGateway)
                                        {
                                            <p class="meta-text"><strong>UNSAFE:</strong> this app requires Gluetun and is blocked until it is routed through a VPN gateway.</p>
                                        }
                                        <label class="home-lab-password-label" for="home-lab-selected-route">Internet route</label>
                                        <select id="home-lab-selected-route"
                                                class="ui-control-input"
                                                value="@GetRouteSelection(selectedInstallation)"
                                                disabled="@busy"
                                                @onchange="eventArgs => ChangeSelectedRouteAsync(eventArgs.Value?.ToString())">
                                            <option value="direct" disabled="@GetApp(selectedDetails.AppId).RequiresVpnGateway">Direct (no VPN)</option>
                                            @foreach (var gateway in InstalledVpnGateways)
                                            {
                                                <option value="@gateway.Id">VPN · @gateway.DisplayName (@gateway.HealthState)</option>
                                            }
                                        </select>
                                    </div>
                                }

                                @if (selectedDetails.AppId.Equals("qbittorrent", StringComparison.OrdinalIgnoreCase))
                                {
                                    <div class="home-lab-credential-panel">
                                        <h3>qBittorrent login</h3>
                                        <p class="meta-text">Username: <code>admin</code></p>
                                        <p class="meta-text">The current image generates a temporary password on startup. LMS reads it from the container logs until you change it in qBittorrent.</p>
                                        @if (TryGetTemporaryPassword() is { } temporaryPassword)
                                        {
                                            <label class="home-lab-password-label" for="qbittorrent-temporary-password">Current temporary password</label>
                                            <input id="qbittorrent-temporary-password"
                                                   class="ui-control-input home-lab-password-field"
                                                   value="@temporaryPassword"
                                                   readonly
                                                   aria-label="Current qBittorrent temporary password" />
                                        }
                                        else if (selectedLogs?.StartsWith("Could not read container logs", StringComparison.OrdinalIgnoreCase) == true)
                                        {
                                            <p class="home-lab-temporary-password">@selectedLogs</p>
                                        }
                                        else if (selectedLogs is not null)
                                        {
                                            <p class="home-lab-temporary-password">No temporary password was found. qBittorrent appears to have a persistent password configured.</p>
                                        }
                                        else
                                        {
                                            <p class="home-lab-temporary-password">Reading the current qBittorrent startup logs...</p>
                                        }
                                        <div class="home-lab-action-row">
                                            <UiCommandButton Label="View login logs"
                                                             Glyph="UiIconGlyph.Terminal"
                                                             Variant="UiButtonVariant.Ghost"
                                                             Disabled="@busy"
                                                             OnClick="LoadSelectedLogsAsync" />
                                            <UiCommandButton Label="Reset to temporary password"
                                                             Glyph="UiIconGlyph.Restart"
                                                             Variant="UiButtonVariant.ActionSubtle"
                                                             Disabled="@busy"
                                                             OnClick="ResetSelectedCredentialsAsync" />
                                        </div>
                                    </div>
                                }
                            </section>

                            <div class="home-lab-details-grid">
                                <div class="home-lab-detail-block">
                                    <h3>Access</h3>
                                    <ul class="home-lab-detail-list">
                                        @foreach (var item in selectedDetails.Access)
                                        {
                                            <li><code>@item</code></li>
                                        }
                                    </ul>
                                </div>
                                <div class="home-lab-detail-block">
                                    <h3>Connections</h3>
                                    <ul class="home-lab-detail-list">
                                        @foreach (var item in selectedDetails.Connections)
                                        {
                                            <li>@item</li>
                                        }
                                    </ul>
                                </div>
                                <div class="home-lab-detail-block">
                                    <h3>Runtime</h3>
                                    <dl class="home-lab-detail-list home-lab-detail-definition-list">
                                        <dt>Container</dt><dd><code>@selectedDetails.ContainerName</code></dd>
                                        <dt>Image</dt><dd><code>@selectedDetails.Image</code></dd>
                                        <dt>Definition</dt><dd><code>@GetApp(selectedDetails.AppId).DefinitionVersion</code></dd>
                                        <dt>Network mode</dt><dd><code>@selectedDetails.NetworkMode</code></dd>
                                        <dt>Network</dt><dd><code>@effectiveConfiguration.NetworkName</code></dd>
                                        <dt>Published ports</dt><dd><code>@string.Join(", ", selectedDetails.Ports)</code></dd>
                                        @if (selectedInstallation.CaddySourcePort is int caddyPort)
                                        {
                                            <dt>LMS Caddy port</dt><dd><code>@caddyPort</code></dd>
                                        }
                                    </dl>
                                </div>
                                <div class="home-lab-detail-block">
                                    <h3>Health</h3>
                                    <dl class="home-lab-detail-list home-lab-detail-definition-list">
                                        <dt>State</dt><dd>@selectedInstallation.HealthState</dd>
                                        <dt>Detail</dt><dd>@selectedInstallation.HealthDetail</dd>
                                        <dt>Check</dt><dd>@DescribeHealthCheck(GetApp(selectedDetails.AppId))</dd>
                                    </dl>
                                </div>
                            </div>

                            <details class="home-lab-advanced-details">
                                <summary>Technical Docker details</summary>
                                <div class="home-lab-detail-block">
                                    <h3>Environment and settings</h3>
                                    <pre class="home-lab-detail-code">@string.Join(Environment.NewLine, selectedDetails.Environment)</pre>
                                </div>
                                <div class="home-lab-detail-block">
                                    <h3>Volume mappings</h3>
                                    <pre class="home-lab-detail-code">@string.Join(Environment.NewLine, selectedDetails.Volumes)</pre>
                                </div>
                                <div class="home-lab-detail-block">
                                    <h3>Deployment topology</h3>
                                    <div class="home-lab-topology-list">
                                        @foreach (var container in effectiveConfiguration.Containers)
                                        {
                                            <div class="home-lab-topology-row">
                                                <strong>@GetApp(container.AppId).Name</strong>
                                                <span>@string.Join(" · ", container.Connections)</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <div class="home-lab-detail-block">
                                    <h3>Dependencies</h3>
                                    @if (selectedDetails.Dependencies.Count == 0)
                                    {
                                        <p class="meta-text">None declared.</p>
                                    }
                                    else
                                    {
                                        <ul class="home-lab-detail-list">
                                            @foreach (var dependency in selectedDetails.Dependencies)
                                            {
                                                <li>@GetApp(dependency).Name <code>(@dependency)</code></li>
                                            }
                                        </ul>
                                    }
                                </div>
                            </details>

                            <details class="home-lab-advanced-details">
                                <summary>Container logs and diagnostics</summary>
                                <div class="home-lab-detail-block">
                                    <div class="home-lab-logs-heading">
                                        <div>
                                            <h3>Container logs</h3>
                                            <p class="meta-text">Use these logs for startup passwords, provider errors, health failures, and application diagnostics.</p>
                                        </div>
                                        <UiCommandButton Label="View logs"
                                                         Glyph="UiIconGlyph.Terminal"
                                                         Variant="UiButtonVariant.Ghost"
                                                         Disabled="@busy"
                                                         OnClick="LoadSelectedLogsAsync" />
                                    </div>
                                    @if (selectedLogs is not null)
                                    {
                                        <pre class="home-lab-detail-code home-lab-logs">@selectedLogs</pre>
                                    }
                                </div>
                            </details>
                        </section>
                            </ChildContent>
                        </UiModal>
                    }
                }

                <div class="home-lab-filter-tabs" role="tablist" aria-label="App categories">
                    @foreach (var category in Categories)
                    {
                        <button class="@(activeCategory == category ? "active" : string.Empty)"
                                type="button"
                                role="tab"
                                aria-selected="@(activeCategory == category)"
                                @onclick="() => activeCategory = category">@(category is null ? "All" : FormatCategory(category.Value))</button>
                    }
                </div>

                <div class="surface-card home-lab-app-list">
                    <div class="home-lab-app-list-header">
                        <span>Application</span>
                        <span>Image</span>
                        <span>Network</span>
                        <span>Status</span>
                        <span>Actions</span>
                    </div>
                    @foreach (var app in FilteredApps)
                    {
                        var installations = workspace.Installations.Where(item => item.AppId.Equals(app.Id, StringComparison.OrdinalIgnoreCase)).ToArray();
                        var installation = installations.FirstOrDefault();
                        <div class="home-lab-app-row">
                            <div class="home-lab-app-name">
                                <strong>@app.Name</strong>
                                <span>@app.Description</span>
                                @if (app.Id.Equals("vpn-gateway", StringComparison.OrdinalIgnoreCase) && installations.Length > 0)
                                {
                                    @foreach (var gateway in installations)
                                    {
                                        <span>@gateway.DisplayName · @gateway.HealthState</span>
                                    }
                                }
                                else if (installation is not null)
                                {
                                    <span>Network: @FormatNetwork(installation.NetworkMode)</span>
                                }
                            </div>
                            <span class="home-lab-image">@app.ImageRepository:@app.ImageTag</span>
                            @if (installation is not null)
                            {
                                <div class="home-lab-network-summary">
                                    <div class="home-lab-network-summary-heading">
                                        <UiPill Tone="@GetNetworkSummaryTone(installation)">@GetNetworkSummaryState(installation)</UiPill>
                                        <strong>@GetNetworkSummaryRoute(installation)</strong>
                                    </div>
                                    <span>Public IP: <code>@GetNetworkSummaryPublicIp(installation)</code></span>
                                    @if (app.SupportsVpnGateway && !app.Id.Equals("vpn-gateway", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <select class="ui-control-input home-lab-route-select"
                                                aria-label="Internet route for @app.Name"
                                                value="@GetRouteSelection(installation)"
                                                disabled="@busy"
                                                @onchange="eventArgs => ChangeSummaryRouteAsync(installation, eventArgs.Value?.ToString())">
                                            <option value="direct" disabled="@app.RequiresVpnGateway">Direct (no VPN)</option>
                                            @foreach (var gateway in InstalledVpnGateways)
                                            {
                                                <option value="@gateway.Id">VPN · @gateway.DisplayName</option>
                                            }
                                        </select>
                                    }
                                </div>
                            }
                            <UiPill Tone="@(installation is null ? UiPillTone.Neutral : GetHealthTone(installation.HealthState))">
                                @(installation is null ? "Available" : installation.HealthState.ToString())
                            </UiPill>
                            <div class="home-lab-action-row row-action-cluster">
                                @if (installation is not null)
                                {
                                    @if (app.Id.Equals("vpn-gateway", StringComparison.OrdinalIgnoreCase) && installations.Length > 1)
                                    {
                                        @foreach (var gateway in installations)
                                        {
                                            @if (BuildLocalUrl(gateway) is { } gatewayUrl)
                                            {
                                                <UiCommandButton Label="Open" Glyph="UiIconGlyph.Website" Variant="UiButtonVariant.Action" Href="@gatewayUrl" Target="_blank" Rel="noopener" />
                                            }
                                            <UiCommandButton Label="@($"Settings: {gateway.DisplayName}")"
                                                             Glyph="UiIconGlyph.ListView"
                                                             Variant="UiButtonVariant.Ghost"
                                                             Disabled="@busy"
                                                             OnClick="() => ManageAsync(gateway)" />
                                            <UiCommandButton Label="Start" Glyph="UiIconGlyph.Run" Variant="UiButtonVariant.ActionSubtle" Disabled="@busy" OnClick="() => RunAsync(gateway.Id, HomeLabLifecycleAction.Start)" />
                                            <UiCommandButton Label="Stop" Glyph="UiIconGlyph.Stop" Variant="UiButtonVariant.Ghost" Disabled="@busy" OnClick="() => RunAsync(gateway.Id, HomeLabLifecycleAction.Stop)" />
                                            <UiCommandButton Label="Update" Glyph="UiIconGlyph.Refresh" Variant="UiButtonVariant.Ghost" Disabled="@busy" OnClick="() => RunAsync(gateway.Id, HomeLabLifecycleAction.Update)" />
                                            <UiCommandButton Label="Remove" Glyph="UiIconGlyph.Delete" Variant="UiButtonVariant.Danger" Disabled="@busy" OnClick="() => RunAsync(gateway.Id, HomeLabLifecycleAction.Remove)" />
                                        }
                                    }
                                    else
                                    {
                                        @if (BuildLocalUrl(installation) is { } localUrl)
                                        {
                                            <UiCommandButton Label="Open" Glyph="UiIconGlyph.Website" Variant="UiButtonVariant.Action" Href="@localUrl" Target="_blank" Rel="noopener" />
                                        }
                                        <UiCommandButton Label="Settings"
                                                         Glyph="UiIconGlyph.ListView"
                                                         Variant="UiButtonVariant.Ghost"
                                                         Title="View effective Docker settings"
                                                         Disabled="@busy"
                                                         OnClick="() => ManageAsync(installation)" />
                                        <UiCommandButton Label="Start" Glyph="UiIconGlyph.Run" Variant="UiButtonVariant.ActionSubtle" Disabled="@busy" OnClick="() => RunAsync(installation.Id, HomeLabLifecycleAction.Start)" />
                                        <UiCommandButton Label="Stop" Glyph="UiIconGlyph.Stop" Variant="UiButtonVariant.Ghost" Disabled="@busy" OnClick="() => RunAsync(installation.Id, HomeLabLifecycleAction.Stop)" />
                                        <UiCommandButton Label="Update" Glyph="UiIconGlyph.Refresh" Variant="UiButtonVariant.Ghost" Disabled="@busy" OnClick="() => RunAsync(installation.Id, HomeLabLifecycleAction.Update)" />
                                        <UiCommandButton Label="Remove" Glyph="UiIconGlyph.Delete" Variant="UiButtonVariant.Danger" Disabled="@busy" OnClick="() => RunAsync(installation.Id, HomeLabLifecycleAction.Remove)" />
                                    }
                                }
                                else
                                {
                                    <UiCommandButton Label="Install" Glyph="UiIconGlyph.Download" Variant="UiButtonVariant.PrimaryMuted" Disabled="@busy" OnClick="() => InstallAsync(app)" />
                                }
                            </div>
                        </div>
                    }
                </div>
            </TabPage>

            <TabPage Value="storage" Title="Storage">
                <section class="surface-subcard home-lab-storage-panel">
                    <div>
                        <p class="eyebrow">Shared storage roles</p>
                        <h2>Choose host locations once</h2>
                        <p class="meta-text">Recipes reuse these paths when mounting downloads and media into participating containers.</p>
                    </div>
                    <div class="home-lab-storage-grid">
                        @foreach (var role in StorageRoles)
                        {
                            <div class="home-lab-storage-row">
                                <label for="storage-@role">@role</label>
                                <input id="storage-@role" class="ui-control-input" @bind="storagePaths[role]" placeholder="/mnt/storage/@role" />
                                <UiCommandButton Label="Save" Glyph="UiIconGlyph.Save" Variant="UiButtonVariant.ActionSubtle" Disabled="@busy" OnClick="() => SaveStorageRoleAsync(role)" />
                            </div>
                        }
                    </div>
                </section>
            </TabPage>

            <TabPage Value="ai" Title="AI help">
                <section class="surface-subcard home-lab-ai-panel">
                    <div>
                        <p class="eyebrow">Home Lab assistant</p>
                        <h2>Use AI to plan and troubleshoot</h2>
                        <p class="meta-text">Ask about choosing a recipe, storage layout, Docker health, or an app’s effective configuration. AI suggestions do not install or change anything automatically.</p>
                    </div>
                    <UiCommandButton Label="Open AI assistant" Glyph="UiIconGlyph.Ai" Variant="UiButtonVariant.PrimaryMuted" Href="/ai" />
                </section>
            </TabPage>
        </TabControl>
    }
</div>

@code {
    private static readonly string[] StorageRoles = ["downloads", "movies", "tv", "photos"];
    private readonly Dictionary<string, string> storagePaths = new(StringComparer.OrdinalIgnoreCase)
    {
        ["downloads"] = "/mnt/storage/downloads",
        ["movies"] = "/mnt/storage/movies",
        ["tv"] = "/mnt/storage/tv",
        ["photos"] = "/mnt/storage/photos"
    };
    private HomeLabWorkspace? workspace;
    private string message = string.Empty;
    private bool error;
    private bool busy;
    private string activeTab = "apps";
    private HomeLabAppCategory? activeCategory;
    private HomeLabAppManifest? configuringApp;
    private readonly Dictionary<string, string> configurationValues = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> secretConfigurationValues = new(StringComparer.OrdinalIgnoreCase);
    private HomeLabAppInstallation? selectedInstallation;
    private HomeLabEffectiveConfiguration? effectiveConfiguration;
    private HomeLabNetworkSecurity? networkSecurity;
    private readonly Dictionary<Guid, HomeLabNetworkSecurity> summaryNetworkSecurity = [];
    private string? selectedLogs;

    private static readonly HomeLabAppCategory?[] Categories =
    [
        null,
        HomeLabAppCategory.Infrastructure,
        HomeLabAppCategory.Download,
        HomeLabAppCategory.Media,
        HomeLabAppCategory.Automation,
        HomeLabAppCategory.Photos,
        HomeLabAppCategory.Utilities
    ];

    private IReadOnlyList<HomeLabAppManifest> FilteredApps =>
        workspace?.Apps.Where(app => activeCategory is null || app.Category == activeCategory).ToArray() ?? [];

    private IEnumerable<HomeLabAppInstallation> InstalledVpnGateways =>
        workspace?.Installations
            .Where(item => item.AppId.Equals("vpn-gateway", StringComparison.OrdinalIgnoreCase))
            .OrderBy(item => item.DisplayName, StringComparer.OrdinalIgnoreCase)
        ?? Enumerable.Empty<HomeLabAppInstallation>();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        busy = true;
        try
        {
            workspace = await HomeLabService.GetWorkspaceAsync();
            foreach (var role in workspace.StorageRoles)
            {
                storagePaths[role.Role] = role.HostPath;
            }
            await RefreshSummaryNetworkSecurityAsync();
        }
        catch (Exception exception)
        {
            SetMessage(exception.Message, true);
        }
        finally
        {
            busy = false;
        }
    }

    private Task HandleTabChangedAsync(string? value)
    {
        activeTab = value is "storage" or "ai" ? value : "apps";
        return Task.CompletedTask;
    }

    private async Task SaveStorageRoleAsync(string role)
    {
        await RunUiOperationAsync(async () =>
        {
            await HomeLabService.SaveStorageRoleAsync(role, storagePaths[role]);
            SetMessage($"Storage role '{role}' saved.", false);
        });
    }

    private async Task InstallAsync(HomeLabAppManifest app)
    {
        if (app.ConfigurationSchema.Count > 0 || app.SupportsVpnGateway)
        {
            configuringApp = app;
            configurationValues.Clear();
            secretConfigurationValues.Clear();
            if (app.SupportsVpnGateway)
            {
                configurationValues["network-route"] = "VPN Gateway (Gluetun)";
                var gateways = InstalledVpnGateways.ToArray();
                if (gateways.Length == 1)
                {
                    configurationValues["vpn-gateway"] = gateways[0].Id.ToString();
                }
            }
            if (app.Id.Equals("vpn-gateway", StringComparison.OrdinalIgnoreCase))
            {
                configurationValues["gateway-name"] = NextGatewayName();
                configurationValues["configuration-mode"] = "Guided";
                configurationValues["provider"] = "ProtonVPN";
                configurationValues["protocol"] = "WireGuard";
            }
            activeTab = "apps";
            return;
        }

        await RunUiOperationAsync(async () =>
        {
            var paths = storagePaths
                .Where(item => app.Volumes.Any(volume => volume.SharedRole?.Equals(item.Key, StringComparison.OrdinalIgnoreCase) == true))
                .ToDictionary(item => item.Key, item => item.Value, StringComparer.OrdinalIgnoreCase);
            var result = await HomeLabService.InstallAppAsync(new HomeLabInstallRequest(app.Id, StoragePaths: paths));
            SetMessage($"{result.Summary} {result.Detail}", !result.Succeeded);
        });
    }

    private async Task InstallConfiguredAsync()
    {
        if (configuringApp is not { } app)
        {
            return;
        }

        await RunUiOperationAsync(async () =>
        {
            var paths = storagePaths
                .Where(item => app.Volumes.Any(volume => volume.SharedRole?.Equals(item.Key, StringComparison.OrdinalIgnoreCase) == true))
                .ToDictionary(item => item.Key, item => item.Value, StringComparer.OrdinalIgnoreCase);
            var result = await HomeLabService.InstallAppAsync(new HomeLabInstallRequest(
                app.Id,
                StoragePaths: paths,
                Configuration: configurationValues,
                SecretConfiguration: secretConfigurationValues));
            SetMessage($"{result.Summary} {result.Detail}", !result.Succeeded);
            if (result.Succeeded)
            {
                configuringApp = null;
                configurationValues.Clear();
                secretConfigurationValues.Clear();
            }
        });
    }

    private async Task ManageAsync(HomeLabAppInstallation installation)
    {
        if (busy)
        {
            return;
        }
        busy = true;
        try
        {
                            selectedInstallation = installation;
                            effectiveConfiguration = await HomeLabService.GetEffectiveConfigurationAsync(installation.DeploymentId);
                            networkSecurity = await HomeLabService.GetNetworkSecurityAsync(installation.Id);
                            selectedLogs = null;
            if (installation.AppId.Equals("qbittorrent", StringComparison.OrdinalIgnoreCase))
            {
                var logs = await HomeLabService.GetLogsAsync(installation.Id);
                selectedLogs = logs.Succeeded
                    ? logs.Logs
                    : $"Could not read container logs: {logs.Error}";
            }
            activeTab = "apps";
        }
        catch (Exception exception)
        {
            SetMessage(exception.Message, true);
        }
        finally
        {
            busy = false;
        }
    }

    private void CloseDetails()
    {
        selectedInstallation = null;
        effectiveConfiguration = null;
        networkSecurity = null;
        selectedLogs = null;
    }

    private async Task RefreshSummaryNetworkSecurityAsync()
    {
        summaryNetworkSecurity.Clear();
        if (workspace is null)
        {
            return;
        }

        foreach (var installation in workspace.Installations)
        {
            try
            {
                summaryNetworkSecurity[installation.Id] = await HomeLabService.GetNetworkSecurityAsync(installation.Id);
            }
            catch
            {
                // A stopped or unavailable container is represented in the summary as unverified.
            }
        }
    }

    private HomeLabNetworkSecurity? GetSummaryNetworkSecurity(HomeLabAppInstallation installation) =>
        summaryNetworkSecurity.TryGetValue(installation.Id, out var security) ? security : null;

    private string GetNetworkSummaryState(HomeLabAppInstallation installation)
    {
        var security = GetSummaryNetworkSecurity(installation);
        if (installation.AppId.Equals("vpn-gateway", StringComparison.OrdinalIgnoreCase))
        {
            return installation.HealthState == HomeLabHealthState.Healthy
                ? "VPN GATEWAY ACTIVE"
                : $"VPN GATEWAY {installation.HealthState.ToString().ToUpperInvariant()}";
        }

        return security is null
            ? "UNVERIFIED"
            : security.IsSecured
                ? "VPN SECURED"
                : security.Status.Equals("DIRECT", StringComparison.OrdinalIgnoreCase)
                    ? "DIRECT / NO VPN"
                    : security.Status;
    }

    private string GetNetworkSummaryRoute(HomeLabAppInstallation installation)
    {
        var security = GetSummaryNetworkSecurity(installation);
        if (installation.AppId.Equals("vpn-gateway", StringComparison.OrdinalIgnoreCase))
        {
            return "VPN gateway container · provider tunnel";
        }

        if (security is null)
        {
            return IsVpnRoute(installation.NetworkMode) ? "VPN gateway · checking" : "Direct internet · checking";
        }

        return security.IsVpnRouted
            ? $"VPN gateway · {FormatGatewayLabel(security.GatewayContainer)}"
            : "Direct internet · no VPN";
    }

    private string GetNetworkSummaryPublicIp(HomeLabAppInstallation installation) =>
        GetSummaryNetworkSecurity(installation)?.PublicIp ?? "Unavailable";

    private UiPillTone GetNetworkSummaryTone(HomeLabAppInstallation installation)
    {
        var security = GetSummaryNetworkSecurity(installation);
        if (installation.AppId.Equals("vpn-gateway", StringComparison.OrdinalIgnoreCase))
        {
            return installation.HealthState == HomeLabHealthState.Healthy
                ? UiPillTone.Success
                : GetHealthTone(installation.HealthState);
        }

        if (security is null)
        {
            return UiPillTone.Warning;
        }

        return security.IsSecured
            ? UiPillTone.Success
            : security.Status.Equals("DIRECT", StringComparison.OrdinalIgnoreCase)
                ? UiPillTone.Warning
                : UiPillTone.Failure;
    }

    private string GetRouteSelection(HomeLabAppInstallation installation) =>
        GetGatewayIdFromNetworkMode(installation.NetworkMode) is { Length: > 0 } gatewayId
            ? gatewayId
            : "direct";

    private async Task ChangeSummaryRouteAsync(HomeLabAppInstallation installation, string? selection)
    {
        var value = selection?.Trim() ?? string.Empty;
        var useVpnGateway = !value.Equals("direct", StringComparison.OrdinalIgnoreCase);
        Guid? gatewayInstallationId = Guid.TryParse(value, out var parsedGatewayId) ? parsedGatewayId : null;
        if (useVpnGateway && gatewayInstallationId is null)
        {
            return;
        }

        await RunUiOperationAsync(async () =>
        {
            var result = await HomeLabService.SetNetworkRouteAsync(
                installation.Id,
                useVpnGateway,
                gatewayInstallationId);
            SetMessage($"{result.Summary} {result.Detail}", !result.Succeeded);
        });
    }

    private Task ChangeSelectedRouteAsync(string? selection) =>
        selectedInstallation is null
            ? Task.CompletedTask
            : ChangeSummaryRouteAsync(selectedInstallation, selection);

    private async Task LoadSelectedLogsAsync()
    {
        if (selectedInstallation is null || busy)
