    private void ResetContainerSettingsDraft()
    {
        if (selectedInstallation is null || effectiveConfiguration is null)
        {
            return;
        }

        var details = effectiveConfiguration.Containers.FirstOrDefault(item =>
            item.ContainerName.Equals(selectedInstallation.ContainerName, StringComparison.OrdinalIgnoreCase));
        if (details is null)
        {
            return;
        }

        var app = GetApp(details.AppId);
        var managedKeys = app.Ports
            .Select(port => port.VpnEnvironmentVariable)
            .Where(key => !string.IsNullOrWhiteSpace(key))
            .Cast<string>()
            .Append(app.PublicUrlEnvironmentVariable ?? string.Empty)
            .Where(key => key.Length > 0)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        containerImageDraft = details.Image;
        containerEnvironmentDraft = string.Join(
            Environment.NewLine,
            details.Environment.Where(item => IsEditableEnvironmentEntry(item, managedKeys)));
        containerVolumesDraft = string.Join(Environment.NewLine, details.Volumes);
    }

