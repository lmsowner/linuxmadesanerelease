    private string? TryGetTemporaryPassword()
    {
        if (string.IsNullOrWhiteSpace(selectedLogs))
        {
            return null;
        }

        var lines = selectedLogs.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries);
        for (var index = lines.Length - 1; index >= 0; index--)
        {
            var line = lines[index];
            var passwordIndex = line.IndexOf("temporary password", StringComparison.OrdinalIgnoreCase);
            var sessionMarker = "for this session:";
            var sessionIndex = passwordIndex >= 0
                ? line.IndexOf(sessionMarker, passwordIndex, StringComparison.OrdinalIgnoreCase)
                : -1;
            if (sessionIndex >= 0)
            {
                var password = line[(sessionIndex + sessionMarker.Length)..]
                    .Trim()
                    .Split([' ', '\t'], StringSplitOptions.RemoveEmptyEntries)
                    .FirstOrDefault()
                    ?.TrimEnd('.', '\r');
                return string.IsNullOrWhiteSpace(password) ? null : password;
            }
        }

        return null;
    }

    private void CancelConfiguration()
    {
        configuringApp = null;
        configurationValues.Clear();
        secretConfigurationValues.Clear();
    }

    private bool ShouldShowConfigurationField(HomeLabConfigurationField field)
    {
        if (field.Id.Equals("vpn-gateway", StringComparison.OrdinalIgnoreCase))
        {
            return GetConfigurationValue("network-route").Equals("VPN Gateway (Gluetun)", StringComparison.OrdinalIgnoreCase);
        }

        if (configuringApp is null || !configuringApp.Id.Equals("vpn-gateway", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        var setupMode = GetConfigurationValue("configuration-mode");
        if (field.Id.Equals("vpn-config", StringComparison.OrdinalIgnoreCase))
        {
            return setupMode.Equals("Paste provider config", StringComparison.OrdinalIgnoreCase);
        }
        if (field.Id.Equals("provider", StringComparison.OrdinalIgnoreCase))
        {
            return !setupMode.Equals("Paste provider config", StringComparison.OrdinalIgnoreCase);
        }
        if (setupMode.Equals("Paste provider config", StringComparison.OrdinalIgnoreCase) &&
            !field.Id.Equals("configuration-mode", StringComparison.OrdinalIgnoreCase) &&
            !field.Id.Equals("protocol", StringComparison.OrdinalIgnoreCase) &&
            !field.Id.StartsWith("openvpn-", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        var protocol = GetConfigurationValue("protocol");
        if (field.Id.StartsWith("wireguard-", StringComparison.OrdinalIgnoreCase))
        {
            return protocol.Equals("WireGuard", StringComparison.OrdinalIgnoreCase);
        }
        if (field.Id.StartsWith("openvpn-", StringComparison.OrdinalIgnoreCase))
        {
            return protocol.Equals("OpenVPN", StringComparison.OrdinalIgnoreCase);
        }
        return true;
    }

    private string GetConfigurationValue(string key) =>
        configurationValues.TryGetValue(key, out var value) ? value : string.Empty;

    private string GetSecretConfigurationValue(string key) =>
        secretConfigurationValues.TryGetValue(key, out var value) ? value : string.Empty;

    private void SetConfigurationValue(string key, string? value, bool secret = false)
    {
        var target = secret ? secretConfigurationValues : configurationValues;
        target[key] = value ?? string.Empty;
    }

    private static HomeLabAppManifest GetApp(string appId) => HomeLabCatalog.GetApp(appId);

    private static string GetEffectiveEnvironmentValue(HomeLabEffectiveContainer container, string key)
    {
        var prefix = key + "=";
        var value = container.Environment
            .FirstOrDefault(item => item.StartsWith(prefix, StringComparison.OrdinalIgnoreCase));
        return value is null ? "Not set" : value[prefix.Length..];
    }

    private static string FormatProvider(string value) =>
        string.IsNullOrWhiteSpace(value) || value.Equals("custom", StringComparison.OrdinalIgnoreCase)
            ? "Custom provider configuration"
            : value;

    private static string FormatProtocol(string value) =>
        value.Equals("wireguard", StringComparison.OrdinalIgnoreCase)
            ? "WireGuard"
            : value.Equals("openvpn", StringComparison.OrdinalIgnoreCase)
                ? "OpenVPN"
                : string.IsNullOrWhiteSpace(value) ? "Not set" : value;

    private static string FormatNetwork(string networkMode) =>
        networkMode.StartsWith("container:", StringComparison.OrdinalIgnoreCase)
            ? "VPN GATEWAY: GLUETUN"
            : "NO VPN: DIRECT NETWORK";

    private static bool IsVpnRoute(string networkMode) =>
        networkMode.StartsWith("container:", StringComparison.OrdinalIgnoreCase);

    private string NextGatewayName()
    {
        var count = InstalledVpnGateways.Count();
        return count == 0 ? "VPN Gateway" : $"VPN Gateway {count + 1}";
    }

    private string GetGatewayIdFromNetworkMode(string networkMode)
    {
        if (!IsVpnRoute(networkMode))
        {
            return string.Empty;
        }

        var containerName = networkMode["container:".Length..];
        return InstalledVpnGateways.FirstOrDefault(item => item.ContainerName.Equals(containerName, StringComparison.OrdinalIgnoreCase))?.Id.ToString() ?? string.Empty;
    }

    private string FormatGatewayLabel(string containerName)
    {
        if (string.IsNullOrWhiteSpace(containerName))
        {
            return "None";
        }

        var gateway = InstalledVpnGateways.FirstOrDefault(item => item.ContainerName.Equals(containerName, StringComparison.OrdinalIgnoreCase));
        return gateway is null ? containerName : $"{gateway.DisplayName} ({containerName})";
    }

    private static UiPillTone GetSecurityTone(string status) =>
        status.Equals("SECURED", StringComparison.OrdinalIgnoreCase)
            ? UiPillTone.Success
            : status is "BLOCKED" or "UNSAFE"
                ? UiPillTone.Failure
                : UiPillTone.Warning;

    private static string DescribeHealthCheck(HomeLabAppManifest app)
    {
        if (app.HealthCheck is null)
        {
            return "Container state fallback";
        }

        if (!string.IsNullOrWhiteSpace(app.HealthCheck.HttpPath))
        {
            return $"HTTP {app.HealthCheck.HttpPath} on port {app.HealthCheck.Port}";
        }

        if (!string.IsNullOrWhiteSpace(app.HealthCheck.DockerCommand))
        {
            return $"Docker command: {app.HealthCheck.DockerCommand}";
        }

        return "Container state fallback";
    }

    private async Task RunAsync(Guid installationId, HomeLabLifecycleAction action)
    {
        await RunUiOperationAsync(async () =>
        {
            var result = await HomeLabService.ExecuteAsync(installationId, action);
            SetMessage($"{result.Summary} {result.Detail}", !result.Succeeded);
        });
    }

    private async Task VerifySecurityAsync()
    {
        if (selectedInstallation is null || busy)
        {
            return;
        }

        busy = true;
        try
        {
            networkSecurity = await HomeLabService.GetNetworkSecurityAsync(selectedInstallation.Id);
            summaryNetworkSecurity[selectedInstallation.Id] = networkSecurity;
        }
        catch (Exception exception)
        {
            SetMessage(exception.Message, true);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task RunUiOperationAsync(Func<Task> operation)
    {
        if (busy) return;
        busy = true;
        try
        {
            await operation();
            workspace = await HomeLabService.GetWorkspaceAsync();
            await RefreshSummaryNetworkSecurityAsync();
            if (selectedInstallation is { } openInstallation)
            {
                selectedInstallation = workspace.Installations.FirstOrDefault(item => item.Id == openInstallation.Id);
                if (selectedInstallation is null)
                {
                    CloseDetails();
                }
                else
                {
                    networkSecurity = GetSummaryNetworkSecurity(selectedInstallation);
                    effectiveConfiguration = await HomeLabService.GetEffectiveConfigurationAsync(selectedInstallation.DeploymentId);
                }
            }
        }
        catch (Exception exception)
        {
            SetMessage(exception.Message, true);
        }
        finally
        {
            busy = false;
        }
    }

    private void SetMessage(string text, bool isError)
    {
        message = text;
        error = isError;
    }

    private static string FormatCategory(HomeLabAppCategory category) => category switch
    {
        HomeLabAppCategory.Infrastructure => "Infrastructure",
        HomeLabAppCategory.Download => "Download",
        HomeLabAppCategory.Media => "Media",
        HomeLabAppCategory.Automation => "Automation",
        HomeLabAppCategory.Photos => "Photos",
        _ => "Utilities"
    };

    private static UiPillTone GetHealthTone(HomeLabHealthState state) => state switch
    {
        HomeLabHealthState.Healthy => UiPillTone.Success,
        HomeLabHealthState.Starting => UiPillTone.Warning,
        HomeLabHealthState.Stopped => UiPillTone.Neutral,
        _ => UiPillTone.Failure
    };

    private string? BuildLocalUrl(HomeLabAppInstallation installation)
    {
        if (installation.CaddySourcePort is not int caddyPort || caddyPort <= 0)
        {
            return null;
        }

        if (!Uri.TryCreate(Navigation.BaseUri, UriKind.Absolute, out var baseUri) ||
            string.IsNullOrWhiteSpace(baseUri.Host))
        {
            return null;
        }

        return $"http://{baseUri.Host}:{caddyPort}";
    }
}
