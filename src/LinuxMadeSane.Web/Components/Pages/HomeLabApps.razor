@page "/home-lab/apps"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using LinuxMadeSane.Application.Contracts.Ai
@using LinuxMadeSane.Application.Contracts.EdgeGateway
@using LinuxMadeSane.Application.Contracts.HomeLab
@using LinuxMadeSane.Application.Interfaces
@using LinuxMadeSane.Core.Enums
@using LinuxMadeSane.Core.Models.HomeLab
@using Microsoft.Extensions.DependencyInjection
@inject IHomeLabService HomeLabService
@inject IEdgeGatewayService EdgeGatewayService
@inject IHomeLabPromptRecipeProvider PromptRecipeProvider
@inject IServiceScopeFactory ServiceScopeFactory
@inject IAiThreadService AiThreadService
@inject IAiChatService AiChatService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Home Lab | Linux Made Sane</PageTitle>

<div class="page-shell home-lab-page">
    <UiHeroPanel Eyebrow="Home Lab"
                  Title="Home Lab"
                  Description="Set up services with guided prompts, manage their Docker containers, and troubleshoot each container with AI."
                  Compact="true">
        <Actions>
            <UiCommandButton Label="@(backgroundRefreshInProgress ? "Refreshing..." : "Refresh")"
                             Glyph="UiIconGlyph.Refresh"
                             Variant="UiButtonVariant.Ghost"
                             Disabled="@(busy || backgroundRefreshInProgress)"
                             OnClick="RefreshAsync" />
        </Actions>
    </UiHeroPanel>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <p class="callout @(error ? "error" : "ready")">@message</p>
    }

    @if (workspace is null)
    {
        <UiPanel><p class="meta-text">Loading Home Lab...</p></UiPanel>
    }
    else
    {
        @if (renamingGateway is { } gatewayToRename)
        {
            <UiModal IsOpen="true"
                     Title="Rename VPN gateway"
                     Subtitle="This changes the name shown in Linux Made Sane. Docker networking and routed apps stay connected to the same gateway."
                     Class="home-lab-rename-modal"
                     OnClose="CancelGatewayRename">
                <ChildContent>
                    <section class="home-lab-rename-panel">
                        <div class="home-lab-config-field">
                            <label for="home-lab-gateway-name">Gateway name</label>
                            <input id="home-lab-gateway-name"
                                   class="ui-control-input"
                                   maxlength="160"
                                   value="@gatewayRenameValue"
                                   @oninput="eventArgs => gatewayRenameValue = eventArgs.Value?.ToString() ?? string.Empty"
                                   autofocus />
                            <span class="meta-text">Currently shown as @gatewayToRename.DisplayName.</span>
                        </div>
                        <div class="home-lab-rename-actions">
                            <UiCommandButton Label="Cancel"
                                             Glyph="UiIconGlyph.Clear"
                                             Variant="UiButtonVariant.Ghost"
                                             Disabled="@busy"
                                             OnClick="CancelGatewayRename" />
                            <UiCommandButton Label="Rename gateway"
                                             Glyph="UiIconGlyph.Edit"
                                             Variant="UiButtonVariant.PrimaryMuted"
                                             Disabled="@(busy || !CanRenameGateway)"
                                             OnClick="RenameGatewayAsync" />
                        </div>
                    </section>
                </ChildContent>
            </UiModal>
        }

        @if (pendingRemoval is { } installationToRemove)
        {
            <UiModal IsOpen="true"
                     Title="@($"Remove {installationToRemove.DisplayName}?")"
                     Subtitle="The Docker container and its LMS access routes will be removed. Persistent host data will be left in place."
                     Class="home-lab-confirm-modal"
                     OnClose="CancelRemoval">
                <ChildContent>
                    <section class="home-lab-confirm-panel">
                        <p>This action stops and removes <strong>@installationToRemove.DisplayName</strong>.</p>
                        <div class="home-lab-confirm-actions">
                            <UiCommandButton Label="Cancel" Glyph="UiIconGlyph.Clear" Variant="UiButtonVariant.Ghost" Disabled="@busy" OnClick="CancelRemoval" />
                            <UiCommandButton Label="Remove container" Glyph="UiIconGlyph.Delete" Variant="UiButtonVariant.Danger" Disabled="@busy" OnClick="ConfirmRemovalAsync" />
                        </div>
                    </section>
                </ChildContent>
            </UiModal>
        }

        <TabControl ActiveValue="@activeTab"
                    ActiveValueChanged="HandleTabChangedAsync"
                    Class="home-lab-tabs"
                    PanelClass="home-lab-tab-panel">
            <TabPage Value="apps" Title="Docker">
                @if (configuringApp is { } appToConfigure)
                {
                    <UiModal IsOpen="true"
                             Title="@(configuringInstallation is null ? $"Configure {appToConfigure.Name}" : $"Edit {configuringInstallation.DisplayName}")"
                             Subtitle="Container settings are applied by LMS. Secrets are stored securely and are not shown again."
                             Class="home-lab-settings-modal"
                             Resizable="true"
                             CloseOnBackdrop="false"
                             OnClose="CancelConfiguration">
                        <ChildContent>
                    <section class="home-lab-config-panel">
                        <div class="home-lab-config-heading">
                            <div>
                                <p class="eyebrow">Installation settings</p>
                                <h2>@(configuringInstallation is null ? $"Configure {appToConfigure.Name}" : $"Edit {configuringInstallation.DisplayName}")</h2>
                                <p class="meta-text">These values are applied to the Docker container. Secret fields are stored by LMS and are not shown again.</p>
                            </div>
                            <UiCommandButton Label="Cancel" Glyph="UiIconGlyph.Clear" Variant="UiButtonVariant.Ghost" Disabled="@busy" OnClick="CancelConfiguration" />
                        </div>
                        <div class="home-lab-config-grid">
                            @foreach (var field in appToConfigure.ConfigurationSchema.Where(ShouldShowConfigurationField))
                            {
                                <div class="@GetConfigurationFieldClass(field)">
                                    <label for="home-lab-@field.Id">@field.Label</label>
                                    @if (field.Type.Equals("select", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <select id="home-lab-@field.Id" class="ui-control-input" value="@GetConfigurationValue(field.Id)" @onchange="eventArgs => SetConfigurationValue(field.Id, eventArgs.Value?.ToString())">
                                            <option value="">Choose...</option>
                                            @if (field.Id.Equals("vpn-gateway", StringComparison.OrdinalIgnoreCase))
                                            {
                                                @foreach (var gateway in InstalledVpnGateways)
                                                {
                                                    <option value="@gateway.Id">@gateway.DisplayName (@gateway.HealthState)</option>
                                                }
                                            }
                                            else
                                            {
                                                @foreach (var option in GetConfigurationFieldOptions(field))
                                                {
                                                    <option value="@option">@option</option>
                                                }
                                            }
                                        </select>
                                    }
                                    else if (field.Type.Equals("secret-textarea", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <textarea id="home-lab-@field.Id"
                                                  class="ui-control-input ui-control-textarea"
                                                  rows="8"
                                                  autocomplete="off"
                                                  @oninput="eventArgs => SetConfigurationValue(field.Id, eventArgs.Value?.ToString(), true)">@GetSecretConfigurationValue(field.Id)</textarea>
                                    }
                                    else
                                    {
                                        <input id="home-lab-@field.Id"
                                               class="ui-control-input"
                                               type="@(field.Secret ? "password" : "text")"
                                               value="@(field.Secret ? GetSecretConfigurationValue(field.Id) : GetConfigurationValue(field.Id))"
                                               autocomplete="@(field.Secret ? "new-password" : "off")"
                                               @oninput="eventArgs => SetConfigurationValue(field.Id, eventArgs.Value?.ToString(), field.Secret)" />
                                    }
                                    @if (!string.IsNullOrWhiteSpace(field.Help))
                                    {
                                        <span class="meta-text">@GetConfigurationFieldHelp(field)</span>
                                    }
                                </div>
                            }
                        </div>
                        <div class="home-lab-config-footer">
                            <span class="meta-text">VPN routing and the kill switch are applied by the selected gateway.</span>
                            <UiCommandButton Label="@(configuringInstallation is null ? "Install configured app" : "Save gateway")" Glyph="UiIconGlyph.Save" Variant="UiButtonVariant.Primary" Disabled="@busy" OnClick="InstallConfiguredAsync" />
                        </div>
                    </section>
                        </ChildContent>
                    </UiModal>
                }

                @if (selectedInstallation is not null && effectiveConfiguration is not null)
                {
                    var selectedDetails = effectiveConfiguration.Containers.FirstOrDefault(item => item.AppId.Equals(selectedInstallation.AppId, StringComparison.OrdinalIgnoreCase));
                    if (selectedDetails is not null)
                    {
                        <UiModal IsOpen="true"
                                 Title="@($"Settings · {selectedInstallation.DisplayName}")"
                                 Subtitle="View and edit this LMS-managed Docker container. Secrets remain protected."
                                 Class="home-lab-settings-modal"
                                 Resizable="true"
                                 CloseOnBackdrop="false"
                                 OnClose="CloseDetails">
                            <ChildContent>
                                <section class="home-lab-details-panel">
                                    <div class="home-lab-details-heading">
                                        <div>
                                            <p class="eyebrow">Container settings</p>
                                            <h2>@selectedInstallation.DisplayName</h2>
                                        </div>
                                        <UiCommandButton Label="Close" Glyph="UiIconGlyph.Clear" Variant="UiButtonVariant.Ghost" Disabled="@busy" OnClick="CloseDetails" />
                                    </div>

                                    <TabControl ActiveValue="@settingsTab"
                                                ActiveValueChanged="HandleSettingsTabChangedAsync"
                                                Class="home-lab-settings-tabs"
                                                PanelClass="home-lab-settings-tab-panel">
                                        <TabPage Value="overview" Title="Overview">
                                            <div class="home-lab-settings-overview">
                                                <div class="home-lab-detail-block">
                                                    <h3>Health</h3>
                                                    <dl class="home-lab-detail-list home-lab-detail-definition-list">
                                                        <dt>Status</dt><dd><UiPill Tone="@GetHealthTone(selectedInstallation.HealthState)">@selectedInstallation.HealthState</UiPill></dd>
                                                        <dt>Detail</dt><dd>@selectedInstallation.HealthDetail</dd>
                                                        <dt>Container</dt><dd><code>@selectedDetails.ContainerName</code></dd>
                                                        <dt>Definition</dt><dd><code>@GetApp(selectedDetails.AppId).DefinitionVersion</code></dd>
                                                        <dt>Health check</dt><dd>@DescribeHealthCheck(GetApp(selectedDetails.AppId))</dd>
                                                    </dl>
                                                </div>
                                                <div class="home-lab-detail-block">
                                                    <h3>Access</h3>
                                                    <ul class="home-lab-detail-list">
                                                        @foreach (var item in selectedDetails.Access)
                                                        {
                                                            <li><code>@item</code></li>
                                                        }
                                                    </ul>
                                                </div>
                                                <div class="home-lab-detail-block">
                                                    <h3>Files</h3>
                                                    <p class="meta-text">Configuration and shared data are grouped under this container's named folder.</p>
                                                    <code>@GetContainerFilesPath(selectedInstallation)</code>
                                                    <UiCommandButton Label="Browse files"
                                                                     Glyph="UiIconGlyph.FolderOpen"
                                                                     Variant="UiButtonVariant.ActionSubtle"
                                                                     Href="@BuildHomeLabFilesUrl(selectedInstallation)"
                                                                     Target="@BuildHomeLabFilesPopupName(selectedInstallation)"
                                                                     Rel="noopener"
                                                                     OnClientPointerDown="@BuildHomeLabFilesPopupPrepareScript(selectedInstallation)"
                                                                     OnClientClick="@BuildHomeLabFilesPopupOpenScript()" />
                                                </div>
                                                <div class="home-lab-detail-block">
                                                    <h3>Dependencies</h3>
                                                    @if (selectedDetails.Dependencies.Count == 0)
                                                    {
                                                        <p class="meta-text">None.</p>
                                                    }
                                                    else
                                                    {
                                                        <ul class="home-lab-detail-list">
                                                            @foreach (var dependency in selectedDetails.Dependencies)
                                                            {
                                                                <li>@GetApp(dependency).Name</li>
                                                            }
                                                        </ul>
                                                    }
                                                </div>
                                            </div>
                                        </TabPage>

                                        @if (!IsVpnGateway(selectedInstallation))
                                        {
                                        <TabPage Value="connections" Title="Connections">
                                            <div class="home-lab-settings-stack">
                                                <div class="home-lab-connection-intro">
                                                    <strong>Addresses to use inside @selectedInstallation.DisplayName</strong>
                                                    <span>Copy these values into this app when it asks for another LMS-managed service. Do not use a Docker IP or the browser Open address; Docker IPs change and browser routes are intended for people.</span>
                                                </div>
                                                @if (connectionGuide is null)
                                                {
                                                    <p class="meta-text">Loading connection addresses...</p>
                                                }
                                                else if (connectionGuide.Addresses.Count == 0)
                                                {
                                                    <div class="home-lab-setting-card">
                                                        <strong>No connected app endpoints were found.</strong>
                                                        <span class="meta-text">Run related apps from one recipe or route them through the same VPN Gateway so LMS can provide a stable internal address.</span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    @foreach (var connection in connectionGuide.Addresses)
                                                    {
                                                        <div class="home-lab-connection-card">
                                                            <div class="home-lab-connection-heading">
                                                                <div>
                                                                    <strong>@connection.TargetName</strong>
                                                                    <span>@connection.Purpose</span>
                                                                </div>
                                                                <UiPill Tone="@(connection.IsReachable ? UiPillTone.Success : UiPillTone.Warning)">@(connection.IsReachable ? "Ready" : "Network change needed")</UiPill>
                                                            </div>
                                                            @if (connection.IsReachable)
                                                            {
                                                                <div class="home-lab-connection-value">
                                                                    <code>@connection.Url</code>
                                                                    <UiCommandButton Label="Copy address"
                                                                                     Glyph="UiIconGlyph.Copy"
                                                                                     Variant="UiButtonVariant.ActionSubtle"
                                                                                     OnClick="() => CopyConnectionAddressAsync(connection)" />
                                                                </div>
                                                            }
                                                            <dl class="home-lab-detail-list home-lab-detail-definition-list home-lab-connection-details">
                                                                @if (connection.IsReachable)
                                                                {
                                                                    <dt>Host</dt><dd><code>@connection.Host</code></dd>
                                                                    <dt>Port</dt><dd><code>@connection.Port</code></dd>
                                                                }
                                                                <dt>Network path</dt><dd>@connection.NetworkPath</dd>
                                                                <dt>Extra port mapping</dt><dd>@connection.PortMapping</dd>
                                                            </dl>
                                                            <p class="meta-text">@connection.Detail</p>
                                                        </div>
                                                    }
                                                }
                                                <p class="meta-text">The address establishes the network connection. If the target app requires an API key or login, obtain that value from the target app itself.</p>
                                            </div>
                                        </TabPage>
                                        }

                                        <TabPage Value="network" Title="Network">
                                            <div class="home-lab-settings-stack">
                                                <div class="home-lab-setting-card">
                                                    <div class="home-lab-details-heading">
                                                        <div>
                                                            <h3>Network status</h3>
                                                            <p class="meta-text">Live routing information for this container.</p>
                                                        </div>
                                                        <UiPill Tone="@GetCompactNetworkTone(selectedInstallation)">@GetCompactNetworkState(selectedInstallation)</UiPill>
                                                    </div>
                                                    @if (networkSecurity is { } security)
                                                    {
                                                        <dl class="home-lab-detail-list home-lab-detail-definition-list">
                                                            <dt>Route</dt><dd>@GetNetworkRouteLabel(selectedInstallation)</dd>
                                                            <dt>Public IP</dt><dd><code>@(security.PublicIp ?? "Unavailable")</code></dd>
                                                            <dt>Gateway health</dt><dd>@security.GatewayHealth</dd>
                                                            @if (selectedDetails.AppId.Equals("qbittorrent", StringComparison.OrdinalIgnoreCase))
                                                            {
                                                                <dt>Incoming peer port</dt><dd>@(security.PortForwardingStatus ?? "Unverified")@(security.ForwardedPort is int forwardedPort ? $" · {forwardedPort}" : string.Empty)</dd>
                                                            }
                                                            <dt>Checked</dt><dd>@security.CheckedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</dd>
                                                        </dl>
                                                    }
                                                    <UiCommandButton Label="Check now"
                                                                     Glyph="UiIconGlyph.Refresh"
                                                                     Variant="UiButtonVariant.ActionSubtle"
                                                                     Disabled="@busy"
                                                                     OnClick="VerifySecurityAsync" />
                                                </div>

                                                @if (IsVpnGateway(selectedInstallation))
                                                {
                                                    <div class="home-lab-setting-card">
                                                        <h3>VPN gateway</h3>
                                                        <dl class="home-lab-detail-list home-lab-detail-definition-list">
                                                            <dt>Name</dt><dd>@selectedInstallation.DisplayName</dd>
                                                            <dt>Provider</dt><dd>@FormatProvider(GetEffectiveEnvironmentValue(selectedDetails, "VPN_SERVICE_PROVIDER"))</dd>
                                                            <dt>Protocol</dt><dd>@FormatProtocol(GetEffectiveEnvironmentValue(selectedDetails, "VPN_TYPE"))</dd>
                                                        </dl>
                                                        <div class="home-lab-action-row">
                                                            <UiCommandButton Label="Edit VPN settings" Glyph="UiIconGlyph.Edit" Variant="UiButtonVariant.ActionSubtle" Disabled="@busy" OnClick="BeginVpnReconfiguration" />
                                                            <UiCommandButton Label="Rename gateway" Glyph="UiIconGlyph.Edit" Variant="UiButtonVariant.Ghost" Disabled="@busy" OnClick="() => BeginGatewayRename(selectedInstallation)" />
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </TabPage>

                                        <TabPage Value="external" Title="External access">
                                            <div class="home-lab-settings-stack">
                                                @if (!GetApp(selectedInstallation.AppId).EdgeGatewaySupported)
                                                {
                                                    <div class="home-lab-setting-card">
                                                        <h3>External access unavailable</h3>
                                                        <p class="meta-text">This service cannot be published through LMS Edge Gateway.</p>
                                                    </div>
                                                }
                                                else
                                                {
                                                    var externalRoute = GetExternalRoute(selectedInstallation);
                                                    var publicEndpoint = selectedInstallation.ServiceEndpoints?.FirstOrDefault(endpoint => endpoint.Scope == HomeLabEndpointScope.Public);
                                                    <div class="home-lab-setting-card">
                                                        <div class="home-lab-details-heading">
                                                            <div>
                                                                <h3>Edge Gateway publishing</h3>
                                                                <p class="meta-text">Choose exactly which Home Lab services are reachable externally and how Edge Gateway protects them.</p>
                                                            </div>
                                                            <UiPill Tone="@(externalRoute is { Enabled: true } ? UiPillTone.Success : UiPillTone.Neutral)">@(externalRoute is { Enabled: true } ? "Published" : "Local only")</UiPill>
                                                        </div>

                                                        @if (externalRoute is { Enabled: true } && publicEndpoint is not null)
                                                        {
                                                            <dl class="home-lab-detail-list home-lab-detail-definition-list">
                                                                <dt>External URL</dt><dd><a href="@publicEndpoint.Url" target="_blank" rel="noopener">@publicEndpoint.Url</a></dd>
                                                                <dt>Protection</dt><dd>@FormatExternalAuthMode(externalRoute.AuthMode)</dd>
                                                                <dt>Endpoint health</dt><dd>@publicEndpoint.HealthState — @publicEndpoint.HealthDetail</dd>
                                                            </dl>
                                                            <UiCommandButton Label="Test endpoint"
                                                                             Glyph="UiIconGlyph.Refresh"
                                                                             Variant="UiButtonVariant.ActionSubtle"
                                                                             Disabled="@busy"
                                                                             OnClick="TestSelectedEndpointAsync" />
                                                        }

                                                        @if (AvailableExternalDomains.Count == 0)
                                                        {
                                                            <p class="meta-text">Set up a Cloudflare domain and relay in Edge Gateway before publishing this service.</p>
                                                            <UiCommandButton Label="Open Edge Gateway"
                                                                             Glyph="UiIconGlyph.Website"
                                                                             Variant="UiButtonVariant.ActionSubtle"
                                                                             Href="/edge-gateway" />
                                                        }
                                                        else
                                                        {
                                                            <div class="home-lab-config-grid">
                                                                <div class="home-lab-config-field">
                                                                    <label for="home-lab-external-hostname">External hostname</label>
                                                                    <input id="home-lab-external-hostname"
                                                                           class="ui-control-input"
                                                                           value="@externalHostnameDraft"
                                                                           disabled="@(externalRoute is { Enabled: true })"
                                                                           @oninput="eventArgs => externalHostnameDraft = eventArgs.Value?.ToString() ?? string.Empty" />
                                                                    <span class="meta-text">@(externalRoute is { Enabled: true } ? "Remove external access before changing the hostname." : "Use a new hostname inside the selected Cloudflare zone.")</span>
                                                                </div>
                                                                <div class="home-lab-config-field">
                                                                    <label for="home-lab-external-domain">Cloudflare zone</label>
                                                                    <select id="home-lab-external-domain"
                                                                            class="ui-control-input"
                                                                            value="@externalDomainDraft"
                                                                            disabled="@(externalRoute is { Enabled: true })"
                                                                            @onchange="ChangeExternalDomain">
                                                                        @foreach (var domain in AvailableExternalDomains)
                                                                        {
                                                                            <option value="@domain.DomainName">@domain.DomainName</option>
                                                                        }
                                                                    </select>
                                                                </div>
                                                                <div class="home-lab-config-field">
                                                                    <label for="home-lab-external-auth">Protection</label>
                                                                    <select id="home-lab-external-auth"
                                                                            class="ui-control-input"
                                                                            value="@externalAuthModeDraft"
                                                                            @onchange="ChangeExternalAuthMode">
                                                                        <option value="@EdgeGatewayAuthMode.RequireMfa">LMS MFA / passkey</option>
                                                                        <option value="@EdgeGatewayAuthMode.TemporaryIpApproval">Email approve IP</option>
                                                                        <option value="@EdgeGatewayAuthMode.PassThrough">Pass through to app</option>
                                                                    </select>
                                                                    <span class="meta-text">Use pass-through only when the app must handle native clients or provides its own suitable login.</span>
                                                                </div>
                                                            </div>
                                                            <div class="home-lab-setting-card">
                                                                <strong>Public address</strong>
                                                                <code>@BuildExternalPreview()</code>
                                                            </div>
                                                            <div class="home-lab-action-row">
                                                                <UiCommandButton Label="@(externalRoute is null ? "Publish externally" : "Save external access")"
                                                                                 Glyph="UiIconGlyph.Website"
                                                                                 Variant="UiButtonVariant.Primary"
                                                                                 Disabled="@(busy || !CanSaveExternalAccess)"
                                                                                 OnClick="SaveExternalAccessAsync" />
                                                                @if (selectedInstallation.EdgeGatewayRouteId.HasValue)
                                                                {
                                                                    <UiCommandButton Label="Remove external access"
                                                                                     Glyph="UiIconGlyph.Delete"
                                                                                     Variant="UiButtonVariant.Danger"
                                                                                     Disabled="@busy"
                                                                                     OnClick="RequestExternalUnpublish" />
                                                                }
                                                            </div>
                                                        }
                                                    </div>

                                                    @if (confirmExternalUnpublish)
                                                    {
                                                        <div class="home-lab-setting-card">
                                                            <strong>Remove external access?</strong>
                                                            <p class="meta-text">LMS will remove the app's managed DNS record, tunnel ingress, and Edge Gateway route. Local access remains available.</p>
                                                            <div class="home-lab-action-row">
                                                                <UiCommandButton Label="Cancel" Glyph="UiIconGlyph.Clear" Variant="UiButtonVariant.Ghost" Disabled="@busy" OnClick="CancelExternalUnpublish" />
                                                                <UiCommandButton Label="Remove external access" Glyph="UiIconGlyph.Delete" Variant="UiButtonVariant.Danger" Disabled="@busy" OnClick="UnpublishExternalAccessAsync" />
                                                            </div>
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        </TabPage>

                                        <TabPage Value="container" Title="Container">
                                            <div class="home-lab-container-editor">
                                                <div class="home-lab-config-field">
                                                    <label for="home-lab-container-image">Docker image</label>
                                                    <input id="home-lab-container-image" class="ui-control-input" @bind="containerImageDraft" @bind:event="oninput" />
                                                </div>
                                                <div class="home-lab-config-field">
                                                    <label for="home-lab-container-environment">Environment</label>
                                                    <textarea id="home-lab-container-environment" class="ui-control-textarea home-lab-code-editor" @bind="containerEnvironmentDraft" @bind:event="oninput"></textarea>
                                                    <span class="meta-text">One KEY=value entry per line. Protected secrets and LMS-managed routing values are excluded.</span>
                                                </div>
                                                <div class="home-lab-config-field">
                                                    <label for="home-lab-container-volumes">Volume mappings</label>
                                                    <textarea id="home-lab-container-volumes" class="ui-control-textarea home-lab-code-editor" @bind="containerVolumesDraft" @bind:event="oninput"></textarea>
                                                    <span class="meta-text">One absolute host:container mapping per line. Add :ro for read-only mounts.</span>
                                                </div>
                                                <div class="home-lab-setting-card">
                                                    <h3>Published ports</h3>
                                                    <code>@(selectedDetails.Ports.Count == 0 ? "None" : string.Join(Environment.NewLine, selectedDetails.Ports))</code>
                                                    <p class="meta-text">LMS manages published ports and checks every shared VPN namespace for collisions.</p>
                                                </div>
                                                <div class="home-lab-config-footer">
                                                    <span class="meta-text">Saving recreates the container with these values. Use AI Help if an edited container does not start.</span>
                                                    <div class="home-lab-action-row">
                                                        @if (selectedDetails.HasCustomSettings)
                                                        {
                                                            <UiCommandButton Label="Restore pre-edit settings" Glyph="UiIconGlyph.Repair" Variant="UiButtonVariant.ActionSubtle" Disabled="@busy" OnClick="RestoreContainerSettingsAsync" />
                                                        }
                                                        <UiCommandButton Label="Reset edits" Glyph="UiIconGlyph.Refresh" Variant="UiButtonVariant.Ghost" Disabled="@busy" OnClick="ResetContainerSettingsDraft" />
                                                        <UiCommandButton Label="Save and recreate" Glyph="UiIconGlyph.Save" Variant="UiButtonVariant.Primary" Disabled="@busy" OnClick="SaveContainerSettingsAsync" />
                                                    </div>
                                                </div>
                                            </div>
                                        </TabPage>

                                        <TabPage Value="logs" Title="Logs">
                                            <div class="home-lab-settings-stack">
                                                @if (selectedDetails.AppId.Equals("qbittorrent", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <div class="home-lab-setting-card">
                                                        <h3>qBittorrent direct login</h3>
                                                        <p class="meta-text">Username: <code>admin</code>. The LMS Open link uses the trusted local route.</p>
                                                        @if (TryGetTemporaryPassword() is { } temporaryPassword)
                                                        {
                                                            <label class="home-lab-password-label" for="qbittorrent-temporary-password">Current temporary password</label>
                                                            <input id="qbittorrent-temporary-password" class="ui-control-input home-lab-password-field" value="@temporaryPassword" readonly />
                                                        }
                                                        <UiCommandButton Label="Reset to temporary password" Glyph="UiIconGlyph.Restart" Variant="UiButtonVariant.ActionSubtle" Disabled="@busy" OnClick="ResetSelectedCredentialsAsync" />
                                                    </div>
                                                }
                                                <div class="home-lab-setting-card">
                                                    <div class="home-lab-logs-heading">
                                                        <div>
                                                            <h3>Container logs</h3>
                                                            <p class="meta-text">Startup, health, and application output.</p>
                                                        </div>
                                                        <UiCommandButton Label="Refresh logs" Glyph="UiIconGlyph.Terminal" Variant="UiButtonVariant.Ghost" Disabled="@busy" OnClick="LoadSelectedLogsAsync" />
                                                    </div>
                                                    @if (selectedLogs is null)
                                                    {
                                                        <p class="meta-text">Select Refresh logs to load the latest output.</p>
                                                    }
                                                    else
                                                    {
                                                        <pre class="home-lab-detail-code home-lab-logs">@selectedLogs</pre>
                                                    }
                                                </div>
                                            </div>
                                        </TabPage>
                                    </TabControl>
                                </section>
                            </ChildContent>
                        </UiModal>
                    }
                }

                <section class="surface-subcard home-lab-docker-heading">
                    <div>
                        <p class="eyebrow">Managed Docker</p>
                        <h2>Installed containers</h2>
                        <p class="meta-text">Use AI Help on a container to inspect its health, LMS Caddy route, dependencies, and Docker networking, then approve a repair if one is needed.</p>
                    </div>
                    <UiCommandButton Label="Add VPN Gateway"
                                     Title="Install another independently configured VPN gateway"
                                     Glyph="UiIconGlyph.Plus"
                                     Variant="UiButtonVariant.PrimaryMuted"
                                     Disabled="@busy"
                                     OnClick='() => InstallAsync(GetApp("vpn-gateway"))' />
                </section>

                <div class="surface-card home-lab-app-list">
                    <div class="home-lab-app-list-header">
                        <span>Container</span>
                        <span>VPN</span>
                        <span>Status</span>
                        <span>Actions</span>
                    </div>
                    @if (workspace.Installations.Count == 0)
                    {
                        <div class="home-lab-empty-state">
                            <strong>No Docker containers have been set up yet.</strong>
                            <span>Use a HomeLab Recipe, enter your own request, or add a VPN Gateway.</span>
                        </div>
                    }
                    @foreach (var group in BuildInstallationGroups())
                    {
                        var expanded = !collapsedInstallationGroups.Contains(group.Key);
                        <button type="button"
                                class="home-lab-installation-group-heading"
                                aria-expanded="@expanded"
                                aria-controls="@($"home-lab-installation-group-{group.Key}")"
                                @onclick="() => ToggleInstallationGroup(group.Key)">
                            <span class="home-lab-installation-group-toggle" aria-hidden="true">@(expanded ? "−" : "+")</span>
                            <span class="home-lab-installation-group-name">
                                <strong>@group.Name</strong>
                                <span>@group.Detail</span>
                            </span>
                            <span class="home-lab-installation-group-count">@FormatContainerCount(group.Installations.Count)</span>
                        </button>
                        @if (expanded)
                        {
                            <div id="@($"home-lab-installation-group-{group.Key}")" class="home-lab-installation-group-rows">
                            @foreach (var installation in group.Installations)
                            {
                                var app = GetApp(installation.AppId);
                                <div class="home-lab-app-row">
                                    <div class="home-lab-app-name">
                                        <strong>@installation.DisplayName</strong>
                                        <span>@app.Description</span>
                                    </div>
                                    <div class="home-lab-network-compact">
                                        @if (app.SupportsVpnGateway)
                                        {
                                            <select class="ui-control-input home-lab-route-select"
                                                    aria-label="Internet route for @installation.DisplayName"
                                                    value="@GetRouteSelection(installation)"
                                                    disabled="@busy"
                                                    @onchange="eventArgs => ChangeSummaryRouteAsync(installation, eventArgs.Value?.ToString())">
                                                <option value="direct" disabled="@app.RequiresVpnGateway">Direct (no VPN)</option>
                                                @foreach (var gateway in InstalledVpnGateways)
                                                {
                                                    <option value="@gateway.Id">@gateway.DisplayName</option>
                                                }
                                            </select>
                                            <UiPill Tone="@GetCompactNetworkTone(installation)">@GetCompactNetworkState(installation)</UiPill>
                                        }
                                        else if (IsVpnGateway(installation))
                                        {
                                            <UiPill Tone="@GetCompactNetworkTone(installation)">VPN Gateway</UiPill>
                                        }
                                        else
                                        {
                                            <UiPill Tone="@UiPillTone.Neutral">Direct</UiPill>
                                        }
                                    </div>
                                    <UiPill Tone="@GetHealthTone(installation.HealthState)">@installation.HealthState</UiPill>
                                    <div class="home-lab-row-actions">
                                        @if (BuildOpenUrl(installation) is { } openUrl)
                                        {
                                            <UiCommandButton Label="Open"
                                                             Glyph="UiIconGlyph.Website"
                                                             Variant="UiButtonVariant.Action"
                                                             Href="@openUrl"
                                                             Target="_blank"
                                                             Rel="noopener"
                                                             referrerpolicy="@(installation.AppId.Equals("qbittorrent", StringComparison.OrdinalIgnoreCase) ? "no-referrer" : null)" />
                                        }
                                        <UiCommandButton Label="AI Help"
                                                         Title="Open a troubleshooting chat for this Docker container"
                                                         Glyph="UiIconGlyph.Ai"
                                                         Variant="UiButtonVariant.PrimaryMuted"
                                                         Disabled="@(busy || startingPromptRecipeId is not null)"
                                                         OnClick="() => StartContainerHelpAsync(installation)" />
                                        <UiCommandButton Label="Settings"
                                                         Glyph="UiIconGlyph.Edit"
                                                         Variant="UiButtonVariant.Ghost"
                                                         Disabled="@busy"
                                                         OnClick="() => ManageAsync(installation)" />
                                        <select class="ui-control-input home-lab-action-select"
                                                aria-label="Actions for @installation.DisplayName"
                                                value=""
                                                disabled="@busy"
                                                @onchange="eventArgs => HandleContainerActionAsync(installation, eventArgs.Value?.ToString())">
                                            <option value="">Actions...</option>
                                            <option value="start">Start</option>
                                            <option value="stop">Stop</option>
                                            <option value="restart">Restart</option>
                                            @if (CanRepair(installation))
                                            {
                                                <option value="repair">Repair</option>
                                            }
                                            <option value="update">Update</option>
                                            @if (IsVpnGateway(installation))
                                            {
                                                <option value="rename">Rename</option>
                                                <option value="vpn-settings">VPN settings</option>
                                            }
                                            <option value="remove">Remove...</option>
                                        </select>
                                    </div>
                                </div>
                            }
                            </div>
                        }
                    }
                </div>
            </TabPage>

            <TabPage Value="prompts" Title="HomeLab Recipes">
                <section class="surface-subcard home-lab-prompt-intro">
                    <div>
                        <p class="eyebrow">Guided AI deployments</p>
                        <h2>Start with a HomeLab Recipe, then make it yours</h2>
                        <p class="meta-text">Choose a category, then a recipe from the public Linux Made Sane GitHub catalog. Review what LMS will do, add any precise requirements, then select Go.</p>
                    </div>
                </section>
                <section class="surface-card home-lab-recipe-selector">
                    <div class="home-lab-recipe-steps">
                        <div class="home-lab-recipe-choice">
                            <label for="home-lab-recipe-category">1. Category</label>
                            <select id="home-lab-recipe-category"
                                    class="ui-control-input"
                                    value="@selectedRecipeCategory"
                                    @onchange="SelectPromptRecipeCategory">
                                <option value="">Choose a category...</option>
                                @foreach (var category in RecipeCategories)
                                {
                                    <option value="@category">@category</option>
                                }
                                <option value="custom">Enter your own</option>
                            </select>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(selectedRecipeCategory) &&
                             !selectedRecipeCategory.Equals("custom", StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="home-lab-recipe-choice">
                                <label for="home-lab-prompt-recipe">2. Recipe</label>
                                <select id="home-lab-prompt-recipe"
                                        class="ui-control-input"
                                        value="@selectedPromptRecipeId"
                                        @onchange="SelectPromptRecipe">
                                    <option value="">Choose a recipe...</option>
                                    @foreach (var promptRecipe in RecipesInSelectedCategory)
                                    {
                                        <option value="@promptRecipe.Id">@promptRecipe.Name</option>
                                    }
                                </select>
                            </div>
                        }
                    </div>

                    @if (customizingPromptRecipe is { } selectedRecipe)
                    {
                        <div class="home-lab-selected-recipe">
                            <div class="home-lab-recipe-summary">
                                <div>
                                    <p class="eyebrow">@selectedRecipe.Category</p>
                                    <h3>@selectedRecipe.Name</h3>
                                    <p>@selectedRecipe.Description</p>
                                </div>
                                <dl class="home-lab-recipe-summary-facts">
                                    <div>
                                        <dt>What LMS will do</dt>
                                        <dd>@(selectedRecipe.RequiresPlanning
                                            ? "Open a guided AI plan, collect the choices this setup needs, and identify what LMS can deploy safely."
                                            : "Open a guided AI task, inspect the current HomeLab, confirm your requirements, and deploy the supported stack.")</dd>
                                    </div>
                                    <div>
                                        <dt>Network</dt>
                                        <dd>@(selectedRecipe.RequiresVpnGateway
                                            ? "Reuse an existing VPN Gateway and route only the apps defined by this recipe."
                                            : "Use LMS-managed local access unless you add different requirements below.")</dd>
                                    </div>
                                </dl>
                            </div>
                            <strong class="home-lab-recipe-field-label">@(selectedRecipe.RequiresPlanning ? "Recipe components" : "Apps being deployed")</strong>
                            <div class="home-lab-recipe-apps" aria-label="Recipe components">
                                @foreach (var component in selectedRecipe.Components)
                                {
                                    <span>@component</span>
                                }
                                @if (selectedRecipe.RequiresVpnGateway)
                                {
                                    <span>Existing VPN Gateway</span>
                                }
                            </div>
                            @if (selectedRecipe.RequiresPlanning)
                            {
                                <p class="meta-text">This recipe needs choices from you before LMS can safely deploy it. The AI will identify supported parts and will not install a misleading partial stack.</p>
                            }
                            <label for="home-lab-recipe-prompt">Base recipe prompt</label>
                            <textarea id="home-lab-recipe-prompt"
                                      class="ui-control-textarea"
                                      @bind="recipePromptDraft"
                                      @bind:event="oninput"></textarea>
                            <p class="meta-text">Add versions, variants, databases, admin tools, domains, storage, or other requirements. The AI will explain unsupported details before proposing changes.</p>
                            <div class="home-lab-prompt-actions">
                                <UiCommandButton Label="Reset base prompt"
                                                 Glyph="UiIconGlyph.Refresh"
                                                 Variant="UiButtonVariant.ActionSubtle"
                                                 Disabled="@(startingPromptRecipeId is not null)"
                                                 OnClick="ResetPromptRecipeDraft" />
                                <UiCommandButton Label="Go"
                                                 Glyph="UiIconGlyph.Ai"
                                                 Variant="UiButtonVariant.PrimaryMuted"
                                                 Disabled="@(startingPromptRecipeId is not null || string.IsNullOrWhiteSpace(recipePromptDraft))"
                                                 OnClick="StartPromptRecipeAsync" />
                            </div>
                        </div>
                    }
                    else if (selectedPromptRecipeId.Equals("custom", StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="home-lab-selected-recipe">
                            <div>
                                <p class="eyebrow">Enter your own</p>
                                <h2>Enter the apps you would like made available by LMS</h2>
                            </div>
                            <textarea id="home-lab-custom-prompt"
                                      class="ui-control-textarea"
                                      @bind="customPrompt"
                                      @bind:event="oninput"
                                      placeholder="For example: WordPress, a database, and a database administration tool"></textarea>
                            <UiCommandButton Label="Go"
                                             Glyph="UiIconGlyph.Ai"
                                             Variant="UiButtonVariant.PrimaryMuted"
                                             Disabled="@(busy || startingPromptRecipeId is not null || string.IsNullOrWhiteSpace(customPrompt))"
                                             OnClick="StartCustomPromptAsync" />
                        </div>
                    }
                </section>
            </TabPage>

            <TabPage Value="storage" Title="Storage">
                <section class="surface-subcard home-lab-storage-panel">
                    <div>
                        <p class="eyebrow">HomeLab app files</p>
                        <h2>One clear folder for every container</h2>
                        <p class="meta-text">Each container gets a folder named after the Docker container. Its configuration and shared-data mounts appear inside, so you never need to find a deployment ID.</p>
                    </div>
                    <div class="home-lab-storage-row">
                        <label for="storage-home-lab">HomeLab files</label>
                        <input id="storage-home-lab" class="ui-control-input" @bind="storagePaths[HomeLabFilesRole]" placeholder="/mnt/storage/home-lab" />
                        <div class="home-lab-storage-actions">
                            <UiCommandButton Label="Save" Glyph="UiIconGlyph.Save" Variant="UiButtonVariant.ActionSubtle" Disabled="@busy" OnClick="() => SaveStorageRoleAsync(HomeLabFilesRole)" />
                            <UiCommandButton Label="Browse all files"
                                             Glyph="UiIconGlyph.FolderOpen"
                                             Variant="UiButtonVariant.Action"
                                             Href="@BuildHomeLabFilesUrl()"
                                             Target="@BuildHomeLabFilesPopupName()"
                                             Rel="noopener"
                                             OnClientPointerDown="@BuildHomeLabFilesPopupPrepareScript()"
                                             OnClientClick="@BuildHomeLabFilesPopupOpenScript()" />
                        </div>
                    </div>
                </section>
                <section class="surface-subcard home-lab-storage-panel">
                    <div>
                        <p class="eyebrow">Container storage access</p>
                        <h2>Use the same paths in every container</h2>
                        <p class="meta-text">LMS mounts <code>/mnt/storage</code> at <code>/storage</code> inside every HomeLab container. A network share mounted at <code>/mnt/storage/network/nas-media</code> is therefore available to apps at <code>/storage/network/nas-media</code>.</p>
                        <p class="meta-text">Live mount propagation is enabled from host to container, so network shares added beneath <code>/mnt/storage</code> appear without another container restart.</p>
                    </div>
                    <div class="home-lab-action-row">
                        <UiCommandButton Label="Apply to containers"
                                         Glyph="UiIconGlyph.NetworkMount"
                                         Variant="UiButtonVariant.PrimaryMuted"
                                         Disabled="@busy"
                                         OnClick="ApplyStandardStorageAsync" />
                    </div>
                </section>
                <section class="surface-subcard home-lab-storage-panel">
                    <div>
                        <p class="eyebrow">Shared storage roles</p>
                        <h2>Choose host locations once</h2>
                        <p class="meta-text">Apps and guided AI setups reuse these paths when mounting shared data into participating containers.</p>
                    </div>
                    <div class="home-lab-storage-grid">
                        @foreach (var role in StorageRoles)
                        {
                            <div class="home-lab-storage-row">
                                <label for="storage-@role">@role</label>
                                <input id="storage-@role" class="ui-control-input" @bind="storagePaths[role]" placeholder="/mnt/storage/@role" />
                                <UiCommandButton Label="Save" Glyph="UiIconGlyph.Save" Variant="UiButtonVariant.ActionSubtle" Disabled="@busy" OnClick="() => SaveStorageRoleAsync(role)" />
                            </div>
                        }
                    </div>
                </section>
            </TabPage>

        </TabControl>
    }
</div>

@code {
    private const string HomeLabFilesRole = "home-lab";
    private static readonly string[] StorageRoles = ["downloads", "movies", "tv", "photos"];
    private readonly Dictionary<string, string> storagePaths = new(StringComparer.OrdinalIgnoreCase)
    {
        [HomeLabFilesRole] = "/mnt/storage/home-lab",
        ["downloads"] = "/mnt/storage/downloads",
        ["movies"] = "/mnt/storage/movies",
        ["tv"] = "/mnt/storage/tv",
        ["photos"] = "/mnt/storage/photos"
    };
    private HomeLabWorkspace? workspace;
    private string message = string.Empty;
    private bool error;
    private bool busy;
    private string activeTab = "apps";
    private string? startingPromptRecipeId;
    private string selectedRecipeCategory = string.Empty;
    private string selectedPromptRecipeId = string.Empty;
    private string customPrompt = string.Empty;
    private IReadOnlyList<HomeLabPromptRecipe> promptRecipes = HomeLabPromptRecipeCatalog.All;
    private HomeLabPromptRecipe? customizingPromptRecipe;
    private string recipePromptDraft = string.Empty;
    private IEnumerable<string> RecipeCategories => promptRecipes
        .Select(recipe => recipe.Category)
        .Distinct(StringComparer.OrdinalIgnoreCase);
    private IEnumerable<HomeLabPromptRecipe> RecipesInSelectedCategory => promptRecipes
        .Where(recipe => recipe.Category.Equals(selectedRecipeCategory, StringComparison.OrdinalIgnoreCase));
    private HomeLabAppManifest? configuringApp;
    private HomeLabAppInstallation? configuringInstallation;
    private HomeLabAppInstallation? renamingGateway;
    private HomeLabAppInstallation? pendingRemoval;
    private string gatewayRenameValue = string.Empty;
    private readonly Dictionary<string, string> configurationValues = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> secretConfigurationValues = new(StringComparer.OrdinalIgnoreCase);
    private HomeLabAppInstallation? selectedInstallation;
    private HomeLabEffectiveConfiguration? effectiveConfiguration;
    private HomeLabConnectionGuide? connectionGuide;
    private HomeLabNetworkSecurity? networkSecurity;
    private EdgeGatewayDashboardViewModel? edgeGatewayDashboard;
    private IReadOnlyList<EdgeGatewayRouteListItem> edgeGatewayRoutes = [];
    private readonly Dictionary<Guid, HomeLabNetworkSecurity> summaryNetworkSecurity = [];
    private readonly HashSet<string> collapsedInstallationGroups = new(StringComparer.Ordinal);
    private string? selectedLogs;
    private string settingsTab = "overview";
    private string containerImageDraft = string.Empty;
    private string containerEnvironmentDraft = string.Empty;
    private string containerVolumesDraft = string.Empty;
    private string externalHostnameDraft = string.Empty;
    private string externalDomainDraft = string.Empty;
    private EdgeGatewayAuthMode externalAuthModeDraft = EdgeGatewayAuthMode.RequireMfa;
    private bool confirmExternalUnpublish;
    private readonly CancellationTokenSource healthMonitorCancellation = new();
    private Task? healthMonitorTask;
    private Task? backgroundRefreshTask;
    private bool backgroundRefreshInProgress;
    private bool healthRefreshInProgress;
    private bool disposed;

    [SupplyParameterFromQuery(Name = "tab")]
    public string? RequestedTab { get; set; }

    private IEnumerable<HomeLabAppInstallation> InstalledVpnGateways =>
        workspace?.Installations
            .Where(item => item.AppId.Equals("vpn-gateway", StringComparison.OrdinalIgnoreCase))
            .OrderBy(item => item.DisplayName, StringComparer.OrdinalIgnoreCase)
        ?? Enumerable.Empty<HomeLabAppInstallation>();

    private IReadOnlyList<EdgeGatewayCloudflareDomainOption> AvailableExternalDomains =>
        edgeGatewayDashboard?.Cloudflare.Domains
            .Where(domain => domain is
            {
                Paused: false,
                RelayConfigured: true,
                RelayUsesCloudflareTunnel: true,
                RelayOwnedByThisLms: true
            })
            .OrderByDescending(domain => domain.IsSavedDefault)
            .ThenBy(domain => domain.DomainName, StringComparer.OrdinalIgnoreCase)
            .ToArray()
        ?? [];

    private IReadOnlyList<HomeLabInstallationGroup> BuildInstallationGroups()
    {
        if (workspace is null)
        {
            return [];
        }

        var groups = new List<HomeLabInstallationGroup>();
        var recipeGroups = new List<HomeLabInstallationGroup>();
        var assignedInstallationIds = new HashSet<Guid>();
        var gateways = workspace.Installations
            .Where(IsVpnGateway)
            .OrderBy(item => item.DisplayName, StringComparer.OrdinalIgnoreCase)
            .ToArray();
        if (gateways.Length > 0)
        {
            assignedInstallationIds.UnionWith(gateways.Select(item => item.Id));
            groups.Add(new("vpn-gateways", "VPN Gateways", "VPN infrastructure", gateways, DateTimeOffset.MaxValue));
        }

        foreach (var recipeRun in workspace.Deployments
                     .Where(item => item.RecipeRunId.HasValue || !string.IsNullOrWhiteSpace(item.RecipeId))
                     .GroupBy(item => item.RecipeRunId ?? item.Id)
                     .OrderByDescending(items => items.Max(item => item.RecipeRunId.HasValue ? item.UpdatedAtUtc : item.CreatedAtUtc)))
        {
            var deployment = recipeRun.OrderByDescending(item => item.UpdatedAtUtc).First();
            var deploymentIds = recipeRun.Select(item => item.Id).ToHashSet();
            var installations = workspace.Installations
                .Where(item => deploymentIds.Contains(item.DeploymentId) && !assignedInstallationIds.Contains(item.Id))
                .OrderBy(item => item.DisplayName, StringComparer.OrdinalIgnoreCase)
                .ToArray();
            if (installations.Length == 0)
            {
                continue;
            }

            assignedInstallationIds.UnionWith(installations.Select(item => item.Id));
            var runDate = deployment.RecipeRunId.HasValue
                ? recipeRun.Max(item => item.UpdatedAtUtc)
                : recipeRun.Min(item => item.CreatedAtUtc);
            recipeGroups.Add(new(
                $"recipe-{recipeRun.Key:N}",
                ResolveRecipeName(deployment),
                FormatRecipeRunDetail(runDate),
                installations,
                runDate));
        }

        // HomeLab Recipes originally installed each app as a standalone deployment. Match those
        // legacy installs by the published recipe app list so existing systems gain useful groups.
        foreach (var recipe in promptRecipes
                     .OrderByDescending(item => item.AppIds.Count)
                     .ThenBy(item => item.Name, StringComparer.OrdinalIgnoreCase))
        {
            var runNumber = 0;
            while (TryMatchRecipeInstallations(recipe, assignedInstallationIds, out var installations))
            {
                runNumber++;
                assignedInstallationIds.UnionWith(installations.Select(item => item.Id));
                var createdAt = installations.Min(item => item.CreatedAtUtc);
                recipeGroups.Add(new(
                    $"prompt-recipe-{recipe.Id}-{runNumber}",
                    recipe.Name,
                    FormatRecipeRunDetail(createdAt),
                    installations,
                    createdAt));
            }
        }

        groups.AddRange(recipeGroups.OrderByDescending(item => item.SortDate));

        var standalone = workspace.Installations
            .Where(item => !assignedInstallationIds.Contains(item.Id))
            .OrderBy(item => item.DisplayName, StringComparer.OrdinalIgnoreCase)
            .ToArray();
        if (standalone.Length > 0)
        {
            groups.Add(new("individual", "Individually installed", "Added outside a recipe", standalone, DateTimeOffset.MinValue));
        }

        return groups;
    }

    private bool TryMatchRecipeInstallations(
        HomeLabPromptRecipe recipe,
        IReadOnlySet<Guid> assignedInstallationIds,
        out HomeLabAppInstallation[] installations)
    {
        var matched = new List<HomeLabAppInstallation>();
        foreach (var appId in recipe.AppIds)
        {
            var installation = workspace!.Installations
                .Where(item => !assignedInstallationIds.Contains(item.Id) &&
                               !matched.Any(match => match.Id == item.Id) &&
                               item.AppId.Equals(appId, StringComparison.OrdinalIgnoreCase))
                .OrderBy(item => item.CreatedAtUtc)
                .FirstOrDefault();
            if (installation is null)
            {
                installations = [];
                return false;
            }

            matched.Add(installation);
        }

        var deploymentIds = matched.Select(item => item.DeploymentId).ToHashSet();
        installations = workspace!.Installations
            .Where(item => deploymentIds.Contains(item.DeploymentId) &&
                           !assignedInstallationIds.Contains(item.Id) &&
                           !IsVpnGateway(item))
            .OrderBy(item => item.DisplayName, StringComparer.OrdinalIgnoreCase)
            .ToArray();
        return installations.Length > 0;
    }

    private string ResolveRecipeName(HomeLabDeployment deployment) =>
        promptRecipes.FirstOrDefault(item => item.Id.Equals(deployment.PromptRecipeId ?? deployment.RecipeId, StringComparison.OrdinalIgnoreCase))?.Name
        ?? workspace?.Recipes.FirstOrDefault(item => item.Id.Equals(deployment.RecipeId, StringComparison.OrdinalIgnoreCase))?.Name
        ?? deployment.Name;

    private void ToggleInstallationGroup(string key)
    {
        if (!collapsedInstallationGroups.Add(key))
        {
            collapsedInstallationGroups.Remove(key);
        }
    }

    private static string FormatRecipeRunDetail(DateTimeOffset createdAt) =>
        $"Recipe run · {createdAt.ToLocalTime():d MMM yyyy, HH:mm}";

    private static string FormatContainerCount(int count) => $"{count} {(count == 1 ? "container" : "containers")}";

    private sealed record HomeLabInstallationGroup(
        string Key,
        string Name,
        string Detail,
        IReadOnlyList<HomeLabAppInstallation> Installations,
        DateTimeOffset SortDate);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            StartBackgroundRefresh();
            healthMonitorTask = MonitorRuntimeHealthAfterInitialRefreshAsync(healthMonitorCancellation.Token);
        }

        return Task.CompletedTask;
    }

    protected override void OnParametersSet()
    {
        activeTab = RequestedTab is "prompts" or "storage" ? RequestedTab : "apps";
    }

