    private static bool IsEditableEnvironmentEntry(string entry, IReadOnlySet<string> managedKeys)
    {
        var separator = entry.IndexOf('=');
        if (separator <= 0 || entry.Contains("<redacted", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        var key = entry[..separator];
        return !managedKeys.Contains(key) &&
               (char.IsAsciiLetter(key[0]) || key[0] == '_') &&
               key.All(character => char.IsAsciiLetterOrDigit(character) || character == '_');
    }

    private static IReadOnlyDictionary<string, string> ParseEnvironmentDraft(string draft)
    {
        var values = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var line in draft.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            if (line.StartsWith('#'))
            {
                continue;
            }

            var separator = line.IndexOf('=');
            if (separator <= 0)
            {
                throw new InvalidOperationException($"Environment entry '{line}' must use KEY=value.");
            }

            var key = line[..separator].Trim();
            if (!values.TryAdd(key, line[(separator + 1)..]))
            {
                throw new InvalidOperationException($"Environment variable '{key}' is listed more than once.");
            }
        }

        return values;
    }

    private static IReadOnlyList<HomeLabContainerVolumeSetting> ParseVolumeDraft(string draft)
    {
        var volumes = new List<HomeLabContainerVolumeSetting>();
        foreach (var line in draft.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            if (line.StartsWith('#'))
            {
                continue;
            }

            var readOnly = line.EndsWith(":ro", StringComparison.OrdinalIgnoreCase);
            var mapping = readOnly ? line[..^3] : line;
            var separator = mapping.IndexOf(':');
            if (separator <= 0 || separator == mapping.Length - 1)
            {
                throw new InvalidOperationException($"Volume mapping '{line}' must use /host/path:/container/path[:ro].");
            }

            volumes.Add(new HomeLabContainerVolumeSetting(
                mapping[..separator].Trim(),
                mapping[(separator + 1)..].Trim(),
                readOnly));
        }

        return volumes;
    }

