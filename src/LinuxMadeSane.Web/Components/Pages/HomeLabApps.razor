    private async Task ResetSelectedCredentialsAsync()
    {
        if (selectedInstallation is null || busy)
        {
            return;
        }

        await RunUiOperationAsync(async () =>
        {
            var result = await HomeLabService.ResetCredentialsAsync(selectedInstallation.Id);
            SetMessage($"{result.Summary} {result.Detail}", !result.Succeeded);
            if (result.Succeeded)
            {
                var logs = await HomeLabService.GetLogsAsync(selectedInstallation.Id);
                selectedLogs = logs.Succeeded ? logs.Logs : $"Could not read container logs: {logs.Error}";
            }
