    private void BeginVpnReconfiguration()
    {
        if (selectedInstallation is not { } gateway || !gateway.AppId.Equals("vpn-gateway", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        BeginVpnReconfiguration(gateway);
    }

    private void BeginVpnReconfiguration(HomeLabAppInstallation gateway)
    {
        if (!gateway.AppId.Equals("vpn-gateway", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        configuringInstallation = gateway;
        configuringApp = GetApp("vpn-gateway");
        configurationValues.Clear();
        secretConfigurationValues.Clear();
        configurationValues["gateway-name"] = gateway.DisplayName;
        configurationValues["configuration-mode"] = "Paste provider config";
        configurationValues["provider"] = "ProtonVPN";
        configurationValues["protocol"] = "WireGuard";
        configurationValues["port-forwarding"] = HomeLabVpnPortForwardingPlan.RequiredSelection;
        CloseDetails();
    }

    private void BeginGatewayRename(HomeLabAppInstallation gateway)
    {
        if (!IsVpnGateway(gateway))
        {
            return;
        }

        renamingGateway = gateway;
        gatewayRenameValue = gateway.DisplayName;
        CloseDetails();
    }

    private bool CanRenameGateway =>
        renamingGateway is { } gateway &&
        !string.IsNullOrWhiteSpace(gatewayRenameValue) &&
        gatewayRenameValue.Trim().Length <= 160 &&
        !gateway.DisplayName.Equals(gatewayRenameValue.Trim(), StringComparison.Ordinal);

    private void CancelGatewayRename()
    {
        renamingGateway = null;
        gatewayRenameValue = string.Empty;
    }

    private async Task RenameGatewayAsync()
    {
        if (renamingGateway is not { } gateway || !CanRenameGateway)
        {
            return;
        }

        var renamed = false;
        await RunUiOperationAsync(async () =>
        {
            var configuration = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            {
                ["gateway-name"] = gatewayRenameValue.Trim(),
                ["configuration-mode"] = "Paste provider config"
            };
            var result = await HomeLabService.ReconfigureVpnGatewayAsync(
                gateway.Id,
                configuration,
                new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase));
            renamed = result.Succeeded;
            SetMessage($"{result.Summary} {result.Detail}", !result.Succeeded);
        });

        if (renamed)
        {
            CancelGatewayRename();
        }
    }

    private bool ShouldShowConfigurationField(HomeLabConfigurationField field)
    {
        if (field.Id.Equals("vpn-gateway", StringComparison.OrdinalIgnoreCase))
        {
            return GetConfigurationValue("network-route").Equals("VPN Gateway (Gluetun)", StringComparison.OrdinalIgnoreCase);
        }

        if (configuringApp is null || !configuringApp.Id.Equals("vpn-gateway", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        var setupMode = GetConfigurationValue("configuration-mode");
        if (field.Id.Equals("vpn-config", StringComparison.OrdinalIgnoreCase))
        {
            return setupMode.Equals("Paste provider config", StringComparison.OrdinalIgnoreCase);
        }
        if (setupMode.Equals("Paste provider config", StringComparison.OrdinalIgnoreCase) &&
            !field.Id.Equals("configuration-mode", StringComparison.OrdinalIgnoreCase) &&
            !field.Id.Equals("protocol", StringComparison.OrdinalIgnoreCase) &&
            !field.Id.Equals("provider", StringComparison.OrdinalIgnoreCase) &&
            !field.Id.Equals("port-forwarding", StringComparison.OrdinalIgnoreCase) &&
            !field.Id.StartsWith("openvpn-", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        var protocol = GetConfigurationValue("protocol");
        if (field.Id.StartsWith("wireguard-", StringComparison.OrdinalIgnoreCase))
        {
            return protocol.Equals("WireGuard", StringComparison.OrdinalIgnoreCase);
        }
        if (field.Id.StartsWith("openvpn-", StringComparison.OrdinalIgnoreCase))
        {
            return protocol.Equals("OpenVPN", StringComparison.OrdinalIgnoreCase);
        }
        return true;
    }

    private string GetConfigurationValue(string key) =>
        configurationValues.TryGetValue(key, out var value) ? value : string.Empty;

    private string GetSecretConfigurationValue(string key) =>
        secretConfigurationValues.TryGetValue(key, out var value) ? value : string.Empty;

    private void SetConfigurationValue(string key, string? value, bool secret = false)
    {
        var target = secret ? secretConfigurationValues : configurationValues;
        target[key] = value ?? string.Empty;
        if (!secret && key.Equals("provider", StringComparison.OrdinalIgnoreCase))
        {
            configurationValues["port-forwarding"] = HomeLabVpnPortForwardingPlan.SupportsAutomaticPortForwarding(value)
                ? HomeLabVpnPortForwardingPlan.RequiredSelection
                : HomeLabVpnPortForwardingPlan.OffSelection;
        }
    }

    private static string GetConfigurationFieldClass(HomeLabConfigurationField field) =>
        field.Type.Equals("secret-textarea", StringComparison.OrdinalIgnoreCase)
            ? "home-lab-config-field home-lab-config-field-wide"
            : "home-lab-config-field";

    private IEnumerable<string> GetConfigurationFieldOptions(HomeLabConfigurationField field)
    {
        if (!field.Id.Equals("port-forwarding", StringComparison.OrdinalIgnoreCase) ||
            HomeLabVpnPortForwardingPlan.SupportsAutomaticPortForwarding(GetConfigurationValue("provider")))
        {
            return field.Options ?? [];
        }

        return [HomeLabVpnPortForwardingPlan.OffSelection];
    }

    private string? GetConfigurationFieldHelp(HomeLabConfigurationField field)
    {
        if (!field.Id.Equals("port-forwarding", StringComparison.OrdinalIgnoreCase))
        {
            return field.Help;
        }

        var provider = GetConfigurationValue("provider");
        return HomeLabVpnPortForwardingPlan.SupportsAutomaticPortForwarding(provider)
            ? field.Help
            : $"{provider} can carry P2P traffic but does not provide an inbound forwarded port. LMS will install this gateway with incoming port forwarding off; qBittorrent will still work, with reduced inbound peer reachability.";
    }

    private static HomeLabAppManifest GetApp(string appId) => HomeLabCatalog.GetApp(appId);

    private static string GetEffectiveEnvironmentValue(HomeLabEffectiveContainer container, string key)
    {
        var prefix = key + "=";
        var value = container.Environment
            .FirstOrDefault(item => item.StartsWith(prefix, StringComparison.OrdinalIgnoreCase));
        return value is null ? "Not set" : value[prefix.Length..];
    }

    private static string FormatProvider(string value) =>
        string.IsNullOrWhiteSpace(value) || value.Equals("custom", StringComparison.OrdinalIgnoreCase)
            ? "Custom provider configuration"
            : value;

    private static string FormatProtocol(string value) =>
        value.Equals("wireguard", StringComparison.OrdinalIgnoreCase)
            ? "WireGuard"
            : value.Equals("openvpn", StringComparison.OrdinalIgnoreCase)
                ? "OpenVPN"
                : string.IsNullOrWhiteSpace(value) ? "Not set" : value;

    private static bool IsVpnRoute(string networkMode) =>
        networkMode.StartsWith("container:", StringComparison.OrdinalIgnoreCase);

    private string NextGatewayName()
    {
        var existingNames = InstalledVpnGateways
            .Select(item => item.DisplayName)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        if (!existingNames.Contains("VPN Gateway"))
        {
            return "VPN Gateway";
        }

        for (var suffix = 2; ; suffix++)
        {
            var candidate = $"VPN Gateway {suffix}";
            if (!existingNames.Contains(candidate))
            {
                return candidate;
            }
        }
    }

    private string GetGatewayIdFromNetworkMode(string networkMode)
    {
        if (!IsVpnRoute(networkMode))
        {
            return string.Empty;
        }

        var containerName = networkMode["container:".Length..];
        return InstalledVpnGateways.FirstOrDefault(item => item.ContainerName.Equals(containerName, StringComparison.OrdinalIgnoreCase))?.Id.ToString() ?? string.Empty;
    }

    private static string DescribeHealthCheck(HomeLabAppManifest app)
    {
        if (app.HealthCheck is null)
        {
            return "Container state fallback";
        }

        if (!string.IsNullOrWhiteSpace(app.HealthCheck.HttpPath))
        {
            return $"HTTP {app.HealthCheck.HttpPath} on port {app.HealthCheck.Port}";
        }

        if (!string.IsNullOrWhiteSpace(app.HealthCheck.DockerCommand))
        {
            return $"Docker command: {app.HealthCheck.DockerCommand}";
        }

        return "Container state fallback";
    }

    private async Task RunAsync(Guid installationId, HomeLabLifecycleAction action)
    {
        await RunUiOperationAsync(async () =>
        {
            var result = await HomeLabService.ExecuteAsync(installationId, action);
            SetMessage($"{result.Summary} {result.Detail}", !result.Succeeded);
        });
    }

    private async Task HandleContainerActionAsync(HomeLabAppInstallation installation, string? selection)
    {
        switch (selection?.Trim().ToLowerInvariant())
        {
            case "start":
                await RunAsync(installation.Id, HomeLabLifecycleAction.Start);
                break;
            case "stop":
                await RunAsync(installation.Id, HomeLabLifecycleAction.Stop);
                break;
            case "restart":
                await RunAsync(installation.Id, HomeLabLifecycleAction.Restart);
                break;
            case "repair":
                await RunAsync(installation.Id, HomeLabLifecycleAction.Repair);
                break;
            case "update":
                await RunAsync(installation.Id, HomeLabLifecycleAction.Update);
                break;
            case "rename":
                BeginGatewayRename(installation);
                break;
            case "vpn-settings":
                BeginVpnReconfiguration(installation);
                break;
            case "remove":
                pendingRemoval = installation;
                break;
        }
    }

    private void CancelRemoval()
    {
        if (!busy)
        {
            pendingRemoval = null;
        }
    }

    private async Task ConfirmRemovalAsync()
    {
        if (pendingRemoval is not { } installation || busy)
        {
            return;
        }

        pendingRemoval = null;
        await RunAsync(installation.Id, HomeLabLifecycleAction.Remove);
    }

    private static bool IsVpnGateway(HomeLabAppInstallation installation) =>
        installation.AppId.Equals("vpn-gateway", StringComparison.OrdinalIgnoreCase);

    private async Task VerifySecurityAsync()
    {
        if (selectedInstallation is null || busy)
        {
            return;
        }

        busy = true;
        try
        {
            networkSecurity = await HomeLabService.GetNetworkSecurityAsync(selectedInstallation.Id);
            summaryNetworkSecurity[selectedInstallation.Id] = networkSecurity;
        }
        catch (Exception exception)
        {
            SetMessage(exception.Message, true);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task TestSelectedEndpointAsync()
    {
        if (selectedInstallation is null)
        {
            return;
        }
        await RunUiOperationAsync(async () =>
        {
            var endpoints = await HomeLabService.RefreshEndpointHealthAsync(selectedInstallation.Id);
            var endpoint = endpoints.FirstOrDefault(item => item.Scope == HomeLabEndpointScope.Public);
            SetMessage(
                endpoint is null ? "No public endpoint is registered." : endpoint.HealthDetail,
                endpoint?.HealthState == HomeLabEndpointHealthState.Broken);
        });
    }

    private async Task RunUiOperationAsync(Func<Task> operation)
    {
        if (busy) return;
        busy = true;
        try
        {
            await operation();
            workspace = await HomeLabService.GetWorkspaceAsync();
            await RefreshEdgeGatewayStateAsync();
            await RefreshSummaryNetworkSecurityAsync();
            if (selectedInstallation is { } openInstallation)
            {
                selectedInstallation = workspace.Installations.FirstOrDefault(item => item.Id == openInstallation.Id);
                if (selectedInstallation is null)
                {
                    CloseDetails();
                }
                else
                {
                    networkSecurity = GetSummaryNetworkSecurity(selectedInstallation);
                    effectiveConfiguration = await HomeLabService.GetEffectiveConfigurationAsync(selectedInstallation.DeploymentId);
                    connectionGuide = await HomeLabService.GetConnectionGuideAsync(selectedInstallation.Id);
                    await LoadExternalAccessDraftAsync(selectedInstallation);
                    ResetContainerSettingsDraft();
                    if (selectedInstallation.AppId.Equals("qbittorrent", StringComparison.OrdinalIgnoreCase))
                    {
                        var logs = await HomeLabService.GetLogsAsync(selectedInstallation.Id);
                        selectedLogs = logs.Succeeded ? logs.Logs : $"Could not read container logs: {logs.Error}";
                    }
                }
            }
        }
        catch (Exception exception)
        {
            SetMessage(exception.Message, true);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task LoadExternalAccessDraftAsync(HomeLabAppInstallation installation)
    {
        confirmExternalUnpublish = false;
        if (installation.EdgeGatewayRouteId is Guid routeId)
        {
            var editor = await EdgeGatewayService.GetEditorAsync(routeId);
            if (editor.Id.HasValue)
            {
                externalHostnameDraft = editor.Hostname;
                externalDomainDraft = editor.DomainName;
                externalAuthModeDraft = editor.AuthMode;
                return;
            }
        }

        var domain = AvailableExternalDomains.FirstOrDefault();
        externalDomainDraft = domain?.DomainName ?? string.Empty;
        externalHostnameDraft = string.IsNullOrWhiteSpace(externalDomainDraft)
            ? installation.AppId
            : $"{BuildAvailableExternalSubdomain(installation)}.{externalDomainDraft}";
        externalAuthModeDraft = EdgeGatewayAuthMode.RequireMfa;
    }

    private async Task RefreshEdgeGatewayStateAsync()
    {
        edgeGatewayRoutes = await EdgeGatewayService.ListRoutesAsync();
        try
        {
            edgeGatewayDashboard = await EdgeGatewayService.GetDashboardAsync();
        }
        catch
        {
            edgeGatewayDashboard = null;
        }
    }

    private string BuildAvailableExternalSubdomain(HomeLabAppInstallation installation)
    {
        var candidate = installation.AppId.Trim().ToLowerInvariant();
        var hostname = $"{candidate}.{externalDomainDraft}";
        var isUsed = edgeGatewayRoutes.Any(route =>
            route.Id != installation.EdgeGatewayRouteId &&
            route.Hostname.Equals(hostname, StringComparison.OrdinalIgnoreCase)) == true;
        return isUsed ? $"{candidate}-{installation.ContainerName[^Math.Min(8, installation.ContainerName.Length)..]}" : candidate;
    }

    private void ChangeExternalDomain(ChangeEventArgs eventArgs)
    {
        var previousDomain = externalDomainDraft;
        externalDomainDraft = eventArgs.Value?.ToString()?.Trim() ?? string.Empty;
        if (selectedInstallation is null || string.IsNullOrWhiteSpace(externalDomainDraft))
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(externalHostnameDraft) ||
            (!string.IsNullOrWhiteSpace(previousDomain) && externalHostnameDraft.EndsWith($".{previousDomain}", StringComparison.OrdinalIgnoreCase)))
        {
            externalHostnameDraft = $"{BuildAvailableExternalSubdomain(selectedInstallation)}.{externalDomainDraft}";
        }
    }

    private void ChangeExternalAuthMode(ChangeEventArgs eventArgs)
    {
        if (Enum.TryParse<EdgeGatewayAuthMode>(eventArgs.Value?.ToString(), out var mode) &&
            mode is EdgeGatewayAuthMode.RequireMfa or EdgeGatewayAuthMode.TemporaryIpApproval or EdgeGatewayAuthMode.PassThrough)
        {
            externalAuthModeDraft = mode;
        }
    }

    private bool CanSaveExternalAccess =>
        selectedInstallation is not null &&
        !string.IsNullOrWhiteSpace(externalHostnameDraft) &&
        !string.IsNullOrWhiteSpace(externalDomainDraft) &&
        AvailableExternalDomains.Any(domain => domain.DomainName.Equals(externalDomainDraft, StringComparison.OrdinalIgnoreCase));

    private async Task SaveExternalAccessAsync()
    {
        if (selectedInstallation is null || !CanSaveExternalAccess)
        {
            return;
        }

        await RunUiOperationAsync(async () =>
        {
            var result = await HomeLabService.PublishExternalAccessAsync(
                selectedInstallation.Id,
                new HomeLabEdgeGatewayRequest(externalHostnameDraft, externalDomainDraft, externalAuthModeDraft));
            SetMessage($"{result.Summary} {result.Detail}", !result.Succeeded);
        });
    }

    private void RequestExternalUnpublish() => confirmExternalUnpublish = true;

    private void CancelExternalUnpublish() => confirmExternalUnpublish = false;

    private async Task UnpublishExternalAccessAsync()
    {
        if (selectedInstallation is null || !confirmExternalUnpublish)
        {
            return;
        }

        await RunUiOperationAsync(async () =>
        {
            var result = await HomeLabService.UnpublishExternalAccessAsync(selectedInstallation.Id);
            SetMessage($"{result.Summary} {result.Detail}", !result.Succeeded);
            confirmExternalUnpublish = false;
        });
    }

    private void SetMessage(string text, bool isError)
    {
        message = text;
        error = isError;
    }

    private static UiPillTone GetHealthTone(HomeLabHealthState state) => state switch
    {
        HomeLabHealthState.Healthy => UiPillTone.Success,
        HomeLabHealthState.Starting => UiPillTone.Warning,
        HomeLabHealthState.Stopped => UiPillTone.Neutral,
        _ => UiPillTone.Failure
    };

    private bool CanRepair(HomeLabAppInstallation installation)
    {
        if (installation.HealthState is HomeLabHealthState.Degraded or HomeLabHealthState.Failed)
        {
            return true;
        }

        if (installation.HealthState != HomeLabHealthState.Blocked || !IsVpnRoute(installation.NetworkMode))
        {
            return false;
        }

        var gatewayContainer = installation.NetworkMode["container:".Length..];
        var gateway = InstalledVpnGateways.FirstOrDefault(item =>
            item.ContainerName.Equals(gatewayContainer, StringComparison.OrdinalIgnoreCase));
        return gateway?.HealthState is HomeLabHealthState.Healthy or HomeLabHealthState.Degraded or HomeLabHealthState.Failed;
    }

    private EdgeGatewayRouteListItem? GetExternalRoute(HomeLabAppInstallation installation) =>
        installation.EdgeGatewayRouteId is Guid routeId
            ? edgeGatewayRoutes.FirstOrDefault(route => route.Id == routeId)
            : null;

    private bool IsEdgeGatewaySession
    {
        get
        {
            if (!Uri.TryCreate(Navigation.BaseUri, UriKind.Absolute, out var baseUri))
            {
                return false;
            }

            return edgeGatewayRoutes.Any(route =>
                route.Enabled &&
                route.Hostname.Trim().TrimEnd('.').Equals(baseUri.Host.Trim().TrimEnd('.'), StringComparison.OrdinalIgnoreCase)) == true;
        }
    }

    private string? BuildOpenUrl(HomeLabAppInstallation installation)
    {
        var endpoints = installation.ServiceEndpoints ?? [];
        var clientEndpoint = endpoints.FirstOrDefault(endpoint => endpoint.Scope == HomeLabEndpointScope.Client);
        if (clientEndpoint is null)
        {
            return null;
        }
        if (!IsEdgeGatewaySession)
        {
            return clientEndpoint.Url;
        }
        return clientEndpoint.Scheme.Equals("https", StringComparison.OrdinalIgnoreCase)
            ? clientEndpoint.Url
            : null;
    }

    private static string? BuildExternalUrl(EdgeGatewayRouteListItem route)
    {
        if (string.IsNullOrWhiteSpace(route.Hostname))
        {
            return null;
        }

        var path = route.TargetPathPrefix?.Trim() ?? string.Empty;
        if (path.Length > 0 && !path.StartsWith("/", StringComparison.Ordinal))
        {
            path = $"/{path}";
        }
        return $"https://{route.Hostname.Trim().TrimEnd('.')}{path}";
    }

    private string BuildExternalPreview()
    {
        var hostname = externalHostnameDraft.Trim().TrimEnd('.');
        if (hostname.Length > 0 && !hostname.Contains('.', StringComparison.Ordinal) && !string.IsNullOrWhiteSpace(externalDomainDraft))
        {
            hostname = $"{hostname}.{externalDomainDraft.Trim().Trim('.')}";
        }
        return hostname.Length == 0 ? "Choose a hostname" : $"https://{hostname}";
    }

    private static string FormatExternalAuthMode(EdgeGatewayAuthMode mode) => mode switch
    {
        EdgeGatewayAuthMode.PassThrough => "Pass through to the app",
        EdgeGatewayAuthMode.TemporaryIpApproval => "Email approve IP",
        _ => "LMS MFA / passkey"
    };

