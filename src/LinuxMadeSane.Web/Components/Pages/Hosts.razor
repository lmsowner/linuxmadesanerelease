    private async Task SafeInvokeAsync(Action action)
    {
        try
        {
            await InvokeAsync(() =>
            {
                action();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

