@page "/hosts"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IAsyncDisposable
@using LinuxMadeSane.Application.Interfaces
@using LinuxMadeSane.Core.Abstractions
@using LinuxMadeSane.Core.Enums
@using LinuxMadeSane.Core.Models
@using LinuxMadeSane.Core.Versioning
@using LinuxMadeSane.Core.Models.LocalAi
@inject PortalAddonBootstrapService PortalRegistration
@inject FleetPortalRegistrationService FleetRegistration
@inject ILocalAiEngineManagerService AiEngineManager
@inject PageStatusCache StatusCache
@inject IManagedHostService HostService
@inject ICommandExecutionService CommandExecutionService
@inject IManagedHostPublicKeyInstaller PublicKeyInstaller
@inject ISshKeySetupRecoveryService KeySetupRecovery
@inject ISshKeyPairGenerator SshKeyPairGenerator
@inject IServiceScopeFactory ServiceScopeFactory
@inject TerminalWorkspaceRegistry TerminalWorkspaceRegistry
@inject TerminalWorkspaceAccessor TerminalWorkspaceAccessor
@inject IAiThreadService AiThreadService
@inject ILogger<Hosts> Logger
@inject FileThumbnailCacheService FileThumbnailCacheService
@inject ApplicationUpdateService LocalApplicationUpdates
@inject LmsHostUpdateAvailabilityService LmsUpdateAvailabilityService
@inject LmsHostEdgeGatewaySummaryService EdgeGatewaySummaryService
@inject LmsHostBenchmarkService BenchmarkService
@inject RemoteLmsSshTunnelService RemoteLmsSshTunnelService
@inject IHostAdministratorCredentials AdministratorCredentials
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<PageTitle>Hosts | Linux Made Sane</PageTitle>

<div class="page-shell hosts-page">
    <UiHeroPanel Title="Hosts"
                 Compact="true">
        <Actions>
            <UiCommandButton Label="@(refreshingHosts ? "Refreshing…" : "Refresh")" Glyph="UiIconGlyph.Refresh" Disabled="@(refreshingHosts || isStatusRefreshInProgress || isLmsUpdateRefreshInProgress)" OnClick="RefreshHostsAsync" Title="Refresh host status, versions, AI and routing. Results are cached for five minutes." />
            <UiCommandButton Label="Search logs" Glyph="UiIconGlyph.Search" Href="/logs" />
            <UiCommandButton Label="Update LMS on all hosts" Glyph="UiIconGlyph.Download" Title="Update all registered LMS hosts using each host’s selected Dev or Stable channel" Disabled="@(updatingAllHosts || LmsHostRows.Count == 0)" OnClick="UpdateAllLmsHostsAsync" />
            @if (portalRegistered) { <UiCommandButton Label="Register with Portal" Glyph="UiIconGlyph.Connection" OnClick="@(()=>portalRegistration?.Open())" /> }
            <UiCommandButton Label="Package updates" Glyph="UiIconGlyph.Download" OnClick="@(() => packageUpdates?.Open())" />
            <UiCommandButton Label="Add host" Glyph="UiIconGlyph.Plus" Href="/hosts/new" />
        </Actions>
    </UiHeroPanel>

    <FleetPortalRegistration @ref="portalRegistration" Hosts="@LmsHostRows.Select(row=>row.Host).ToArray()" />
    <FleetPackageUpdates @ref="packageUpdates" Hosts="@hostRows.Select(row=>row.Host).ToArray()" AiAvailable="@terminalAiAvailable" />

    @if (activeHostTab is not ("sftp" or "remote-desktop"))
    {
    <div class="summary-pill-row">
        <UiPill Tone="UiPillTone.Neutral">@($"{ActiveHostRows.Count} configured")</UiPill>
        <UiPill Tone="@(ActiveOnlineHostCount > 0 ? UiPillTone.Success : UiPillTone.Warning)">
            @(ActiveOnlineHostCount > 0 ? $"{ActiveOnlineHostCount} online" : "No online hosts")
        </UiPill>
        <UiPill Tone="@(ActiveCheckingHostCount > 0 ? UiPillTone.Warning : UiPillTone.Neutral)">
            @(ActiveCheckingHostCount > 0 ? $"{ActiveCheckingHostCount} checking" : "No hosts checking")
        </UiPill>
        <UiPill Tone="@(ActiveOfflineHostCount > 0 ? UiPillTone.Failure : UiPillTone.Neutral)">
            @(ActiveOfflineHostCount > 0 ? $"{ActiveOfflineHostCount} offline" : "No offline hosts")
        </UiPill>
    </div>

    }
    @if (!string.IsNullOrWhiteSpace(lmsConnectStatus))
    {
        <p class="@($"callout {lmsConnectTone}")">@lmsConnectStatus
            @if (lmsConnectUrl is not null) { <a href="@lmsConnectUrl" target="_blank" rel="noopener noreferrer">Open LMS</a> }
        </p>
    }

    <TabControl ActiveValue="@activeHostTab"
                ActiveValueChanged="HandleHostTabChangedAsync"
                Class="page-tab-control hosts-tab-control"
                PanelClass="page-tab-panel hosts-tab-panel">
            <TabPage Value="@LmsHostsTabValue" Title="@($"LMS Hosts ({LmsHostRows.Count})")">
                <table class="hosts-table hosts-table-lms" role="table" aria-label="LMS hosts">
                    <colgroup>
                        <col class="hosts-col-name" />
                        <col class="hosts-col-status" />
                        <col class="hosts-col-auth" />
                        <col class="hosts-col-version" />
                        <col class="hosts-col-channel" />
                        <col class="hosts-col-ai" />
                        <col class="hosts-col-performance" />
                        <col class="hosts-col-last-seen" />
                        <col class="hosts-col-actions" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th><span class="hosts-column-heading">Name</span></th>
                            <th><span class="hosts-column-heading">Status</span></th>
                            <th><span class="hosts-column-heading">Auth</span></th>
                            <th><span class="hosts-column-heading">Version</span></th>
                            <th><span class="hosts-column-heading">Channel</span></th>
                            <th><span class="hosts-column-heading">AI Server</span></th>
                            <th><span class="hosts-column-heading">Performance</span></th>
                            <th><span class="hosts-column-heading">Last seen</span></th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (LmsHostRows.Count == 0)
                        {
                            <tr>
                                <td colspan="9" class="hosts-loading-cell">
                                    <span class="meta-text">No LMS hosts registered yet.</span>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @for (var hostIndex = 0; hostIndex < LmsHostRows.Count; hostIndex++)
                            {
                                var row = LmsHostRows[hostIndex];
                                var stripeClass = hostIndex % 2 == 0 ? "hosts-group-even" : "hosts-group-odd";
                                var hasRoutes = edgeGatewaySummaries.TryGetValue(row.Host.Id, out var edgeSummary) && edgeSummary!.Links.Count > 0;
                                <tr @key="row.Host.Id" class="hosts-summary-row @stripeClass @(hasRoutes ? "hosts-has-routes" : "")" @onclick="(() => ToggleHostDetails(row.Host.Id))"
                                    tabindex="0" @onkeydown="@(e => { if (e.Key == "Enter") ToggleHostDetails(row.Host.Id); })"
                                    aria-expanded="@(expandedHostId == row.Host.Id ? "true" : "false")" aria-controls="@($"host-inline-{row.Host.Id}")">
                                    <td class="hosts-identity-cell" data-label="Name">
                                        <div class="hosts-identity">
                                            <div class="hosts-quick-open">
                                                <span class="hosts-row-control" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true"><UiIconButton Label="Open terminal" Glyph="UiIconGlyph.Terminal"
                                                              data-lms-prepare-popup="@HostTerminalPopupName(row.Host)"
                                                              OnClick="@(() => OpenHostTerminalAsync(row.Host))" /></span>
                                                <span class="hosts-row-control" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true"><UiIconButton Label="Open file browser" Glyph="UiIconGlyph.Files"
                                                              Href="@($"/file-browser-window?hostId={row.Host.Id}")" Target="_blank" Rel="noopener noreferrer"
                                                              OnClientClick="if(window.lmsTerminalWindow?.openPopup(this.href,this.target))return false;" /></span>
                                            </div>
                                            <div class="stack-tight hosts-name-stack">
                                                <div class="inventory-host-title">
                                                    <strong class="hosts-name-text">@GetHostDisplayName(row.Host)</strong>
                                                    @if(FleetRegistration.Status(row.Host.Id) is {Registered:true})
                                                    { <span class="hosts-portal-badge" title="Registered in Portal" aria-label="Registered in Portal"><UiGlyphIcon Glyph="UiIconGlyph.Connection" /></span> }
                                                </div>
                                                <strong class="meta-text hosts-row-meta hosts-address">@row.Host.Hostname:@row.Host.Port</strong>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="hosts-status-cell" data-label="Status">
                                        <div class="stack-tight hosts-status-stack">
                                            <UiPill Tone="@GetStatusTone(row)" Class="hosts-status-pill">@GetStatusLabel(row)</UiPill>
                                            @if (ShouldShowStatusSummary(row))
                                            {
                                                <span class="meta-text hosts-row-meta">@GetStatusSummary(row)</span>
                                            }
                                        </div>
                                    </td>
                                    <td data-label="Authentication"><span class="hosts-row-value hosts-last-seen-value">@FormatAuthentication(row.Host.PrimaryAuthenticationType)</span></td>
                                    <td class="hosts-version-cell" data-label="Version">
                                        <div class="stack-tight hosts-version-stack" title="@GetLmsVersionTooltip(row)">
                                            <UiPill Tone="@GetLmsUpdateTone(row)" Class="hosts-version-pill">@GetLmsVersionLabel(row)</UiPill>
                                        </div>
                                    </td>
                                    <td data-label="Channel"><span class="hosts-row-value hosts-last-seen-value">@(row.LmsUpdate?.ReleaseChannel switch { "development" => "Development", "stable" => "Stable", _ => "Unknown" })</span></td>
                                    <td data-label="AI Server" class="hosts-ai-cell">
                                        @if (hostAi.TryGetValue(row.Host.Id, out var ai))
                                        {
                                            <span class="hosts-row-value hosts-last-seen-value" title="@ai.Detail">@(ai.LocalEngineInstalled ? "Yes" : "No")</span>
                                            @if (ai.LocalEngineInstalled && ai.LocalEngineRunning)
                                            {
                                                @if (LinuxMadeSane.Core.Models.Ai.AiLocalMachine.IsLocalMachine(row.Host.Id))
                                                { <a class="hosts-ai-available" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true" href="/ai/engine" title="Manage this host’s local AI">Local AI available</a> }
                                                else if (ai.SharingReady)
                                                { <button class="hosts-ai-available hosts-ai-link" type="button" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true" title="Connect to this host’s shared AI" @onclick="@(() => OpenPeerAi(row.Host, ai))">Local AI available</button> }
                                                else
                                                { <span class="hosts-ai-available" title="Local AI is running; sharing is not ready">Local AI available</span> }
                                            }
                                        }
                                        else { <span class="hosts-row-value hosts-last-seen-value">No</span> }
                                    </td>
                                    <td class="hosts-performance-cell" data-label="Performance">
                                        @if (hostBenchmarks.TryGetValue(row.Host.Id, out var benchmark))
                                        {
                                            @if (benchmark.Result is { } score)
                                            {
                                                <span class="hosts-performance-summary" title="@($"CPU: single-core / multi-core events per second. R: disk read; W: disk write. {score.ToolVersion} · {score.TestedAtUtc.ToLocalTime():yyyy-MM-dd HH:mm} · {score.DiskFolder} · {score.Threads} threads")">
                                                    <span>CPU @score.SingleCpu.ToString("N0") / @score.MultiCpu.ToString("N0")</span>
                                                    <small>R @score.ReadMBps.ToString("N0") · W @score.WriteMBps.ToString("N0") MB/s</small>
                                                    @if (score.Internet is { } internet) { <small>↓ @internet.DownloadMbps.ToString("N1") · ↑ @internet.UploadMbps.ToString("N1") Mbps</small> }
                                                </span>
                                            }
                                            else { <span class="meta-text" title="@benchmark.Error">@(benchmark.Error is null ? "Not benchmarked" : "Unavailable")</span> }
                                        }
                                        else { <span class="meta-text">Checking…</span> }
                                    </td>
                                    <td data-label="Last seen"><span class="hosts-row-value hosts-last-seen-value">@FormatLastSeen(row)</span></td>
                                    <td class="actions-cell" data-label="Actions">
                                        <div class="row-action-cluster">
                                            @if (ShouldShowLmsConnectAction(row))
                                            {
                                                @if (CanOpenLmsDirectly(row))
                                                {
                                                    <span class="hosts-row-control" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true"><UiCommandButton Label="Connect"
                                                                     Glyph="UiIconGlyph.Connect"
                                                                     Title="Open this host’s verified HTTPS/HTTP LMS address."
                                                                     Variant="UiButtonVariant.Action"
                                                                     Href="@BuildDirectLmsRootUrl(row.Host)"
                                                                     Target="_blank"
                                                                     Rel="noreferrer" /></span>
                                                }
                                                else
                                                {
                                                    <span class="hosts-row-control" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true"><UiCommandButton Label="Connect"
                                                                     Glyph="UiIconGlyph.Connect"
                                                                     Title="@GetLmsTunnelConnectTitle(row.Host)"
                                                                     Variant="UiButtonVariant.Action"
                                                                     Disabled="@(!CanConnectRemoteLmsHostThroughSsh(row.Host) || IsLmsConnectBusyFor(row.Host))"
                                                                     OnClick="@(() => ConnectToRemoteLmsAsync(row.Host))" /></span>
                                                }
                                            }
                                            @if (ShouldShowLmsUpdateAction(row))
                                            {
                                                <span class="hosts-row-control" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true"><UiCommandButton Label="Update"
                                                                 Glyph="UiIconGlyph.Download"
                                                                 Variant="UiButtonVariant.Action"
                                                                 Disabled="@IsLmsUpdateActiveFor(row.Host)"
                                                                 OnClick="@(() => StartLmsHostUpdateAsync(row.Host))" /></span>
                                            }
                                            @if (ShouldShowPublicKeySetupAction(row.Host))
                                            {
                                                <span class="hosts-row-control" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true"><UiCommandButton Label="Setup key"
                                                                 Title="Set up public key SSH"
                                                                 Glyph="UiIconGlyph.Key"
                                                                 Variant="UiButtonVariant.Action"
                                                                 Disabled="@IsPublicKeySetupBusyFor(row.Host)"
                                                                 OnClick="@(() => OpenPublicKeySetupAsync(row.Host))" /></span>
                                            }
                                            @if(portalRegistered && FleetRegistration.CanRegister(row.Host.Id))
                                            { <span class="hosts-row-control" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true"><UiCommandButton Label="Register with Portal" Glyph="UiIconGlyph.Connection" Variant="UiButtonVariant.Action" OnClick="@(()=>portalRegistration?.Open(row.Host.Id))" /></span> }


                                        </div>
                                    </td>
                                </tr>
                                @if (hasRoutes)
                                {
                                    <tr @key="@($"routes-{row.Host.Id}")" class="hosts-edge-routes-row @stripeClass">
                                        <td colspan="9">
                                            <div class="hosts-edge-routes">
                                                <span class="meta-text">Edge Gateway routes</span>
                                                @foreach (var link in edgeSummary!.Links)
                                                {
                                                    <a href="@link.Url" title="@link.Label" target="_blank" rel="noopener noreferrer">@link.Label</a>
                                                }
                                                @if (edgeSummary!.RouteCount > edgeSummary!.Links.Count)
                                                {
                                                    <span class="meta-text">+@(edgeSummary!.RouteCount - edgeSummary!.Links.Count) more</span>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                                @if (detailedHostId == row.Host.Id)
                                {
                                    <tr @key="@($"details-{row.Host.Id}")" class="hosts-inline-details-row @stripeClass" hidden="@(expandedHostId != row.Host.Id)"><td colspan="9">
                                        <section id="@($"host-inline-{row.Host.Id}")" aria-label="@($"Details for {GetHostDisplayName(row.Host)}")">
                                            <HostInlineDetails @key="row.Host.Id" Host="row.Host" IsExpanded="@(expandedHostId == row.Host.Id)" InstalledVersion="@row.LmsUpdate?.InstalledVersion"
                                                               ReleaseChannel="@row.LmsUpdate?.ReleaseChannel" LmsEndpoint="@GetInlineLmsEndpoint(row.Host)" />
                                            <div class="toolbar-row">
                                            <UiCommandButton Label="Edit" Glyph="UiIconGlyph.Edit" Href="@($"/hosts/{row.Host.Id}/edit")" Variant="UiButtonVariant.Action" />
                                            <HostRebootAction Host="row.Host" />
                                            @if (ShouldShowLmsUninstallAction(row))
                                            {
                                                <UiCommandButton Label="Uninstall"
                                                                 Glyph="UiIconGlyph.Uninstall"
                                                                 Title="Uninstall LMS software on this machine; data removal is a separate option."
                                                                 Href="@BuildLmsUninstallHref(row.Host)"
                                                                 Variant="UiButtonVariant.Action" />
                                            }

                                            <div class="hosts-browser-action-main">
                                                <UiCommandButton Label="Flush cache"
                                                                 Title="Flush this host's image thumbnail cache"
                                                                 Glyph="UiIconGlyph.ImageCacheClear"
                                                                 Variant="UiButtonVariant.Action"
                                                                 aria-label="Flush this host's image thumbnail cache"
                                                                 Disabled="@IsThumbnailCacheFlushBusyFor(row.Host)"
                                                                 OnClick="@(() => FlushHostThumbnailCacheAsync(row.Host))" />
                                            </div>
                                            @if (CanRemoveHost(row.Host))
                                            {
                                                <UiCommandButton Label="Remove"
                                                                 Title="Remove this host from LMS inventory without uninstalling its software."
                                                                 Glyph="UiIconGlyph.Delete"
                                                                 Variant="UiButtonVariant.Danger"
                                                                 Disabled="@isRemovingHost"
                                                                 OnClick="@(() => OpenRemoveHostDialog(row.Host))" />
                                            }
                                            </div>
                                        </section>
                                    </td></tr>
                                }
                                @if (GetLmsUpdateOperation(row.Host.Id) is { State: LmsHostUpdateOperationState.Failed } failedUpdate)
                                {
                                    <tr class="hosts-update-failure-row @stripeClass">
                                        <td colspan="9">
                                            <p class="callout error" role="alert">@failedUpdate.Message</p>
                                            <div class="hosts-update-recovery-actions">
                                                <span>Open this host’s terminal to investigate the update failure.</span>
                                                <UiCommandButton Label="Open terminal" Glyph="UiIconGlyph.Run" OnClientPointerDown="@PrepareHostTerminalPopup(row.Host)" OnClick="@(() => OpenHostTerminalAsync(row.Host))" />
                                                @if (terminalAiAvailable)
                                                {
                                                    <UiCommandButton Label="Fix this using AI" Glyph="UiIconGlyph.Ai" OnClientPointerDown="@PrepareHostTerminalPopup(row.Host)" OnClick="@(() => OpenHostTerminalAsync(row.Host, failedUpdate.Message))" />
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </TabPage>

            <TabPage Value="@SshHostsTabValue" Title="@($"SSH Hosts ({SshHostRows.Count})")">
                <table class="hosts-table hosts-table-ssh" role="table" aria-label="SSH hosts">
                    <colgroup>
                        <col class="hosts-col-name" />
                        <col class="hosts-col-status" />
                        <col class="hosts-col-auth" />
                        <col class="hosts-col-last-seen" />
                        <col class="hosts-col-actions" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th><span class="hosts-column-heading">Name</span></th>
                            <th><span class="hosts-column-heading">Status</span></th>
                            <th><span class="hosts-column-heading">Auth</span></th>
                            <th><span class="hosts-column-heading">Last seen</span></th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (SshHostRows.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="hosts-loading-cell">
                                    <span class="meta-text">No SSH-only hosts registered yet.</span>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var row in SshHostRows)
                            {
                                <tr @key="row.Host.Id" class="hosts-summary-row" @onclick="(() => ToggleHostDetails(row.Host.Id))"
                                    tabindex="0" @onkeydown="@(e => { if (e.Key == "Enter") ToggleHostDetails(row.Host.Id); })"
                                    aria-expanded="@(expandedHostId == row.Host.Id ? "true" : "false")" aria-controls="@($"host-inline-{row.Host.Id}")">
                                    <td class="hosts-identity-cell" data-label="Name">
                                        <div class="hosts-identity">
                                            <div class="hosts-quick-open">
                                                <span class="hosts-row-control" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true"><UiIconButton Label="Open terminal" Glyph="UiIconGlyph.Terminal"
                                                              data-lms-prepare-popup="@HostTerminalPopupName(row.Host)"
                                                              OnClick="@(() => OpenHostTerminalAsync(row.Host))" /></span>
                                                <span class="hosts-row-control" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true"><UiIconButton Label="Open file browser" Glyph="UiIconGlyph.Files"
                                                              Href="@($"/file-browser-window?hostId={row.Host.Id}")" Target="_blank" Rel="noopener noreferrer"
                                                              OnClientClick="if(window.lmsTerminalWindow?.openPopup(this.href,this.target))return false;" /></span>
                                            </div>
                                            <div class="stack-tight hosts-name-stack">
                                                <div class="inventory-host-title">
                                                    <strong class="hosts-name-text">@GetHostDisplayName(row.Host)</strong>
                                                    @if(FleetRegistration.Status(row.Host.Id) is {Registered:true})
                                                    { <span class="hosts-portal-badge" title="Registered in Portal" aria-label="Registered in Portal"><UiGlyphIcon Glyph="UiIconGlyph.Connection" /></span> }
                                                </div>
                                                <strong class="meta-text hosts-row-meta hosts-address">@row.Host.Hostname:@row.Host.Port</strong>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="hosts-status-cell" data-label="Status">
                                        <div class="stack-tight hosts-status-stack">
                                            <UiPill Tone="@GetStatusTone(row)" Class="hosts-status-pill">@GetStatusLabel(row)</UiPill>
                                            @if (ShouldShowStatusSummary(row))
                                            {
                                                <span class="meta-text hosts-row-meta">@GetStatusSummary(row)</span>
                                            }
                                        </div>
                                    </td>
                                    <td data-label="Authentication"><span class="hosts-row-value hosts-last-seen-value">@FormatAuthentication(row.Host.PrimaryAuthenticationType)</span></td>
                                    <td data-label="Last seen"><span class="hosts-row-value hosts-last-seen-value">@FormatLastSeen(row)</span></td>
                                    <td class="actions-cell" data-label="Actions">
                                        <div class="row-action-cluster">
                                            @if (ShouldShowPublicKeySetupAction(row.Host))
                                            {
                                                <span class="hosts-row-control" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true"><UiCommandButton Label="Setup key"
                                                                 Title="Set up public key SSH"
                                                                 Glyph="UiIconGlyph.Key"
                                                                 Variant="UiButtonVariant.Action"
                                                                 Disabled="@IsPublicKeySetupBusyFor(row.Host)"
                                                                 OnClick="@(() => OpenPublicKeySetupAsync(row.Host))" /></span>
                                            }
                                            @if (TryGetLmsInstallAction(row.Host) is { } installAction)
                                            {
                                                <span class="hosts-row-control" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true"><UiCommandButton Label="@installAction.Label"
                                                                 Glyph="UiIconGlyph.Plus"
                                                                 Href="@installAction.Href"
                                                                 Title="@installAction.Title"
                                                                 Disabled="@installAction.Disabled"
                                                                 Variant="UiButtonVariant.Action" /></span>
                                            }


                                        </div>
                                    </td>
                                </tr>
                                @if (detailedHostId == row.Host.Id)
                                {
                                    <tr @key="@($"details-{row.Host.Id}")" class="hosts-inline-details-row" hidden="@(expandedHostId != row.Host.Id)"><td colspan="5">
                                        <section id="@($"host-inline-{row.Host.Id}")" aria-label="@($"Details for {GetHostDisplayName(row.Host)}")">
                                            <HostInlineDetails @key="row.Host.Id" Host="row.Host" IsExpanded="@(expandedHostId == row.Host.Id)" />
                                            <div class="toolbar-row">
                                            <UiCommandButton Label="Edit" Glyph="UiIconGlyph.Edit" Href="@($"/hosts/{row.Host.Id}/edit")" Variant="UiButtonVariant.Action" />

                                            <div class="hosts-browser-action-main">
                                                <UiCommandButton Label="Flush cache"
                                                                 Title="Flush this host's image thumbnail cache"
                                                                 Glyph="UiIconGlyph.ImageCacheClear"
                                                                 Variant="UiButtonVariant.Action"
                                                                 aria-label="Flush this host's image thumbnail cache"
                                                                 Disabled="@IsThumbnailCacheFlushBusyFor(row.Host)"
                                                                 OnClick="@(() => FlushHostThumbnailCacheAsync(row.Host))" />
                                            </div>
                                            @if (CanRemoveHost(row.Host))
                                            {
                                                <UiCommandButton Label="Remove"
                                                                 Title="Remove this host from LMS inventory without uninstalling its software."
                                                                 Glyph="UiIconGlyph.Delete"
                                                                 Variant="UiButtonVariant.Danger"
                                                                 Disabled="@isRemovingHost"
                                                                 OnClick="@(() => OpenRemoveHostDialog(row.Host))" />
                                            }
                                            </div>
                                        </section>
                                    </td></tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </TabPage>
            <TabPage Value="sftp" Title="SFTP Hosts">
                <SftpHostsPanel />
            </TabPage>
            <TabPage Value="remote-desktop" Title="Remote Desktop (RDP/VNC)">
                <RemoteDesktopPanel />
            </TabPage>
    </TabControl>
</div>

<UiModal IsOpen="@(hostPendingRemoval is not null)"
         Title="Remove host"
         Subtitle="@RemoveHostDialogSubtitle"
         Class="hosts-remove-modal"
             CloseOnBackdrop="false"
         OnClose="CloseRemoveHostDialog">
    <ChildContent>
        @if (hostPendingRemoval is not null)
        {
            <div class="stack-relaxed">
                <p class="callout warning">
                    Remove <strong>@hostPendingRemoval.Name</strong> from LMS? This removes the inventory entry, saved SSH credentials, host runbooks, AI host attachments, and file shortcuts.
                </p>
                <p class="meta-text">This does not uninstall Linux Made Sane or change anything on the remote machine.</p>
                @if (!string.IsNullOrWhiteSpace(removeHostStatus))
                {
                    <p class="@($"callout {removeHostTone}")">@removeHostStatus</p>
                }
            </div>
        }
    </ChildContent>
    <Footer>
        <div class="hosts-remove-footer">
            <UiCommandButton Label="Cancel"
                             Glyph="UiIconGlyph.Clear"
                             Variant="UiButtonVariant.Ghost"
                             Disabled="@isRemovingHost"
                             OnClick="CloseRemoveHostDialog" />
            <UiCommandButton Label="@(isRemovingHost ? "Removing..." : "Remove host")"
                             Glyph="UiIconGlyph.Delete"
                             Variant="UiButtonVariant.Danger"
                             Disabled="@(!CanConfirmRemoveHost)"
                             OnClick="ConfirmRemoveHostAsync" />
        </div>
    </Footer>
</UiModal>

<UiModal IsOpen="@isPublicKeySetupOpen"
         Title="Set up public key SSH"
         Subtitle="@PublicKeySetupSubtitle"
         Class="hosts-public-key-modal"
             CloseOnBackdrop="false"
         OnClose="ClosePublicKeySetupAsync">
    <ChildContent>
        @if (publicKeySetupHost is null || publicKeySetupEditor is null || publicKeySetupKeyPair is null)
        {
            <p class="callout info hosts-public-key-status">Preparing public key setup...</p>
        }
        else
        {
            <div class="hosts-public-key-flow">
                <div class="hosts-public-key-steps">
                    <article class="surface-subcard hosts-public-key-step">
                        <strong>1. Generate</strong>
                        <span>LMS generated a key for @PublicKeySetupTargetLabel. The private key is only saved after a successful key-auth test.</span>
                    </article>
                    <article class="surface-subcard hosts-public-key-step">
                        <strong>2. Install</strong>
                        <span>@(LinuxMadeSane.Core.Models.Ai.AiLocalMachine.IsLocalMachine(publicKeySetupHost.Id) ? "LMS uses its existing administrator access to install the key for this local Linux account." : "LMS appends the public key using this host’s saved SSH login.")</span>
                    </article>
                    <article class="surface-subcard hosts-public-key-step">
                        <strong>3. Save</strong>
                        <span>LMS tests the new key and switches the host to Public key auth when the test passes.</span>
                    </article>
                </div>

                <label class="terminal-inline-field">
                    <span>Public key</span>
                    <textarea readonly class="ui-control-input hosts-public-key-textarea">@publicKeySetupKeyPair.PublicKey</textarea>
                </label>

                <span class="meta-text">Fingerprint: @publicKeySetupKeyPair.FingerprintSha256</span>

                <details class="hosts-public-key-command">
                    <summary>Install command</summary>
                    <pre class="command-preview-block command-display-block">@PublicKeySetupInstallCommand</pre>
                </details>

                <div class="toolbar-row hosts-public-key-actions">
                    <UiCommandButton Label="Copy public key"
                                     Glyph="UiIconGlyph.Copy"
                                     Variant="UiButtonVariant.ActionSubtle"
                                     Disabled="@isPublicKeySetupBusy"
                                     OnClick="CopyPublicKeySetupKeyAsync" />
                    <UiCommandButton Label="Copy command"
                                     Glyph="UiIconGlyph.Copy"
                                     Variant="UiButtonVariant.ActionSubtle"
                                     Disabled="@isPublicKeySetupBusy"
                                     OnClick="CopyPublicKeySetupCommandAsync" />
                    <UiCommandButton Label="Generate new key"
                                     Glyph="UiIconGlyph.Refresh"
                                     Variant="UiButtonVariant.Ghost"
                                     Disabled="@isPublicKeySetupBusy"
                                     OnClick="GeneratePublicKeySetupKeyAsync" />
                </div>

                <UiCheckboxField @bind-Value="keepStoredPasswordFallback"
                                 Label="Keep saved password as fallback"
                                 Helper="Recommended until the key has been used for a few normal connections. Disable it later if you want key-only SSH."
                                 Disabled="@(!publicKeySetupEditor.HasStoredPassword || isPublicKeySetupBusy)"
                                 Compact="true"
                                 Card="true" />

                @if (!string.IsNullOrWhiteSpace(publicKeySetupCommandOutput))
                {
                    <details class="hosts-public-key-command" open>
                        <summary>Last setup output</summary>
                        <pre class="command-preview-block command-display-block">@publicKeySetupCommandOutput</pre>
                    </details>
                }
            </div>
        }
    </ChildContent>

    <Footer>
        <div class="hosts-public-key-footer">
            @if (!string.IsNullOrWhiteSpace(publicKeySetupStatus))
            {
                <p class="callout @publicKeySetupTone hosts-public-key-status">@publicKeySetupStatus</p>
            }

            <div class="hosts-public-key-footer-actions">
                <UiCommandButton Label="Close"
                                 Glyph="UiIconGlyph.Clear"
                                 Variant="UiButtonVariant.Ghost"
                                 Disabled="@isPublicKeySetupBusy"
                                 OnClick="ClosePublicKeySetupAsync" />
                <UiCommandButton Label="@(isPublicKeySetupBusy ? "Working..." : "Install, test, and save")"
                                 Glyph="UiIconGlyph.Key"
                                 Disabled="@(!CanRunPublicKeySetup)"
                                 OnClick="InstallAndSavePublicKeyAsync" />
            </div>
        </div>
    </Footer>
</UiModal>

@if (peerAiHost is not null)
{
    <UiModal IsOpen="true" Title="@($"Use AI on {peerAiHost.Name}")" OnClose="ClosePeerAi" Class="hosts-peer-ai-modal">
        <div class="hosts-peer-ai-dialog">
            <p>The connection runs from this LMS server to the AI service over direct HTTP/HTTPS, using LAN or tailnet routing. SSH access alone does not create this connection.</p>
            <label>AI service URL<input @bind="peerAiUrl" placeholder="http://ai-host:11434" disabled="@peerAiBusy" /></label>
            <label>Host sharing access key<input type="password" @bind="peerAiKey" autocomplete="off" disabled="@peerAiBusy" /></label>
