    private Task UpdateAllLmsHostsAsync()
    {
        if (updatingAllHosts) return Task.CompletedTask;
        var targets = LmsHostRows.Select(row => row.Host).Where(host => !IsLmsUpdateActiveFor(host)).ToArray();
        updatingAllHosts = true;
        foreach (var host in targets) SetLmsUpdateOperation(host.Id, new(LmsHostUpdateOperationState.Started, "Queued for update.", DateTimeOffset.UtcNow));
        lmsConnectStatus = $"Updating {targets.Length} LMS host(s), each on its own release channel. Per-host progress appears in the list.";
        lmsConnectTone = "info";
        _ = RunAllLmsHostUpdatesAsync(targets);
        return Task.CompletedTask;
    }

    private async Task RunAllLmsHostUpdatesAsync(IReadOnlyList<ManagedHost> targets)
    {
        // Finish remote updates before self-update, which may restart this LMS process.
        foreach (var host in targets.Where(host => !IsCurrentLmsEndpoint(host)))
            await RunLmsHostUpdateInBackgroundAsync(host.Id);
        foreach (var host in targets.Where(IsCurrentLmsEndpoint))
        {
            try
            {
                var result = await LocalApplicationUpdates.InstallLatestAsync(CancellationToken.None);
                await SafeInvokeAsync(() => SetLmsUpdateOperation(host.Id, new(
                    result.State == ApplicationUpdateState.Failed ? LmsHostUpdateOperationState.Failed : result.State == ApplicationUpdateState.Installing ? LmsHostUpdateOperationState.Applying : LmsHostUpdateOperationState.Completed,
                    result.Summary, DateTimeOffset.UtcNow)));
            }
            catch (Exception ex) { await ApplyLmsHostUpdateFailureAsync(host.Id, ex.Message); }
        }
        await SafeInvokeAsync(() => { updatingAllHosts = false; lmsConnectStatus = "Update All finished or handed off to the local updater. Review each host’s result."; });
    }

    private Task StartLmsHostUpdateAsync(ManagedHost host)
    {
        if (IsLmsUpdateActiveFor(host) || IsCurrentLmsEndpoint(host))
        {
            return Task.CompletedTask;
        }

        SetLmsUpdateOperation(
            host.Id,
            new LmsHostUpdateOperation(
                LmsHostUpdateOperationState.Started,
                "Update started.",
                DateTimeOffset.UtcNow));

        _ = RunLmsHostUpdateInBackgroundAsync(host.Id);
        return Task.CompletedTask;
    }

    private async Task RunLmsHostUpdateInBackgroundAsync(Guid hostId)
    {
        var progress = new Progress<ManagedHostLmsInstallProgressUpdate>(update =>
        {
            _ = ApplyLmsHostUpdateProgressAsync(hostId, update);
        });

        try
        {
            var managedUpdate = await RemoteLmsSshTunnelService.UpdateAsync(hostId);
            if (managedUpdate is not null)
            {
                await SafeInvokeAsync(() => SetLmsUpdateOperation(hostId, new(
                    LmsHostUpdateOperationState.Completed, managedUpdate.Summary,
                    GetLmsUpdateOperation(hostId)?.StartedAtUtc ?? DateTimeOffset.UtcNow, DateTimeOffset.UtcNow)));
                await StatusCache.InvalidateAsync("hosts");
                await RefreshLmsUpdateStatusesAsync(CancellationToken.None);
                return;
            }
            await using var scope = ServiceScopeFactory.CreateAsyncScope();
            var hostService = scope.ServiceProvider.GetRequiredService<IManagedHostService>();
            var host = hostRows.FirstOrDefault(row => row.Host.Id == hostId)?.Host
                ?? throw new InvalidOperationException("Host not found.");
            var options = BuildLmsUpdateOptions();
            options.AdministratorInput = await AdministratorCredentials.ResolveAsync(hostId, host.Username);
            var result = await hostService.InstallLmsAsync(
                hostId,
                options,
                progress,
                CancellationToken.None);

            await ApplyLmsHostUpdateResultAsync(hostId, result);
        }
        catch (Exception ex)
        {
            await ApplyLmsHostUpdateFailureAsync(hostId, ex.Message);
        }
    }

    private Task ApplyLmsHostUpdateProgressAsync(Guid hostId, ManagedHostLmsInstallProgressUpdate update) =>
        SafeInvokeAsync(() =>
        {
            // Progress<T> posts callbacks asynchronously. A late callback must not replace the final result.
            if (GetLmsUpdateOperation(hostId)?.CompletedAtUtc is not null) return;
            var state = update.State switch
            {
                ManagedHostLmsInstallProgressState.Starting => LmsHostUpdateOperationState.Started,
                ManagedHostLmsInstallProgressState.Completed => LmsHostUpdateOperationState.Completed,
                ManagedHostLmsInstallProgressState.Failed => LmsHostUpdateOperationState.Failed,
                _ => LmsHostUpdateOperationState.Applying
            };

            var message = state switch
            {
                LmsHostUpdateOperationState.Started => "Update started.",
                LmsHostUpdateOperationState.Applying => "Applying update.",
                LmsHostUpdateOperationState.Completed => "Update finished.",
                LmsHostUpdateOperationState.Failed => FirstNonBlank(update.Message, "Update failed.")!,
                _ => FirstNonBlank(update.Message, "Update status changed.")!
            };

            SetLmsUpdateOperation(
                hostId,
                new LmsHostUpdateOperation(
                    state,
                    message,
                    update.OccurredAtUtc,
                    state is LmsHostUpdateOperationState.Completed or LmsHostUpdateOperationState.Failed
                        ? update.OccurredAtUtc
                        : null));
        });

    private Task ApplyLmsHostUpdateResultAsync(Guid hostId, ManagedHostLmsInstallResult result) =>
        SafeInvokeAsync(() =>
        {
            SetLmsUpdateOperation(
                hostId,
                new LmsHostUpdateOperation(
                    result.Success ? LmsHostUpdateOperationState.Completed : LmsHostUpdateOperationState.Failed,
                    result.Success ? "Update finished." : FirstNonBlank(result.Detail, result.Summary, "Update failed.")!,
                    result.StartedAtUtc,
                    result.CompletedAtUtc));
        });

    private Task ApplyLmsHostUpdateFailureAsync(Guid hostId, string message) =>
        SafeInvokeAsync(() =>
        {
            SetLmsUpdateOperation(
                hostId,
                new LmsHostUpdateOperation(
                    LmsHostUpdateOperationState.Failed,
                    FirstNonBlank(message, "Update failed.")!,
                    DateTimeOffset.UtcNow,
                    DateTimeOffset.UtcNow));
        });

