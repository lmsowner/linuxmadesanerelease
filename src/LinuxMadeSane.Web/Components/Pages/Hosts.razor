}

@code {
    private void PortalStatusesChanged()=>_ = SafeInvokeAsync(StateHasChanged);
    private FleetPackageUpdates? packageUpdates;
    private FleetPortalRegistration? portalRegistration;
    private bool portalRegistered;
    private readonly Dictionary<Guid, HostAiAvailability> hostAi = new();
    private ManagedHost? peerAiHost;
    private string peerAiUrl = "", peerAiKey = "", peerAiMessage = "", peerAiTone = "info";
    private bool peerAiBusy, peerAiDefault = true;

    private async Task RefreshHostAiAsync(Guid hostId, CancellationToken token)
    {
        try
        {
            using var scope = ServiceScopeFactory.CreateScope();
            var service = scope.ServiceProvider.GetRequiredService<HostAiAvailabilityService>();
            var directBaseUrl = GetCachedDirectBaseUrl(hostId);
            var status = await StatusCache.GetAsync("hosts", ("ai", StatusKey(hostRows.First(row => row.Host.Id == hostId).Host)), () => Task.Run(() => LinuxMadeSane.Core.Models.Ai.AiLocalMachine.IsLocalMachine(hostId)
                ? service.GetLocalAsync(token)
                : service.GetRemoteAsync(directBaseUrl, token), token));
            if (!token.IsCancellationRequested) await InvokeAsync(() => { hostAi[hostId] = status; StateHasChanged(); });
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception ex) { Logger.LogDebug(ex, "Could not check AI for host {HostId}", hostId); }
    }
    private void OpenPeerAi(ManagedHost host, HostAiAvailability ai)
    {
        peerAiHost = host; peerAiKey = ""; peerAiDefault = true;
        peerAiUrl = ai.Routes.FirstOrDefault(r => r.Reachable)?.Url ?? ai.Routes.FirstOrDefault()?.Url ?? "";
        peerAiTone = "info"; peerAiMessage = "Enter the host sharing key. Verification checks this LMS server’s route and the remote model before saving.";
    }
    private void ClosePeerAi() { if (peerAiBusy) return; peerAiHost = null; peerAiKey = ""; }
    private async Task SavePeerAiAsync()
    {
        if (peerAiHost is null || peerAiBusy) return;
        peerAiBusy = true; peerAiTone = "info"; peerAiMessage = "Verifying the AI route, access key and available model…";
        await InvokeAsync(StateHasChanged);
        try
        {
            var provider = await AiEngineManager.CreateOrUpdatePeerLmsProviderAsync(new PeerLmsAiProviderRequest(peerAiUrl, peerAiKey) { DisplayName = $"AI on {peerAiHost.Name}", SetDefault = peerAiDefault });
            peerAiKey = ""; peerAiTone = "success";
            peerAiMessage = $"Connected to {provider.DefaultModelId}. Available in AI tools, terminal and runbooks" + (provider.IsDefault ? " as the default provider." : ".");
            await RefreshTerminalAiAvailabilityAsync();
        }
        catch (Exception ex) { peerAiTone = "error"; peerAiMessage = ex.Message; }
        finally { peerAiBusy = false; }
    }

    private const string LmsHostsTabValue = "lms";
    private const string SshHostsTabValue = "ssh";
    private static readonly TimeSpan StatusCheckTimeout = TimeSpan.FromSeconds(8);
    private IReadOnlyList<HostRowState> hostRows = [];
    private readonly Dictionary<Guid, LmsHostEdgeGatewaySummary> edgeGatewaySummaries = [];
    private CancellationTokenSource? statusRefreshCancellationTokenSource;
    private bool isStatusRefreshInProgress;
    private bool isLmsUpdateRefreshInProgress;
    private bool updatingAllHosts;
    private string? lmsConnectUrl;
    private string activeHostTab = LmsHostsTabValue;
    private ManagedHost? publicKeySetupHost;
    private ManagedHostEditor? publicKeySetupEditor;
    private GeneratedSshKeyPair? publicKeySetupKeyPair;
    private bool isPublicKeySetupOpen;
    private bool isPublicKeySetupBusy;
    private bool keepStoredPasswordFallback = true;
    private string publicKeySetupStatus = string.Empty;
    private string publicKeySetupTone = "info";
    private string publicKeySetupCommandOutput = string.Empty;
    private ManagedHost? hostPendingRemoval;
    private bool isRemovingHost;
    private string removeHostStatus = string.Empty;
    private string removeHostTone = "info";
    private Guid? lmsConnectHostId;
    private string lmsConnectStatus = string.Empty;
    private string lmsConnectTone = "info";
    private readonly HashSet<Guid> thumbnailCacheFlushHostIds = [];
    private readonly Dictionary<Guid, LmsHostUpdateOperation> lmsUpdateOperations = [];

    private IReadOnlyList<HostRowState> LmsHostRows =>
        hostRows
            .Where(row => ManagedHostCapabilities.IsLmsHost(row.Host))
            .ToArray();

    private IReadOnlyList<HostRowState> SshHostRows =>
        hostRows
            .Where(row => !ManagedHostCapabilities.IsLmsHost(row.Host))
            .ToArray();

    private IReadOnlyList<HostRowState> ActiveHostRows =>
        string.Equals(activeHostTab, SshHostsTabValue, StringComparison.Ordinal)
            ? SshHostRows
            : LmsHostRows;

    private int ActiveOnlineHostCount => ActiveHostRows.Count(row => ResolveConnectionStatus(row) == ConnectionTestStatus.Succeeded);

    private int ActiveCheckingHostCount => isStatusRefreshInProgress
        ? ActiveHostRows.Count(row => !HasActiveTerminalSession(row.Host.Id))
        : 0;

    private int ActiveOfflineHostCount => ActiveHostRows.Count(row => !row.IsStatusLoading && ResolveConnectionStatus(row) != ConnectionTestStatus.Succeeded);

    private string RemoveHostDialogSubtitle =>
        hostPendingRemoval is null
            ? "Remove a host registration from LMS."
            : ManagedHostCapabilities.IsLmsHost(hostPendingRemoval)
                ? "Remove a remote LMS host registration without uninstalling the remote machine."
                : "Remove an SSH host registration from LMS.";

    private bool CanConfirmRemoveHost =>
        hostPendingRemoval is not null &&
        !isRemovingHost &&
        CanRemoveHost(hostPendingRemoval);

    private bool terminalAiAvailable;
    private static string HostTerminalPopupName(ManagedHost host) => $"lms-host-terminal-{host.Id:N}";
    private static string PrepareHostTerminalPopup(ManagedHost host) =>
        $"window.lmsTerminalWindow?.preparePopup('{HostTerminalPopupName(host)}');";

    private async Task<bool> HasTerminalAiAsync()
    {
        var context = await AiThreadService.GetEditorAsync();
        return context.ConfiguredProviders.Any(provider => provider.IsEnabled &&
            (!provider.RequiresApiKey || provider.HasApiKeyConfigured) &&
            context.SupportedProviders.Any(definition => definition.ProviderType == provider.ProviderType && definition.IsRuntimeImplemented));
    }

    private async Task RefreshTerminalAiAvailabilityAsync()
    {
        try { terminalAiAvailable = await HasTerminalAiAsync(); }
        catch (Exception exception) { Logger.LogWarning(exception, "Could not check local terminal AI availability"); terminalAiAvailable = false; }
        await SafeInvokeAsync(StateHasChanged);
    }

    private async Task OpenHostTerminalAsync(ManagedHost host, string? updateFailure = null)
    {
        var popupName = HostTerminalPopupName(host);
        try
        {
            if (updateFailure is not null && !await HasTerminalAiAsync())
                throw new InvalidOperationException("AI is no longer enabled on this LMS host. Open the terminal to investigate manually.");
            var workspace = TerminalWorkspaceRegistry.GetOrCreate(TerminalWorkspaceAccessor.GetWorkspaceId());
            await TerminalWorkspaceRegistry.RefreshSessionsAsync(host.Id);
            var tab = updateFailure is null ? workspace.EnsureHostTab(host) : workspace.AddTab(host);
            if (updateFailure is null && !tab.ConnectionDesired && !tab.IsBusy && tab.Snapshot is not null)
                tab = workspace.AddTab(host);
            if (updateFailure is not null)
            {
                tab.PendingAiTaskPrompt = $"Investigate and help repair the failed LMS update on this connected host ({host.Name}). The update reported:\n{updateFailure}\nCheck the actual installer/service logs and current installed version before proposing a fix. Preserve configuration, credentials and data. Do not change release channel or use Home Lab repair tools. Explain the cause and verify LMS health after any approved repair.";
                tab.PendingSudoAuthentication = TerminalAiSecureInputPolicy.HasSudoAuthenticationFailure(updateFailure);
                tab.StartPendingAiTask = true;
                workspace.SetAiPanelOpen(tab.Id, true);
            }
            var opened = await JSRuntime.InvokeAsync<bool>("lmsTerminalWindow.openPopup", $"/terminal-window/{tab.Id}?autoconnect=true", popupName);
            if (!opened) throw new InvalidOperationException("Your browser blocked the terminal window. Allow popups for LMS and try again.");
            workspace.SetDetached(tab.Id, true);
        }
        catch (Exception exception)
        {
            lmsConnectStatus = $"Could not open {host.Name}'s terminal: {exception.Message}";
            lmsConnectTone = "error";
            await JSRuntime.InvokeAsync<bool>("lmsTerminalWindow.setPreparedPopupStatus", popupName, "Could not open terminal", exception.Message, "error");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        FleetRegistration.Changed+=PortalStatusesChanged;
        var portalStatus=await PortalRegistration.StatusAsync();
        portalRegistered=portalStatus is {IsEnabled:true,PortalInstanceId:not null,PortalOrganizationId:not null};
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(NavigationManager.Uri).Query);
        if (query.TryGetValue("tab", out var tab)) await HandleHostTabChangedAsync(tab.ToString());
        if (query.TryGetValue("details", out var inlineHost) && Guid.TryParse(inlineHost, out var inlineHostId)) expandedHostId = detailedHostId = inlineHostId;
        var hosts = await HostService.ListHostsAsync();
        await TerminalWorkspaceRegistry.RefreshSessionsAsync();
        hostRows = hosts
            .OrderBy(ManagedHostCapabilities.GetSortRank)
            .ThenBy(host => host.Name, StringComparer.OrdinalIgnoreCase)
            .Select(host =>
            {
                var hasActiveSession = TerminalWorkspaceRegistry.HasActiveSession(host.Id);

                return new HostRowState
                {
                    Host = host,
                    ConnectionTest = hasActiveSession
                        ? BuildLiveSessionConnectionResult()
                        : BuildCachedConnectionResult(host),
                    IsStatusLoading = false
                };
            })
            .ToArray();

        if (expandedHostId is { } expandedId && hostRows.FirstOrDefault(row => row.Host.Id == expandedId) is { } expandedRow)
            activeHostTab = ManagedHostCapabilities.IsLmsHost(expandedRow.Host) ? LmsHostsTabValue : "ssh";
        isStatusRefreshInProgress = hostRows.Any(row => !HasActiveTerminalSession(row.Host.Id));
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            statusRefreshCancellationTokenSource = new CancellationTokenSource();
            _ = RefreshStatusesAsync(statusRefreshCancellationTokenSource.Token);
            _ = RefreshLmsUpdateStatusesAsync(statusRefreshCancellationTokenSource.Token);
            _ = RefreshEdgeGatewaySummariesAsync(statusRefreshCancellationTokenSource.Token);
            _ = RefreshBenchmarksAsync(statusRefreshCancellationTokenSource.Token);
            _ = RefreshTerminalAiAvailabilityAsync();
            _ = MonitorTerminalSessionsAsync(statusRefreshCancellationTokenSource.Token);
        }

        return Task.CompletedTask;
    }

    private string? GetCachedDirectBaseUrl(Guid hostId) =>
        hostRows.FirstOrDefault(row => row.Host.Id == hostId)?.LmsUpdate?.VerifiedDirectBaseUrl
        ?? LmsUpdateAvailabilityService.GetDirectBaseUrl(hostId);

    private bool refreshingHosts;
    private static ManagedHost StatusKey(ManagedHost host) => host with
    {
        LastSeenUtc = null, LastConnectionTestStatus = default, OperatingStatus = default
    };

    private async Task RefreshHostsAsync()
    {
        if (refreshingHosts) return;
        refreshingHosts = true;
        lmsConnectStatus = "Refreshing host status and versions…";
        lmsConnectTone = "info";
        await InvokeAsync(StateHasChanged);
        await StatusCache.InvalidateAsync("hosts");
        var token = statusRefreshCancellationTokenSource?.Token ?? CancellationToken.None;
        try
        {
            await Task.WhenAll(RefreshStatusesAsync(token), RefreshLmsUpdateStatusesAsync(token),
                RefreshEdgeGatewaySummariesAsync(token), RefreshBenchmarksAsync(token));
            lmsConnectStatus = "Host checks completed. Results are cached for five minutes.";
            lmsConnectTone = "success";
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception ex) { lmsConnectStatus = "Could not refresh hosts: " + ex.Message; lmsConnectTone = "error"; }
        finally { refreshingHosts = false; }
    }

    private async Task MonitorTerminalSessionsAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
            var previous = TerminalSessionSummary();
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await TerminalWorkspaceRegistry.RefreshSessionsAsync(cancellationToken: cancellationToken);
                var current = TerminalSessionSummary();
                if(current==previous) continue;
                previous=current;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    }

    public async ValueTask DisposeAsync()
    {
        FleetRegistration.Changed-=PortalStatusesChanged;
        if (statusRefreshCancellationTokenSource is not null)
        {
            await statusRefreshCancellationTokenSource.CancelAsync();
            statusRefreshCancellationTokenSource.Dispose();
        }
    }

    private string TerminalSessionSummary()=>string.Join(';',hostRows.Select(row=>$"{row.Host.Id}:{TerminalWorkspaceRegistry.GetOpenSessionCount(row.Host.Id)}:{HasActiveTerminalSession(row.Host.Id)}"));
    private Guid? expandedHostId, detailedHostId;
    private void ToggleHostDetails(Guid hostId)
    {
        if(expandedHostId==hostId) expandedHostId=null;
        else expandedHostId=detailedHostId=hostId;
    }
    private string? GetInlineLmsEndpoint(ManagedHost host) => IsCurrentLmsEndpoint(host)
        ? NavigationManager.BaseUri.TrimEnd('/') : GetCachedDirectBaseUrl(host.Id);

    private Task HandleHostTabChangedAsync(string? value)
    {
        activeHostTab = value is "ssh" or "sftp" or "remote-desktop" ? value : LmsHostsTabValue;
        return Task.CompletedTask;
    }

    private Task OpenRemoveHostDialog(ManagedHost host)
    {
        if (!CanRemoveHost(host) || isRemovingHost)
        {
            return Task.CompletedTask;
        }

        hostPendingRemoval = host;
        removeHostStatus = string.Empty;
        removeHostTone = "info";
        return Task.CompletedTask;
    }

    private Task CloseRemoveHostDialog()
    {
        if (!isRemovingHost)
        {
            hostPendingRemoval = null;
            removeHostStatus = string.Empty;
        }

        return Task.CompletedTask;
    }

    private async Task ConfirmRemoveHostAsync()
    {
        var host = hostPendingRemoval;
        if (host is null || !CanRemoveHost(host) || isRemovingHost)
        {
            return;
        }

        isRemovingHost = true;
        removeHostStatus = "Removing host...";
        removeHostTone = "info";

        try
        {
            await HostService.DeleteHostAsync(host.Id);
            hostRows = hostRows
                .Where(row => row.Host.Id != host.Id)
                .ToArray();
            lmsUpdateOperations.Remove(host.Id);

            if (publicKeySetupHost?.Id == host.Id)
            {
                isPublicKeySetupOpen = false;
                publicKeySetupHost = null;
                publicKeySetupEditor = null;
                publicKeySetupKeyPair = null;
            }

            hostPendingRemoval = null;
            removeHostStatus = string.Empty;
            lmsConnectStatus = $"Removed {host.Name}.";
            lmsConnectTone = "success";
        }
        catch (Exception exception)
        {
            removeHostStatus = exception.Message;
            removeHostTone = "error";
        }
        finally
        {
            isRemovingHost = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private readonly Dictionary<Guid, LmsHostBenchmark> hostBenchmarks = [];
    private async Task RefreshBenchmarksAsync(CancellationToken token)
    {
        using var gate = new SemaphoreSlim(3);
        try
        {
            await Task.WhenAll(LmsHostRows.Select(async row =>
            {
                await gate.WaitAsync(token);
                try
                {
                    var result = await StatusCache.GetAsync("hosts", ("benchmark", StatusKey(row.Host)), () => BenchmarkService.GetAsync(row.Host, token));
                    await InvokeAsync(() => { if (!token.IsCancellationRequested) { hostBenchmarks[row.Host.Id] = result; StateHasChanged(); } });
                }
                finally { gate.Release(); }
            }));
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
    }

    private async Task RefreshEdgeGatewaySummariesAsync(CancellationToken cancellationToken)
    {
        using var concurrency = new SemaphoreSlim(3);
        var tasks = LmsHostRows.Select(async row =>
        {
            await concurrency.WaitAsync(cancellationToken);
            try
            {
                var summary = await StatusCache.GetAsync("hosts", ("edge", StatusKey(row.Host)), () => EdgeGatewaySummaryService.GetAsync(row.Host, cancellationToken));
                await InvokeAsync(() =>
                {
                    if (cancellationToken.IsCancellationRequested) return;
                    edgeGatewaySummaries[row.Host.Id] = summary;
                    StateHasChanged();
                });
            }
            finally
            {
                concurrency.Release();
            }
        }).ToArray();
        try
        {
            await Task.WhenAll(tasks);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private async Task RefreshStatusesAsync(CancellationToken cancellationToken)
    {
        var hostsToRefresh = hostRows
            .Where(row => !HasActiveTerminalSession(row.Host.Id))
            .Select(row => row.Host)
            .ToArray();

        if (hostsToRefresh.Length == 0)
        {
            isStatusRefreshInProgress = false;
            return;
        }

        try
        {
            var work = hostsToRefresh
                .Select(host => ProbeHostStatusAsync(host, cancellationToken))
                .ToList();

            while (work.Count > 0)
            {
                var completed = await Task.WhenAny(work);
                work.Remove(completed);
                var result = await completed;
                await ApplyHostStatusResultAsync(result);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        finally
        {
            isStatusRefreshInProgress = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RefreshLmsUpdateStatusesAsync(CancellationToken cancellationToken)
    {
        var lmsHosts = hostRows
            .Where(row => ManagedHostCapabilities.IsLmsHost(row.Host))
            .Select(row => row.Host)
            .ToArray();

        if (lmsHosts.Length == 0)
        {
            return;
        }

        isLmsUpdateRefreshInProgress = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var latestVersionTask = StatusCache.GetAsync("hosts", "latest", () => LmsUpdateAvailabilityService.CheckLatestVersionAsync(cancellationToken));
            var latest = await latestVersionTask;
            var checks = lmsHosts.Select(host => StatusCache.GetAsync("hosts", ("update", StatusKey(host)), () => LmsUpdateAvailabilityService.CheckHostAsync(host, latest, cancellationToken))).ToList();
            var aiChecks = new List<Task>();
            while (checks.Count > 0)
            {
                var completed = await Task.WhenAny(checks); checks.Remove(completed);
                var update = await completed;
                await ApplyLmsUpdateResultAsync(update);
                aiChecks.Add(RefreshHostAiAsync(update.HostId, cancellationToken));
            }
            await Task.WhenAll(aiChecks);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            hostRows = hostRows
                .Select(row => new HostRowState
                {
                    Host = row.Host,
                    ConnectionTest = row.ConnectionTest,
                    IsStatusLoading = row.IsStatusLoading,
                    LmsUpdate = ManagedHostCapabilities.IsLmsHost(row.Host)
                        ? new LmsHostUpdateAvailability(
                            row.Host.Id,
                            LmsHostUpdateAvailabilityState.Unknown,
                            "Unknown",
                            "Unknown",
                            ex.Message)
                        : row.LmsUpdate
                })
                .ToArray();
        }
        finally
        {
            isLmsUpdateRefreshInProgress = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static LmsLatestVersionCheck ResolveEffectiveLatestVersion(
        LmsLatestVersionCheck publicManifestVersionCheck,
        string localLatestVersion)
    {
        if (string.IsNullOrWhiteSpace(localLatestVersion))
        {
            return publicManifestVersionCheck;
        }

        if (!publicManifestVersionCheck.HasVersion ||
            ApplicationUpdateVersionComparer.IsNewer(localLatestVersion, publicManifestVersionCheck.Version))
        {
            return new LmsLatestVersionCheck(localLatestVersion, publicManifestVersionCheck.Failure);
        }

        return publicManifestVersionCheck;
    }

    private Task ApplyHostStatusResultAsync(HostStatusProbeResult result) =>
        InvokeAsync(() =>
        {
            hostRows = hostRows
                .Select(row =>
                {
                    if (row.Host.Id != result.HostId)
                    {
                        return row;
                    }

                    if (HasActiveTerminalSession(row.Host.Id))
                    {
                        return new HostRowState
                        {
                            Host = row.Host,
                            ConnectionTest = BuildLiveSessionConnectionResult(),
                            IsStatusLoading = false,
                            LmsUpdate = row.LmsUpdate
                        };
                    }

                    return new HostRowState
                    {
                        Host = ApplyConnectionResult(row.Host, result.Connection),
                        ConnectionTest = result.Connection,
                        IsStatusLoading = false,
                        LmsUpdate = row.LmsUpdate
                    };
                })
                .ToArray();
            StateHasChanged();
        });

    private Task ApplyLmsUpdateResultAsync(LmsHostUpdateAvailability update) =>
        InvokeAsync(() =>
        {
            hostRows = hostRows
                .Select(row => row.Host.Id == update.HostId
                    ? new HostRowState
                    {
                        Host = row.Host,
                        ConnectionTest = row.ConnectionTest,
                        IsStatusLoading = row.IsStatusLoading,
                        LmsUpdate = update
                    }
                    : row)
                .ToArray();
            StateHasChanged();
        });


    private async Task<HostStatusProbeResult> ProbeHostStatusAsync(
        ManagedHost host,
        CancellationToken cancellationToken)
    {
        return await StatusCache.GetAsync("hosts", ("connection", StatusKey(host)), () => Task.Run(
            () => ProbeHostStatusCoreAsync(host, cancellationToken),
            cancellationToken));
    }

    private async Task<HostStatusProbeResult> ProbeHostStatusCoreAsync(
        ManagedHost host,
        CancellationToken cancellationToken)
    {
        try
        {
            await using var scope = ServiceScopeFactory.CreateAsyncScope();
            var hostService = scope.ServiceProvider.GetRequiredService<IManagedHostService>();
            using var probeCancellationTokenSource = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);
            probeCancellationTokenSource.CancelAfter(StatusCheckTimeout);

            var connectionTask = hostService.TestConnectionAsync(host, probeCancellationTokenSource.Token);

            try
            {
                return new HostStatusProbeResult(
                    host.Id,
                    await connectionTask.WaitAsync(StatusCheckTimeout, cancellationToken));
            }
            catch (TimeoutException)
            {
                probeCancellationTokenSource.Cancel();
                _ = ObserveLateConnectionResultAsync(connectionTask);
                return new HostStatusProbeResult(host.Id, BuildTimedOutConnectionResult());
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            throw;
        }
        catch
        {
            return new HostStatusProbeResult(
                host.Id,
                new HostConnectionTestResult(
                    ConnectionTestStatus.Failed,
                    "Connection check failed.",
                    null,
                    DateTimeOffset.UtcNow));
        }
    }

