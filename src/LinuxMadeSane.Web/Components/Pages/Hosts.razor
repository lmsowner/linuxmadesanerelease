    private UiPillTone GetLmsUpdateTone(HostRowState row)
    {
        var operation = GetLmsUpdateOperation(row.Host.Id);
        if (operation is not null)
        {
            return operation.State switch
            {
                LmsHostUpdateOperationState.Completed => UiPillTone.Success,
                LmsHostUpdateOperationState.Failed => UiPillTone.Failure,
                _ => UiPillTone.Warning
            };
        }

        if (row.LmsUpdate is null)
        {
            return isLmsUpdateRefreshInProgress ? UiPillTone.Warning : UiPillTone.Neutral;
        }

        return row.LmsUpdate.State switch
        {
            LmsHostUpdateAvailabilityState.UpdateAvailable => UiPillTone.Warning,
            LmsHostUpdateAvailabilityState.Current => UiPillTone.Success,
            _ => UiPillTone.Neutral
        };
    }

