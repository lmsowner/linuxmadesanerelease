    private string BuildDirectLmsRootUrl(ManagedHost host) =>
        BuildDirectLmsUrl(host, "/");

    private string BuildDirectLmsUrl(ManagedHost host, string path)
    {
        if (GetCachedDirectBaseUrl(host.Id) is { } verifiedUrl)
            return new Uri(new Uri(verifiedUrl), path).ToString();
        var endpoint = host.Hostname.Trim();
        var scheme = Uri.UriSchemeHttp;
        if (Uri.TryCreate(endpoint, UriKind.Absolute, out var uri))
        {
            endpoint = uri.Host;
            scheme = uri.Scheme.Equals(Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase)
                ? Uri.UriSchemeHttps
                : Uri.UriSchemeHttp;
        }

        return new UriBuilder(scheme, endpoint, 5080, path.TrimStart('/')).Uri.ToString();
    }

    private async Task ConnectToRemoteLmsAsync(ManagedHost host)
    {
        if (!CanConnectRemoteLmsHostThroughSsh(host) || IsLmsConnectBusyFor(host))
        {
            return;
        }

        lmsConnectHostId = host.Id;
        lmsConnectStatus = $"Opening an SSH tunnel to {host.Name}...";
        lmsConnectTone = "info";
        var popupName = BuildRemoteLmsPopupName(host);
        lmsConnectUrl = null;
        var popupPrepared = await JSRuntime.InvokeAsync<bool>("lmsTerminalWindow.prepareBrowserWindow", popupName);
        if (popupPrepared)
        {
            _ = await JSRuntime.InvokeAsync<bool>(
                "lmsTerminalWindow.setPreparedPopupStatus",
                popupName,
                $"Connecting to {host.Name}",
                "Opening the SSH tunnel and preparing the Caddy relay.");
        }

        try
        {
            var connection = await RemoteLmsSshTunnelService.ConnectAsync(host.Id);
            if (popupPrepared)
            {
                _ = await JSRuntime.InvokeAsync<bool>(
                    "lmsTerminalWindow.setPreparedPopupStatus",
                    popupName,
                    $"Opening {host.Name}",
                    "Caddy relay is ready. Opening the remote LMS.");
            }

            var opened = await JSRuntime.InvokeAsync<bool>(
                "lmsTerminalWindow.openPreparedBrowserWindow",
                connection.Url,
                popupName);
            if (!opened)
            {
                lmsConnectUrl = connection.Url;
                lmsConnectStatus = "The connection is ready. Your browser blocked the new window; use Open LMS to open it.";
                lmsConnectTone = "info";
            }
        }
        catch (Exception ex)
        {
            lmsConnectStatus = $"Could not connect to {host.Name} through SSH: {ex.Message}";
            lmsConnectTone = "error";
            if (popupPrepared)
            {
                _ = await JSRuntime.InvokeAsync<bool>(
                    "lmsTerminalWindow.setPreparedPopupStatus",
                    popupName,
                    $"Could not open {host.Name}",
                    ex.Message,
                    "error");
            }
        }
        finally
        {
            lmsConnectHostId = null;
        }
    }

