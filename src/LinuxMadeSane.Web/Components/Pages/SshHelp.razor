@page "/help/ssh"
@rendermode InteractiveServer
@inject NavigationManager Navigation
<PageTitle>SSH made simple | Linux Made Sane</PageTitle>
<div class="surface-card stack-list">
    <h1>SSH made simple</h1>
    <p>Keys, passwords and what to check when a connection fails.</p>
    <UiCommandButton Label="Open SSH guide" Glyph="UiIconGlyph.Info" OnClick="() => isOpen = true" />
</div>
<SshHelpDialog IsOpen="isOpen" InitialSection="@Section" OnClose="() => isOpen = false" />
@code {
    private bool isOpen = true;
    private string Section => new Uri(Navigation.Uri).Fragment.TrimStart('#');
}
