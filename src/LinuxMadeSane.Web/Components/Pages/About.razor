@page "/about"
@rendermode InteractiveServer
@using LinuxMadeSane.Core.Versioning

<PageTitle>About | Linux Made Sane</PageTitle>

<div class="about-page">
    <section class="about-hero" aria-labelledby="about-title">
        <div class="about-hero-copy">
            <span class="about-eyebrow">A little sanity for your server</span>
            <h1 id="about-title">Linux Made Sane<span class="about-title-dot">.</span></h1>
            <p class="about-intro">Your Linux world. One thoughtful workspace.</p>
            <p class="about-description">Hosts, terminals, files and services — with the tools you need to make Linux feel like home.</p>
            <div class="about-build"><span class="about-version">@ProductVersion</span></div>
            <div class="about-project-links" aria-label="Project links">
                <a href="@AboutCredits.WebsiteUrl" target="_blank" rel="noopener noreferrer" class="about-project-link about-primary-link">
                    <UiGlyphIcon Glyph="UiIconGlyph.Website" /><span>Visit website</span><span aria-hidden="true">↗</span>
                </a>
                <a href="@AboutCredits.GitHubUrl" target="_blank" rel="noopener noreferrer" class="about-project-link">
                    <span class="about-github-mark" aria-hidden="true"></span><span>GitHub</span><span aria-hidden="true">↗</span>
                </a>
            </div>
        </div>
        <div class="about-hero-art" aria-hidden="true"><img src="/images/lms-logo.png" alt="" /><span>LINUX MADE SANE</span></div>
    </section>

    <section class="about-thanks" aria-labelledby="about-thanks-title">
        <div><span class="about-eyebrow">Built with great company</span><h2 id="about-thanks-title">Made possible by the community.</h2>
            <p>Thank you to the maintainers and contributors whose work powers LMS. Each project keeps its own license and attribution.</p></div>
        <div class="about-framework"><strong>.NET @Environment.Version</strong><span>ASP.NET Core &amp; Blazor</span><a href="https://github.com/dotnet/dotnet" target="_blank" rel="noopener noreferrer">Framework &amp; runtime · MIT ↗</a></div>
    </section>

    <section class="about-packages" aria-labelledby="about-packages-title">
        <div class="about-section-heading"><div><h2 id="about-packages-title">Packages &amp; acknowledgments</h2><p>Explore the libraries behind the server, Desktop Assistant and browser experience.</p></div><span class="about-count">@AboutCredits.Packages.Count packages</span></div>
        <div class="about-package-toolbar">
            <div class="about-package-filters" aria-label="Filter packages">
                @foreach (var group in Groups)
                {
                    <button type="button" class="@(selectedGroup == group ? "selected" : null)" aria-pressed="@(selectedGroup == group ? "true" : "false")" @onclick="() => selectedGroup = group">@group</button>
                }
            </div>
            <input class="about-search" type="search" aria-label="Search packages or licenses" placeholder="Search packages or licenses…" @bind="search" @bind:event="oninput" />
        </div>
        <p class="about-results" role="status">@VisiblePackages.Count of @AboutCredits.Packages.Count packages</p>
        <div class="about-package-list" role="region" aria-label="Package acknowledgments" tabindex="0">
            @foreach (var package in VisiblePackages)
            {
                <article class="about-package" @key="package">
                    <div class="about-package-main">
                        <div class="about-package-name"><a href="@package.Url" target="_blank" rel="noopener noreferrer">@package.Name <span aria-hidden="true">↗</span></a><span class="about-package-version">@package.Version</span></div>
                        <p>@package.Description</p>
                        <span class="about-package-authors">@package.Authors</span>
                    </div>
                    <div class="about-package-meta">
                        <a class="about-license" href="@package.LicenseUrl" target="_blank" rel="noopener noreferrer" aria-label="@($"{package.Name} license: {package.License}")">@package.License</a>
                        <span>@string.Join(" · ", package.Groups)</span>
                        @if (!string.IsNullOrEmpty(package.PackageUrl))
                        {
                            <a class="about-nuget" href="@package.PackageUrl" target="_blank" rel="noopener noreferrer" aria-label="@($"{package.Name} {package.Version} on NuGet")">NuGet ↗</a>
                        }
                    </div>
                </article>
            }
            @if (VisiblePackages.Count == 0)
            {
                <p class="about-empty">No matching packages. Try another name or license, or choose All.</p>
            }
        </div>
        <p class="about-inventory-note">NuGet entries include direct, transitive and build dependencies resolved for Community Edition and its Desktop Assistant. Platform-specific assets depend on the build. “Bundled” means the vendored asset does not declare a verified version.</p>
    </section>

    <section class="about-notices" aria-labelledby="about-notices-title">
        <div class="about-section-heading"><div><h2 id="about-notices-title">Licenses &amp; notices</h2><p>Copyright © Linux Made Sane. Third-party components remain under their own licenses.</p></div></div>
        <div class="about-license-summary"><strong>Community Edition · Business Source License 1.1</strong><p>The applicable Change Date and Apache-2.0 Change License are set out in the full LMS license below.</p></div>
        @foreach (var notice in AboutCredits.Notices)
        {
            <details class="about-notice"><summary>@notice.Title <span>@notice.FileName</span></summary><pre>@notice.Text</pre></details>
        }
        <details class="about-notice"><summary>Development &amp; optional system tools</summary>
            <div class="about-system-notes">
                <p>Additional development tools include xUnit, VSTest and coverlet. Demo Mode uses Microsoft.Playwright and YamlDotNet. These are separate from the CE runtime package inventory above.</p>
                <p>Host integrations can use tools such as Caddy, cloudflared, Docker, OpenSSH, UFW, Samba, cifs-utils, Postfix, FFmpeg and FFprobe. These are installed or provided separately; their versions, notices and license terms come from the installed upstream or distribution packages.</p>
                <p>GitHub and the Invertocat mark are trademarks of GitHub, Inc. Links to upstream projects do not imply affiliation or endorsement. Embedded vendor notices are retained in the distributed browser assets.</p>
            </div>
        </details>
    </section>
    <footer class="about-footer"><img src="/images/lms-logo.png" alt="" /><span>Made for the people who look after Linux.</span></footer>
</div>

@code {
    private static readonly string ProductVersion = LinuxMadeSaneBuildVersion.GetCurrent(typeof(About).Assembly);
    private static readonly string[] Groups = ["All", "Server", "Desktop Assistant", "Browser libraries"];
    private string selectedGroup = "All";
    private string search = string.Empty;
    private IReadOnlyList<AboutPackage> VisiblePackages => AboutCredits.Packages.Where(package =>
        (selectedGroup == "All" || package.Groups.Contains(selectedGroup)) &&
        (string.IsNullOrWhiteSpace(search) || $"{package.Name} {package.License} {package.Authors} {package.Description}".Contains(search.Trim(), StringComparison.OrdinalIgnoreCase))).ToArray();
}
