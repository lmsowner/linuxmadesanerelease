@using LinuxMadeSane.Core.Versioning
@rendermode InteractiveServer
@using LinuxMadeSane.Application.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using System.Text.Json
@implements IAsyncDisposable
@inject IUserDisplayPreferenceService UserDisplayPreferenceService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JSRuntime
@inject LinuxMadeSane.Web.Services.OverviewRefreshPreference RefreshPreference

<div class="nav-shell @(mobileMenuOpen ? "mobile-open" : string.Empty)" @ref="navShellElement">
    <div class="nav-shell-top">
        <div class="brand-lockup">
            <button class="brand-link"
                    type="button"
                    title="About Linux Made Sane"
                    aria-label="About Linux Made Sane"
                    data-about-open>
            <span class="brand-mark">
                <img class="brand-logo" src="/images/lms-logo.png" alt="" />
            </span>
            <span class="brand-text">
                <span class="brand-name">Linux Made Sane</span>
                <span class="brand-version" title="Linux Made Sane @ProductVersion">@VersionLabel</span>
            </span>
        </button>
        <button class="ui-button glass-button glass-button-toolbar sidebar-mobile-menu-button"
                type="button"
                aria-expanded="@mobileMenuOpen"
                aria-controls="sidebar-mobile-navigation"
                @onclick="ToggleMobileMenu">
            Menu <span aria-hidden="true">@(mobileMenuOpen ? "▴" : "▾")</span>
        </button>
        </div>

        <button class="ui-button glass-button glass-button-toolbar ui-icon-button sidebar-hide-button"
                type="button"
                title="Hide sidebar"
                aria-label="Hide sidebar"
                data-sidebar-toggle="hide">
            <span class="ui-button-icon" aria-hidden="true">
                <UiGlyphIcon Glyph="UiIconGlyph.SidebarCollapse" />
            </span>
            <span class="ui-button-label">Hide sidebar</span>
        </button>
    </div>

    <div id="sidebar-mobile-navigation" class="sidebar-section @(mobileMenuOpen ? "mobile-open" : string.Empty)">
        <div class="nav-button-list" @ref="navListElement" @onclick="CloseMobileMenu">
            @foreach (var item in OrderedNavItems)
            {
                <div @key="item.Href" class="nav-reorder-item" data-nav-path="@item.Href">
                    <UiNavButton Href="@item.Href"
                                 Label="@item.Label"
                                 Match="@item.Match"
                                 Preview="@item.Preview"
                                 IconName="@item.Icon"
                                 AdditionalActivePathPrefixes="@item.AdditionalActivePathPrefixes" />
                </div>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(orderError))
        {
            <p class="sidebar-order-error" role="alert">@orderError</p>
        }
    </div>

    <div class="sidebar-footer">
        <div class="sidebar-account" data-lms-account>
            @if (IsAuthenticated)
            {
                <div class="sidebar-account-chip" aria-label="@LmsAccountLabel">
                    <div class="sidebar-account-details">
                        <span class="sidebar-account-kicker">LMS Account</span>
                        <span class="sidebar-account-value" title="@AuthenticatedEmail">@AuthenticatedEmail</span>
                        <span class="sidebar-account-auth" aria-label="Authentication method: @AuthenticationMethod">@AuthenticationMethod</span>
                    </div>
                    <UiIconButton Label="Sign out"
                                  Glyph="UiIconGlyph.SignOut"
                                  Class="sidebar-signout-button"
                                  aria-haspopup="dialog"
                                  data-account-signout-open />
                </div>

                <dialog class="sidebar-signout-dialog"
                        data-account-signout-dialog
                        aria-labelledby="@signOutTitleId"
                        aria-describedby="@signOutDescriptionId">
                    <header class="sidebar-signout-heading">
                        <h2 id="@signOutTitleId">Sign out of LMS?</h2>
                        <UiIconButton Label="Close sign-out dialog"
                                      Glyph="UiIconGlyph.Clear"
                                      data-account-signout-close />
                    </header>
                    <p id="@signOutDescriptionId">End your LMS session in this browser.</p>
                    <p class="sidebar-signout-email">@AuthenticatedEmail</p>
                    <form method="post" action="/auth/logout" data-enhance="false" class="sidebar-signout-actions">
                        <UiButton Type="button" Variant="UiButtonVariant.Ghost" data-account-signout-close autofocus>Cancel</UiButton>
                        <UiCommandButton Label="Sign out" Glyph="UiIconGlyph.SignOut" Type="submit" />
                    </form>
                </dialog>
            }

            <div class="sidebar-linux-row">
                <div class="sidebar-linux-user" title="Local Linux account on this LMS instance: @LinuxUsername" aria-label="Local Linux user: @LinuxUsername">
                    <span class="sidebar-linux-user-icon" aria-hidden="true"><UiGlyphIcon Glyph="UiIconGlyph.User" /></span>
                    <span class="sidebar-linux-user-label">Linux</span>
                    <strong>@LinuxUsername</strong>
                </div>
                <div class="sidebar-workspace-actions" aria-label="Local workspaces">
                    <UiIconButton Label="Open a new terminal window"
                                  Glyph="UiIconGlyph.Terminal" Class="sidebar-workspace-button"
                                  Href="/local-workspace/terminal" Target="_blank" Rel="noopener"
                                  OnClientClick="if (window.lmsTerminalWindow?.openPopup(this.href, '_blank')) return false;" />
                    <UiIconButton Label="Open a new files window"
                                  Glyph="UiIconGlyph.Files" Class="sidebar-workspace-button"
                                  Href="/local-workspace/files" Target="_blank" Rel="noopener"
                                  OnClientClick="if (window.lmsTerminalWindow?.openPopup(this.href, '_blank')) return false;" />
                </div>
            </div>
        </div>
    </div>
</div>

<div class="host-file-browser-context-menu sidebar-context-menu" popover="auto" tabindex="-1"
     role="menu" aria-label="Sidebar actions" data-lms-context-menu="true" @ref="sidebarMenuElement">
    <UiDisplayPreferenceToolbar AsContextMenu="true" />
    <UiContextSubmenu Label="Overview update speed" Glyph="UiIconGlyph.Refresh">
        @for (var index = 0; index < LinuxMadeSane.Web.Services.OverviewRefreshPreference.IntervalsSeconds.Length; index++)
        {
            var preset = index;
            var seconds = LinuxMadeSane.Web.Services.OverviewRefreshPreference.IntervalsSeconds[index];
            <UiContextMenuButton Label="@(seconds == 0 ? "Manual" : $"Every {seconds} seconds")" Glyph="UiIconGlyph.Refresh"
                Selected="@(RefreshPreference.PresetIndex == preset)" OnClick="@(() => RefreshPreference.SetAsync(preset))" />
        }
    </UiContextSubmenu>
    <div class="host-file-context-submenu-divider"></div>
    <UiContextMenuButton Label="Open terminal" Glyph="UiIconGlyph.Terminal" Href="/local-workspace/terminal" Target="_blank" Rel="noopener"
        OnClientClick="if (window.lmsTerminalWindow?.openPopup(this.href, '_blank')) return false;" />
    <UiContextMenuButton Label="Open file browser" Glyph="UiIconGlyph.Files" Href="/local-workspace/files" Target="_blank" Rel="noopener"
        OnClientClick="if (window.lmsTerminalWindow?.openPopup(this.href, '_blank')) return false;" />
</div>

@code {
    [Parameter] public bool IsAuthenticated { get; set; }
    [Parameter] public Guid? UserId { get; set; }
    [Parameter] public string AuthenticatedEmail { get; set; } = string.Empty;
    [Parameter] public string AuthenticationMethod { get; set; } = "Authenticated session";
    [Parameter] public string LinuxUsername { get; set; } = Environment.UserName;

    private readonly string signOutTitleId = $"lms-signout-title-{Guid.NewGuid():N}";
    private readonly string signOutDescriptionId = $"lms-signout-description-{Guid.NewGuid():N}";
    private readonly List<string> navigationOrder = [];
    private ElementReference navListElement, navShellElement, sidebarMenuElement;
    private IJSObjectReference? sidebarMenuModule;
    private IJSObjectReference? navOrderModule;
    private DotNetObjectReference<NavMenu>? navOrderReference;
    private Guid? loadedUserId;
    private Guid? preferenceUserId;
    private bool mobileMenuOpen;
    private string? orderError;

    private IReadOnlyList<NavItem> OrderedNavItems => NavItems
        .OrderBy(item =>
        {
            var index = navigationOrder.IndexOf(item.Href);
            return index < 0 ? int.MaxValue : index;
        })
        .ToArray();

    protected override async Task OnParametersSetAsync()
    {
        // Direct access uses one default menu order for this LMS instance. A
        // signed-in account uses its own profile, including in the CE layout.
        preferenceUserId = IsAuthenticated ? UserId : Guid.Empty;
        if (IsAuthenticated && preferenceUserId is null)
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (Guid.TryParse(authenticationState.User.FindFirstValue(ClaimTypes.NameIdentifier), out var authenticatedUserId))
            {
                preferenceUserId = authenticatedUserId;
            }
        }

        if (loadedUserId == preferenceUserId)
        {
            return;
        }

        loadedUserId = preferenceUserId;
        navigationOrder.Clear();
        if (preferenceUserId is not { } userId)
        {
            return;
        }

        var preference = await UserDisplayPreferenceService.GetAsync(userId);
        if (preference is null)
        {
            return;
        }

        try
        {
            var savedOrder = JsonSerializer.Deserialize<string[]>(preference.NavigationOrderJson) ?? [];
            navigationOrder.AddRange(savedOrder.Where(path => NavItems.Any(item => item.Href == path)).Distinct());
        }
        catch (JsonException)
        {
            // Older or damaged preferences fall back to the standard menu order.
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        RefreshPreference.Changed += RefreshMenuSelectionAsync;
        navOrderModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", $"/scripts/nav-order.js?v={ProductVersion}");
        sidebarMenuModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", $"/scripts/sidebar-context-menu.js?v={ProductVersion}");
        await sidebarMenuModule.InvokeVoidAsync("bind", navShellElement, sidebarMenuElement);
        navOrderReference = DotNetObjectReference.Create(this);
        await navOrderModule.InvokeVoidAsync("bindNavOrder", navListElement, navOrderReference);
    }

    private Task RefreshMenuSelectionAsync() => InvokeAsync(StateHasChanged);

    [JSInvokable]
    public async Task MoveNavigationItemAsync(string sourcePath, string targetPath, bool insertBefore)
    {
        if (preferenceUserId is not { } userId)
        {
            orderError = "Sign in to save the menu order to your profile.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (sourcePath == targetPath ||
            !NavItems.Any(item => item.Href == sourcePath) ||
            !NavItems.Any(item => item.Href == targetPath))
        {
            return;
        }

        var previousOrder = navigationOrder.ToArray();
        var orderedPaths = OrderedNavItems.Select(item => item.Href).ToList();
        orderedPaths.Remove(sourcePath);
        orderedPaths.Insert(orderedPaths.IndexOf(targetPath) + (insertBefore ? 0 : 1), sourcePath);
        navigationOrder.Clear();
        navigationOrder.AddRange(orderedPaths);
        orderError = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            await UserDisplayPreferenceService.SaveNavigationOrderAsync(userId, orderedPaths);
        }
        catch
        {
            navigationOrder.Clear();
            navigationOrder.AddRange(previousOrder);
            orderError = "Menu order could not be saved. Please try again.";
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ToggleMobileMenu() => mobileMenuOpen = !mobileMenuOpen;
    private void CloseMobileMenu() => mobileMenuOpen = false;

    public async ValueTask DisposeAsync()
    {
        RefreshPreference.Changed -= RefreshMenuSelectionAsync;
        if (sidebarMenuModule is not null)
        {
            try { await sidebarMenuModule.InvokeVoidAsync("unbind", navShellElement); await sidebarMenuModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }

        if (navOrderModule is not null)
        {
            try
            {
                await navOrderModule.InvokeVoidAsync("disposeNavOrder", navListElement);
                await navOrderModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        navOrderReference?.Dispose();
    }

    private static readonly string ProductVersion = LinuxMadeSaneBuildVersion.GetCurrent(typeof(Program).Assembly);
    private static string VersionLabel => ProductVersion.Equals("dev", StringComparison.OrdinalIgnoreCase)
        ? "dev"
        : $"{ProductVersion}";

    private string LmsAccountLabel => string.IsNullOrWhiteSpace(AuthenticatedEmail)
        ? "Signed in LMS account"
        : $"LMS Account: {AuthenticatedEmail}";

    private static readonly IReadOnlyList<NavItem> NavItems =
    [
        new("/", "Overview", UiIconName.Overview, NavLinkMatch.All, AdditionalActivePathPrefixes: ["/system-info", "/system-analysis"]),
        new("/hosts", "Hosts", UiIconName.Hosts),
        new("/storage", "Storage", UiIconName.Storage),
        new("/network", "Network", UiIconName.Security),
        new("/system", "System", UiIconName.Overview),
        new("/edge-gateway", "Edge Gateway", UiIconName.Integrations),
        new("/home-lab/apps", "Home Lab", UiIconName.Services, AdditionalActivePathPrefixes: ["/home-lab/assist"]),
        new("/scheduling", "Scheduling", UiIconName.Scheduling),
        new("/updates", "Updates", UiIconName.Updates),
        new("/commands", "Runbooks", UiIconName.Runbooks),
        new("/ai", "AI Services", UiIconName.AiOverview),
        new("/desktop-assistant", "Desktop Assistant", UiIconName.RdpOptimizer, AdditionalActivePathPrefixes: ["/rdp-optimizer"]),
        new("/settings", "Security & Networking", UiIconName.Security, AdditionalActivePathPrefixes: ["/attack-surface"]),
        new("/shares/identities", "Users and Groups", UiIconName.UsersGroups),
        new("/sftp-server", "SFTP Server", UiIconName.SftpServer),
        new("/shares", "Network Shares", UiIconName.Shares, NavLinkMatch.All, AdditionalActivePathPrefixes: ["/shares/mounts", "/shares/manager"]),
        new("/services", "Services", UiIconName.Services),
        new("/about", "About", UiIconName.About)
    ];

    private sealed record NavItem(
        string Href,
        string Label,
        UiIconName Icon,
        NavLinkMatch Match = NavLinkMatch.Prefix,
        bool Preview = false,
        IReadOnlyList<string>? AdditionalActivePathPrefixes = null);
}
