@using LinuxMadeSane.Application.Contracts.EdgeGateway
@* The anonymous availability endpoint remains reachable while LMS is restarting. *@
<dialog id="components-reconnect-modal"
        data-availability-url="@EdgeGatewayAuthenticationPaths.Availability"
        aria-labelledby="reconnect-title"
        aria-describedby="reconnect-description"
        data-nosnippet>
    <h2 id="reconnect-title">Waiting for LMS</h2>
    <p id="reconnect-description">The server may be restarting. This page will stay where it is while LMS reconnects.</p>
    <p class="reconnect-status" data-reconnect-status role="status">Checking the connection…</p>
    <p class="reconnect-countdown" data-reconnect-countdown role="timer" aria-live="off" hidden></p>
    <button type="button" class="reconnect-refresh" data-reconnect-refresh hidden>Refresh this page</button>
</dialog>
<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>
