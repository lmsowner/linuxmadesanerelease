@inherits LayoutComponentBase

<div class="auth-layout-shell">
    <div class="auth-layout-orb auth-layout-orb-sun"></div>
    <div class="auth-layout-orb auth-layout-orb-sky"></div>
    <div class="auth-layout-grid"></div>

    <main class="auth-layout-main">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    LMS lost its live connection. Reloading…
    <a href="." class="reload">Reload now</a>
    <span class="dismiss">x</span>
</div>
