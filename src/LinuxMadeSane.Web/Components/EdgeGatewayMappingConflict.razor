@using LinuxMadeSane.Application.Contracts.EdgeGateway
@if (Review.HasConflict)
{
    <div class="edge-mapping-conflict" role="alert">
        <strong>@Review.Hostname already exists.</strong>
        <p>Are you sure you want to overwrite this hostname's mappings?</p>
        <p>Saving with overwrite replaces all existing address and app mappings for this hostname. The previous service will stop working at this address.</p>
        <p>New route: @Review.Hostname → @Review.RelayHostname → @Target</p>
        <details><summary>Existing mappings (@Review.ExistingMappings.Count)</summary>
            @foreach (var mapping in Review.ExistingMappings) { <div>@mapping</div> }
        </details>
        <UiCheckboxField Value="@Confirmed" ValueChanged="@ConfirmedChanged" Label="@($"Yes, overwrite all mappings for {Review.Hostname}")" Disabled="@Busy" />
    </div>
}
@code {
    [Parameter, EditorRequired] public EdgeGatewayRouteMappingReview Review { get; set; } = default!;
    [Parameter] public string Target { get; set; } = string.Empty;
    [Parameter] public bool Confirmed { get; set; }
    [Parameter] public EventCallback<bool> ConfirmedChanged { get; set; }
    [Parameter] public bool Busy { get; set; }
}
