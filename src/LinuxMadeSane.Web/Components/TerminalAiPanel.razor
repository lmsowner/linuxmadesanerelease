@implements IAsyncDisposable
@using System.Text.RegularExpressions
@using LinuxMadeSane.Application.Contracts
@using LinuxMadeSane.Application.Contracts.Ai
@using LinuxMadeSane.Application.Interfaces
@using LinuxMadeSane.Application.Services
@using LinuxMadeSane.Core.Abstractions
@using LinuxMadeSane.Core.Enums
@using LinuxMadeSane.Core.Models
@using LinuxMadeSane.Web.Services
@inject IAiThreadService ThreadService
@inject IManagedHostService HostService
@inject ISshKeyPairGenerator SshKeyPairGenerator
@inject ITerminalAiAssistantService TerminalAiAssistantService
@inject ITerminalAiCommandDaemon TerminalAiCommandDaemon
@inject IJSRuntime JSRuntime

<section class="surface-card terminal-ai-panel">
    @if (!string.IsNullOrWhiteSpace(panelInfo))
    {
        <div class="callout warning">@panelInfo</div>
    }
    @if (!string.IsNullOrWhiteSpace(panelError))
    {
        <div class="callout error">@panelError</div>
    }
    @if (ShouldShowHostAuthAdvice)
    {
        <div class="callout warning terminal-ai-auth-advice">
            <div class="terminal-ai-auth-advice-copy">
                <strong>Public key SSH is recommended for AI-run terminal commands.</strong>
                <span>This host is configured for username/password SSH. LMS runs AI commands on a separate private channel and asks here if sudo needs a password. Public key auth plus an intentional sudo policy is still the smoother automation setup.</span>
            </div>
            <div class="terminal-ai-auth-advice-actions">
                <UiCommandButton Label="Set up public key"
                                 Glyph="UiIconGlyph.Connection"
                                 Variant="UiButtonVariant.ActionSubtle"
                                 Disabled="@isPublicKeySetupBusy"
                                 OnClick="OpenPublicKeySetupAsync" />
            </div>
        </div>
    }

    <section class="terminal-ai-access-bar" aria-label="Terminal AI access">
        <div class="terminal-ai-access-copy">
            <div class="terminal-ai-access-heading">
                <strong>@GetAccessModeLabel(Tab.AiAccessMode)</strong>
                @if (HasAgentSessionApproval)
                {
                    <UiPill Tone="UiPillTone.Success">Allowed for this session</UiPill>
                }
            </div>
            <span>@GetAccessModeDescription(Tab.AiAccessMode)</span>
        </div>

        <UiSelectField TValue="TerminalAiAccessMode"
                       Label="Access"
                       Value="@Tab.AiAccessMode"
                       ValueChanged="HandleAccessModeChangedAsync"
                       ValueExpression="@(() => Tab.AiAccessMode)"
                       Disabled="@isBusy"
                       Compact="true"
                       Class="terminal-ai-access-select">
            <option value="@TerminalAiAccessMode.ReadOnly">Read only</option>
            <option value="@TerminalAiAccessMode.Agent">Agent</option>
            <option value="@TerminalAiAccessMode.FullAccess">Full access</option>
        </UiSelectField>
    </section>

    <section class="terminal-ai-section terminal-ai-provider-section">
        @if (isProviderContextLoading)
        {
            <p class="meta-text">Loading AI providers...</p>
        }
        else if (AvailableAiProviders.Count == 0)
        {
            <p class="meta-text">No enabled runnable AI provider is configured.</p>
        }
        else
        {
            <AiProviderSwitcher Providers="@AvailableAiProviders"
                                Models="@(aiProviderContext?.Models ?? [])"
                                ProviderKey="@selectedProviderKey"
                                ProviderKeyChanged="HandleProviderSelectionChangedAsync"
                                ModelId="@selectedModelId"
                                ModelIdChanged="HandleModelSelectionChangedAsync"
                                Disabled="@isBusy"
                                ProviderLabel="AI provider"
                                ModelLabel="Model"
                                Class="terminal-ai-provider-switcher" />
        }
    </section>

    <section class="terminal-ai-section terminal-ai-activity-section">
        @if (RecentEntries.Count == 0)
        {
            <div class="empty-state compact-empty-state">
                <p>No AI activity yet.</p>
                <p class="meta-text">Ask AI below or review the live terminal state.</p>
            </div>
        }
        else
        {
            <div class="terminal-ai-activity-list" @ref="activityListElement">
                @foreach (var entry in RecentEntries)
                {
                    <article class="@(entry.Role == AiChatMessageRole.Assistant ? "terminal-ai-tool-card" : "terminal-ai-message-card")">
                        <div class="terminal-ai-message-header">
                            <UiPill Tone="@GetMessageTone(entry.Role)">@GetRoleLabel(entry.Role)</UiPill>
                            <span class="meta-text">@entry.CreatedAtUtc.ToLocalTime().ToString("HH:mm:ss")</span>
                        </div>
                        <p class="terminal-ai-message-content">@entry.Content</p>

                        @if (!string.IsNullOrWhiteSpace(entry.SuggestedCommand))
                        {
                            <pre class="command-preview-block command-display-block terminal-ai-command-preview">@entry.SuggestedCommand</pre>
                            @if (ShouldShowCommandAuthAdvice(entry.SuggestedCommand))
                            {
                                <div class="callout warning terminal-ai-auth-advice">
                                    <span>This command uses sudo. If a password is required, LMS asks for it locally and sends it only through the private command channel.</span>
                                </div>
                            }
                        }
                    </article>
                }
            </div>
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(pendingApprovalCommand))
    {
        <section class="terminal-ai-approval-card terminal-ai-approval-waiting" role="alert" aria-live="assertive">
            <div class="terminal-ai-approval-copy">
                <strong>Allow this command?</strong>
                <UiPill Tone="UiPillTone.Warning">Waiting for you</UiPill>
            </div>
            <span class="terminal-ai-approval-summary">The AI needs to make a change before it can continue.</span>
            <pre class="command-preview-block command-display-block terminal-ai-command-preview">@pendingApprovalCommand</pre>
            <div class="toolbar-row terminal-ai-approval-actions">
                <UiCommandButton Label="Allow once"
                                 Glyph="UiIconGlyph.Run"
                                 OnClick="AllowPendingCommandOnceAsync" />
                <UiCommandButton Label="Allow for session"
                                 Title="Run this and all later AI commands in this terminal session without asking again."
                                 Glyph="UiIconGlyph.Run"
                                 Variant="UiButtonVariant.ActionSubtle"
                                 Disabled="@(!Tab.SessionId.HasValue)"
                                 OnClick="AllowPendingCommandsForSessionAsync" />
                <UiCommandButton Label="Stop"
                                 Glyph="UiIconGlyph.Clear"
                                 Variant="UiButtonVariant.Ghost"
                                 OnClick="StopPendingCommandAsync" />
            </div>
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(pendingSecureCommand))
    {
        <section class="terminal-ai-approval-card terminal-ai-secure-input-card" role="alert" aria-live="assertive">
            <div class="terminal-ai-approval-copy">
                <strong>Sudo password required</strong>
                <UiPill Tone="UiPillTone.Warning">Local input</UiPill>
            </div>
            <span class="terminal-ai-approval-summary">This value goes only to the private command channel. It is never added to the AI request, conversation history, command output, or logs.</span>
            <pre class="command-preview-block command-display-block terminal-ai-command-preview">@pendingSecureCommand</pre>
            <label class="terminal-inline-field">
                <span>Password</span>
                <input class="ui-control-input"
                       type="password"
                       autocomplete="off"
                       spellcheck="false"
                       @bind="secureInputText"
                       @bind:event="oninput" />
            </label>
            <div class="toolbar-row terminal-ai-approval-actions">
                <UiCommandButton Label="Continue"
                                 Glyph="UiIconGlyph.Run"
                                 Disabled="@(string.IsNullOrEmpty(secureInputText))"
                                 OnClick="SubmitSecureInputAsync" />
                <UiCommandButton Label="Cancel"
                                 Glyph="UiIconGlyph.Clear"
                                 Variant="UiButtonVariant.Ghost"
                                 OnClick="CancelSecureInputAsync" />
            </div>
        </section>
    }

    <section class="terminal-ai-section terminal-ai-composer">
        <label class="terminal-ai-prompt-field">
            <span>What should the AI do?</span>
            <textarea class="ui-control-input ui-control-textarea"
                      @ref="promptInputElement"
                      @bind="promptText"
                      @bind:event="oninput"
                      disabled="@isBusy"
                      placeholder="@GetPromptPlaceholder()"></textarea>
        </label>

        <div class="terminal-ai-composer-actions">
            <div class="toolbar-row">
                <UiCommandButton Label="@(isBusy ? GetBusyLabel() : "Send")"
                                 Title="Ask a question or describe the outcome you want."
                                 Glyph="UiIconGlyph.Send"
                                 OnClick="SendCustomPromptAsync"
                                 Disabled="@(isBusy || string.IsNullOrWhiteSpace(promptText))" />
                @if (isRunningAgent)
                {
                    <UiCommandButton Label="Stop"
                                     Title="Stop the current AI request and unlock the composer."
                                     Glyph="UiIconGlyph.Clear"
                                     Variant="UiButtonVariant.Ghost"
                                     OnClick="StopAgentAsync" />
                }
                <UiCommandButton Label="Clear context" Glyph="UiIconGlyph.Clear" Variant="UiButtonVariant.Ghost" OnClick="ClearContext" Disabled="@(isBusy || Tab.AiConversation.Entries.Count == 0)" />
            </div>

            <div class="terminal-ai-option-row">
                <UiCheckboxField @bind-Value="Tab.AllowInternetResearch"
                                 Label="Web research"
                                 Compact="true"
                                 Class="terminal-ai-option" />
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(agentStatus))
        {
            <p class="terminal-ai-run-status" role="status" aria-live="polite">@agentStatus</p>
        }
    </section>
</section>

<UiModal IsOpen="@isPublicKeySetupOpen"
         Title="Set up public key SSH"
         Subtitle="Generate an LMS key, install the public key in the current SSH account, then test and save the host so future sessions use key auth first."
         Class="terminal-ai-public-key-modal"
         CloseOnBackdrop="@(!isPublicKeySetupBusy)"
         OnClose="ClosePublicKeySetupAsync">
    <ChildContent>
        @if (publicKeySetupEditor is null || publicKeySetupKeyPair is null)
        {
            <p class="callout info terminal-ai-public-key-status">Preparing public key setup...</p>
        }
        else
        {
            <div class="terminal-ai-public-key-flow">
                <div class="terminal-ai-public-key-steps">
                    <article class="surface-subcard terminal-ai-public-key-step">
                        <strong>1. Generate</strong>
                        <span>LMS generated a key pair for @PublicKeySetupTargetLabel. The private key is only saved after the connection test passes.</span>
                    </article>
                    <article class="surface-subcard terminal-ai-public-key-step">
                        <strong>2. Install</strong>
                        <span>Send the install command to the current terminal. It only appends the public key to the current account's authorized_keys file.</span>
                    </article>
                    <article class="surface-subcard terminal-ai-public-key-step">
                        <strong>3. Save</strong>
                        <span>LMS tests key auth without using the password, then saves this host as Public key first.</span>
                    </article>
                </div>

                <label class="terminal-inline-field">
                    <span>Public key</span>
                    <textarea readonly class="ui-control-input terminal-ai-public-key-textarea">@publicKeySetupKeyPair.PublicKey</textarea>
                </label>

                <span class="meta-text">Fingerprint: @publicKeySetupKeyPair.FingerprintSha256</span>

                <details class="terminal-ai-public-key-command">
                    <summary>Install command</summary>
                    <pre class="command-preview-block command-display-block">@PublicKeyInstallCommand</pre>
                </details>

                <div class="toolbar-row terminal-ai-public-key-actions">
                    <UiCommandButton Label="Install public key"
                                     Glyph="UiIconGlyph.Run"
                                     Variant="UiButtonVariant.ActionSubtle"
                                     Disabled="@(isPublicKeySetupBusy || RunCommand is null)"
                                     OnClick="RunPublicKeyInstallCommandAsync" />
                    <UiCommandButton Label="Copy public key"
                                     Glyph="UiIconGlyph.Copy"
                                     Variant="UiButtonVariant.ActionSubtle"
                                     Disabled="@isPublicKeySetupBusy"
                                     OnClick="CopyPublicKeySetupKeyAsync" />
                    <UiCommandButton Label="Generate new key"
                                     Glyph="UiIconGlyph.Refresh"
                                     Variant="UiButtonVariant.Ghost"
                                     Disabled="@isPublicKeySetupBusy"
                                     OnClick="GeneratePublicKeySetupKeyAsync" />
                </div>

                <UiCheckboxField @bind-Value="keepStoredPasswordFallback"
                                 Label="Keep saved password as fallback"
                                 Helper="Recommended until the key has been used for a few normal connections. Disable it later if you want key-only SSH."
                                 Disabled="@(!publicKeySetupEditor.HasStoredPassword || isPublicKeySetupBusy)"
                                 Compact="true"
                                 Card="true" />
            </div>
        }
    </ChildContent>

    <Footer>
        <div class="terminal-ai-public-key-footer">
            @if (!string.IsNullOrWhiteSpace(publicKeySetupStatus))
            {
                <p class="callout @publicKeySetupTone terminal-ai-public-key-status">@publicKeySetupStatus</p>
            }

            <div class="terminal-ai-public-key-footer-actions">
                <UiCommandButton Label="Close"
                                 Glyph="UiIconGlyph.Clear"
                                 Variant="UiButtonVariant.Ghost"
                                 Disabled="@isPublicKeySetupBusy"
                                 OnClick="ClosePublicKeySetupAsync" />
                <UiCommandButton Label="@(isPublicKeySetupBusy ? "Testing..." : "Save and test key auth")"
                                 Glyph="UiIconGlyph.Save"
                                 Disabled="@(isPublicKeySetupBusy || publicKeySetupEditor is null || publicKeySetupKeyPair is null)"
                                 OnClick="SavePublicKeyAuthenticationAsync" />
            </div>
        </div>
    </Footer>
</UiModal>

@code {
    [Parameter, EditorRequired]
    public TerminalTabState Tab { get; set; } = default!;

    [Parameter]
    public Func<string, CancellationToken, Task>? RunCommand { get; set; }

    private string promptText = string.Empty;
    private string panelInfo = string.Empty;
    private string panelError = string.Empty;
    private string agentStatus = string.Empty;
    private string pendingApprovalCommand = string.Empty;
    private string pendingSecureCommand = string.Empty;
    private string secureInputText = string.Empty;
    private string latestStructuredCommandOutput = string.Empty;
    private bool isSendingPrompt;
    private bool isRunningAgent;
    private bool isProviderContextLoading;
    private int renderedEntryCount = -1;
    private ElementReference activityListElement;
    private ElementReference promptInputElement;
    private AiChatThreadEditorContextViewModel? aiProviderContext;
    private DotNetObjectReference<TerminalAiPanel>? promptInteropReference;
    private CancellationTokenSource? providerContextLoadCts;
    private CancellationTokenSource? agentRunCts;
    private Task? providerContextLoadTask;
    private TaskCompletionSource<bool>? pendingApprovalSource;
    private TaskCompletionSource<string?>? pendingSecureInputSource;
    private const int MaxAgentCommands = 8;
    private const int MaxAgentRecoveryTurns = 4;
    private string selectedProviderKey = string.Empty;
    private string selectedModelId = string.Empty;
    private Guid? observedTabId;
    private bool isDisposed;
    private ManagedHostEditor? publicKeySetupEditor;
    private GeneratedSshKeyPair? publicKeySetupKeyPair;
    private bool isPublicKeySetupOpen;
    private bool isPublicKeySetupBusy;
    private bool publicKeyInstallCommandSent;
    private bool publicKeySetupSaved;
    private bool keepStoredPasswordFallback = true;
    private string publicKeySetupStatus = string.Empty;
    private string publicKeySetupTone = "info";
    private static readonly Regex sudoCommandPattern = new(
        @"(?im)(^|[;&|]\s*)sudo(\s|$)",
        RegexOptions.Compiled);

    private bool isBusy => isSendingPrompt || isRunningAgent;
    private bool HasAgentSessionApproval =>
        Tab.AiAccessMode == TerminalAiAccessMode.Agent &&
        Tab.SessionId.HasValue &&
        Tab.AiCommandApprovalSessionId == Tab.SessionId;
    private bool HostUsesPublicKeyAuthentication =>
        ManagedHostAuthenticationPolicy.UsesPublicKeyAuthentication(Tab.PrimaryAuthenticationType) ||
        ManagedHostAuthenticationPolicy.UsesPublicKeyAuthentication(Tab.FallbackAuthenticationType);
    private bool ShouldShowHostAuthAdvice =>
        !publicKeySetupSaved &&
        ManagedHostAuthenticationPolicy.UsesPassword(Tab.PrimaryAuthenticationType) &&
        !HostUsesPublicKeyAuthentication;
    private string PublicKeyInstallCommand =>
        publicKeySetupKeyPair is null
            ? string.Empty
            : BuildPublicKeyInstallCommand(publicKeySetupKeyPair.PublicKey);
    private string PublicKeySetupTargetLabel =>
        publicKeySetupEditor is null
            ? Tab.HostName
            : $"{publicKeySetupEditor.Username}@{publicKeySetupEditor.Hostname}";

    private IReadOnlyList<TerminalAiConversationEntry> RecentEntries =>
        Tab.AiConversation.Entries
            .TakeLast(10)
            .ToArray();

    public Task AnalyzeSessionAsync() =>
        SendPromptAsync(TerminalAiPromptMode.Analyze, string.Empty, TerminalAiAccessMode.ReadOnly);

    public async Task AnalyzeSelectionAsync(string selectionText)
    {
        var selected = selectionText.Trim();
        if (string.IsNullOrWhiteSpace(selected))
        {
            panelError = "Select terminal output first.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        var requestText = $"""
Review this selected content from the current terminal session.
Explain what it indicates, then suggest the safest next step or command if useful.

Selected terminal content:
```text
{selected}
```
""";

        await SendPromptAsync(TerminalAiPromptMode.Analyze, requestText, TerminalAiAccessMode.ReadOnly);
    }

    private async Task SendCustomPromptAsync()
    {
        var requestText = promptText.Trim();
        if (string.IsNullOrWhiteSpace(requestText))
        {
            panelError = "Enter a request first.";
            return;
        }

        if (!Tab.IsSessionActive && Tab.AiAccessMode != TerminalAiAccessMode.ReadOnly)
        {
            panelError = "Connect the terminal before asking the AI to make changes.";
            return;
        }

        isRunningAgent = true;
        var runCts = new CancellationTokenSource();
        agentRunCts = runCts;
        Tab.RegisterAiOperation(runCts);
        var cancellationToken = runCts.Token;
        panelInfo = string.Empty;
        panelError = string.Empty;
        agentStatus = "Thinking...";
        var requestTabId = Tab.Id;
        await InvokeAsync(StateHasChanged);

        try
        {
            var commandCount = 0;
            var recoveryTurns = 0;

            while (commandCount < MaxAgentCommands)
            {
                cancellationToken.ThrowIfCancellationRequested();
                if (isDisposed || Tab.Id != requestTabId)
                {
                    return;
                }

                var result = await ExecutePromptCoreAsync(
                    TerminalAiPromptMode.Custom,
                    commandCount == 0 && recoveryTurns == 0 ? requestText : string.Empty,
                    appendUserEntry: commandCount == 0 && recoveryTurns == 0,
                    cancellationToken: cancellationToken);

                if (commandCount == 0 && recoveryTurns == 0)
                {
                    promptText = string.Empty;
                }

                if (string.IsNullOrWhiteSpace(result.AssistantEntry.SuggestedCommand))
                {
                    agentStatus = string.Empty;
                    return;
                }

                var normalizedCommand = result.AssistantEntry.SuggestedCommand.Trim();
                if (!await EnsureCommandAllowedAsync(normalizedCommand))
                {
                    return;
                }

                agentStatus = "Running command...";
                await InvokeAsync(StateHasChanged);
                try
                {
                    var commandResult = await ExecuteSuggestedCommandAsync(normalizedCommand, cancellationToken);
                    if (TerminalAiSecureInputPolicy.RequiresSudoPassword(normalizedCommand, commandResult) &&
                        TerminalAiSecureInputPolicy.TryPrepareSudoPasswordCommand(normalizedCommand, out var secureCommand))
                    {
                        var secureInput = await RequestSecureInputAsync(normalizedCommand, cancellationToken);
                        if (secureInput is null)
                        {
                            agentStatus = "Stopped — no password was sent.";
                            return;
                        }

                        agentStatus = "Running command with local secure input...";
                        await InvokeAsync(StateHasChanged);
                        commandResult = await ExecuteSuggestedCommandAsync(
                            secureCommand,
                            cancellationToken,
                            new CommandExecutionInput($"{secureInput}{Environment.NewLine}", true));
                        secureInput = string.Empty;
                    }

                    latestStructuredCommandOutput = TerminalAiCommandEvidenceFormatter.Format(commandResult);
                    AddSystemEntry(latestStructuredCommandOutput);
                }
                catch (TerminalSessionUnavailableException exception)
                {
                    panelError = exception.Message;
                    agentStatus = string.Empty;
                    return;
                }
                catch (Exception exception)
                {
                    recoveryTurns++;
                    AddSystemEntry(TerminalAiAgentRecovery.BuildDispatchFailureFeedback(normalizedCommand, exception));
                    if (recoveryTurns >= MaxAgentRecoveryTurns)
                    {
                        agentStatus = "The private command channel could not complete after bounded recovery attempts. The console remains available.";
                        return;
                    }

                    agentStatus = "Private command channel interrupted. Recovering without touching the console...";
                    await InvokeAsync(StateHasChanged);
                    continue;
                }

                commandCount++;
                recoveryTurns = 0;
                if (isDisposed || Tab.Id != requestTabId)
                {
                    return;
                }

                agentStatus = "Checking the result...";
                await InvokeAsync(StateHasChanged);
            }

            agentStatus = $"Stopped after {MaxAgentCommands} commands. Send a follow-up to continue.";
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            agentStatus = "Stopped.";
        }
        catch (Exception exception)
        {
            panelError = exception.Message;
            agentStatus = string.Empty;
        }
        finally
        {
            if (ReferenceEquals(agentRunCts, runCts))
            {
                agentRunCts = null;
            }
            Tab.UnregisterAiOperation(runCts);
            runCts.Dispose();
            isRunningAgent = false;
            if (!isDisposed)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task<bool> EnsureCommandAllowedAsync(string commandText)
    {
        if (!Tab.IsSessionActive)
        {
            agentStatus = "Connect the terminal before the AI can run a command.";
            return false;
        }

        var disposition = TerminalAiAccessPolicy.Evaluate(
            Tab.AiAccessMode,
            commandText,
            HasAgentSessionApproval);

        if (disposition == TerminalAiCommandDisposition.Run)
        {
            return true;
        }

        if (disposition == TerminalAiCommandDisposition.Block)
        {
            agentStatus = "Read only — the requested change was not run.";
            return false;
        }

        return await RequestCommandApprovalAsync(commandText);
    }

    private async Task<bool> RequestCommandApprovalAsync(string commandText)
    {
        var source = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
        pendingApprovalSource = source;
        pendingApprovalCommand = commandText;
        agentStatus = "Waiting for approval.";
        await InvokeAsync(StateHasChanged);

        var allowed = await source.Task;

        if (ReferenceEquals(pendingApprovalSource, source))
        {
            pendingApprovalSource = null;
            pendingApprovalCommand = string.Empty;
        }

        agentStatus = allowed ? "Running command..." : "Stopped — no change was made.";
        if (!isDisposed)
        {
            await InvokeAsync(StateHasChanged);
        }

        return allowed;
    }

    private Task AllowPendingCommandOnceAsync()
    {
        pendingApprovalSource?.TrySetResult(true);
        return Task.CompletedTask;
    }

    private Task AllowPendingCommandsForSessionAsync()
    {
        if (Tab.SessionId.HasValue)
        {
            Tab.AiCommandApprovalSessionId = Tab.SessionId;
            pendingApprovalSource?.TrySetResult(true);
        }

        return Task.CompletedTask;
    }

    private Task StopPendingCommandAsync()
    {
        pendingApprovalSource?.TrySetResult(false);
        return Task.CompletedTask;
    }

    private Task StopAgentAsync()
    {
        agentStatus = "Stopping...";
        Tab.CancelAiOperation();
        pendingApprovalSource?.TrySetResult(false);
        pendingSecureInputSource?.TrySetResult(null);
        return InvokeAsync(StateHasChanged);
    }

    private async Task SendPromptAsync(
        TerminalAiPromptMode mode,
        string requestText,
        TerminalAiAccessMode? accessModeOverride = null)
    {
        isSendingPrompt = true;
        panelInfo = string.Empty;
        panelError = string.Empty;
        await InvokeAsync(StateHasChanged);

        try
        {
            await ExecutePromptCoreAsync(mode, requestText, accessModeOverride: accessModeOverride);
            promptText = string.Empty;
        }
        catch (Exception exception)
        {
            panelError = exception.Message;
        }
        finally
        {
            isSendingPrompt = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            promptInteropReference ??= DotNetObjectReference.Create(this);

            try
            {
                await JSRuntime.InvokeVoidAsync("lmsTerminal.registerAiPromptShortcut", promptInputElement, promptInteropReference);
            }
            catch (JSDisconnectedException)
            {
            }
        }

        var currentEntryCount = RecentEntries.Count;
        if (currentEntryCount == renderedEntryCount)
        {
            return;
        }

        renderedEntryCount = currentEntryCount;

        if (currentEntryCount == 0)
        {
            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("lmsTerminal.scrollElementToBottom", activityListElement);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    [JSInvokable]
    public async Task SubmitPromptFromKeyboardAsync()
    {
        if (isBusy || string.IsNullOrWhiteSpace(promptText))
        {
            return;
        }

        await SendCustomPromptAsync();
    }

    protected override Task OnParametersSetAsync()
    {
        if (observedTabId != Tab.Id)
        {
            pendingApprovalSource?.TrySetResult(false);
            pendingSecureInputSource?.TrySetResult(null);
            pendingSecureInputSource = null;
            pendingSecureCommand = string.Empty;
            secureInputText = string.Empty;
            latestStructuredCommandOutput = string.Empty;
            observedTabId = Tab.Id;
            ResetPublicKeySetupState();
        }

        StartProviderContextLoad();
        return Task.CompletedTask;
    }

    private async Task<TerminalAiTurnResult> ExecutePromptCoreAsync(
        TerminalAiPromptMode mode,
        string requestText,
        bool appendUserEntry = true,
        TerminalAiAccessMode? accessModeOverride = null,
        CancellationToken cancellationToken = default)
    {
        await EnsureProviderContextAsync(cancellationToken);
        SyncTerminalProviderSelection();

        var result = await TerminalAiAssistantService.ExecutePromptAsync(
            Tab.AiConversation,
            new TerminalAiPromptRequest
            {
                Mode = mode,
                AccessMode = accessModeOverride ?? Tab.AiAccessMode,
                HostId = Tab.HostId,
                HostName = Tab.HostName,
                HostAddress = Tab.HostAddress,
                WorkingDirectory = Tab.WorkingDirectory,
                TerminalOutput = Tab.Snapshot?.Output ?? string.Empty,
                StructuredCommandOutput = latestStructuredCommandOutput,
                Request = requestText,
                AllowInternetResearch = Tab.AllowInternetResearch
            },
            cancellationToken);
        latestStructuredCommandOutput = string.Empty;

        panelInfo = result.Sanitization.Applied
            ? result.Sanitization.Message
            : string.Empty;

        ApplyTerminalProviderSelection(result.ProviderKey, result.ModelId);
        Tab.AiConversation.ProviderConversationReference = result.ProviderConversationReference;
        Tab.AiConversation.ProviderResponseId = result.ProviderResponseId;
        if (appendUserEntry)
        {
            Tab.AiConversation.Entries.Add(result.UserEntry);
        }
        Tab.AiConversation.Entries.Add(result.AssistantEntry);
        await InvokeAsync(StateHasChanged);
        return result;
    }

    private async Task EnsureProviderContextAsync(CancellationToken cancellationToken = default)
    {
        if (aiProviderContext is not null)
        {
            return;
        }

        if (providerContextLoadTask is null || providerContextLoadTask.IsCompleted)
        {
            providerContextLoadTask = LoadProviderContextAsync(notifyOnCompletion: false);
        }

        await providerContextLoadTask.WaitAsync(cancellationToken);
    }

    private void StartProviderContextLoad()
    {
        if (aiProviderContext is not null)
        {
            SyncTerminalProviderSelection();
            return;
        }

        if (providerContextLoadTask is { IsCompleted: false })
        {
            return;
        }

        providerContextLoadTask = LoadProviderContextAsync(notifyOnCompletion: true);
    }

    private async Task LoadProviderContextAsync(bool notifyOnCompletion)
    {
        providerContextLoadCts?.Cancel();
        providerContextLoadCts?.Dispose();
        providerContextLoadCts = new CancellationTokenSource();
        var cancellationToken = providerContextLoadCts.Token;
        isProviderContextLoading = true;

        try
        {
            aiProviderContext = await ThreadService.GetEditorAsync(cancellationToken: cancellationToken);
            SyncTerminalProviderSelection();
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            panelError = exception.Message;
        }
        finally
        {
            isProviderContextLoading = false;
            if (notifyOnCompletion && !isDisposed)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void SyncTerminalProviderSelection()
    {
        if (aiProviderContext is null)
        {
            return;
        }

        var requestedProviderKey = string.IsNullOrWhiteSpace(selectedProviderKey)
            ? Tab.AiConversation.ProviderKey
            : selectedProviderKey;
        var requestedModelId = string.IsNullOrWhiteSpace(selectedModelId)
            ? Tab.AiConversation.ModelId
            : selectedModelId;
        var providers = BuildAvailableAiProviders(requestedProviderKey);
        var selection = AiProviderSelectionResolver.Resolve(
            requestedProviderKey,
            requestedModelId,
            aiProviderContext.Editor.ProviderKey,
            aiProviderContext.Editor.ModelId,
            providers,
            aiProviderContext.Models);

        selectedProviderKey = selection.ProviderKey;
        selectedModelId = selection.ModelId;
        Tab.AiConversation.ProviderKey = selection.ProviderKey;
        Tab.AiConversation.ModelId = selection.ModelId;
        Tab.AiConversation.ProviderLabel = selection.ProviderLabel;
    }

    private IReadOnlyList<AiConfiguredProviderViewModel> AvailableAiProviders =>
        BuildAvailableAiProviders(selectedProviderKey);

    private Task HandleProviderSelectionChangedAsync(string providerKey)
    {
        var previousProviderKey = Tab.AiConversation.ProviderKey;
        var previousModelId = Tab.AiConversation.ModelId;
        ApplyTerminalProviderSelection(providerKey, string.Empty);
        if (!string.Equals(previousProviderKey, Tab.AiConversation.ProviderKey, StringComparison.OrdinalIgnoreCase) ||
            !string.Equals(previousModelId, Tab.AiConversation.ModelId, StringComparison.OrdinalIgnoreCase))
        {
            ResetTerminalProviderState();
        }

        return InvokeAsync(StateHasChanged);
    }

    private Task HandleModelSelectionChangedAsync(string modelId)
    {
        var previousModelId = Tab.AiConversation.ModelId;
        ApplyTerminalProviderSelection(selectedProviderKey, modelId);
        if (!string.Equals(previousModelId, Tab.AiConversation.ModelId, StringComparison.OrdinalIgnoreCase))
        {
            ResetTerminalProviderState();
        }

        return InvokeAsync(StateHasChanged);
    }

    private Task HandleAccessModeChangedAsync(TerminalAiAccessMode accessMode)
    {
        Tab.AiAccessMode = accessMode;
        Tab.AiCommandApprovalSessionId = null;
        agentStatus = string.Empty;
        return InvokeAsync(StateHasChanged);
    }

    private static string GetAccessModeLabel(TerminalAiAccessMode accessMode) =>
        accessMode switch
        {
            TerminalAiAccessMode.ReadOnly => "Read only",
            TerminalAiAccessMode.FullAccess => "Full access",
            _ => "Agent"
        };

    private static string GetAccessModeDescription(TerminalAiAccessMode accessMode) =>
        accessMode switch
        {
            TerminalAiAccessMode.ReadOnly => "Inspects and explains. Read-only checks can run, but the AI never changes the host.",
            TerminalAiAccessMode.FullAccess => "Runs the commands needed to finish the request without asking for approval.",
            _ => "Runs safe checks automatically and pauses before the first change. Allow it once or for the session."
        };

