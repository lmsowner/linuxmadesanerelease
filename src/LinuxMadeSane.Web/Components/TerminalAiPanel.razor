        Tab.AiAccessMode switch
        {
            TerminalAiAccessMode.ReadOnly => "Ask a question or request an investigation. No changes will be made.",
            TerminalAiAccessMode.FullAccess => "Describe the outcome you want. The AI will work until it is done.",
