@using LinuxMadeSane.Application.Contracts.Infrastructure
@using LinuxMadeSane.Application.Interfaces
@using LinuxMadeSane.Application.Contracts.Shares
@using LinuxMadeSane.Core.Enums
@inject IHostBackupService Backup
@inject IInfrastructureDiagnosticsService Diagnostics
@inject ShareMountsWorkspaceService ShareWorkspace
<FeaturePackageGate Feature="Backup" OnInstalled="Load">
    <p>Keep an encrypted copy of LMS and your chosen folders. First choose where to keep backups, then choose what to back up.</p>
    <div class="infrastructure-actions"><UiCommandButton Label="Refresh" Disabled="@busy" OnClick="Load" />
    <UiCommandButton Label="Set up backup storage" HideIcon="true" Disabled="@busy" OnClick="NewRepository" />
    <UiCommandButton Label="Add backup plan" HideIcon="true" Disabled="@(busy || workspace?.Repositories.Count is null or 0)" OnClick="NewSet" /></div>
    @if (repositoryNotice is not null) { <p class="callout" role="status">@repositoryNotice</p> }
    @if (busy) { <p class="callout" role="status" aria-busy="true">@progress</p> }
    @if (error is not null) { <p class="callout error" role="alert">@error</p> }
    @if (workspace is not null)
    {
        <h3>Backup plans</h3>
        <p>Each plan has its own files, destination, schedule and retention. Several plans can share a storage location.</p>
        @if (workspace.Sets.Count == 0) { <p>No plans yet. Select <strong>Add backup plan</strong> above to choose what to protect.</p> }
        <div class="backup-plan-grid">
        @foreach (var set in workspace.Sets)
        {
            var destination = workspace.Repositories.FirstOrDefault(repo => repo.Id == set.RepositoryId);
            var last = workspace.History.FirstOrDefault(item => item.SetId == set.Id && item.Kind.StartsWith("Backup", StringComparison.Ordinal));
            var lastFinished = set.LastFinishedUtc ?? last?.FinishedUtc;
            var lastSucceeded = set.LastRunSucceeded ?? last?.Success;
            var lastSuccess = workspace.History.FirstOrDefault(item => item.SetId == set.Id && item.Kind.StartsWith("Backup", StringComparison.Ordinal) && item.Success);
            <section class="surface-card backup-plan-card"><h3>@set.Name</h3>
                <p><strong>Protects:</strong> @(set.FullSystem ? "Full system + ReaR boot recovery" : set.IncludeLms ? "LMS configuration, credentials & database" : "Selected folders")@((set.IncludeLms && set.Sources.Count > 0) ? "; " : "")@string.Join("; ", set.Sources)</p>
                <p><strong>Destination:</strong> @(destination?.Name ?? "Storage location missing") · @destination?.Path</p>
                <p><strong>Schedule:</strong> @(set.ScheduleEnabled ? set.ScheduleSummary : "Manual — scheduled backups off")</p>
                <p><strong>Retention:</strong> @set.KeepDaily daily · @set.KeepWeekly weekly · @set.KeepMonthly monthly</p>
                @if (set.FullSystem) { <p><strong>Restore test:</strong> @(set.RecoveryTestRecordedUtc is null ? "Not recorded — test on disposable disks" : $"User-reported · {set.RecoveryTestRecordedUtc.Value.ToLocalTime():g} · {set.RecoveryTestSnapshotId[..8]}")</p> }
                <p><strong>Last run:</strong> @(lastFinished is null ? "Not run yet" : $"{lastFinished.Value.ToLocalTime():g} · {(lastSucceeded == true ? "Success" : "Failed — open history for details")}")</p>
                <p><strong>Last successful backup:</strong> @((set.LastSuccessfulBackupUtc ?? lastSuccess?.FinishedUtc)?.ToLocalTime().ToString("g") ?? "None recorded")</p>
                <div class="infrastructure-actions">
                    <UiCommandButton Label="Edit plan" HideIcon="true" Disabled="@busy" OnClick="(() => EditSet(set))" />
                    <UiCommandButton Label="Back up now" HideIcon="true" Variant="UiButtonVariant.Action" Disabled="@busy" OnClick="(() => Run(set.Id))" />
                    <UiCommandButton Label="Restore" HideIcon="true" Disabled="@(busy || destination is null)" OnClick="(() => ShowSnapshots(destination!, set))" />
                    <UiCommandButton Label="History & logs" HideIcon="true" Disabled="@busy" OnClick="(() => ShowHistory(set.Id, null, set.Name))" />
                    @if (set.FullSystem && destination is not null) { <UiCommandButton Label="Record restore test" HideIcon="true" Disabled="@busy" OnClick="(() => OpenRecoveryTest(set))" /> }
                </div>
                @if (!string.IsNullOrWhiteSpace(set.Notes)) { <details><summary>Notes & recovery instructions</summary><p class="backup-plan-notes">@set.Notes</p></details> }
            </section>
        }
        </div>
        <details class="backup-storage"><summary>Backup storage locations (@workspace.Repositories.Count)</summary>
        @foreach (var repository in workspace.Repositories)
        {
            <section class="surface-card"><h3>@repository.Name</h3><p>@repository.Path</p>
                <div class="infrastructure-actions"><UiCommandButton Label="Edit storage" HideIcon="true" Disabled="@busy" OnClick="(() => EditRepository(repository))" />
                <UiCommandButton Label="Add backup plan" HideIcon="true" Disabled="@busy" OnClick="(() => NewSetForRepository(repository.Id))" />
                <UiCommandButton Label="All snapshots / restore" HideIcon="true" Disabled="@busy" OnClick="(() => ShowSnapshots(repository))" />
                <UiCommandButton Label="History & logs" HideIcon="true" Disabled="@busy" OnClick="(() => ShowHistory(null, repository.Id, repository.Name))" />
                <UiCommandButton Label="Statistics" HideIcon="true" Disabled="@busy" OnClick="(() => Inspect(repository, false))" />
                <UiCommandButton Label="Integrity check" HideIcon="true" Disabled="@busy" OnClick="(() => Inspect(repository, true))" /></div>
                @if (!string.IsNullOrWhiteSpace(repository.Notes)) { <details><summary>Storage notes</summary><p class="backup-plan-notes">@repository.Notes</p></details> }
            </section>
        }
        </details>
    }
</FeaturePackageGate>
<div class="backup-dialogs">
<UiModal Class="backup-compact-modal" IsOpen="@(repositoryEditor is not null && !showNetworkMount)" Title="@(editingRepository ? "Edit backup storage" : "Set up backup storage")" OnClose="CloseRepository"><ChildContent>
    @if (repositoryEditor is not null)
    {
        <p class="backup-introduction">This chooses where backups are stored. You will choose the files and schedule next.</p>
        <section class="backup-setup-step">
            <h3>1. Choose where to keep backups</h3>
            <div class="backup-two-columns">
            <UiTextField Label="Name for this backup location" Placeholder="For example: NAS backups" Disabled="@busy" @bind-Value="repositoryEditor.Name" />
            @if (!editingRepository)
            {
                <UiSelectField TValue="bool" Label="What are you setting up?" Disabled="@busy" @bind-Value="initialize">
                    <option value="true">A new backup location</option>
                    <option value="false">Connect an existing restic backup</option>
                </UiSelectField>
            }
            </div>
            <UiSelectField TValue="string" Label="Store backups on" Disabled="@busy" @bind-Value="backupDestination">
                <option value="">Choose a network share</option>
                @foreach (var destination in workspace?.NetworkDestinations ?? [])
                { <option value="@destination.Path" disabled="@destination.IsReadOnly">@destination.Share — @(destination.IsReadOnly ? "Read-only" : destination.IsMounted ? "Connected" : "Not connected")</option> }
                <option value="local">A folder on this host — enter its full path</option>
            </UiSelectField>
            <div class="infrastructure-actions">
                <UiCommandButton Label="Add network share" Glyph="UiIconGlyph.NetworkMount" Disabled="@busy" OnClick="OpenNetworkMount" />
                <UiCommandButton Label="Refresh shares" Glyph="UiIconGlyph.Refresh" Variant="UiButtonVariant.Ghost" Disabled="@busy" OnClick="RefreshDestinations" />
            </div>
            @if (SelectedNetworkDestination is { } network)
            {
                <p>Share: <strong>@network.Share</strong> · Available on LMS at <strong>@network.Path</strong></p>
                @if (!network.IsMounted && network.ManagedMountId.HasValue)
                {
                    <UiCommandButton Label="Connect this saved share" Glyph="UiIconGlyph.Connect" Disabled="@busy" OnClick="ReconnectDestination" />
                }
            }
            else if (backupDestination != "local")
            {
                <p>@((workspace?.NetworkDestinations.Count ?? 0) == 0 ? "No network shares are set up yet. Add one above using your saved server credentials." : "Choose an existing share above, or add another. LMS uses the same network mounts as the file manager.")</p>
            }
            @if (backupDestination == "local")
            {
                <UiTextField Label="Full path to the backup folder" Placeholder="/var/backups/lms" Helper="Backups on the same disk cannot protect you if that disk fails. A separate disk or network share is safer." Disabled="@busy" @bind-Value="localBackupPath" />
            }
            else if (backupDestination.Length > 0 && !UseHostBackupFolder)
            {
                <UiTextField Label="Backup folder inside this share" Placeholder="lms-backups" Helper="Use a dedicated folder. To connect an existing backup, enter its existing folder name." Disabled="@busy" @bind-Value="backupFolder" />
            }
            @if (!editingRepository && initialize && backupDestination != "local") { @HostBackupFolderOptions }
        </section>
        <section class="backup-setup-step">
            <h3>2. Protect your backups</h3>
            <div class="backup-two-columns">
            <UiTextField Label="Backup encryption password" Type="password" Autocomplete="new-password" Disabled="@busy" @bind-Value="password" />
            @if (initialize || password.Length > 0)
            {
                <UiTextField Label="Repeat backup password" Type="password" Autocomplete="new-password" Disabled="@busy" @bind-Value="passwordConfirmation" />
            }
            </div>
            <p>@(editingRepository ? "Leave blank to keep the saved password. This is separate from your Linux or LMS login." : initialize ? "Choose a password of at least 12 characters. This is separate from your Linux or LMS login." : "Enter the encryption password used when this restic backup was created.")</p>
            <p class="backup-password-guide"><strong>The whole backup is encrypted and password protected, including configuration, credentials and recovery keys.</strong> LMS stores this password encrypted. Keep a recovery copy in your password manager: you need it to restore backups if this LMS host is lost.</p>
        </section>
        <section class="backup-setup-step">
            <h3>3. Check and save</h3>
            @if (BackupPathPreview is { } preview) { <p class="backup-location-preview">Backups will be stored in <strong>@preview</strong>.</p> }
            else { <p>Choose a destination and backup folder above.</p> }
            <p>@(initialize ? "LMS will create encrypted backup storage here. Existing backups are not overwritten." : "LMS will check that it can open the existing backup with this password.") No backup runs at this step.</p>
            <UiTextAreaField Label="Storage notes (optional)" Helper="For example, NAS ownership or where the recovery password is kept. Do not put passwords in notes." Rows="2" @bind-Value="repositoryEditor.Notes" />
            <div class="infrastructure-actions">
                <UiCommandButton Label="@(initialize ? "Create backup storage" : "Check & save backup storage")" HideIcon="true" Disabled="@(busy || BackupPathPreview is null || (backupDestination != "local" && SelectedNetworkDestination is not { IsMounted: true, IsReadOnly: false }) || string.IsNullOrWhiteSpace(repositoryEditor.Name) || (!editingRepository && password.Length == 0) || ((initialize || password.Length > 0) && password != passwordConfirmation))" OnClick="SaveRepository" />
                <UiCommandButton Label="Cancel" Variant="UiButtonVariant.Ghost" HideIcon="true" Disabled="@busy" OnClick="CloseRepository" />
            </div>
            @if (passwordConfirmation.Length > 0 && password != passwordConfirmation) { <p class="callout error" role="alert">The passwords do not match.</p> }
            @if (busy) { <p class="callout" role="status" aria-busy="true">@progress</p> }
        </section>
        @if (error is not null) { <p class="callout error">@error</p> }
    }
</ChildContent></UiModal>
<UiModal Class="backup-compact-modal" IsOpen="@(recoveryMediaSnapshot is not null)" Title="Prepare boot recovery media" OnClose="CloseRecoveryMedia"><ChildContent>
    @if (recoveryMediaSnapshot is not null)
    {
        <p class="backup-introduction">The recovery ISO boots the tools that rebuild disks and restore this encrypted backup. Prepare it before the original server fails.</p>
        <UiTextField Label="New private export folder on this LMS host" Helper="Exported files are decrypted. Keep recovery media private and offline." @bind-Value="recoveryMediaTarget" />
        <UiCommandButton Label="Extract recovery ISO & guide" HideIcon="true" Disabled="@busy" OnClick="ExtractRecoveryMedia" />
        @if (busy) { <p role="status" aria-busy="true">@progress</p> }
        @if (error is not null) { <p class="callout error" role="alert">@error</p> }
        @if (recoveryMediaExported)
        {
            <p><strong>Media extracted.</strong> Use Files below to download the ISO and recovery guide. Keep the repository password independently of LMS.</p>
            <UiCommandButton Label="Open exported files" Glyph="UiIconGlyph.FolderOpen" Href="@($"/file-browser-window?hostId={LinuxMadeSane.Core.Models.Ai.AiLocalMachine.ManagedHostId}&path={Uri.EscapeDataString(recoveryMediaTarget)}")" Target="_blank" Rel="noopener noreferrer" OnClientClick="if(window.lmsTerminalWindow?.openPopup(this.href,this.target))return false;" />
        }
        <details><summary>Restore on a replacement machine</summary><p>Use the same CPU architecture and BIOS/UEFI mode as the original. Attach the ISO as a virtual CD or compatible recovery medium. Boot it, connect the backup storage and follow FULL-SYSTEM-RECOVERY.txt. Review target disks before running rear recover: disk contents will be replaced. Test in isolation, then record Linux boot, LMS login and workload checks against this snapshot.</p></details>
    }
</ChildContent></UiModal>
<UiModal Class="backup-compact-modal" IsOpen="@(recoveryTestSet is not null)" Title="Record a successful restore test" OnClose="CloseRecoveryTest"><ChildContent>
    @if (recoveryTestSet is not null)
    {
        <p class="backup-introduction">Only record this after booting a restored disposable machine and checking LMS login, credentials and required workloads. This is your test record, not an automatic certification.</p>
        @if (busy) { <p role="status">@progress</p> }
        @if (error is not null) { <p class="callout error" role="alert">@error</p> }
        <UiSelectField TValue="string" Label="Tested full-system snapshot" @bind-Value="recoveryTestSnapshot"><option value="">Choose the snapshot you restored</option>@foreach (var item in recoveryTestSnapshots) { <option value="@item.Id">@item.Time.ToLocalTime().ToString("g") · @item.Id[..8]</option> }</UiSelectField>
        <UiTextAreaField Label="Test machine & results" Helper="Include Linux boot, LMS login, credential and workload checks. No passwords." Rows="3" @bind-Value="recoveryTestEvidence" />
        <UiCommandButton Label="Save test record" HideIcon="true" Disabled="@(busy || recoveryTestSnapshot.Length == 0 || recoveryTestEvidence.Trim().Length < 20)" OnClick="SaveRecoveryTest" />
    }
</ChildContent></UiModal>
<UiModal Class="share-mapping-modal" IsOpen="@showNetworkMount" Title="Add network share for backups" Subtitle="Connect the share and folder. Choose the backup subfolder in the backup setup after connecting." OnClose="CloseNetworkMount">
    @if (showNetworkMount)
    {
        <ShareMappingForm Editor="@networkMountEditor" EnableRemoteShareDiscovery="true" ShowPersistenceToggle="false" PreferLmsDefaultMountPath="true"
                          IsBusy="@connectingNetworkMount" StatusMessage="@networkMountStatus" StatusTone="error"
                          PermanentSubmitLabel="Connect share & use for backups" OnCreateMount="CreateBackupNetworkMount"
                          ReviewAtEnd="true" />
    }
</UiModal>
<UiModal Class="backup-compact-modal" IsOpen="@(setEditor is not null)" Title="Choose what to back up" OnClose="CloseSet"><ChildContent>
    @if (setEditor is not null)
    {
        <div class="backup-two-columns"><UiTextField Label="Plan name" @bind-Value="setEditor.Name" />
        <UiSelectField TValue="Guid" Label="Backup location" Disabled="@busy" Value="@setEditor.RepositoryId" ValueChanged="ChangeBackupRepository">@foreach (var repo in workspace?.Repositories ?? []) { <option value="@repo.Id">@repo.Name — @repo.Path</option> }</UiSelectField></div>
        <UiSelectField TValue="bool" Label="Backup type" Disabled="@busy" Value="@setEditor.FullSystem" ValueChanged="ChangeBackupType"><option value="false">LMS configuration / selected folders</option><option value="true">Full system + boot recovery</option></UiSelectField>
        @if (setEditor.FullSystem)
        {
            <UiCommandButton Label="Check disks & recovery readiness" HideIcon="true" Disabled="@busy" OnClick="CheckFullSystem" />
            @if (!fullSystemReady && busy) { <p role="status">@progress</p> }
            @if (!fullSystemReady && error is not null) { <p class="callout error" role="alert">@error</p> }
            @if (fullSystemReady)
            {
            <FeaturePackageGate Feature="FullBackup" Label="Full-system recovery" OnInstalled="CheckFullSystem"><p class="backup-introduction">Encrypted backup of Linux, LMS and local disks, with ReaR boot recovery media. Network shares and the backup disk are excluded. A restore drill is required to prove recovery.</p></FeaturePackageGate>
            }
            @if (fullSystemCheck is not null) { <details><summary>Detected filesystems & exclusions</summary><pre class="backup-readiness">@fullSystemCheck</pre></details> }
        }
        else
        {
        <UiCheckboxField Label="LMS configuration, credentials & database (recommended)" Helper="Encrypted database, saved credentials, recovery keys and configuration. No folder entry needed." @bind-Value="setEditor.IncludeLms" />
        <section class="backup-setup-step">
            <strong>Choose folders to back up</strong>
            <p>Tick a folder to include everything inside it. Expand it to select individual subfolders instead.</p>
            <BackupFolderTree @key="setEditor.Id" Selected="@SelectedSources" SelectedChanged="SetSelectedSources" SelectFullSystem="(() => ChangeBackupType(true))" Disabled="@busy" />
            <p>For Linux and boot recovery, choose <strong>Full system + boot recovery</strong> above.</p>
        </section>
        }
        <div class="infrastructure-grid"><UiNumberField TValue="int" Label="Keep daily" @bind-Value="setEditor.KeepDaily" min="0" /><UiNumberField TValue="int" Label="Weekly" @bind-Value="setEditor.KeepWeekly" min="0" /><UiNumberField TValue="int" Label="Monthly" @bind-Value="setEditor.KeepMonthly" min="0" /></div>
        <UiCheckboxField Label="Enable scheduled backups" Helper="This schedule applies only to this plan, in the host’s local timezone." @bind-Value="schedule" />
        @if (schedule)
        {
            <div class="backup-schedule-grid">
            <UiSelectField TValue="ScheduledTaskScheduleMode" Label="How often?" @bind-Value="setEditor.ScheduleMode">
                <option value="@ScheduledTaskScheduleMode.Hourly">Hourly</option>
                <option value="@ScheduledTaskScheduleMode.Daily">Daily</option>
                <option value="@ScheduledTaskScheduleMode.Weekly">Weekly</option>
                <option value="@ScheduledTaskScheduleMode.Monthly">Monthly</option>
                @if (setEditor.ScheduleMode is not (ScheduledTaskScheduleMode.Hourly or ScheduledTaskScheduleMode.Daily or ScheduledTaskScheduleMode.Weekly or ScheduledTaskScheduleMode.Monthly))
                { <option value="@setEditor.ScheduleMode">@setEditor.ScheduleSummary — managed in Scheduling</option> }
            </UiSelectField>
            @if (setEditor.ScheduleMode == ScheduledTaskScheduleMode.Weekly)
            {
                <UiSelectField TValue="string" Label="Day of week" @bind-Value="setEditor.ScheduleDaysOfWeekCsv">
                    <option value="0">Sunday</option><option value="1">Monday</option><option value="2">Tuesday</option><option value="3">Wednesday</option><option value="4">Thursday</option><option value="5">Friday</option><option value="6">Saturday</option>
                    @if (setEditor.ScheduleDaysOfWeekCsv.Contains(',')) { <option value="@setEditor.ScheduleDaysOfWeekCsv">Existing days: @setEditor.ScheduleDaysOfWeekCsv</option> }
                </UiSelectField>
            }
            @if (setEditor.ScheduleMode == ScheduledTaskScheduleMode.Monthly) { <UiNumberField TValue="int" Label="Day of month" @bind-Value="setEditor.ScheduleDayOfMonth" min="1" max="31" /> }
            @if (setEditor.ScheduleMode is ScheduledTaskScheduleMode.Hourly or ScheduledTaskScheduleMode.Daily or ScheduledTaskScheduleMode.Weekly or ScheduledTaskScheduleMode.Monthly)
            {
                    @if (setEditor.ScheduleMode != ScheduledTaskScheduleMode.Hourly) { <UiNumberField TValue="int" Label="Hour" @bind-Value="hour" min="0" max="23" /> }
                    <UiNumberField TValue="int" Label="Minute" @bind-Value="minute" min="0" max="59" />
            }
            </div>
            <p><a href="/scheduling">Advanced schedules</a></p>
        }
        <UiTextAreaField Label="Notes & recovery instructions" Helper="Stored inside the encrypted backup. Do not enter passwords." Rows="2" @bind-Value="setEditor.Notes" />
        <div class="infrastructure-actions">
            <UiCommandButton Label="Save & back up now" HideIcon="true" Variant="UiButtonVariant.Action" Disabled="@(busy || (setEditor.FullSystem && (!fullSystemReady || !fullSystemPackagesReady)))" OnClick="(() => SaveSet(true))" />
            <UiCommandButton Label="Save plan only" HideIcon="true" Disabled="@(busy || (setEditor.FullSystem && (!fullSystemReady || !fullSystemPackagesReady)))" OnClick="(() => SaveSet(false))" />
        </div>
        @if (busy) { <p class="callout" role="status">@progress</p> }
        @if (error is not null) { <p class="callout error">@error</p> }
    }
</ChildContent></UiModal>
<UiModal IsOpen="@(snapshotRepository is not null && recoveryMediaSnapshot is null)" Title="@(snapshotPlan is null ? "Snapshots & restore" : $"Restore: {snapshotPlan.Name}")" OnClose="CloseSnapshots"><ChildContent>
    @if (busy) { <p class="callout" role="status" aria-busy="true">@progress</p> }
    @if (error is not null)
    {
        <p class="callout error" role="alert">@error</p>
        @if (snapshotRepository is { } repository)
        { <UiCommandButton Label="Try again" Disabled="@busy" OnClick="(() => ShowSnapshots(repository, snapshotPlan))" /> }
    }
    @if (!busy && error is null && snapshots.Count == 0)
    {
        <p><strong>No backups have been saved here yet.</strong></p>
        <p>Choose what to back up, then select “Back up now” on your backup plan. Once a backup succeeds, it will appear here for browsing and restoring.</p>
        <UiCommandButton Label="Choose what to back up" HideIcon="true" OnClick="ChooseSnapshotBackup" />
    }
    @if (snapshotPlan is not null) { <p>Showing only snapshots for <strong>@snapshotPlan.Name</strong>. Each new backup includes a <strong>backup-plan.json</strong> recovery record with the settings and notes at backup time.</p> }
    @foreach (var item in snapshots.OrderByDescending(item => item.Time))
    { <div class="infrastructure-actions"><span>@item.Time.ToLocalTime().ToString("g") · @item.Id[..8]@(item.Tags.Contains("lms-full-system") && !item.Tags.Contains("lms-backup-complete") ? " · Incomplete — boot recovery unavailable" : "")</span><UiCommandButton Label="Browse snapshot" Disabled="@busy" OnClick="(() => Browse(item.Id))" />@if (item.Tags.Contains("lms-full-system") && item.Tags.Contains("lms-backup-complete")) { <UiCommandButton Label="Recovery media" HideIcon="true" Disabled="@busy" OnClick="(() => OpenRecoveryMedia(item))" /> }</div> }
    @if (snapshot is not null)
    {
        @if (snapshots.FirstOrDefault(item => item.Id == snapshot)?.Tags.Contains("lms-full-system") == true)
        {
            <details class="backup-recovery-guide"><summary><strong>Full-system / bare-metal recovery</strong></summary>
                <ol><li>Before failure, restore the boot-recovery ISO from this snapshot to a private folder and keep boot media offline.</li><li>Boot that ISO on the replacement machine. Connect the backup storage; keep the encryption password independently of LMS.</li><li>Run <code>rear recover</code> at its console. Enter the repository path and password privately. The ISO finds its matching completed backup and checks its data before any disk changes. Review the proposed target disks carefully before approving recreation.</li><li>Check Linux boot, LMS login, saved credentials and required workloads. Record the test against this plan. See FULL-SYSTEM-RECOVERY.txt in the encrypted snapshot.</li></ol>
                <p>Different hardware needs review. Live databases and containers need application-consistent backups. A successful backup does not prove a successful restore.</p>
            </details>
        }
        <div class="snapshot-files">@foreach (var file in files.Take(1000)) { <UiCheckboxField Label="@(file.Path + (file.Type == "dir" ? "/" : ""))" Value="@selection.Contains(file.Path)" ValueChanged="(value => Select(file.Path, value))" /> }</div>
        @if (files.Count > 1000) { <p>Showing the first 1,000 entries. Selecting a directory includes its contents.</p> }
        <UiTextField Label="Restore destination" Helper="Use an alternate directory. Live LMS data and system roots are protected." @bind-Value="restoreTarget" />
        <UiCheckboxField Label="I explicitly allow existing files at this destination to be overwritten" @bind-Value="overwrite" />
        <p>@(selection.Count == 0 ? "All snapshot files will be restored." : $"{selection.Count} selected file(s) or directory(s) will be restored.")</p>
        <UiCommandButton Label="Restore to destination" HideIcon="true" Disabled="@busy" OnClick="Restore" />
        <section class="backup-setup-step">
            <h3>Recover LMS configuration on a replacement host</h3>
            <p>First restore the snapshot above to a private alternate folder. New LMS configuration backups include <strong>RECOVERY.txt</strong>, a recovery tool, host configuration and an inventory. Restored files are decrypted: keep this folder private.</p>
            <UiTextField Label="Restored recovery bundle folder" Helper="The folder containing linuxmadesane.db, protection-keys and recovery-manifest.json. LMS fills this in after restoring a new recovery bundle." @bind-Value="lmsRestorePath" />
            <UiCommandButton Label="Validate recovery bundle" HideIcon="true" Disabled="@busy" OnClick="ValidateRestore" />
            <details><summary>Prepare configuration for this replacement host</summary>
                <p>Use the replacement installation’s paths. The tool creates a separate review tree; it cannot overwrite live LMS files or start services.</p>
                <UiTextField Label="New private folder for the recovery plan" @bind-Value="recoveryPreparationPath" />
                <UiTextField Label="Replacement LMS data directory" @bind-Value="recoveryDataDirectory" />
                <UiTextField Label="Replacement LMS application directory" @bind-Value="recoveryApplicationDirectory" />
                <UiTextField Label="Replacement credential protection key directory" @bind-Value="recoveryKeyDirectory" />
                <UiCommandButton Label="Prepare recovery plan" HideIcon="true" Disabled="@busy" OnClick="PrepareRecovery" />
            </details>
            <p><strong>Review before applying:</strong> interface names, disk UUIDs, mounts, Linux users, SSH identity, schedules and Edge Gateway routes may differ. Follow RECOVERY.txt; keep a rollback copy and stop LMS before replacing its database and keys. Do not copy the old /etc wholesale.</p>
        </section>
    }
    @if (output is not null) { <pre>@output</pre> }
</ChildContent></UiModal>
<UiModal Class="backup-compact-modal" IsOpen="@showHistory" Title="@($"History & logs: {historyTitle}")" OnClose="(() => showHistory = false)"><ChildContent>
    @if (busy) { <p class="callout" role="status" aria-busy="true">@progress</p> }
    @if (error is not null) { <p class="callout error" role="alert">@error</p> }
    <p>Times are shown in this host’s local timezone. Each entry records the operation’s result and command output.</p>
    @if (!busy && error is null && !HistoryEntries.Any()) { <p>No operations have been recorded yet.</p> }
    @foreach (var entry in HistoryEntries)
    {
        <details><summary>@entry.FinishedUtc.ToLocalTime().ToString("g") · @entry.Kind · @(entry.Success ? "Success" : "Failed")</summary>
            <p>Started @entry.StartedUtc.ToLocalTime().ToString("g") · Duration @((entry.FinishedUtc - entry.StartedUtc).TotalSeconds.ToString("0")) seconds</p><pre>@entry.Detail</pre>
        </details>
    }
</ChildContent></UiModal>
<UiModal IsOpen="@showOutput" Title="Repository operation" OnClose="(() => showOutput = false)"><ChildContent><pre>@output</pre></ChildContent></UiModal>
</div>
@code {
    private BackupWorkspace? workspace;
    private BackupRepository? repositoryEditor, snapshotRepository;
    private BackupSnapshot? recoveryMediaSnapshot;
    private string recoveryMediaTarget = "";
    private bool recoveryMediaExported;
    private void OpenRecoveryMedia(BackupSnapshot item) { recoveryMediaSnapshot = item; recoveryMediaTarget = "/var/tmp/lms-recovery-media-" + item.Id[..8]; recoveryMediaExported = false; error = null; }
    private void CloseRecoveryMedia() { if (!busy) recoveryMediaSnapshot = null; }
    private Task ExtractRecoveryMedia() => Operation("Extracting recovery media from the encrypted backup…", async () =>
    {
        var bundle = recoveryMediaSnapshot!.Paths.SingleOrDefault(path => path.Contains("/lms-backup-staging-", StringComparison.Ordinal))
            ?? throw new InvalidOperationException("This snapshot has no LMS recovery bundle.");
        await Backup.RestoreAsync(snapshotRepository!.Id, recoveryMediaSnapshot.Id, recoveryMediaTarget,
            [bundle + "/boot-recovery", bundle + "/FULL-SYSTEM-RECOVERY.txt", bundle + "/full-system-recovery.json", bundle + "/backup-plan.json"], false);
        recoveryMediaExported = true;
    });
    private BackupSet? recoveryTestSet;
    private IReadOnlyList<BackupSnapshot> recoveryTestSnapshots = [];
    private string recoveryTestSnapshot = "", recoveryTestEvidence = "";
    private Task OpenRecoveryTest(BackupSet set) { recoveryTestSet = set; recoveryTestSnapshot = ""; recoveryTestEvidence = ""; recoveryTestSnapshots = []; return Operation("Reading full-system snapshots…", async () => recoveryTestSnapshots = (await Backup.SnapshotsAsync(set.RepositoryId)).Where(item => item.Tags.Contains("lms-full-system") && item.Tags.Contains("lms-backup-complete") && item.Tags.Contains("lms-set-" + set.Id.ToString("N"))).ToArray()); }
    private void CloseRecoveryTest() { if (!busy) recoveryTestSet = null; }
    private Task SaveRecoveryTest() => Operation("Saving recovery test record…", async () => { await Backup.RecordRecoveryTestAsync(recoveryTestSet!.Id, recoveryTestSnapshot, recoveryTestEvidence); recoveryTestSet = null; workspace = await Backup.GetAsync(); });
    private string? fullSystemCheck;
    private bool fullSystemReady;
    private bool fullSystemPackagesReady;
    private Task ChangeBackupType(bool full) { setEditor!.FullSystem = full; fullSystemReady = false; fullSystemCheck = null; return full ? CheckFullSystem() : Task.CompletedTask; }
    private Task ChangeBackupRepository(Guid id) { setEditor!.RepositoryId = id; fullSystemReady = false; fullSystemCheck = null; return setEditor.FullSystem ? CheckFullSystem() : Task.CompletedTask; }
    private Task CheckFullSystem() { fullSystemReady = false; fullSystemPackagesReady = false; fullSystemCheck = null; return Operation("Checking disks and recovery readiness…", async () => { fullSystemCheck = await Backup.InspectFullSystemAsync(setEditor!.RepositoryId); fullSystemReady = true; fullSystemPackagesReady = (await Diagnostics.GetPackageStatusAsync("FullBackup")).Installed; }); }
    private BackupSet? setEditor, snapshotPlan;
    private bool showHistory;
    private Guid? historySetId, historyRepositoryId;
    private string historyTitle = "";
    private IEnumerable<BackupOperation> HistoryEntries => (workspace?.History ?? []).Where(item =>
        (!historySetId.HasValue || item.SetId == historySetId) && (!historyRepositoryId.HasValue || item.RepositoryId == historyRepositoryId)).OrderByDescending(item => item.FinishedUtc);
    private Task ShowHistory(Guid? setId, Guid? repositoryId, string title) => Operation("Reading backup history…", async () => { historySetId = setId; historyRepositoryId = repositoryId; historyTitle = title; showHistory = true; workspace = await Backup.GetAsync(); });
    private bool initialize, schedule, busy, overwrite, showOutput;
    private int hour = 2, minute;
    private string recoveryPreparationPath = "", recoveryDataDirectory = "", recoveryApplicationDirectory = "", recoveryKeyDirectory = "";
    private string password = "", sources = "", restoreTarget = "", lmsRestorePath = "", progress = "";
    private string backupDestination = "", backupFolder = "lms-backups", localBackupPath = "", passwordConfirmation = "";
    private bool createHostBackupFolder = true;
    private string hostBackupFolder = "";
    private bool UseHostBackupFolder => initialize && !editingRepository && createHostBackupFolder && backupDestination != "local";
    private string? repositoryNotice;
    private bool editingRepository;
    private bool showNetworkMount, connectingNetworkMount;
    private RemoteShareMountEditor networkMountEditor = new() { PersistOnServer = true };
    private string? networkMountStatus;
    private BackupNetworkDestination? SelectedNetworkDestination => workspace?.NetworkDestinations.FirstOrDefault(item => item.Path == backupDestination);
    private string? BackupPathPreview
    {
        get { try { return UseHostBackupFolder ? BackupDestinationSelection.WithHostSubfolder(backupDestination, hostBackupFolder) : BackupDestinationSelection.Resolve(backupDestination, backupFolder, localBackupPath); } catch (InvalidOperationException) { return null; } }
    }
    private RenderFragment HostBackupFolderOptions => @<div>
        <UiCheckboxField Label="Create a separate subfolder for this host and backup plan" Disabled="@(busy || connectingNetworkMount)" @bind-Value="createHostBackupFolder" />
        @if (createHostBackupFolder)
        {
            <UiTextField Label="Backup subfolder (editable)" Helper="Created directly inside the connected share / folder selected above. Existing folders are not reused." Disabled="@(busy || connectingNetworkMount)" @bind-Value="hostBackupFolder" />
        }
    </div>;
    private string? error, output, snapshot;
    private IReadOnlyList<BackupSnapshot> snapshots = [];
    private IReadOnlyList<BackupFile> files = [];
    private readonly HashSet<string> selection = [];
    protected override async Task OnInitializedAsync() { if ((await Diagnostics.GetPackageStatusAsync("Backup")).Installed) await Load(); }
    private async Task Operation(string label, Func<Task> operation)
    { busy = true; progress = label; error = null; await InvokeAsync(StateHasChanged); await Task.Yield(); try { await operation(); } catch (Exception e) { error = e.Message; } finally { busy = false; } }
    private Task Load() => Operation("Reading backup configuration…", async () => workspace = await Backup.GetAsync());
    private void NewRepository() { error = null; repositoryNotice = null; password = passwordConfirmation = ""; initialize = true; editingRepository = false; backupDestination = localBackupPath = ""; backupFolder = "lms-backups"; createHostBackupFolder = true; hostBackupFolder = BackupDestinationSelection.SuggestHostSubfolder(Environment.MachineName, workspace?.Repositories.Select(item => item.Path) ?? [], (workspace?.Sets.Count ?? 0) + 1); repositoryEditor = new() { Name = "LMS backup" }; }
    private void EditRepository(BackupRepository repo)
    {
        error = null; repositoryNotice = null; password = passwordConfirmation = ""; initialize = false; editingRepository = true;
        var share = workspace?.NetworkDestinations.Where(item => repo.Path.StartsWith(item.Path.TrimEnd('/') + "/", StringComparison.Ordinal))
            .OrderByDescending(item => item.Path.Length).FirstOrDefault();
        backupDestination = share?.Path ?? "local"; localBackupPath = repo.Path;
        backupFolder = share is null ? "lms-backups" : repo.Path[(share.Path.TrimEnd('/').Length + 1)..];
        repositoryEditor = new() { Id = repo.Id, Name = repo.Name, Path = repo.Path, Notes = repo.Notes };
    }
    private void CloseRepository() { if (!busy) { repositoryEditor = null; password = passwordConfirmation = ""; } }
    private Task RefreshDestinations() => Operation("Refreshing connected disks and shares…", async () => workspace = await Backup.GetAsync());
    private void OpenNetworkMount()
    {
        networkMountStatus = null;
        networkMountEditor = new() { PersistOnServer = true };
        showNetworkMount = true;
    }
    private void CloseNetworkMount()
    {
        if (connectingNetworkMount) return;
        showNetworkMount = false;
        networkMountEditor = new() { PersistOnServer = true };
        networkMountStatus = null;
    }
    private async Task CreateBackupNetworkMount(bool _)
    {
        connectingNetworkMount = true; networkMountStatus = null;
        try
        {
            networkMountEditor.PersistOnServer = true;
            var result = await ShareWorkspace.CreateRemoteShareMountAsync(networkMountEditor);
            // Select the actual mount returned by the standard share workflow, not a guessed path.
            backupDestination = result.LocalMountPath;
            showNetworkMount = false;
            networkMountEditor = new() { PersistOnServer = true };
            await RefreshDestinations();
        }
        catch (Exception exception) { networkMountStatus = exception.Message; }
        finally { connectingNetworkMount = false; }
    }
    private Task ReconnectDestination() => Operation("Connecting the saved network share…", async () =>
    {
        var id = SelectedNetworkDestination?.ManagedMountId ?? throw new InvalidOperationException("Choose a saved network share to reconnect.");
        var result = await ShareWorkspace.ReconnectManagedRemoteMountAsync(id);
        workspace = await Backup.GetAsync();
        if (result is null || SelectedNetworkDestination is not { IsMounted: true, IsReadOnly: false })
            throw new InvalidOperationException("This share is not connected for writing. Check its connection in Network Shares before creating backup storage.");
    });
    private Task SaveRepository() => Operation(initialize ? "Creating encrypted backup storage…" : "Checking the backup password and location…", async () =>
    {
        repositoryEditor!.Path = BackupPathPreview ?? throw new InvalidOperationException("Choose a backup destination and a valid folder name.");
        repositoryEditor.CreateNewDirectory = UseHostBackupFolder;
        repositoryEditor.RequiredNetworkMountPath = backupDestination == "local" ? "" : backupDestination;
        if (backupDestination != "local")
        {
            workspace = await Backup.GetAsync();
            if (SelectedNetworkDestination is not { IsMounted: true, IsReadOnly: false })
                throw new InvalidOperationException("Connect this network share before saving. LMS will not put backups in an empty mount folder.");
        }
        if ((initialize || password.Length > 0) && password != passwordConfirmation) throw new InvalidOperationException("The passwords do not match.");
        await Backup.SaveRepositoryAsync(repositoryEditor, password, initialize);
        var repositoryId = repositoryEditor.Id;
        repositoryNotice = $"Backup storage is ready at {repositoryEditor.Path}. Choose the files and schedule in the next step. No backup has run yet.";
        repositoryEditor = null; password = passwordConfirmation = ""; workspace = await Backup.GetAsync();
        if (!editingRepository) NewSetForRepository(repositoryId);
    });
    private void NewSet() => NewSetForRepository(workspace!.Repositories[0].Id);
    private void NewSetForRepository(Guid repositoryId) { error = null; fullSystemReady = false; fullSystemCheck = null; setEditor = new() { Name = "LMS configuration backup", RepositoryId = repositoryId }; sources = ""; schedule = false; hour = 2; minute = 0; }
    private IReadOnlyList<string> SelectedSources => sources.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    private void SetSelectedSources(IReadOnlyList<string> paths) => sources = string.Join('\n', paths);
    private async Task EditSet(BackupSet set) { fullSystemReady = false; fullSystemCheck = null; setEditor = System.Text.Json.JsonSerializer.Deserialize<BackupSet>(System.Text.Json.JsonSerializer.Serialize(set)); sources = string.Join('\n', set.Sources); schedule = set.ScheduleEnabled; hour = set.ScheduleHour; minute = set.ScheduleMinute; if (set.FullSystem) await CheckFullSystem(); }
    private void CloseSet() { if (!busy) setEditor = null; }
    private Task SaveSet(bool runNow) => Operation(runNow ? "Saving the plan and taking your backup…" : "Saving backup plan…", async () =>
    {
        if (setEditor!.FullSystem) { setEditor.IncludeLms = true; sources = ""; }
        setEditor.Sources = sources.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
        await Backup.SaveSetAsync(setEditor, schedule, hour, minute);
        var setId = setEditor.Id;
        setEditor = null;
        repositoryNotice = runNow ? "Your backup is running. Its result will appear in History." : "Backup plan saved. Select ‘Back up now’ on the plan to take a backup, or wait for its enabled schedule.";
        try { if (runNow) await Backup.RunBackupAsync(setId); }
        finally { workspace = await Backup.GetAsync(); }
        if (runNow) repositoryNotice = "Backup completed. Select ‘Snapshots / restore’ on its backup location to browse or restore it.";
    });
    private Task Run(Guid id) => Operation("Backup running… You can find its result in History.", async () => { try { await Backup.RunBackupAsync(id); } finally { workspace = await Backup.GetAsync(); } });
    private Task ShowSnapshots(BackupRepository repo, BackupSet? plan = null) => Operation("Reading snapshots…", async () => { recoveryDataDirectory = workspace?.DataDirectory ?? ""; recoveryApplicationDirectory = workspace?.ApplicationDirectory ?? ""; recoveryKeyDirectory = workspace?.ProtectionKeyDirectory ?? ""; snapshotRepository = repo; snapshotPlan = plan; snapshot = null; output = null; snapshots = []; files = []; selection.Clear(); snapshots = (await Backup.SnapshotsAsync(repo.Id)).Where(item => plan is null || item.Tags.Contains("lms-set-" + plan.Id.ToString("N"), StringComparer.Ordinal)).ToArray(); });
    private void ChooseSnapshotBackup()
    {
        var repositoryId = snapshotRepository!.Id;
        CloseSnapshots();
        NewSetForRepository(repositoryId);
    }
    private Task Browse(string id) => Operation("Reading snapshot files…", async () => { snapshot = id; files = await Backup.FilesAsync(snapshotRepository!.Id, id); selection.Clear(); });
    private void Select(string path, bool selected) { if (selected) selection.Add(path); else selection.Remove(path); }
    private void CloseSnapshots() { if (!busy) { snapshotRepository = null; snapshotPlan = null; } }
    private Task Restore() => Operation("Restoring selected snapshot…", async () => { await Backup.RestoreAsync(snapshotRepository!.Id, snapshot!, restoreTarget, selection.ToArray(), overwrite); var recoveryFolder = snapshots.FirstOrDefault(item => item.Id == snapshot)?.Paths.FirstOrDefault(path => path.Contains("/lms-backup-staging-", StringComparison.Ordinal));
        if (recoveryFolder is not null && (selection.Count == 0 || selection.Contains(recoveryFolder))) lmsRestorePath = Path.Combine(restoreTarget, recoveryFolder.TrimStart('/'));
        output = "Restore completed at " + restoreTarget + ". Restored files are decrypted; keep this directory private. Live LMS data was not changed."; });
    private Task PrepareRecovery() => Operation("Validating and preparing configuration recovery…", async () => output = await Backup.PrepareLmsRestoreAsync(lmsRestorePath, recoveryPreparationPath, recoveryDataDirectory, recoveryApplicationDirectory, recoveryKeyDirectory));
    private Task ValidateRestore() => Operation("Validating LMS restore…", async () => output = await Backup.ValidateLmsRestoreAsync(lmsRestorePath));
    private Task Inspect(BackupRepository repo, bool check) => Operation(check ? "Checking repository data integrity…" : "Reading repository statistics…", async () => { output = await Backup.InspectRepositoryAsync(repo.Id, check); showOutput = true; });
}
