        {
            while (await timer.WaitForNextTickAsync(polling.Token))
            {
                try { await RefreshProgress(); }
                catch (OperationCanceledException) when (polling.IsCancellationRequested) { break; }
                catch { await InvokeAsync(() => { monitoringUnavailable = true; StateHasChanged(); }); }
            }
        }
        catch (OperationCanceledException) when (polling.IsCancellationRequested) { }
