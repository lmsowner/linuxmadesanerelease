    });
    private Task Run(Guid id) => Operation("Starting your backup…", async () => { await Backup.StartBackupAsync(id); await RefreshProgress(); repositoryNotice = null; });
    private Task ShowSnapshots(BackupRepository repo, BackupSet? plan = null) => Operation("Reading snapshots…", async () => { recoveryDataDirectory = workspace?.DataDirectory ?? ""; recoveryApplicationDirectory = workspace?.ApplicationDirectory ?? ""; recoveryKeyDirectory = workspace?.ProtectionKeyDirectory ?? ""; snapshotRepository = repo; snapshotPlan = plan; snapshot = null; output = null; snapshots = []; files = []; selection.Clear(); selectedSnapshots.Clear(); snapshots = (await Backup.SnapshotsAsync(repo.Id)).Where(item => plan is null || item.Tags.Contains("lms-set-" + plan.Id.ToString("N"), StringComparer.Ordinal)).ToArray(); });
    private void ChooseSnapshotBackup()
    {
        var repositoryId = snapshotRepository!.Id;
        CloseSnapshots();
        NewSetForRepository(repositoryId);
    }
    private Task Browse(string id) => Operation("Reading snapshot files…", async () => { snapshot = null; files = []; output = null; files = await Backup.FilesAsync(snapshotRepository!.Id, id); snapshot = id; selection.Clear(); browseDirectory = "/"; fileSearch = ""; filePage = 0; restoreEverything = false; overwrite = false; });
    private void Select(string path, bool selected) { if (selected) selection.Add(path); else selection.Remove(path); }
    private void CloseSnapshots() { if (!busy) { snapshotRepository = null; snapshotPlan = null; } }
    private Task Restore() => Operation("Restoring selected snapshot…", async () => { await Backup.RestoreAsync(snapshotRepository!.Id, snapshot!, restoreTarget, restoreEverything ? [] : selection.ToArray(), overwrite); var recoveryFolder = snapshots.FirstOrDefault(item => item.Id == snapshot)?.Paths.FirstOrDefault(path => path.Contains("/lms-backup-staging-", StringComparison.Ordinal));
        if (recoveryFolder is not null && (restoreEverything || selection.Contains(recoveryFolder))) lmsRestorePath = Path.Combine(restoreTarget, recoveryFolder.TrimStart('/'));
        output = "Restore completed at " + restoreTarget + ". Restored files are decrypted; keep this directory private. Live LMS data was not changed."; });
    private Task PrepareRecovery() => Operation("Validating and preparing configuration recovery…", async () => output = await Backup.PrepareLmsRestoreAsync(lmsRestorePath, recoveryPreparationPath, recoveryDataDirectory, recoveryApplicationDirectory, recoveryKeyDirectory));
    private Task ValidateRestore() => Operation("Validating LMS restore…", async () => output = await Backup.ValidateLmsRestoreAsync(lmsRestorePath));
    private Task Inspect(BackupRepository repo, bool check) => Operation(check ? "Checking repository data integrity…" : "Reading repository statistics…", async () => { output = await Backup.InspectRepositoryAsync(repo.Id, check); showOutput = true; });
}
