    private Task ChangeBackupRepository(Guid id) { setEditor!.RepositoryId = id; fullSystemReady = false; fullSystemCheck = null; return setEditor.FullSystem ? CheckFullSystem() : Task.CompletedTask; }
    private Task CheckFullSystem() { fullSystemReady = false; fullSystemPackagesReady = false; fullSystemCheck = null; return Operation("Checking disks and recovery readiness…", async () => { fullSystemCheck = await Backup.InspectFullSystemAsync(setEditor!.RepositoryId); fullSystemReady = true; fullSystemPackagesReady = (await Diagnostics.GetPackageStatusAsync("FullBackup")).Installed; }); }
    private BackupSet? setEditor, snapshotPlan;
    private bool showHistory;
    private Guid? historySetId, historyRepositoryId;
    private string historyTitle = "";
    private IEnumerable<BackupOperation> HistoryEntries => (workspace?.History ?? []).Where(item =>
        (!historySetId.HasValue || item.SetId == historySetId) && (!historyRepositoryId.HasValue || item.RepositoryId == historyRepositoryId)).OrderByDescending(item => item.FinishedUtc);
    private Task ShowHistory(Guid? setId, Guid? repositoryId, string title) => Operation("Reading backup history…", async () => { historySetId = setId; historyRepositoryId = repositoryId; historyTitle = title; showHistory = true; workspace = await Backup.GetAsync(); });
    private bool initialize, schedule, busy, overwrite, showOutput;
    private int hour = 2, minute;
    private string recoveryPreparationPath = "", recoveryDataDirectory = "", recoveryApplicationDirectory = "", recoveryKeyDirectory = "";
    private bool protectBackupWithPassword;
    private string password = "", sources = "", restoreTarget = "", lmsRestorePath = "", progress = "";
    private string backupDestination = "", backupFolder = "lms-backups", localBackupPath = "", passwordConfirmation = "";
    private bool createHostBackupFolder = true;
    private string hostBackupFolder = "";
    private bool UseHostBackupFolder => initialize && !editingRepository && createHostBackupFolder && backupDestination != "local";
    private string? repositoryNotice;
    private bool editingRepository;
    private bool showNetworkMount, connectingNetworkMount;
    private RemoteShareMountEditor networkMountEditor = new() { PersistOnServer = true };
    private string? networkMountStatus;
