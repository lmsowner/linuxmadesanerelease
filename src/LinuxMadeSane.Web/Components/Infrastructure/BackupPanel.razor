    }
    private RenderFragment HostBackupFolderOptions => @<div>
        <UiCheckboxField Label="Create a separate subfolder for this host and backup plan" Disabled="@(busy || connectingNetworkMount)" @bind-Value="createHostBackupFolder" />
        @if (createHostBackupFolder)
        {
            <UiTextField Label="Backup subfolder (editable)" Helper="Created directly inside the connected share / folder selected above. Existing folders are not reused." Disabled="@(busy || connectingNetworkMount)" @bind-Value="hostBackupFolder" />
        }
    </div>;
    private string? error, output, snapshot;
    private IReadOnlyList<BackupSnapshot> snapshots = [];
    private IReadOnlyList<BackupFile> files = [];
    private readonly HashSet<string> selection = [];
    private IReadOnlyList<BackupProgress> jobs = [];
    private readonly CancellationTokenSource polling = new();
    private Task? pollTask;
    protected override async Task OnInitializedAsync()
    {
        if ((await Diagnostics.GetPackageStatusAsync("Backup")).Installed) await Load();
        await RefreshProgress();
        pollTask = PollProgress();
    }
    private async Task RefreshProgress()
    {
        await using var scope = ScopeFactory.CreateAsyncScope();
        var fresh = await scope.ServiceProvider.GetRequiredService<IHostBackupService>().GetProgressAsync(polling.Token);
        if (!busy && jobs.Any(old => old.IsRunning && fresh.Any(current => current.SetId == old.SetId && !current.IsRunning)))
        {
            var updatedWorkspace = await scope.ServiceProvider.GetRequiredService<IHostBackupService>().GetAsync(polling.Token);
            await InvokeAsync(() => workspace = updatedWorkspace);
        }
