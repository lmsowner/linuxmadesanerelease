    private void CloseRecoveryTest() { if (!busy) recoveryTestSet = null; }
    private Task SaveRecoveryTest() => Operation("Saving your restore notes…", async () => { await Backup.RecordRecoveryTestAsync(recoveryTestSet!.Id, recoveryTestSnapshot, recoveryTestEvidence); recoveryTestSet = null; workspace = await Backup.GetAsync(); });
    private string? fullSystemCheck;
    private bool fullSystemReady;
    private bool fullSystemPackagesReady;
