        <UiCommandButton Label="Choose what to back up" HideIcon="true" OnClick="ChooseSnapshotBackup" />
    }
    @if (snapshotPlan is not null) { <p>Showing only snapshots for <strong>@snapshotPlan.Name</strong>. Each new backup includes a <strong>backup-plan.json</strong> recovery record with the settings and notes at backup time.</p> }
    <p>Choose a dated recovery point. Deleting a snapshot is permanent; remaining snapshots are kept.</p>
    <div class="infrastructure-actions">
        <UiCommandButton Label="Delete selected snapshots" HideIcon="true" Disabled="@(busy || selectedSnapshots.Count == 0)" OnClick="RequestDeleteSnapshots" />
        <UiCommandButton Label="Reclaim unused space" HideIcon="true" Disabled="@busy" OnClick="RequestReclaimSpace" />
        <UiCommandButton Label="Recovery guide" HideIcon="true" OnClick="(() => OpenBackupGuide(snapshotPlan))" />
    </div>
    @if (output is not null && snapshot is null) { <p class="callout" role="status">@output</p> }
    <div class="snapshot-list">
    @foreach (var item in snapshots.OrderByDescending(item => item.Time))
    { <div class="snapshot-row">
        <UiCheckboxField Label="@(item.Time.ToLocalTime().ToString("g") + " · " + item.Id[..8])" Disabled="@busy" Value="@selectedSnapshots.Contains(item.Id)" ValueChanged="(value => SelectSnapshot(item.Id, value))" />
        <UiCommandButton Label="@(snapshot == item.Id ? "Browsing" : "Browse files")" HideIcon="true" Disabled="@busy" OnClick="(() => Browse(item.Id))" />
        @if (item.Tags.Contains("lms-full-system") && item.Tags.Contains("lms-backup-complete")) { <UiCommandButton Label="Recovery media" HideIcon="true" Disabled="@busy" OnClick="(() => OpenRecoveryMedia(item))" /> }
