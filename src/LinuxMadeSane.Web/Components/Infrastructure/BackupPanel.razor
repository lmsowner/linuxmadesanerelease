@using LinuxMadeSane.Application.Contracts.Infrastructure
@using LinuxMadeSane.Application.Interfaces
@using LinuxMadeSane.Application.Contracts.Shares
@inject IHostBackupService Backup
@inject IInfrastructureDiagnosticsService Diagnostics
@inject ShareMountsWorkspaceService ShareWorkspace
<FeaturePackageGate Feature="Backup" OnInstalled="Load">
    <p>Keep an encrypted copy of LMS and your chosen folders. First choose where to keep backups, then choose what to back up.</p>
    <div class="infrastructure-actions"><UiCommandButton Label="Refresh" Disabled="@busy" OnClick="Load" />
    <UiCommandButton Label="Set up backup storage" HideIcon="true" Disabled="@busy" OnClick="NewRepository" />
    <UiCommandButton Label="Choose what to back up" HideIcon="true" Disabled="@(busy || workspace?.Repositories.Count is null or 0)" OnClick="NewSet" /></div>
    @if (repositoryNotice is not null) { <p class="callout" role="status">@repositoryNotice</p> }
    @if (workspace is not null)
    {
        @foreach (var repository in workspace.Repositories)
        {
            <section class="surface-card"><h3>@repository.Name</h3><p>@repository.Path</p>
                <div class="infrastructure-actions"><UiCommandButton Label="Edit" Disabled="@busy" OnClick="(() => EditRepository(repository))" />
                <UiCommandButton Label="Snapshots / restore" Disabled="@busy" OnClick="(() => ShowSnapshots(repository))" />
                <UiCommandButton Label="Statistics" Disabled="@busy" OnClick="(() => Inspect(repository, false))" />
                <UiCommandButton Label="Integrity check" Disabled="@busy" OnClick="(() => Inspect(repository, true))" /></div>
            </section>
        }
        @foreach (var set in workspace.Sets)
        {
            <section class="surface-card"><h3>@set.Name</h3><p>Sources: @(set.IncludeLms ? "LMS database and protection keys; " : "")@string.Join("; ", set.Sources)</p>
            <p>Keep @set.KeepDaily daily · @set.KeepWeekly weekly · @set.KeepMonthly monthly · @set.ScheduleSummary @(set.ScheduleId.HasValue && !set.ScheduleEnabled ? "(disabled)" : "")</p>
            <div class="infrastructure-actions"><UiCommandButton Label="Edit set" Disabled="@busy" OnClick="(() => EditSet(set))" />
            <UiCommandButton Label="Back up now" Disabled="@busy" OnClick="(() => Run(set.Id))" /></div></section>
        }
        <h3>History</h3>
        @foreach (var history in workspace.History.Take(20))
        { <details class="surface-card"><summary>@history.StartedUtc.ToLocalTime().ToString("g") · @history.Kind · @(history.Success ? "Success" : "Failed")</summary><pre>@history.Detail</pre></details> }
    }
    @if (busy) { <p class="callout" aria-busy="true">@progress</p> }
    @if (error is not null) { <p class="callout error" role="alert">@error</p> }
</FeaturePackageGate>
<div class="backup-dialogs">
<UiModal Class="backup-compact-modal" IsOpen="@(repositoryEditor is not null && !showNetworkMount)" Title="@(editingRepository ? "Edit backup storage" : "Set up backup storage")" OnClose="CloseRepository"><ChildContent>
    @if (repositoryEditor is not null)
    {
        <p class="backup-introduction">This chooses where backups are stored. You will choose the files and schedule next.</p>
        <section class="backup-setup-step">
            <h3>1. Choose where to keep backups</h3>
            <UiTextField Label="Name for this backup location" Placeholder="For example: NAS backups" Disabled="@busy" @bind-Value="repositoryEditor.Name" />
            @if (!editingRepository)
            {
                <UiSelectField TValue="bool" Label="What are you setting up?" Disabled="@busy" @bind-Value="initialize">
                    <option value="true">A new backup location</option>
                    <option value="false">Connect an existing restic backup</option>
                </UiSelectField>
            }
            <UiSelectField TValue="string" Label="Store backups on" Disabled="@busy" @bind-Value="backupDestination">
                <option value="">Choose a network share</option>
                @foreach (var destination in workspace?.NetworkDestinations ?? [])
                { <option value="@destination.Path" disabled="@destination.IsReadOnly">@destination.Share — @(destination.IsReadOnly ? "Read-only" : destination.IsMounted ? "Connected" : "Not connected")</option> }
                <option value="local">A folder on this host — enter its full path</option>
            </UiSelectField>
            <div class="infrastructure-actions">
                <UiCommandButton Label="Add network share" Glyph="UiIconGlyph.NetworkMount" Disabled="@busy" OnClick="OpenNetworkMount" />
                <UiCommandButton Label="Refresh shares" Glyph="UiIconGlyph.Refresh" Variant="UiButtonVariant.Ghost" Disabled="@busy" OnClick="RefreshDestinations" />
            </div>
            @if (SelectedNetworkDestination is { } network)
            {
                <p>Share: <strong>@network.Share</strong> · Available on LMS at <strong>@network.Path</strong></p>
                @if (!network.IsMounted && network.ManagedMountId.HasValue)
                {
                    <UiCommandButton Label="Connect this saved share" Glyph="UiIconGlyph.Connect" Disabled="@busy" OnClick="ReconnectDestination" />
                }
            }
            else if (backupDestination != "local")
            {
                <p>@((workspace?.NetworkDestinations.Count ?? 0) == 0 ? "No network shares are set up yet. Add one above using your saved server credentials." : "Choose an existing share above, or add another. LMS uses the same network mounts as the file manager.")</p>
            }
            @if (backupDestination == "local")
            {
                <UiTextField Label="Full path to the backup folder" Placeholder="/var/backups/lms" Helper="Backups on the same disk cannot protect you if that disk fails. A separate disk or network share is safer." Disabled="@busy" @bind-Value="localBackupPath" />
            }
            else if (backupDestination.Length > 0)
            {
                <UiTextField Label="Backup folder inside this share" Placeholder="lms-backups" Helper="Use a dedicated folder. To connect an existing backup, enter its existing folder name." Disabled="@busy" @bind-Value="backupFolder" />
            }
        </section>
        <section class="backup-setup-step">
            <h3>2. Protect your backups</h3>
            <UiTextField Label="Backup encryption password" Type="password" Autocomplete="new-password" Helper="@(editingRepository ? "Leave blank to keep the saved password. This is separate from your Linux or LMS login." : initialize ? "Choose a new password for these backups. This is separate from your Linux or LMS login." : "Enter the encryption password used when this restic backup was created.")" Disabled="@busy" @bind-Value="password" />
            @if (initialize || password.Length > 0)
            {
                <UiTextField Label="Repeat backup password" Type="password" Autocomplete="new-password" Disabled="@busy" @bind-Value="passwordConfirmation" />
            }
            <p class="backup-password-guide">LMS stores this password encrypted. Keep a recovery copy in your password manager: you need it to restore backups if this LMS host is lost.</p>
        </section>
        <section class="backup-setup-step">
            <h3>3. Check and save</h3>
            @if (BackupPathPreview is { } preview) { <p class="backup-location-preview">Backups will be stored in <strong>@preview</strong>.</p> }
            else { <p>Choose a destination and backup folder above.</p> }
            <p>@(initialize ? "LMS will create encrypted backup storage here. Existing backups are not overwritten." : "LMS will check that it can open the existing backup with this password.") No backup runs at this step.</p>
            <div class="infrastructure-actions">
                <UiCommandButton Label="@(initialize ? "Create backup storage" : "Check & save backup storage")" HideIcon="true" Disabled="@(busy || BackupPathPreview is null || (backupDestination != "local" && SelectedNetworkDestination is not { IsMounted: true, IsReadOnly: false }) || string.IsNullOrWhiteSpace(repositoryEditor.Name) || (!editingRepository && password.Length == 0) || ((initialize || password.Length > 0) && password != passwordConfirmation))" OnClick="SaveRepository" />
                <UiCommandButton Label="Cancel" Variant="UiButtonVariant.Ghost" HideIcon="true" Disabled="@busy" OnClick="CloseRepository" />
            </div>
            @if (passwordConfirmation.Length > 0 && password != passwordConfirmation) { <p class="callout error" role="alert">The passwords do not match.</p> }
            @if (busy) { <p class="callout" role="status" aria-busy="true">@progress</p> }
        </section>
        @if (error is not null) { <p class="callout error">@error</p> }
    }
</ChildContent></UiModal>
<UiModal Class="share-mapping-modal" IsOpen="@showNetworkMount" Title="Add network share for backups" Subtitle="Choose saved server credentials and a share. LMS saves a permanent mount so scheduled backups can use it after a restart." OnClose="CloseNetworkMount">
    @if (showNetworkMount)
    {
        <ShareMappingForm Editor="@networkMountEditor" EnableRemoteShareDiscovery="true" ShowPersistenceToggle="false" PreferLmsDefaultMountPath="true"
                          IsBusy="@connectingNetworkMount" StatusMessage="@networkMountStatus" StatusTone="error"
                          PermanentSubmitLabel="Connect share & use for backups" OnCreateMount="CreateBackupNetworkMount" />
    }
</UiModal>
<UiModal Class="backup-compact-modal" IsOpen="@(setEditor is not null)" Title="Choose what to back up" OnClose="CloseSet"><ChildContent>
    @if (setEditor is not null)
    {
        <p class="backup-introduction">Choose the files to protect and when to back them up. The backup location stores the encrypted copies.</p>
        <UiTextField Label="Name for this backup" @bind-Value="setEditor.Name" />
        <UiSelectField TValue="Guid" Label="Backup location" @bind-Value="setEditor.RepositoryId">@foreach (var repo in workspace?.Repositories ?? []) { <option value="@repo.Id">@repo.Name — @repo.Path</option> }</UiSelectField>
        <UiCheckboxField Label="Back up LMS itself" Helper="Includes a consistent copy of the LMS database and the protection keys needed to recover saved credentials." @bind-Value="setEditor.IncludeLms" />
        <UiTextAreaField Label="Additional source directories" Helper="One absolute directory per line, for example /etc/ssh or your Docker compose directory" @bind-Value="sources" Rows="3" />
        <div class="infrastructure-grid"><UiNumberField TValue="int" Label="Daily snapshots" @bind-Value="setEditor.KeepDaily" min="0" /><UiNumberField TValue="int" Label="Weekly" @bind-Value="setEditor.KeepWeekly" min="0" /><UiNumberField TValue="int" Label="Monthly" @bind-Value="setEditor.KeepMonthly" min="0" /></div>
        <UiCheckboxField Label="Enable scheduled backups" Helper="New schedules run daily in the host's local timezone. Other schedules can be edited in Scheduling." @bind-Value="schedule" />
        @if (schedule && setEditor.ScheduleUsesDaily) { <div class="infrastructure-grid"><UiNumberField TValue="int" Label="Hour" @bind-Value="hour" min="0" max="23" /><UiNumberField TValue="int" Label="Minute" @bind-Value="minute" min="0" max="59" /></div> }
        @if (setEditor.ScheduleId.HasValue && !setEditor.ScheduleUsesDaily) { <p>@setEditor.ScheduleSummary · <a href="/scheduling">Edit schedule</a></p> }
        <UiCommandButton Label="Save backup plan" HideIcon="true" Disabled="@busy" OnClick="SaveSet" />
        @if (busy) { <p class="callout" role="status">@progress</p> }
        @if (error is not null) { <p class="callout error">@error</p> }
    }
</ChildContent></UiModal>
<UiModal IsOpen="@(snapshotRepository is not null)" Title="Snapshots & restore" OnClose="CloseSnapshots"><ChildContent>
    @foreach (var item in snapshots.OrderByDescending(item => item.Time))
    { <div class="infrastructure-actions"><span>@item.Time.ToLocalTime().ToString("g") · @item.Id[..8]</span><UiCommandButton Label="Browse snapshot" Disabled="@busy" OnClick="(() => Browse(item.Id))" /></div> }
    @if (snapshot is not null)
    {
        <div class="snapshot-files">@foreach (var file in files.Take(1000)) { <UiCheckboxField Label="@(file.Path + (file.Type == "dir" ? "/" : ""))" Value="@selection.Contains(file.Path)" ValueChanged="(value => Select(file.Path, value))" /> }</div>
        @if (files.Count > 1000) { <p>Showing the first 1,000 entries. Selecting a directory includes its contents.</p> }
        <UiTextField Label="Restore destination" Helper="Use an alternate directory. Live LMS data and system roots are protected." @bind-Value="restoreTarget" />
        <UiCheckboxField Label="I explicitly allow existing files at this destination to be overwritten" @bind-Value="overwrite" />
        <p>@(selection.Count == 0 ? "All snapshot files will be restored." : $"{selection.Count} selected file(s) or directory(s) will be restored.")</p>
        <UiCommandButton Label="Restore to destination" HideIcon="true" Disabled="@busy" OnClick="Restore" />
        <details><summary>Restoring LMS itself</summary><p>Restore the snapshot to an alternate directory first. Find its LMS staging folder containing linuxmadesane.db and protection-keys. Validate it below before a maintenance restore. LMS must be stopped before its live database and keys are replaced.</p>
        <UiTextField Label="Restored LMS staging folder" @bind-Value="lmsRestorePath" /><UiCommandButton Label="Validate staged LMS restore" HideIcon="true" Disabled="@busy" OnClick="ValidateRestore" /></details>
    }
    @if (busy) { <p class="callout">@progress</p> }
    @if (error is not null) { <p class="callout error">@error</p> }
    @if (output is not null) { <pre>@output</pre> }
</ChildContent></UiModal>
<UiModal IsOpen="@showOutput" Title="Repository operation" OnClose="(() => showOutput = false)"><ChildContent><pre>@output</pre></ChildContent></UiModal>
</div>
@code {
    private BackupWorkspace? workspace;
    private BackupRepository? repositoryEditor, snapshotRepository;
    private BackupSet? setEditor;
    private bool initialize, schedule, busy, overwrite, showOutput;
    private int hour = 2, minute;
    private string password = "", sources = "", restoreTarget = "", lmsRestorePath = "", progress = "";
    private string backupDestination = "", backupFolder = "lms-backups", localBackupPath = "", passwordConfirmation = "";
    private string? repositoryNotice;
    private bool editingRepository;
    private bool showNetworkMount, connectingNetworkMount;
    private RemoteShareMountEditor networkMountEditor = new() { PersistOnServer = true };
    private string? networkMountStatus;
    private BackupNetworkDestination? SelectedNetworkDestination => workspace?.NetworkDestinations.FirstOrDefault(item => item.Path == backupDestination);
    private string? BackupPathPreview
    {
        get { try { return BackupDestinationSelection.Resolve(backupDestination, backupFolder, localBackupPath); } catch (InvalidOperationException) { return null; } }
    }
    private string? error, output, snapshot;
    private IReadOnlyList<BackupSnapshot> snapshots = [];
    private IReadOnlyList<BackupFile> files = [];
    private readonly HashSet<string> selection = [];
    protected override async Task OnInitializedAsync() { if ((await Diagnostics.GetPackageStatusAsync("Backup")).Installed) await Load(); }
    private async Task Operation(string label, Func<Task> operation)
    { busy = true; progress = label; error = null; await InvokeAsync(StateHasChanged); await Task.Yield(); try { await operation(); } catch (Exception e) { error = e.Message; } finally { busy = false; } }
    private Task Load() => Operation("Reading backup configuration…", async () => workspace = await Backup.GetAsync());
    private void NewRepository() { error = null; repositoryNotice = null; password = passwordConfirmation = ""; initialize = true; editingRepository = false; backupDestination = localBackupPath = ""; backupFolder = "lms-backups"; repositoryEditor = new() { Name = "LMS backup" }; }
    private void EditRepository(BackupRepository repo)
    {
        error = null; repositoryNotice = null; password = passwordConfirmation = ""; initialize = false; editingRepository = true;
        var share = workspace?.NetworkDestinations.Where(item => repo.Path.StartsWith(item.Path.TrimEnd('/') + "/", StringComparison.Ordinal))
            .OrderByDescending(item => item.Path.Length).FirstOrDefault();
        backupDestination = share?.Path ?? "local"; localBackupPath = repo.Path;
        backupFolder = share is null ? "lms-backups" : repo.Path[(share.Path.TrimEnd('/').Length + 1)..];
        repositoryEditor = new() { Id = repo.Id, Name = repo.Name, Path = repo.Path };
    }
    private void CloseRepository() { if (!busy) { repositoryEditor = null; password = passwordConfirmation = ""; } }
    private Task RefreshDestinations() => Operation("Refreshing connected disks and shares…", async () => workspace = await Backup.GetAsync());
    private void OpenNetworkMount()
    {
        networkMountStatus = null;
        networkMountEditor = new() { PersistOnServer = true };
        showNetworkMount = true;
    }
    private void CloseNetworkMount()
    {
        if (connectingNetworkMount) return;
        showNetworkMount = false;
        networkMountEditor = new() { PersistOnServer = true };
        networkMountStatus = null;
    }
    private async Task CreateBackupNetworkMount(bool _)
    {
        connectingNetworkMount = true; networkMountStatus = null;
        try
        {
            networkMountEditor.PersistOnServer = true;
            var result = await ShareWorkspace.CreateRemoteShareMountAsync(networkMountEditor);
            // Select the actual mount returned by the standard share workflow, not a guessed path.
            backupDestination = result.LocalMountPath;
            showNetworkMount = false;
            networkMountEditor = new() { PersistOnServer = true };
            await RefreshDestinations();
        }
        catch (Exception exception) { networkMountStatus = exception.Message; }
        finally { connectingNetworkMount = false; }
    }
    private Task ReconnectDestination() => Operation("Connecting the saved network share…", async () =>
    {
        var id = SelectedNetworkDestination?.ManagedMountId ?? throw new InvalidOperationException("Choose a saved network share to reconnect.");
        var result = await ShareWorkspace.ReconnectManagedRemoteMountAsync(id);
        workspace = await Backup.GetAsync();
        if (result is null || SelectedNetworkDestination is not { IsMounted: true, IsReadOnly: false })
            throw new InvalidOperationException("This share is not connected for writing. Check its connection in Network Shares before creating backup storage.");
    });
    private Task SaveRepository() => Operation(initialize ? "Creating encrypted backup storage…" : "Checking the backup password and location…", async () =>
    {
        repositoryEditor!.Path = BackupDestinationSelection.Resolve(backupDestination, backupFolder, localBackupPath);
        if (backupDestination != "local")
        {
            workspace = await Backup.GetAsync();
            if (SelectedNetworkDestination is not { IsMounted: true, IsReadOnly: false })
                throw new InvalidOperationException("Connect this network share before saving. LMS will not put backups in an empty mount folder.");
        }
        if ((initialize || password.Length > 0) && password != passwordConfirmation) throw new InvalidOperationException("The passwords do not match.");
        await Backup.SaveRepositoryAsync(repositoryEditor, password, initialize);
        repositoryNotice = $"Backup storage is ready at {repositoryEditor.Path}. Next, select ‘Choose what to back up’ to choose files and a schedule. No backup has run yet.";
        repositoryEditor = null; password = passwordConfirmation = ""; workspace = await Backup.GetAsync();
    });
    private void NewSet() { error = null; setEditor = new() { RepositoryId = workspace!.Repositories[0].Id }; sources = ""; schedule = false; hour = 2; minute = 0; }
    private void EditSet(BackupSet set) { setEditor = System.Text.Json.JsonSerializer.Deserialize<BackupSet>(System.Text.Json.JsonSerializer.Serialize(set)); sources = string.Join('\n', set.Sources); schedule = set.ScheduleEnabled; hour = set.ScheduleHour; minute = set.ScheduleMinute; }
    private void CloseSet() { if (!busy) setEditor = null; }
    private Task SaveSet() => Operation("Saving backup set…", async () => { setEditor!.Sources = sources.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList(); await Backup.SaveSetAsync(setEditor, schedule, hour, minute); setEditor = null; workspace = await Backup.GetAsync(); });
    private Task Run(Guid id) => Operation("Backup running… You can find its result in History.", async () => { try { await Backup.RunBackupAsync(id); } finally { workspace = await Backup.GetAsync(); } });
    private Task ShowSnapshots(BackupRepository repo) => Operation("Reading snapshots…", async () => { snapshotRepository = repo; snapshot = null; output = null; snapshots = await Backup.SnapshotsAsync(repo.Id); });
    private Task Browse(string id) => Operation("Reading snapshot files…", async () => { snapshot = id; files = await Backup.FilesAsync(snapshotRepository!.Id, id); selection.Clear(); });
    private void Select(string path, bool selected) { if (selected) selection.Add(path); else selection.Remove(path); }
    private void CloseSnapshots() { if (!busy) snapshotRepository = null; }
    private Task Restore() => Operation("Restoring selected snapshot…", async () => { await Backup.RestoreAsync(snapshotRepository!.Id, snapshot!, restoreTarget, selection.ToArray(), overwrite); output = "Restore completed at " + restoreTarget + ". Live LMS data was not changed."; });
    private Task ValidateRestore() => Operation("Validating LMS restore…", async () => output = await Backup.ValidateLmsRestoreAsync(lmsRestorePath));
    private Task Inspect(BackupRepository repo, bool check) => Operation(check ? "Checking repository data integrity…" : "Reading repository statistics…", async () => { output = await Backup.InspectRepositoryAsync(repo.Id, check); showOutput = true; });
}
