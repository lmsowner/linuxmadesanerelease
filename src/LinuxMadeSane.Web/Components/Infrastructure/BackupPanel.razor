    private static string FormatFileSize(long bytes) => bytes >= 1_000_000_000 ? $"{bytes / 1_000_000_000d:0.##} GB" : bytes >= 1_000_000 ? $"{bytes / 1_000_000d:0.##} MB" : bytes >= 1_000 ? $"{bytes / 1_000d:0.##} KB" : $"{bytes} B";
    private void SelectSnapshot(string id, bool value) { if (value) selectedSnapshots.Add(id); else selectedSnapshots.Remove(id); }
    private void CloseDeletion() { if (!busy) pendingDeletion = null; }
    private void RequestDeletePlan(BackupSet set)
    {
        deletionTitle = "Delete plan"; deletionExplanation = $"Delete {set.Name} and its schedule? Its stored backups, storage credentials and history will remain available under Backup storage locations → All snapshots / restore.";
        deletionConfirmation = "Delete this plan and schedule; keep its stored backups"; deletionConfirmed = false; error = null;
        pendingDeletion = async () => { await Backup.DeleteSetAsync(set.Id, true); workspace = await Backup.GetAsync(); repositoryNotice = "Plan deleted. Stored backups are still available in Backup storage locations."; };
    }
    private void RequestDeleteSnapshots()
    {
        var ids = selectedSnapshots.ToArray(); var repository = snapshotRepository!; var plan = snapshotPlan;
        deletionTitle = "Delete selected snapshots"; deletionExplanation = $"Permanently delete {ids.Length} selected recovery point(s) from {repository.Name}? Other snapshots are preserved. Shared data is kept until no remaining backup needs it. Reclaim unused space afterwards if needed.";
        deletionConfirmation = "Permanently delete the selected recovery points"; deletionConfirmed = false; error = null;
        pendingDeletion = async () => { await Backup.DeleteSnapshotsAsync(repository.Id, ids, true); snapshot = null; files = []; selection.Clear(); selectedSnapshots.Clear(); snapshots = (await Backup.SnapshotsAsync(repository.Id)).Where(item => plan is null || item.Tags.Contains("lms-set-" + plan.Id.ToString("N"), StringComparer.Ordinal)).ToArray(); output = "Selected snapshots deleted. Remaining backups are preserved. Reclaim unused space to remove unreferenced data."; };
    }
    private void RequestReclaimSpace()
    {
        var id = snapshotRepository!.Id;
        deletionTitle = "Reclaim unused space"; deletionExplanation = "Restic will remove only data no remaining snapshot needs. This can take a long time and locks this repository against backups. It does not remove recovery points.";
        deletionConfirmation = "Remove unused data; keep all remaining snapshots"; deletionConfirmed = false; error = null;
        pendingDeletion = async () => output = await Backup.ReclaimSpaceAsync(id, true);
    }
    private Task ConfirmDeletion() => Operation(deletionTitle + " — restic is working; please wait…", async () => { await pendingDeletion!(); pendingDeletion = null; });
    private BackupWorkspace? workspace;
