<button type="button" class="ssh-help-link" @ref="trigger" @onclick="() => isOpen = true">@Label</button>
<SshHelpDialog IsOpen="isOpen" InitialSection="@Section" OnClose="CloseAsync" />
@code {
    [Parameter] public string Section { get; set; } = "basics";
    [Parameter] public string Label { get; set; } = "SSH help: keys, passwords and login";
    private bool isOpen;
    private ElementReference trigger;
    private async Task CloseAsync() { isOpen = false; await trigger.FocusAsync(); }
}
