@using LinuxMadeSane.Core.Enums
@using LinuxMadeSane.Application.Services
@if (Kind != RunbookTargetKind.Machine)
{
    <UiTextAreaField Label="@RunbookSelectionSupport.Label(Kind)"
                     Value="@Value" ValueChanged="ValueChanged" ValueExpression="@(() => Value)"
                     Helper="@($"Enter absolute paths on {HostName}, one path per line. Spaces and quotes are preserved. Paths are checked when the script runs.")"
                     Placeholder="/home/user/example" Rows="4" />
    <p class="helper-text">@RunbookScaffold.Describe(Kind)</p>
}
@code {
    [Parameter] public RunbookTargetKind Kind { get; set; }
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string HostName { get; set; } = "the selected host";
}
