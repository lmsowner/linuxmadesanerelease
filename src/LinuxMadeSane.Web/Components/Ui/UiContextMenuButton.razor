@if (!string.IsNullOrWhiteSpace(Href))
{
    @if (OnClick.HasDelegate)
    {
        <a class="@CssClass"
           href="@Href"
           title="@ResolvedTitle"
           target="@Target"
           rel="@Rel"
           onpointerdown="@ResolvedPointerDownClientScript"
           @onclick="OnClick">
            @ButtonContent
        </a>
    }
    else
    {
        <a class="@CssClass"
           href="@Href"
           title="@ResolvedTitle"
           target="@Target"
           rel="@Rel"
           onpointerdown="@OnClientPointerDown"
           onclick="@OnClientClick">
            @ButtonContent
        </a>
    }
}
else
{
    @if (OnClick.HasDelegate)
    {
        <button class="@CssClass"
                role="@(Selected.HasValue ? "menuitemradio" : null)"
                aria-checked="@(Selected.HasValue ? (Selected.Value ? "true" : "false") : null)"
                type="button"
                title="@ResolvedTitle"
                disabled="@Disabled"
                onpointerdown="@ResolvedPointerDownClientScript"
                @onclick="OnClick">
            @ButtonContent
        </button>
    }
    else
    {
        <button class="@CssClass"
                role="@(Selected.HasValue ? "menuitemradio" : null)"
                aria-checked="@(Selected.HasValue ? (Selected.Value ? "true" : "false") : null)"
                type="button"
                title="@ResolvedTitle"
                disabled="@Disabled"
                onpointerdown="@OnClientPointerDown"
                onclick="@OnClientClick">
            @ButtonContent
        </button>
    }
}

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public string? Title { get; set; }
    [Parameter] public UiIconGlyph Glyph { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public string? Target { get; set; }
    [Parameter] public string? Rel { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public UiIconName? IconName { get; set; }
    [Parameter] public bool? Selected { get; set; }
    [Parameter] public bool Danger { get; set; }
    [Parameter] public string? OnClientPointerDown { get; set; }
    [Parameter] public string? OnClientClick { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private string ResolvedTitle => string.IsNullOrWhiteSpace(Title) ? Label : Title.Trim();
    private string CssClass => "ui-context-menu-button" + (Danger ? " danger" : "") + (Selected.HasValue ? " ui-context-menu-choice" : "");
    private string? ResolvedPointerDownClientScript =>
        !string.IsNullOrWhiteSpace(OnClientPointerDown) ? OnClientPointerDown : OnClientClick;
    private RenderFragment ButtonContent => @<text>
        <span class="ui-context-menu-button-icon" aria-hidden="true">
            @if (IconName.HasValue) { <UiIcon Name="@IconName.Value" /> }
            else { <UiGlyphIcon Glyph="@Glyph" /> }
        </span>
        <span class="ui-context-menu-button-label">@Label</span>
        @if (Selected.HasValue) { <span aria-hidden="true">@(Selected.Value ? "✓" : "")</span> }
    </text>;
}
