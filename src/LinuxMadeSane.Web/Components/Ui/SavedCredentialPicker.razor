@using LinuxMadeSane.Application.Interfaces
@inject ISavedConnectionCredentialService Credentials
@using LinuxMadeSane.Core.Abstractions
@inject ISavedCredentialAccessContext Access

<div class="saved-credential-picker">
    <div class="saved-credential-picker-row @(ShowLabel ? string.Empty : "saved-credential-picker-label-less")">
    <UiComboboxField TValue="string" Label="@(ShowLabel ? "Saved server and credentials" : null)" aria-label="Saved server and credentials" Value="@selection" ValueChanged="SelectAsync" Disabled="@(Disabled || userId is null)" Compact="true">
        <option value="">@(SavedOnly ? "Choose saved server and credentials..." : "Enter connection details manually")</option>
        @foreach (var item in entries)
        {
            <option value="@item.Id">@item.Name · @(string.IsNullOrWhiteSpace(item.Server) ? "Reusable keypair" : item.Server)@(string.IsNullOrWhiteSpace(item.Username) ? "" : $" · {item.Username}")</option>
        }
    </UiComboboxField>
    @if (ShowAddButton)
    {
        <UiCommandButton Class="credential-command" Label="Add credentials" Glyph="UiIconGlyph.Plus" OnClick="AddRequested" Disabled="@(Disabled || userId is null)" />
    }
    @if (InlineManageButton)
    {
    <UiCommandButton Class="credential-command" Label="Manage saved credentials" Glyph="UiIconGlyph.Edit" OnClick="ManageSelectedAsync" Disabled="@(Disabled || userId is null || !Guid.TryParse(selection, out _))" Title="Edit the selected credential here without leaving this connection." />
    }
    @Actions
    </div>
    @if (userId is null) { <span class="meta-text">This session does not have access to saved credentials.</span> }
    @if (!InlineManageButton)
    {
    <UiCommandButton Class="credential-command" Label="Manage saved credentials" Glyph="UiIconGlyph.Edit" OnClick="ManageSelectedAsync" Disabled="@(Disabled || userId is null || !Guid.TryParse(selection, out _))" Title="Edit the selected credential here without leaving this connection." />
    }
    @if (!string.IsNullOrWhiteSpace(error)) { <p class="callout error" role="alert">@error</p> }
</div>

@* The reusable editor may be hosted inside a connection EditForm. Its save must
   not bubble into that form and save/close the unfinished connection as well. *@
<div @onsubmit:stopPropagation="true">
    <SavedCredentialsPanel @ref="credentialEditor" EditorOnly="true" Saved="CredentialSavedAsync" />
</div>

@code {
    [Parameter] public Guid? InitialSelectionId { get; set; }
    private Guid? appliedInitialSelection;
    protected override async Task OnParametersSetAsync()
    {
        if (InitialSelectionId is Guid id && id != Guid.Empty && id != appliedInitialSelection && userId is not null)
        { appliedInitialSelection = id; await SelectAsync(id.ToString()); }
    }
    [Parameter] public bool InlineManageButton { get; set; }
    [Parameter] public bool ShowLabel { get; set; } = true;
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public bool ShowAddButton { get; set; }
    [Parameter] public EventCallback AddRequested { get; set; }
    public async Task SelectCreatedAsync(Guid id)
    {
        if (userId is null) return;
        try
        {
            await LoadEntriesAsync();
            await SelectAsync(id.ToString());
        }
        catch { error = "Credential saved, but the list could not be refreshed. Reopen the host dialog to select it."; }
        await InvokeAsync(StateHasChanged);
    }
    private async Task LoadEntriesAsync()
    {
        if (userId.HasValue) entries = (await Credentials.ListAsync(userId.Value)).Where(x => (CredentialKind.HasValue ? x.Kind == CredentialKind.Value : SmbOnly ? x.Kind == ConnectionCredentialKind.Smb : x.Kind is ConnectionCredentialKind.Ssh or ConnectionCredentialKind.Sftp or ConnectionCredentialKind.SshKeyPair) && (string.IsNullOrWhiteSpace(Server) || x.Kind == ConnectionCredentialKind.SshKeyPair && string.IsNullOrWhiteSpace(x.Server) || x.Server.TrimEnd('.').Equals(Server.Trim().TrimEnd('.'), StringComparison.OrdinalIgnoreCase) && (x.Kind is ConnectionCredentialKind.Rdp or ConnectionCredentialKind.Vnc || Port is null || x.Port == Port))).ToArray();
    }

    [Parameter] public string? Server { get; set; }
    [Parameter] public int? Port { get; set; }
    [Parameter] public bool SavedOnly { get; set; }
    [Parameter] public EventCallback Cleared { get; set; }
    [Parameter] public ConnectionCredentialKind? CredentialKind { get; set; }
    [Parameter] public bool SmbOnly { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<SavedConnectionCredential> Selected { get; set; }
    private IReadOnlyList<SavedConnectionCredentialSummary> entries = [];
    private Guid? userId;
    private SavedCredentialsPanel? credentialEditor;
    private async Task ManageSelectedAsync()
    {
        if (Disabled || userId is null || !Guid.TryParse(selection, out var id) || credentialEditor is null) return;
        error = null;
        try { await credentialEditor.OpenEditAsync(id); }
        catch { error = "Unable to open this saved credential. Check that it still exists and retry."; }
    }
    private async Task CredentialSavedAsync(SavedConnectionCredentialSummary saved)
    {
        await SelectCreatedAsync(saved.Id);
    }
    private string selection = "";
    private string? error;
    protected override async Task OnInitializedAsync()
    {
        try
        {
            userId = await Access.GetAuthenticatedUserIdAsync();
            await LoadEntriesAsync();
        }
        catch { error = "Unable to load saved credentials. Open Manage saved credentials to check the store."; }
    }
    private async Task SelectAsync(string value)
    {
        selection = value; error = null;
        if (Disabled || userId is null) return;
        if (!Guid.TryParse(value, out var id)) { await Cleared.InvokeAsync(); return; }
        try
        {
            var item = await Credentials.ResolveAsync(userId.Value, id) ?? throw new InvalidOperationException("This credential is no longer available.");
            await Selected.InvokeAsync(item);
        }
        catch { selection = ""; await Cleared.InvokeAsync(); error = "Unable to use the saved credential. Check it in Security & Networking."; }
    }
}
