@using LinuxMadeSane.Core.Models.Shares

<UiModal IsOpen="@(pending is not null)" Title="Remove share" OnClose="@(() => Complete(false))">
    <ChildContent><p>@share?.RemovalConfirmation</p></ChildContent>
    <Footer>
        <UiCommandButton Label="No" Variant="UiButtonVariant.Ghost" OnClick="@(() => Complete(false))" />
        <UiCommandButton Label="Yes" Variant="UiButtonVariant.Danger" OnClick="@(() => Complete(true))" />
    </Footer>
</UiModal>

@code {
    private SambaShareDefinition? share;
    private TaskCompletionSource<bool>? pending;

    public Task<bool> ShowAsync(SambaShareDefinition selectedShare)
    {
        if (pending is not null)
        {
            return Task.FromResult(false);
        }
        share = selectedShare;
        pending = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
        StateHasChanged();
        return pending.Task;
    }

    private void Complete(bool confirmed)
    {
        var completion = pending;
        pending = null;
        share = null;
        completion?.TrySetResult(confirmed);
    }
}
