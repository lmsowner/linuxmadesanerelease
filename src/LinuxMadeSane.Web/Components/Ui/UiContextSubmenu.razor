<div class="host-file-context-submenu">
    <button type="button" class="ui-context-menu-button host-file-context-submenu-trigger" aria-haspopup="menu" aria-expanded="false">
        <span class="ui-context-menu-button-icon" aria-hidden="true">
            @if (IconName.HasValue) { <UiIcon Name="@IconName.Value" /> }
            else { <UiGlyphIcon Glyph="@Glyph" /> }
        </span>
        <span class="ui-context-menu-button-label">@Label</span>
        <span class="host-file-context-submenu-arrow" aria-hidden="true">›</span>
    </button>
    <div class="host-file-context-submenu-panel" role="menu" aria-label="@Label">@ChildContent</div>
</div>
@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public UiIconName? IconName { get; set; }
    [Parameter] public UiIconGlyph Glyph { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
