@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

@if (IsOpen)
{
    <div class="ssh-help-dialog" @ref="focusRegion" tabindex="-1" @onkeydown="HandleKeyDown">
        <UiModal IsOpen="true" Title="SSH made simple" Subtitle="Keys, passwords and fixing a connection — one step at a time."
                 Class="ssh-help-modal" OnClose="OnClose">
            <ChildContent><SshHelpGuide InitialSection="@InitialSection" /></ChildContent>
            <Footer><span class="meta-text">Your current settings stay open underneath.</span><UiCommandButton Label="Done" HideIcon="true" OnClick="OnClose" /></Footer>
        </UiModal>
    </div>
}
@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string InitialSection { get; set; } = "basics";
    [Parameter] public EventCallback OnClose { get; set; }
    private ElementReference focusRegion;
    private IJSObjectReference? module;
    private bool focusPending;
    private bool wasOpen;
    protected override void OnParametersSet() { focusPending = IsOpen && !wasOpen; wasOpen = IsOpen; }
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (focusPending) { focusPending = false; module ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./Components/Ui/SshHelpDialog.razor.js"); await module.InvokeVoidAsync("trapFocus", focusRegion); } }
    private Task HandleKeyDown(KeyboardEventArgs args) => args.Key == "Escape" ? OnClose.InvokeAsync() : Task.CompletedTask;
    public async ValueTask DisposeAsync()
    {
        if (module is not null) { try { await module.DisposeAsync(); } catch (JSDisconnectedException) { } }
    }
}
