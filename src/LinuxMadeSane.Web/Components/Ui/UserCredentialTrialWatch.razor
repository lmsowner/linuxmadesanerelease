@implements IDisposable
@using LinuxMadeSane.Application.Interfaces
@inject IUserCredentialTrialService Trials
@inject ILogger<UserCredentialTrialWatch> Logger

@code {
    [Parameter, EditorRequired] public UserCredentialTrial Trial { get; set; } = null!;
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public EventCallback OnExpired { get; set; }
    private readonly CancellationTokenSource cancellation = new();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) _ = WatchAsync(cancellation.Token);
    }

    private async Task WatchAsync(CancellationToken token)
    {
        while (!token.IsCancellationRequested)
        {
            try
            {
                await Task.Delay(TimeSpan.FromSeconds(2), token);
                if (IsBusy) continue;
                var current = await Trials.GetActiveTrialAsync(token);
                if (current?.Id == Trial.Id) continue;
                await InvokeAsync(async () => { if (!IsBusy && !token.IsCancellationRequested) await OnExpired.InvokeAsync(); });
                return;
            }
            catch (OperationCanceledException) when (token.IsCancellationRequested) { return; }
            catch (Exception ex) { Logger.LogWarning(ex, "Could not refresh the user login trial status"); }
        }
    }

    public void Dispose() { cancellation.Cancel(); cancellation.Dispose(); }
}
