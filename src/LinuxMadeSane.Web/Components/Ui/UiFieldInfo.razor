<span class="ui-field-info">
    <button type="button" class="ui-field-info-trigger" aria-label="@($"Help: {Title}")" aria-describedby="@tipId">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="8.5" />
            <path d="M12 11.5v5M12 7.5h.01" />
        </svg>
    </button>
    <span class="ui-field-info-tip" id="@tipId" role="tooltip"><strong>@Title</strong><span>@Text</span></span>
</span>
@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Text { get; set; } = string.Empty;
    private readonly string tipId = $"field-info-{Guid.NewGuid():N}";
}
