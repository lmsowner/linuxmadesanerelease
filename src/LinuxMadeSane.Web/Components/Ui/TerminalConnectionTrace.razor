@using LinuxMadeSane.Web.Services

@{
    var entries = Tab.ConnectionTrace;
}
@if (entries.Count > 0)
{
    <details class="terminal-connection-trace" open="@Expanded">
        <summary>SSH connection details · @(Tab.ConnectionTracePending ? "Connecting" : !string.IsNullOrWhiteSpace(Tab.ErrorMessage) ? "Failed" : Tab.IsSessionActive ? "Connected" : "Last attempt")</summary>
        <ol>
            @foreach (var entry in entries)
            {
                <li><time>@entry.ElapsedMilliseconds.ToString("0") ms</time><span>@entry.Message</span></li>
            }
        </ol>
    </details>
}

@code {
    [Parameter, EditorRequired] public TerminalTabState Tab { get; set; } = default!;
    [Parameter] public bool Expanded { get; set; }
}
