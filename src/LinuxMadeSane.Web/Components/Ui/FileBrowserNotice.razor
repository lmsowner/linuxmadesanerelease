@if (!string.IsNullOrWhiteSpace(Message))
{
    <button type="button" class="callout @Tone file-browser-notice" title="@Message" popovertarget="@noticeId">@Message</button>
    <div popover="auto" id="@noticeId" class="callout @Tone file-browser-notice-detail">@Message</div>
}

@code {
    [Parameter] public string? Message { get; set; }
    [Parameter] public string Tone { get; set; } = "info";
    private readonly string noticeId = "file-notice-" + Guid.NewGuid().ToString("N");
}
