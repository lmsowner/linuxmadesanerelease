@using LinuxMadeSane.Application.Interfaces
@using LinuxMadeSane.Core.Abstractions
@using Microsoft.AspNetCore.Components.Authorization
@inject ISavedConnectionCredentialService Credentials
@inject ISavedCredentialAccessContext Access
@inject IManagedHostStore Hosts
@inject ISshKeyPairGenerator KeyGenerator
@inject ISavedCredentialConnectionService Connections
@inject IJSRuntime JS

@if (!EditorOnly)
{
<section class="surface-card credentials-panel">
    <div class="credentials-heading">
        <div><h2>Saved credentials</h2><p class="meta-text">Save a server and its login once, then choose it in SSH, SFTP and SMB/CIFS connection dialogs.</p></div>
        <UiCommandButton Class="credential-command" Label="Add credential" Glyph="UiIconGlyph.Plus" OnClick="AddAsync" Disabled="@(userId is null || busy)" />
    </div>
    @if (userId is null) { <p class="callout info">This session does not have access to administer LMS credentials.</p> }
    else { <p class="meta-text">Central store for this LMS host. Passwords, private keys and key passphrases are encrypted in LMS storage.</p> }
    @if (!string.IsNullOrWhiteSpace(message)) { <p class="callout @tone" role="status">@message</p> }
    @if (loading) { <p class="meta-text">Loading saved credentials...</p> }
    else if (entries.Count == 0) { <p class="meta-text">No saved credentials yet.</p> }
    else
    {
        <div class="credentials-list">
            @foreach (var item in entries)
            {
                <div class="credentials-row">
                    <div><strong>@item.Name</strong><span class="meta-text">@KindLabel(item.Kind) · @(string.IsNullOrWhiteSpace(item.Server) ? "Any SSH/SFTP server" : $"{item.Server}:{item.Port}")@(string.IsNullOrWhiteSpace(item.Username) ? "" : $" · {item.Username}")</span></div>
                    <div class="toolbar-row">
                        @if (item.HasPrivateKey) { <UiCommandButton Class="credential-command" Label="Copy public key" Glyph="UiIconGlyph.Copy" OnClick="@(() => CopyKeyAsync(item.PublicKey))" Disabled="@busy" /> }
                        <UiCommandButton Class="credential-command" Label="Test credentials" OnClick="@(() => TestSavedAsync(item))" Disabled="@busy" />
                        <UiCommandButton Class="credential-command" Label="Edit" Glyph="UiIconGlyph.Edit" OnClick="@(() => EditAsync(item))" Disabled="@busy" />
                        <UiCommandButton Class="credential-command" Label="Delete" Glyph="UiIconGlyph.Delete" OnClick="@(() => RequestDeleteAsync(item))" Disabled="@busy" />
                    </div>
                </div>
            }
        </div>
    }
    @if (audit.Count > 0)
    {
        <details><summary>Recent credential activity</summary>
            <div class="credentials-list">
                @foreach (var entry in audit) { <div class="credentials-row"><span>@entry.Action · @entry.CredentialId</span><span class="meta-text">@entry.OccurredAtUtc.ToLocalTime().ToString("g")</span></div> }
            </div>
        </details>
    }
</section>
}

<UiModal IsOpen="@showEditor" Title="@(editor.Id.HasValue ? "Edit saved credential" : "Add saved credential")" Subtitle="Use a clear name such as NAS media or Ubuntu admin." Class="saved-credential-editor-modal" CloseOnBackdrop="false" OnClose="CloseAsync">
    <EditForm Model="@editor" OnValidSubmit="SaveAsync" class="stack-form">
        <DataAnnotationsValidator />
        @if (!string.IsNullOrWhiteSpace(editorError)) { <p class="callout error" role="alert">@editorError</p> }
        <UiComboboxField TValue="string" Label="Choose a saved server" Value="@selectedServer" ValueChanged="SelectServerAsync" Compact="true">
            <option value="">Enter a server manually</option>
            @foreach (var host in knownHosts) { <option value="@host.Id">@host.Name · @host.Hostname</option> }
        </UiComboboxField>
        <div class="credentials-editor-grid">
            <UiTextField Label="Name" @bind-Value="editor.Name" Compact="true" />
            <UiComboboxField TValue="ConnectionCredentialKind" Label="Type" Value="@editor.Kind" ValueChanged="ChangeKindAsync" Disabled="@(editor.Id.HasValue || busy)" Compact="true">
                @foreach (var kind in Enum.GetValues<ConnectionCredentialKind>().Where(kind => !SshOnly || kind != ConnectionCredentialKind.Smb)) { <option value="@kind">@KindLabel(kind)</option> }
            </UiComboboxField>
            <UiTextField Label="Server" @bind-Value="editor.Server" Helper="@(editor.Kind == ConnectionCredentialKind.SshKeyPair ? "Optional for a keypair you want to reuse on multiple servers." : "Hostname, mDNS name or IP address.")" Compact="true" />
            @if (editor.Kind != ConnectionCredentialKind.Smb) { <UiNumberField Label="Port" @bind-Value="editor.Port" Compact="true" /> }
            <UiTextField Label="Username" @bind-Value="editor.Username" Helper="@(editor.Kind == ConnectionCredentialKind.SshKeyPair ? "Optional: otherwise use the username from the connection form." : "The account on the remote server.")" Compact="true" />
            @if (editor.Kind == ConnectionCredentialKind.Smb) { <UiTextField Label="Domain / workgroup" @bind-Value="editor.Domain" Helper="Optional." Compact="true" /> }
        </div>
        @if (editor.Kind == ConnectionCredentialKind.SshKeyPair)
        {
            <UiTextAreaField Label="Private key" @bind-Value="editor.PrivateKey" Rows="4" Helper="@(editor.HasPrivateKey ? "Leave blank to keep the saved key. Paste a private key to replace it." : "Paste a private key, or generate a new Ed25519 keypair below.")" />
            <div class="toolbar-row"><UiCommandButton Class="credential-command" Label="@(generating ? "Generating..." : "Generate keypair")" Glyph="UiIconGlyph.Key" OnClick="GenerateAsync" Disabled="@busy" /></div>
            <UiTextField Label="Key passphrase" Type="password" @bind-Value="editor.Passphrase" Helper="@(editor.HasPassphrase ? "Leave blank to keep the saved passphrase." : "Only needed if the imported private key is encrypted.")" Compact="true" />
            @if (editor.HasPassphrase) { <UiCheckboxField Label="Remove saved passphrase" @bind-Value="editor.ClearPassphrase" Compact="true" /> }
            @if (!string.IsNullOrWhiteSpace(editor.PublicKey))
            {
                <UiTextAreaField Label="Public key" Value="@editor.PublicKey" ValueExpression="@(() => editor.PublicKey)" Rows="2" readonly Helper="Install this public key in the remote user's ~/.ssh/authorized_keys. The private key stays in LMS." />
                <UiCommandButton Class="credential-command" Label="Copy public key" Glyph="UiIconGlyph.Copy" OnClick="@(() => CopyKeyAsync(editor.PublicKey))" />
            }
        }
        else
        {
            <UiTextField Label="Password" Type="password" @bind-Value="editor.Password" Autocomplete="new-password" Helper="@(editor.HasPassword ? "Leave blank to keep the saved password." : "Password for the remote account.")" Compact="true" />
        }
        @if (!string.IsNullOrWhiteSpace(testMessage)) { <p class="callout @testTone" role="status">@testMessage</p> }
        @if (CanSetUpKey)
        {
            <p class="meta-text">Would you like to set up key authentication for future SSH connections? LMS will check the password login, install the public key and verify key-only login before saving it.</p>
            <UiCommandButton Class="credential-command" Label="Set up key authentication" Glyph="UiIconGlyph.Key" OnClick="@(() => showKeyConfirmation = true)" Disabled="@busy" />
        }
        <div class="toolbar-row">
            <UiCommandButton Class="credential-command" Label="@(testing ? "Testing..." : "Test credentials")" OnClick="TestEditorAsync" Disabled="@busy" />
            <UiCommandButton Class="credential-command" Label="@(busy && !generating && !testing && !settingUpKey ? "Saving..." : "Save credential")" Glyph="UiIconGlyph.Save" Type="submit" Disabled="@busy" />
            <UiCommandButton Class="credential-command" Label="Cancel" HideIcon="true" OnClick="CloseAsync" Disabled="@busy" />
        </div>
    </EditForm>
</UiModal>

<UiModal IsOpen="@showKeyConfirmation" Title="Set up key authentication?" CloseOnBackdrop="false" OnClose="CancelKeySetupAsync">
    <p>Connect to <strong>@editor.Username@@@editor.Server:@editor.Port</strong> using the password, install a new public key for that account, then verify a separate key-only login.</p>
    <p class="meta-text">A new key credential is saved only after verification. Existing password credentials and the server's login settings stay available. Choose the new key credential for future connections.</p>
    @if (settingUpKey) { <p role="status">Installing and verifying key authentication...</p> }
    <div class="toolbar-row"><UiCommandButton Class="credential-command" Label="Install, verify and save key" OnClick="SetUpKeyAsync" Disabled="@busy" /><UiCommandButton Class="credential-command" Label="Cancel" HideIcon="true" OnClick="CancelKeySetupAsync" Disabled="@busy" /></div>
</UiModal>

<UiModal IsOpen="@(pendingDelete is not null)" Title="Delete saved credential?" OnClose="CancelDeleteAsync">
    <p>Delete <strong>@pendingDelete?.Name</strong> from the credential store? Existing mounts and saved host connections keep their current connection settings.</p>
    <div class="toolbar-row"><UiCommandButton Class="credential-command" Label="Delete credential" OnClick="DeleteAsync" Disabled="@busy" /><UiCommandButton Class="credential-command" Label="Cancel" HideIcon="true" OnClick="CancelDeleteAsync" Disabled="@busy" /></div>
</UiModal>

@code {
    [Parameter] public bool EditorOnly { get; set; }
    [Parameter] public bool SshOnly { get; set; }
    [Parameter] public EventCallback<SavedConnectionCredentialSummary> Saved { get; set; }
    public Task OpenCreateAsync(string? name = null, string? server = null, int port = 22)
    {
        editor = new() { Name = name ?? "", Server = server ?? "", Port = port };
        selectedServer = ""; editorError = null; ResetTest(); showEditor = true;
        return InvokeAsync(StateHasChanged);
    }

    private IReadOnlyList<SavedConnectionCredentialSummary> entries = [];
    private IReadOnlyList<SavedCredentialAudit> audit = [];
    private SavedConnectionCredentialEditor editor = new();
    private SavedConnectionCredentialSummary? pendingDelete;
    private Guid? userId;
    private IReadOnlyList<LinuxMadeSane.Core.Models.ManagedHost> knownHosts = [];
    private string selectedServer = "";
    private bool loading = true, busy, generating, testing, settingUpKey, showEditor, showKeyConfirmation;
    private string? testedSignature, testMessage;
    private string testTone = "info";
    private string EditorSignature => System.Text.Json.JsonSerializer.Serialize(editor);
    private bool CanSetUpKey => editor.Kind == ConnectionCredentialKind.Ssh && ((editor.Id.HasValue && editor.HasPassword) || testedSignature == EditorSignature);
    private void ResetTest() { testedSignature = null; testMessage = null; showKeyConfirmation = false; }
    private string? message, editorError;
    private string tone = "success";
    protected override async Task OnInitializedAsync()
    {
        try
        {
            userId = await Access.GetAuthenticatedUserIdAsync();
            if (userId.HasValue) knownHosts = await Hosts.ListAsync();
            if (!EditorOnly) await RefreshAsync();
        }
        catch { message = "Unable to load saved credentials."; tone = "error"; }
        finally { loading = false; }
    }
    private async Task RefreshAsync() { if (userId.HasValue) { entries = await Credentials.ListAsync(userId.Value); audit = await Credentials.AuditAsync(userId.Value); } }
    private Task AddAsync() { editor = new(); selectedServer = ""; editorError = null; ResetTest(); showEditor = true; return Task.CompletedTask; }
    private Task CloseAsync() { if (!busy) { showEditor = false; editor = new(); editorError = null; ResetTest(); } return Task.CompletedTask; }
    private Task SelectServerAsync(string value)
    {
        selectedServer = value;
        if (Guid.TryParse(value, out var id) && knownHosts.FirstOrDefault(x => x.Id == id) is { } host)
        {
            editor.Server = host.Hostname;
            editor.Port = editor.Kind == ConnectionCredentialKind.Smb ? 445 : host.Port;
            if (string.IsNullOrWhiteSpace(editor.Username)) editor.Username = host.Username;
        }
        return Task.CompletedTask;
    }
    private Task ChangeKindAsync(ConnectionCredentialKind kind) { editor.Kind = kind; editor.Port = kind == ConnectionCredentialKind.Smb ? 445 : 22; editor.Password = ""; editor.PrivateKey = ""; editor.Passphrase = ""; editor.PublicKey = ""; return Task.CompletedTask; }
    private Task EditAsync(SavedConnectionCredentialSummary item)
    {
        editor = new() { Id=item.Id, Name=item.Name, Kind=item.Kind, Server=item.Server, Port=item.Port, Username=item.Username, Domain=item.Domain, PublicKey=item.PublicKey, HasPassword=item.HasPassword, HasPrivateKey=item.HasPrivateKey, HasPassphrase=item.HasPassphrase };
        selectedServer = ""; editorError = null; ResetTest(); showEditor = true; return Task.CompletedTask;
    }
    private async Task SaveAsync()
    {
        if (busy || userId is null) return;
        busy = true; editorError = null;
        try
        {
            var saved = await Credentials.SaveAsync(userId.Value, editor);
            if (!EditorOnly) await RefreshAsync();
            showEditor = false; editor = new();
            message = "Credential saved. It is available in connection and mount dialogs."; tone = "success";
            await Saved.InvokeAsync(saved);
        }
        catch (InvalidOperationException ex) { editorError = ex.Message; }
        catch { editorError = "Unable to save this credential."; }
        finally { busy = false; }
    }
    private async Task TestSavedAsync(SavedConnectionCredentialSummary item)
    {
        await EditAsync(item);
        await TestEditorAsync();
    }
    private async Task TestEditorAsync()
    {
        if (busy || userId is null) return;
        busy = true; testing = true; testedSignature = null; editorError = null;
        testMessage = "Connecting and testing credentials..."; testTone = "info";
        var signature = EditorSignature;
        using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(30));
        try
        {
            await Connections.TestAsync(userId.Value, editor, timeout.Token);
            if (signature == EditorSignature) testedSignature = signature;
            testMessage = "Connection and authentication succeeded."; testTone = "success";
        }
        catch (OperationCanceledException) { testMessage = "Connection test timed out. Check the server and port, then try again."; testTone = "error"; }
        catch (InvalidOperationException ex) { testMessage = ex.Message; testTone = "error"; }
        catch { testMessage = "Connection test failed. Check the server, credentials and network access."; testTone = "error"; }
        finally { testing = false; busy = false; }
    }
    private Task CancelKeySetupAsync() { if (!busy) showKeyConfirmation = false; return Task.CompletedTask; }
    private async Task SetUpKeyAsync()
    {
        if (busy || userId is null || !CanSetUpKey) { showKeyConfirmation = false; return; }
        busy = true; settingUpKey = true; editorError = null;
        using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(60));
        try
        {
            var saved = await Connections.SetUpKeyAsync(userId.Value, editor, timeout.Token);
            if (!EditorOnly) await RefreshAsync();
            showEditor = false; showKeyConfirmation = false; editor = new(); ResetTest();
            message = "Key authentication verified and saved. Choose the new key credential for future connections."; tone = "success";
            await Saved.InvokeAsync(saved);
        }
        catch
        {
            showKeyConfirmation = false;
            editorError = "Key setup could not complete. The password credential is unchanged. A public key may have been installed; test and retry before switching credentials.";
        }
        finally { settingUpKey = false; busy = false; }
    }
    private async Task GenerateAsync()
    {
        if (busy) return;
        busy = true; generating = true; editorError = null;
        using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(30));
        try { var key = await KeyGenerator.GenerateAsync(comment: editor.Name, cancellationToken: timeout.Token); editor.PrivateKey = key.PrivateKey; editor.PublicKey = key.PublicKey; editor.Passphrase = ""; editor.ClearPassphrase = true; }
        catch (OperationCanceledException) { editorError = "Key generation timed out. Try again."; }
        catch { editorError = "Unable to generate a keypair. Check that ssh-keygen is installed on the LMS host."; }
        finally { generating = false; busy = false; }
    }
    private async Task CopyKeyAsync(string key) { if (!string.IsNullOrWhiteSpace(key)) await JS.InvokeAsync<bool>("lmsClipboard.writeText", key); }
    private Task RequestDeleteAsync(SavedConnectionCredentialSummary item) { pendingDelete=item; return Task.CompletedTask; }
    private Task CancelDeleteAsync() { if (!busy) pendingDelete=null; return Task.CompletedTask; }
    private async Task DeleteAsync()
    {
        if (busy || pendingDelete is null || userId is null) return;
        busy=true;
        try { await Credentials.DeleteAsync(userId.Value, pendingDelete.Id); pendingDelete=null; await RefreshAsync(); message="Credential deleted."; tone="success"; }
        catch { message="Unable to delete this credential."; tone="error"; }
        finally { busy=false; }
    }
    private static string KindLabel(ConnectionCredentialKind kind) => kind switch { ConnectionCredentialKind.Ssh => "SSH password", ConnectionCredentialKind.Sftp => "SFTP password", ConnectionCredentialKind.Smb => "SMB / CIFS / Samba", _ => "SSH keypair" };
}
