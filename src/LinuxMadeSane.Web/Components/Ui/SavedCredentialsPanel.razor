@using LinuxMadeSane.Application.Interfaces
@using LinuxMadeSane.Core.Abstractions
@using Microsoft.AspNetCore.Components.Authorization
@inject ISavedConnectionCredentialService Credentials
@inject ISavedCredentialAccessContext Access
@inject IManagedHostStore Hosts
@inject ISshKeyPairGenerator KeyGenerator
@inject ISavedCredentialConnectionService Connections
@inject IJSRuntime JS

@if (!EditorOnly)
{
<section class="surface-card credentials-panel">
    <div class="credentials-heading">
        <div><h2>Saved credentials</h2><p class="meta-text">Save a server and its login once, then choose it in SSH, SFTP, SMB/CIFS and remote desktop connection dialogs.</p></div>
        <UiCommandButton Class="credential-command" Label="Add credential" Glyph="UiIconGlyph.Plus" OnClick="AddAsync" Disabled="@(userId is null || busy)" />
    </div>
    @if (userId is null) { <p class="callout info">This session does not have access to administer LMS credentials.</p> }
    @if (!string.IsNullOrWhiteSpace(message)) { <p class="callout @tone" role="status">@message</p> }
    @if (loading) { <p class="meta-text">Loading saved credentials...</p> }
    else if (entries.Count == 0) { <p class="meta-text">No saved credentials yet.</p> }
    else
    {
        <div class="credentials-list">
            @foreach (var item in entries)
            {
                <div class="credentials-row">
                    <div><strong>@item.Name</strong><span class="meta-text">@(item.IsPublicKeyOnly ? "SSH public key" : KindLabel(item.Kind)) · @(string.IsNullOrWhiteSpace(item.Server) ? "Any SSH/SFTP server" : item.Kind is ConnectionCredentialKind.Rdp or ConnectionCredentialKind.Vnc ? item.Server : $"{item.Server}:{item.Port}")@(string.IsNullOrWhiteSpace(item.Username) ? "" : $" · {item.Username}")</span></div>
                    <div class="toolbar-row">
                        @if (!string.IsNullOrWhiteSpace(item.PublicKey)) { <UiCommandButton Class="credential-command" Label="Copy public key" Glyph="UiIconGlyph.Copy" OnClick="@(() => CopyKeyAsync(item.PublicKey))" Disabled="@busy" /> }
                        @if (!item.IsPublicKeyOnly && item.Kind is not (ConnectionCredentialKind.Rdp or ConnectionCredentialKind.Vnc or ConnectionCredentialKind.Smtp or ConnectionCredentialKind.LmsSmtp)) { <UiCommandButton Class="credential-command" Label="Test credentials" OnClick="@(() => TestSavedAsync(item))" Disabled="@busy" /> }
                        <UiCommandButton Class="credential-command" Label="Edit" Glyph="UiIconGlyph.Edit" OnClick="@(() => EditAsync(item))" Disabled="@busy" />
                        <UiCommandButton Class="credential-command" Label="Duplicate" Glyph="UiIconGlyph.Copy" OnClick="@(() => OpenDuplicate(item))" Disabled="@busy" />
                        <UiCommandButton Class="credential-command" Label="Delete" Glyph="UiIconGlyph.Delete" OnClick="@(() => RequestDeleteAsync(item))" Disabled="@busy" />
                    </div>
                </div>
            }
        </div>
    }
    <div class="surface-subcard stack-tight">
        <strong>How your credentials are protected</strong>
        <p class="meta-text">Passwords, private keys and key passphrases are stored encrypted on this LMS host. Only authorised LMS sessions can access the credential store. Credential access and changes are recorded for auditing.</p>
    </div>
</section>
}

<UiModal IsOpen="@showEditor" Title="@(editor.CopyFromId.HasValue ? "Duplicate credential" : editor.Id.HasValue ? "Edit saved credential" : "Add saved credential")" Class="saved-credential-editor-modal" CloseOnBackdrop="false" OnClose="CloseAsync">
    <EditForm Model="@editor" OnValidSubmit="SaveAsync">
      <div class="credential-form">
        <DataAnnotationsValidator />
        @if (!string.IsNullOrWhiteSpace(editorError)) { <p class="callout error" role="alert">@editorError</p> }
        <div class="credentials-editor-grid">
            <UiTextField Label="Name" aria-label="Name" @bind-Value="editor.Name" Compact="true" />
            <UiComboboxField TValue="ConnectionCredentialKind" Label="@KindFieldLabel" aria-label="@KindFieldLabel" Helper="@ModeChangeHint" Value="@editor.Kind" ValueChanged="ChangeKindAsync" Disabled="@(FixedKind.HasValue || OriginalKind is { } original && !original.IsSshAuthenticationMode() || busy)" Compact="true">
                @foreach (var kind in AvailableKinds)
                {
                    <option value="@kind">@(OriginalKind?.IsSshAuthenticationMode() == true ? SshModeLabel(kind) : KindLabel(kind))</option>
                }
            </UiComboboxField>
        </div>
        @if (knownHosts.Count > 0)
        {
            <UiComboboxField TValue="string" Label="Choose a saved server" Value="@selectedServer" ValueChanged="SelectServerAsync" Compact="true">
                <option value="">Enter a server manually</option>
                @foreach (var host in knownHosts) { <option value="@host.Id">@host.Name · @host.Hostname</option> }
            </UiComboboxField>
        }
        <div class="credential-endpoint-grid">
            <div class="credential-server-row">
                <UiTextField Label="Server" aria-label="Server" @bind-Value="editor.Server" Helper="@(editor.Kind == ConnectionCredentialKind.SshKeyPair ? "Optional for a reusable keypair." : null)" Compact="true" />
                @if (editor.UsesConnectionPort && editor.Kind != ConnectionCredentialKind.Smb) { <UiNumberField Label="Port" aria-label="Port" @bind-Value="editor.Port" Compact="true" /> }
            </div>
            @if (editor.Kind != ConnectionCredentialKind.Vnc) { <UiTextField Label="Username" aria-label="Username" @bind-Value="editor.Username" Helper="@(editor.Kind == ConnectionCredentialKind.SshKeyPair ? "Optional for a reusable keypair." : null)" Compact="true" /> }
            @if (editor.Kind is ConnectionCredentialKind.Smb or ConnectionCredentialKind.Rdp) { <UiTextField Label="Domain / workgroup" @bind-Value="editor.Domain" Helper="Optional." Compact="true" /> }
        </div>
        @if (editor.Kind == ConnectionCredentialKind.Sftp)
        {
            <UiComboboxField TValue="bool" Label="Authentication" Value="@sftpUseKey" ValueChanged="SetSftpKeyAuthenticationAsync" Disabled="@busy" Compact="true">
                <option value="false">Password</option><option value="true">Public key</option>
            </UiComboboxField>
        }
        @if (ShowKeyFields || editor.Kind == ConnectionCredentialKind.Ssh && !editor.StoredCredentialId.HasValue && !FixedKind.HasValue)
        {
            <SshPrivateKeyInput Value="@editor.PrivateKey" ValueChanged="PrivateKeyChanged" Imported="PrivateKeyImported" Disabled="@busy" ImportingChanged="@(value => busy = value)"
                                Helper="@(editor.HasPrivateKey ? "Leave blank to keep the saved key. Paste a private key to replace it." : "Paste a private key, or drop a key file above.")" />
            @if (!string.IsNullOrEmpty(editor.PublicKey))
            {
                <div class="credential-public-key">
                    <UiField Label="Public key" Compact="true">
                        <textarea aria-label="Public key" class="ui-control-input ui-control-textarea" rows="2" readonly value="@editor.PublicKey"></textarea>
                    </UiField>
                    <UiCommandButton Class="credential-command" Label="Copy public key" Glyph="UiIconGlyph.Copy" OnClick="@(() => CopyKeyAsync(editor.PublicKey))" />
                </div>
            }
            else if (!string.IsNullOrEmpty(keyPreviewMessage))
            {
                <p class="callout info" role="status">@keyPreviewMessage</p>
            }
        }
        @if (sftpUseKey && editor.Kind == ConnectionCredentialKind.Sftp)
        {
            <UiComboboxField TValue="string" Label="Saved keypair" Value="@selectedSftpKey" ValueChanged="UseSftpSavedKeyAsync" Disabled="@busy" Compact="true">
                <option value="">Import or generate a keypair</option>
                @foreach (var key in MatchingKeys) { <option value="@key.Id">@key.Name</option> }
            </UiComboboxField>
        }
        <div class="credentials-editor-grid">
            @if (!ShowKeyFields || editor.Kind == ConnectionCredentialKind.SshKeyAndPassword)
            {
                <UiTextField Label="@(editor.Kind == ConnectionCredentialKind.SshKeyAndPassword ? "Account password" : "Password")" aria-label="Account password" Type="password" @bind-Value="editor.Password" Autocomplete="new-password" Helper="@(editor.HasPassword ? "Leave blank to keep the saved password." : "Password for the remote account.")" Compact="true" />
            }
            @if (ShowKeyFields)
            {
                <UiField Label="Key passphrase" Helper="@(editor.HasPassphrase ? "Leave blank to keep the saved passphrase." : "Only needed for an encrypted key.")" Compact="true">
                    <input aria-label="Key passphrase" class="ui-control-input" type="password" autocomplete="new-password" disabled="@busy"
                           @bind="editor.Passphrase" @bind:event="oninput" @bind:after="PassphraseChanged" />
                </UiField>
                @if (editor.HasPassphrase) { <UiCheckboxField Label="Remove saved passphrase" @bind-Value="editor.ClearPassphrase" Compact="true" /> }
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(testMessage)) { <p class="callout @testTone" role="status">@testMessage</p> }
        @if (CanSetUpKey)
        {
            <div class="credential-key-offer">
                <p class="meta-text">@(SuggestedKey is { } key ? $"Saved key available: {key.Name}. Test and use it for this account." : SuggestedHostKey is { } hostKey ? $"LMS already holds a key for {hostKey.Username} on {hostKey.Name}. Test it for this server before generating another key." : "Use key authentication for future SSH connections?")</p>
                <div class="toolbar-row">
                    @if (SuggestedKey is { } suggested) { <UiCommandButton Class="credential-command" Label="Use saved key" Glyph="UiIconGlyph.Key" OnClick="@(() => UseSavedKeyAsync(suggested.Id))" Disabled="@busy" /> }
                    else if (SuggestedHostKey is { } suggestedHost) { <UiCommandButton Class="credential-command" Label="Use existing LMS key" Glyph="UiIconGlyph.Key" OnClick="@(() => UseHostKeyAsync(suggestedHost.Id))" Disabled="@busy" /> }
                    <UiCommandButton Class="credential-command" Label="@(SuggestedKey is null && SuggestedHostKey is null ? "Set up key" : "Key options")" Glyph="UiIconGlyph.Key" OnClick="OpenKeyOptions" Disabled="@busy" />
                </div>
            </div>
        }
        <div class="toolbar-row credential-actions">
            @if (ShowKeyFields) { <UiCommandButton Class="credential-command" Label="@(generating ? "Generating..." : "Generate keypair")" Glyph="UiIconGlyph.Key" OnClick="GenerateAsync" Disabled="@busy" /> }
            @if (editor.Kind is not (ConnectionCredentialKind.Rdp or ConnectionCredentialKind.Vnc or ConnectionCredentialKind.Smtp or ConnectionCredentialKind.LmsSmtp)) { <UiCommandButton Class="credential-command" Label="@(testing ? "Testing..." : "Test credentials")" OnClick="TestEditorAsync" Disabled="@(busy || editor.Kind == ConnectionCredentialKind.SshKeyPair && !editor.HasPrivateKey && string.IsNullOrWhiteSpace(editor.PrivateKey))" /> }
            <UiCommandButton Class="credential-command" Label="@(busy && !generating && !testing && !settingUpKey ? "Saving..." : "Save credential")" Glyph="UiIconGlyph.Save" Type="submit" Disabled="@busy" />
            <UiCommandButton Class="credential-command" Label="Cancel" HideIcon="true" OnClick="CloseAsync" Disabled="@busy" />
            @if (EditorOnly && editor.Id.HasValue && SourceEntry is { } entry)
            {
                <UiCommandButton Class="credential-command" Label="Duplicate" Glyph="UiIconGlyph.Copy" Title="Duplicate the saved entry" OnClick="@(() => OpenDuplicate(entry))" Disabled="@busy" />
            }
            @if (editor.Kind.IsSshLogin()) { <SshHelpLink Section="passwords" Label="SSH help" /> }
        </div>
      </div>
    </EditForm>
</UiModal>

<UiModal IsOpen="@showKeyConfirmation" Title="Key authentication" Class="saved-credential-editor-modal" CloseOnBackdrop="false" OnClose="CancelKeySetupAsync">
    <p>Use a key for <strong>@editor.Username@@@editor.Server:@editor.Port</strong>.</p>
    <UiComboboxField TValue="string" Label="Key to use" @bind-Value="selectedKeyChoice" Compact="true" Disabled="@busy">
        @foreach (var key in MatchingKeys) { <option value="@key.Id">@key.Name · saved key</option> }
        @foreach (var host in HostKeys) { <option value="@($"host:{host.Id}")">@host.Name · @host.Username · existing LMS host key</option> }
        <option value="new">Generate a new Ed25519 key</option>
    </UiComboboxField>
    <p class="meta-text">LMS tests an existing key first. If it is not accepted, password login can install its public key; LMS then verifies key-only login. Your password credential stays available.</p>
    @if (settingUpKey) { <p role="status">Installing and verifying key authentication...</p> }
    <div class="toolbar-row"><UiCommandButton Class="credential-command" Label="@(selectedKeyChoice == "new" ? "Generate and install" : "Install saved key")" Glyph="UiIconGlyph.Key" OnClick="SetUpKeyAsync" Disabled="@busy" /><UiCommandButton Class="credential-command" Label="Cancel" HideIcon="true" OnClick="CancelKeySetupAsync" Disabled="@busy" /></div>
</UiModal>

<UiModal IsOpen="@(pendingDelete is not null)" Title="Delete saved credential?" OnClose="CancelDeleteAsync">
    <p>Delete <strong>@pendingDelete?.Name</strong> from the credential store? Existing mounts and saved host connections keep their current connection settings.</p>
    <div class="toolbar-row"><UiCommandButton Class="credential-command" Label="Delete credential" OnClick="DeleteAsync" Disabled="@busy" /><UiCommandButton Class="credential-command" Label="Cancel" HideIcon="true" OnClick="CancelDeleteAsync" Disabled="@busy" /></div>
</UiModal>

@code {
    private string? keyPreviewMessage;
    private void UpdateKeyPreview()
    {
        keyPreviewMessage = null;
        editor.PublicKey = "";
        if (string.IsNullOrWhiteSpace(editor.PrivateKey))
        {
            if (!editor.ClearPrivateKey) editor.PublicKey = SourceEntry?.PublicKey ?? "";
            return;
        }
        try { editor.PublicKey = LinuxMadeSane.Infrastructure.Services.SshPrivateKeyReader.PreviewPublicKey(editor.PrivateKey, editor.Passphrase); }
        catch (InvalidOperationException ex) { keyPreviewMessage = ex.Message; }
    }

    private void PrivateKeyChanged(string value)
    {
        if (editor.Kind == ConnectionCredentialKind.Ssh && !editor.StoredCredentialId.HasValue && !FixedKind.HasValue && !string.IsNullOrWhiteSpace(value))
        {
            editor.Kind = editor.Password.Length > 0
                ? ConnectionCredentialKind.SshKeyAndPassword : ConnectionCredentialKind.SshKeyPair;
        }
        editor.PrivateKey = value;
        editor.ClearPrivateKey = false;
        editor.ClearPassphrase = string.IsNullOrEmpty(editor.Passphrase);
        UpdateKeyPreview();
        selectedSftpKey = "";
        editorError = null;
        ResetTest();
    }

    private void PrivateKeyImported(string filename)
    {
        if (string.IsNullOrWhiteSpace(editor.Name))
        {
            var name = System.IO.Path.GetFileNameWithoutExtension(filename);
            editor.Name = name.Length > 80 ? name[..80] : name;
        }
    }

    private void PassphraseChanged()
    {
        if (!string.IsNullOrEmpty(editor.Passphrase)) editor.ClearPassphrase = false;
        if (!string.IsNullOrWhiteSpace(editor.PrivateKey)) UpdateKeyPreview();
        ResetTest();
    }

    [Parameter] public bool EditorOnly { get; set; }
    [Parameter] public ConnectionCredentialKind? FixedKind { get; set; }
    private SavedConnectionCredentialSummary? SourceEntry => entries.FirstOrDefault(item => item.Id == editor.StoredCredentialId);
    private ConnectionCredentialKind? OriginalKind => SourceEntry?.Kind;
    private string KindFieldLabel => OriginalKind?.IsSshAuthenticationMode() == true ? "Authentication" : "Type";
    private string? ModeChangeHint => editor.Id.HasValue && editor.Kind != OriginalKind
        ? editor.Kind switch
        {
            ConnectionCredentialKind.Ssh when editor.HasPrivateKey => "Saving removes the stored private key and its passphrase from this entry.",
            ConnectionCredentialKind.SshKeyPair when editor.HasPassword => "Saving removes the stored account password from this entry.",
            _ => null
        }
        : null;
    private IEnumerable<ConnectionCredentialKind> AvailableKinds => Enum.GetValues<ConnectionCredentialKind>()
        .Where(kind => (!FixedKind.HasValue || kind == FixedKind.Value) && (!SshOnly || kind.IsSshLogin()))
        .Where(kind => OriginalKind is not { } original || original.CanChangeTo(kind))
        .OrderBy(kind => kind == ConnectionCredentialKind.SshKeyAndPassword ? ConnectionCredentialKind.Ssh : kind);
    private bool ShowKeyFields => editor.Kind == ConnectionCredentialKind.Sftp ? sftpUseKey : editor.UsesPrivateKey;
    private bool sftpUseKey;
    private string selectedSftpKey = "";
    private Task SetSftpKeyAuthenticationAsync(bool useKey)
    {
        keyPreviewMessage = null;
        sftpUseKey = useKey; selectedSftpKey = "";
        editor.ClearPassword = useKey; editor.ClearPrivateKey = !useKey; editor.ClearPassphrase = !useKey;
        editor.Password = ""; editor.PrivateKey = ""; editor.Passphrase = "";
        editor.PublicKey = useKey ? SourceEntry?.PublicKey ?? "" : "";
        ResetTest();
        return Task.CompletedTask;
    }
    private async Task UseSftpSavedKeyAsync(string value)
    {
        if (busy || userId is null || !Guid.TryParse(value, out var id)) return;
        busy = true; editorError = null; ResetTest();
        try
        {
            var key = await Credentials.ResolveAsync(userId.Value, id) ?? throw new InvalidOperationException("Saved key not found.");
            if (!SavedCredentialKeySuggestions.Matches(key.Summary, editor)) throw new InvalidOperationException("Choose a key for this server and account, or a reusable keypair.");
            keyPreviewMessage = null; editor.PrivateKey = key.PrivateKey; editor.Passphrase = key.Passphrase; editor.PublicKey = key.Summary.PublicKey;
            editor.ClearPassphrase = key.Passphrase.Length == 0; selectedSftpKey = value;
        }
        catch { editorError = "Unable to use this saved keypair. Check its server and account scope."; }
        finally { busy = false; }
    }
    [Parameter] public bool SshOnly { get; set; }
    [Parameter] public EventCallback<SavedConnectionCredentialSummary> Saved { get; set; }
    public Task OpenCreateAsync(string? name = null, string? server = null, int port = 22, ConnectionCredentialKind kind = ConnectionCredentialKind.Ssh,
        string? username = null, string? password = null, string? domain = null)
    {
        keyPreviewMessage = null; sftpUseKey = false; selectedSftpKey = "";
        editor = new() { Username = username ?? "", Password = password ?? "", Domain = domain ?? "", Name = name ?? "", Server = server ?? "", Port = kind is ConnectionCredentialKind.Rdp or ConnectionCredentialKind.Vnc ? 0 : port, Kind = kind };
        selectedServer = ""; editorError = null; ResetTest(); showEditor = true;
        return InvokeAsync(StateHasChanged);
    }

    public async Task OpenEditAsync(Guid id)
    {
        if (busy || userId is null) return;
        var item = (await Credentials.ListAsync(userId.Value)).FirstOrDefault(entry => entry.Id == id)
            ?? throw new InvalidOperationException("This saved credential is no longer available.");
        await EditAsync(item);
        await InvokeAsync(StateHasChanged);
    }

    private IReadOnlyList<SavedConnectionCredentialSummary> entries = [];
    private SavedConnectionCredentialEditor editor = new();
    private SavedConnectionCredentialSummary? pendingDelete;
    private Guid? userId;
    private IReadOnlyList<LinuxMadeSane.Core.Models.ManagedHost> knownHosts = [];
    private string selectedServer = "", selectedKeyChoice = "new";
    private IEnumerable<SavedConnectionCredentialSummary> MatchingKeys => entries.Where(key => SavedCredentialKeySuggestions.Matches(key, editor)).OrderByDescending(key => !string.IsNullOrWhiteSpace(key.Server)).ThenByDescending(key => !string.IsNullOrWhiteSpace(key.Username)).ThenBy(key => key.Name);
    private SavedConnectionCredentialSummary? SuggestedKey => MatchingKeys.FirstOrDefault();
    private IEnumerable<LinuxMadeSane.Core.Models.ManagedHost> HostKeys => knownHosts.Where(host => !string.IsNullOrWhiteSpace(host.PrivateKeySecretReference))
        .OrderByDescending(host => host.Hostname.TrimEnd('.').Equals(editor.Server.Trim().TrimEnd('.'), StringComparison.OrdinalIgnoreCase) && host.Port == editor.Port)
        .ThenByDescending(host => host.Username.Equals(editor.Username.Trim(), StringComparison.Ordinal)).ThenBy(host => host.Name);
    private LinuxMadeSane.Core.Models.ManagedHost? SuggestedHostKey => HostKeys.FirstOrDefault(host => host.Username.Equals(editor.Username.Trim(), StringComparison.Ordinal));
    private bool loading = true, busy, generating, testing, settingUpKey, showEditor, showKeyConfirmation;
    private string? testedSignature, testMessage;
    private string testTone = "info";
    private string EditorSignature => System.Text.Json.JsonSerializer.Serialize(editor);
    private bool CanSetUpKey => !editor.CopyFromId.HasValue && editor.Kind == ConnectionCredentialKind.Ssh && ((editor.Id.HasValue && editor.HasPassword) || testedSignature == EditorSignature);
    private void ResetTest() { testedSignature = null; testMessage = null; showKeyConfirmation = false; }
    private string? message, editorError;
    private string tone = "success";
    protected override async Task OnInitializedAsync()
    {
        try
        {
            userId = await Access.GetAuthenticatedUserIdAsync();
            if (userId.HasValue) knownHosts = await Hosts.ListAsync();
            if (!EditorOnly) await RefreshAsync();
            else if (userId.HasValue) entries = await Credentials.ListAsync(userId.Value);
        }
        catch { message = "Unable to load saved credentials."; tone = "error"; }
        finally { loading = false; }
    }
    private async Task RefreshAsync() { if (userId.HasValue) { entries = await Credentials.ListAsync(userId.Value); } }
    private Task AddAsync() { keyPreviewMessage = null; sftpUseKey = false; selectedSftpKey = ""; editor = new() { Kind = FixedKind ?? ConnectionCredentialKind.Ssh }; selectedServer = ""; editorError = null; ResetTest(); showEditor = true; return Task.CompletedTask; }
    private Task CloseAsync() { if (!busy) { showEditor = false; editor = new(); editorError = null; ResetTest(); } return Task.CompletedTask; }
    private Task SelectServerAsync(string value)
    {
        selectedServer = value;
        if (Guid.TryParse(value, out var id) && knownHosts.FirstOrDefault(x => x.Id == id) is { } host)
        {
            editor.Server = host.Hostname;
            editor.Port = editor.Kind switch { ConnectionCredentialKind.Smtp or ConnectionCredentialKind.LmsSmtp => 587, ConnectionCredentialKind.Smb => 445, ConnectionCredentialKind.Rdp or ConnectionCredentialKind.Vnc => 0, _ => host.Port };
            if (string.IsNullOrWhiteSpace(editor.Username)) editor.Username = host.Username;
        }
        return Task.CompletedTask;
    }
    private Task ChangeKindAsync(ConnectionCredentialKind kind)
    {
        var previous = editor.Kind;
        if (previous == kind || OriginalKind is { } original && !original.CanChangeTo(kind)) return Task.CompletedTask;
        var switchingSsh = previous.IsSshAuthenticationMode() && kind.IsSshAuthenticationMode();
        if (!switchingSsh || kind == ConnectionCredentialKind.SshKeyPair)
            editor.Password = "";
        if (!switchingSsh || kind == ConnectionCredentialKind.Ssh)
        {
            editor.PrivateKey = ""; editor.Passphrase = ""; editor.PublicKey = "";
            keyPreviewMessage = null;
        }
        if (!switchingSsh)
            editor.Port = kind switch { ConnectionCredentialKind.Smtp or ConnectionCredentialKind.LmsSmtp => 587, ConnectionCredentialKind.Smb => 445, ConnectionCredentialKind.Rdp or ConnectionCredentialKind.Vnc => 0, _ => 22 };
        sftpUseKey = false; selectedSftpKey = "";
        editor.ClearPassword = false;
        editor.ClearPrivateKey = false;
        if (!switchingSsh || previous == ConnectionCredentialKind.Ssh || kind == ConnectionCredentialKind.Ssh)
            editor.ClearPassphrase = false;
        editor.Kind = kind;
        if (switchingSsh && ShowKeyFields) UpdateKeyPreview();
        editorError = null;
        ResetTest();
        return Task.CompletedTask;
    }
    private async Task EditAsync(SavedConnectionCredentialSummary item)
    {
        if (userId.HasValue) { entries = await Credentials.ListAsync(userId.Value); knownHosts = await Hosts.ListAsync(); }
        OpenStoredEntry(item, duplicate: false);
    }
    private void OpenDuplicate(SavedConnectionCredentialSummary item) => OpenStoredEntry(item, duplicate: true);

    private void OpenStoredEntry(SavedConnectionCredentialSummary item, bool duplicate)
    {
        keyPreviewMessage = null;
        var name = duplicate ? $"Copy of {item.Name}" : item.Name;
        editor = new()
        {
            Id = duplicate ? null : item.Id, CopyFromId = duplicate ? item.Id : null,
            Name = name.Length > 80 ? name[..80] : name, Kind = item.Kind, Server = item.Server,
            Port = item.Port, Username = item.Username, Domain = item.Domain, PublicKey = item.PublicKey,
            HasPassword = item.HasPassword, HasPrivateKey = item.HasPrivateKey, HasPassphrase = item.HasPassphrase
        };
        sftpUseKey = item.Kind == ConnectionCredentialKind.Sftp && item.HasPrivateKey; selectedSftpKey = "";
        selectedServer = ""; editorError = null; ResetTest(); showEditor = true;
    }
    private async Task SaveAsync()
    {
        if (busy || userId is null) return;
        busy = true; editorError = null;
        try
        {
            var duplicate = editor.CopyFromId.HasValue;
            var saved = await Credentials.SaveAsync(userId.Value, editor);
            showEditor = false; editor = new();
            message = duplicate ? $"Duplicate saved as {saved.Name}." : "Credential saved.";
            tone = "success";
            try
            {
                if (!EditorOnly) await RefreshAsync();
                await Saved.InvokeAsync(saved);
            }
            catch
            {
                message = $"Saved {saved.Name}. Reopen the credential list to refresh it.";
                tone = "info";
            }
        }
        catch (InvalidOperationException ex) { editorError = ex.Message; }
        catch { editorError = "Unable to save this credential."; }
        finally { busy = false; }
    }
    private async Task TestSavedAsync(SavedConnectionCredentialSummary item)
    {
        await EditAsync(item);
        await TestEditorAsync();
    }
    private async Task TestEditorAsync()
    {
        if (busy || userId is null) return;
        busy = true; testing = true; testedSignature = null; editorError = null;
        testMessage = "Connecting and testing credentials..."; testTone = "info";
        var signature = EditorSignature;
        using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(30));
        try
        {
            await Connections.TestAsync(userId.Value, editor, timeout.Token);
            if (signature == EditorSignature) testedSignature = signature;
            testMessage = "Connection and authentication succeeded."; testTone = "success";
        }
        catch (OperationCanceledException) { testMessage = "Connection test timed out. Check the server and port, then try again."; testTone = "error"; }
        catch (InvalidOperationException ex) { testMessage = ex.Message; testTone = "error"; }
        catch { testMessage = "Connection test failed. Check the server, credentials and network access."; testTone = "error"; }
        finally { testing = false; busy = false; }
    }
    private void OpenKeyOptions()
    {
        selectedKeyChoice = SuggestedKey?.Id.ToString() ?? (SuggestedHostKey is { } host ? $"host:{host.Id}" : "new");
        showKeyConfirmation = true;
    }
    private async Task UseSavedKeyAsync(Guid keyId)
    {
        if (busy || userId is null || !CanSetUpKey) return;
        busy = true; settingUpKey = true; editorError = null;
        testMessage = "Testing saved key authentication..."; testTone = "info";
        using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(30));
        try
        {
            var saved = await Connections.UseExistingKeyAsync(userId.Value, editor, keyId, timeout.Token);
            if (!EditorOnly) await RefreshAsync();
            showEditor = false; editor = new(); ResetTest();
            message = "Saved key authentication verified. Choose this key credential for future connections."; tone = "success";
            await Saved.InvokeAsync(saved);
        }
        catch
        {
            testMessage = "This key could not connect. Check the server and account. If the key is not installed, use Key options to install it with the password login.";
            testTone = "error";
        }
        finally { settingUpKey = false; busy = false; }
    }
    private async Task UseHostKeyAsync(Guid hostId)
    {
        if (busy || userId is null || !CanSetUpKey) return;
        busy = true; settingUpKey = true; editorError = null;
        testMessage = "Testing the existing LMS key without changing the server..."; testTone = "info";
        using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(30));
        try
        {
            var saved = await Connections.UseManagedHostKeyAsync(userId.Value, editor, hostId, false, timeout.Token);
            if (!EditorOnly) await RefreshAsync();
            showEditor = false; editor = new(); ResetTest();
            message = "Existing LMS key verified and saved for this server and account."; tone = "success";
            await Saved.InvokeAsync(saved);
        }
        catch (OperationCanceledException) { testMessage = "Key test timed out. Check the server and port."; testTone = "error"; }
        catch (Renci.SshNet.Common.SshAuthenticationException) { testMessage = "The server did not accept this key. Use Key options to install this existing key with password login, or choose another key."; testTone = "error"; }
        catch (InvalidOperationException ex) { testMessage = ex.Message; testTone = "error"; }
        catch { testMessage = "Could not connect with the existing key. Check the server and network access."; testTone = "error"; }
        finally { settingUpKey = false; busy = false; }
    }
    private Task CancelKeySetupAsync() { if (!busy) showKeyConfirmation = false; return Task.CompletedTask; }
    private async Task SetUpKeyAsync()
    {
        if (busy || userId is null || !CanSetUpKey) { showKeyConfirmation = false; return; }
        busy = true; settingUpKey = true; editorError = null;
        using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(60));
        try
        {
            testMessage = null;
            var saved = Guid.TryParse(selectedKeyChoice, out var keyId)
                ? await Connections.InstallExistingKeyAsync(userId.Value, editor, keyId, timeout.Token)
                : selectedKeyChoice.StartsWith("host:", StringComparison.Ordinal) && Guid.TryParse(selectedKeyChoice[5..], out var hostId)
                    ? await Connections.UseManagedHostKeyAsync(userId.Value, editor, hostId, true, timeout.Token)
                    : await Connections.SetUpKeyAsync(userId.Value, editor, timeout.Token);
            if (!EditorOnly) await RefreshAsync();
            showEditor = false; showKeyConfirmation = false; editor = new(); ResetTest();
            message = "Key authentication verified and saved. Choose the new key credential for future connections."; tone = "success";
            await Saved.InvokeAsync(saved);
        }
        catch (Exception ex)
        {
            showKeyConfirmation = false;
            editorError = ex switch
            {
                SavedCredentialKeySetupException => ex.Message,
                OperationCanceledException => "Key setup timed out. Your password credential is unchanged.",
                Renci.SshNet.Common.SshAuthenticationException => "The server rejected key authentication. Check the account's SSH login policy and authorized keys. Your password credential is unchanged.",
                InvalidOperationException => ex.Message,
                _ => $"Key setup failed ({ex.GetType().Name}). Your password credential is unchanged."
            };
            try { entries = await Credentials.ListAsync(userId.Value); } catch { /* Keep the failure visible even if reloading is unavailable. */ }
        }
        finally { settingUpKey = false; busy = false; }
    }
    private async Task GenerateAsync()
    {
        if (busy) return;
        busy = true; generating = true; editorError = null;
        using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(30));
        try { var key = await KeyGenerator.GenerateAsync(comment: editor.Name, cancellationToken: timeout.Token); keyPreviewMessage = null; editor.PrivateKey = key.PrivateKey; editor.PublicKey = key.PublicKey; editor.Passphrase = ""; editor.ClearPassphrase = true; }
        catch (OperationCanceledException) { editorError = "Key generation timed out. Try again."; }
        catch { editorError = "Unable to generate a keypair. Check that ssh-keygen is installed on the LMS host."; }
        finally { generating = false; busy = false; }
    }
    private async Task CopyKeyAsync(string key) { if (!string.IsNullOrWhiteSpace(key)) await JS.InvokeAsync<bool>("lmsClipboard.writeText", key); }
    private Task RequestDeleteAsync(SavedConnectionCredentialSummary item) { pendingDelete=item; return Task.CompletedTask; }
    private Task CancelDeleteAsync() { if (!busy) pendingDelete=null; return Task.CompletedTask; }
    private async Task DeleteAsync()
    {
        if (busy || pendingDelete is null || userId is null) return;
        busy=true;
        try { await Credentials.DeleteAsync(userId.Value, pendingDelete.Id); pendingDelete=null; await RefreshAsync(); message="Credential deleted."; tone="success"; }
        catch { message="Unable to delete this credential."; tone="error"; }
        finally { busy=false; }
    }
    private static string SshModeLabel(ConnectionCredentialKind kind) => kind switch
    {
        ConnectionCredentialKind.Ssh => "Password",
        ConnectionCredentialKind.SshKeyPair => "Public key",
        ConnectionCredentialKind.SshKeyAndPassword => "Password + public key",
        _ => KindLabel(kind)
    };
    private static string KindLabel(ConnectionCredentialKind kind) => kind switch
    {
        ConnectionCredentialKind.Ssh => "SSH password",
        ConnectionCredentialKind.SshKeyAndPassword => "SSH key + password",
        ConnectionCredentialKind.SshKeyPair => "SSH keypair",
        ConnectionCredentialKind.Sftp => "SFTP login",
        ConnectionCredentialKind.Smb => "SMB / CIFS / Samba",
        ConnectionCredentialKind.Rdp => "RDP target login",
        ConnectionCredentialKind.Vnc => "VNC target password",
        ConnectionCredentialKind.Smtp => "SMTP mail server",
        ConnectionCredentialKind.LmsSmtp => "LMS SMTP user",
        _ => kind.ToString()
    };
}
