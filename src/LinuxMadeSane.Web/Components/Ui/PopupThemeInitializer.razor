@using System.Security.Claims
@using LinuxMadeSane.Application.Interfaces
@using LinuxMadeSane.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject IUserDisplayPreferenceService UserDisplayPreferenceService
@inject ConnectionProfileUserResolver ConnectionProfileUserResolver
@inject IJSRuntime JSRuntime

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private Guid? currentUserId;

    protected override async Task OnInitializedAsync()
    {
        var principal = AuthenticationStateTask is null
            ? null
            : (await AuthenticationStateTask).User;
        currentUserId = Guid.TryParse(principal?.FindFirstValue(ClaimTypes.NameIdentifier), out var userId)
            ? userId
            : (await ConnectionProfileUserResolver.ResolveAsync(principal))?.Id;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || currentUserId is not { } userId)
        {
            return;
        }

        var preference = await UserDisplayPreferenceService.GetAsync(userId);
        if (preference is not null)
        {
            await JSRuntime.InvokeVoidAsync("lmsTheme.applyUserPreferences", new
            {
                paletteId = preference.ThemePaletteId,
                mode = preference.ThemeMode,
                fontScalePercent = preference.FontScalePercent
            });
        }
    }
}
