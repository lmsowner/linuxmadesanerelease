@using LinuxMadeSane.Core.Models.Cloudflare

<div class="edge-http-service-stamp-shell @(IsBlocked ? "is-blocked" : null)">
    <button class="edge-http-service-stamp @(IsBlocked ? "is-blocked" : null) @(HasPoorTitle ? "is-poor-title" : null)"
            type="button"
            role="listitem"
            title="@DetailsTitle"
            disabled="@IsBlocked"
            @onclick="HandleUseAsync">
        <span class="edge-http-service-stamp-icon" aria-hidden="true">
            @if (!string.IsNullOrWhiteSpace(Service.FaviconDataUrl))
            {
                <img src="@Service.FaviconDataUrl" alt="" loading="lazy" />
            }
            else
            {
                <span class="edge-http-service-stamp-icon-fallback">@FallbackGlyph</span>
            }
        </span>
        <span class="edge-http-service-stamp-body">
            <strong class="edge-http-service-stamp-title">@PrimaryLabel</strong>
            <span class="edge-http-service-stamp-meta">@HostLabel</span>
            <span class="edge-http-service-stamp-scheme">@Service.Scheme.ToUpperInvariant() · @Service.Port</span>
        </span>
    </button>

    @if (!IsBlocked)
    {
        <div class="edge-http-service-stamp-dock" aria-hidden="true">
        <span class="edge-http-service-stamp-icon" aria-hidden="true">
            @if (!string.IsNullOrWhiteSpace(Service.FaviconDataUrl))
            {
                <img src="@Service.FaviconDataUrl" alt="" loading="lazy" />
            }
            else
            {
                <span class="edge-http-service-stamp-icon-fallback">@FallbackGlyph</span>
            }
        </span>
        <span class="edge-http-service-stamp-body">
            <strong class="edge-http-service-stamp-title">@PrimaryLabel</strong>
            <span class="edge-http-service-stamp-meta">@HostLabel</span>
            @if (ShowIpLine)
            {
                <span class="edge-http-service-stamp-ip">IP: @Service.IpAddress</span>
            }
            <span class="edge-http-service-stamp-scheme">@Service.Scheme.ToUpperInvariant() · @Service.Port · HTTP @Service.StatusCode</span>
            <span class="edge-http-service-stamp-url">@Service.Url</span>
            @if (!string.IsNullOrWhiteSpace(Service.ServerHeader))
            {
                <span class="edge-http-service-stamp-meta">Server: @Service.ServerHeader</span>
            }
            @if (!string.IsNullOrWhiteSpace(Service.Scope))
            {
                <span class="edge-http-service-stamp-meta">Scope: @Service.Scope</span>
            }
        </span>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public LocalHttpServiceEndpoint Service { get; set; } = default!;
    [Parameter] public EventCallback<LocalHttpServiceEndpoint> OnUse { get; set; }

    private bool IsBlocked => Service.Exposure == DiscoveryExposure.UnsafeToExpose;

    private bool HasPoorTitle => LocalHttpServiceDiscoveryRanking.TitleQualityRank(Service.Title) > 0;

    private string HostLabel =>
        FirstNonBlank(Service.Host, Service.IpAddress, Service.DisplayName) ?? Service.Host;

    private bool ShowIpLine =>
        !string.IsNullOrWhiteSpace(Service.IpAddress) &&
        !Service.IpAddress.Equals(HostLabel, StringComparison.OrdinalIgnoreCase);

    private string PrimaryLabel
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(Service.Title) &&
                !LocalHttpServiceDiscoveryRanking.LooksLikeErrorTitle(Service.Title))
            {
                return Service.Title.Trim();
            }

            if (!LocalHttpServiceDiscoveryRanking.IsUnknownLabel(Service.ServiceName))
            {
                return Service.ServiceName.Trim();
            }

            return FirstNonBlank(Service.DisplayName, Service.ServerHeader) ?? "Unknown";
        }
    }

    private string FallbackGlyph =>
        string.IsNullOrWhiteSpace(PrimaryLabel) ? "?" : char.ToUpperInvariant(PrimaryLabel.Trim()[0]).ToString();

    private string DetailsTitle
    {
        get
        {
            var parts = new List<string>
            {
                Service.Url,
                $"Scheme: {Service.Scheme}",
                $"Port: {Service.Port}",
                $"HTTP: {Service.StatusCode}"
            };

            AddIfPresent(parts, "Host", Service.Host);
            AddIfPresent(parts, "IP", Service.IpAddress);
            AddIfPresent(parts, "Title", Service.Title);
            AddIfPresent(parts, "Server", Service.ServerHeader);
            AddIfPresent(parts, "Scope", Service.Scope);
            return string.Join(" | ", parts);
        }
    }

    private static string? FirstNonBlank(params string?[] values) =>
        values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value))?.Trim();

    private static void AddIfPresent(List<string> parts, string label, string? value)
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            parts.Add($"{label}: {value.Trim()}");
        }
    }

    private Task HandleUseAsync() => IsBlocked ? Task.CompletedTask : OnUse.InvokeAsync(Service);
}
