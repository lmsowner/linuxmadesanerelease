@implements IDisposable
@using LinuxMadeSane.Core.Models.Cloudflare
@inject LinuxMadeSane.Web.Services.HttpServicePagePreview Previews
@inject ILogger<EdgeGatewayHttpServiceLookupStamp> Logger

<div class="edge-http-service-stamp-shell @(IsDisabled ? "is-blocked" : null)" @onmouseenter="LoadPreview" @onfocusin="LoadPreview" @onmouseleave="CancelPreview" @onfocusout="CancelPreview">
    @if (!string.IsNullOrWhiteSpace(Href) && !IsDisabled)
    {
        <a class="edge-http-service-stamp @(HasPoorTitle ? "is-poor-title" : null)"
           role="listitem"
           title="@DetailsTitle"
           href="@Href"
           target="@Target"
           rel="@Rel"
           onclick="@OnClientClick">
            @StampContent
        </a>
    }
    else
    {
        <button class="edge-http-service-stamp @(IsDisabled ? "is-blocked" : null) @(HasPoorTitle ? "is-poor-title" : null)"
                type="button"
                role="listitem"
                title="@DetailsTitle"
                disabled="@IsDisabled"
                @onclick="HandleUseAsync">
            @StampContent
        </button>
    }

    @if (!IsBlocked)
    {
        <div class="edge-http-service-stamp-dock" aria-hidden="true">
            <span class="edge-http-service-stamp-icon" aria-hidden="true">
                @if (!string.IsNullOrWhiteSpace(Service.FaviconDataUrl))
                {
                    <img src="@Service.FaviconDataUrl" alt="" loading="lazy" />
                }
                else
                {
                    <span class="edge-http-service-stamp-icon-fallback">@FallbackGlyph</span>
                }
            </span>
            <span class="edge-http-service-stamp-body">
                @if (preview?.DataUrl is { } image) { <img class="edge-page-preview" src="@image" alt="Rendered homepage of @PrimaryLabel" /> }
                else { <span class="edge-page-preview-status">@(preview?.Message ?? (loadingPreview ? "Rendering homepage…" : "Hover to preview homepage"))</span> }
                <strong class="edge-http-service-stamp-title">@PrimaryLabel</strong>
                <span class="edge-http-service-stamp-meta">@HostLabel</span>
                @if (ShowIpLine)
                {
                    <span class="edge-http-service-stamp-ip">IP: @Service.IpAddress</span>
                }
                <span class="edge-http-service-stamp-scheme">@Service.Scheme.ToUpperInvariant() · @Service.Port · HTTP @Service.StatusCode</span>
                <span class="edge-http-service-stamp-url">@Service.Url</span>
                @if (!string.IsNullOrWhiteSpace(Service.ServerHeader))
                {
                    <span class="edge-http-service-stamp-meta">Server: @Service.ServerHeader</span>
                }
                @if (!string.IsNullOrWhiteSpace(Service.Scope))
                {
                    <span class="edge-http-service-stamp-meta">Scope: @Service.Scope</span>
                }
            </span>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public LocalHttpServiceEndpoint Service { get; set; } = default!;
    [Parameter] public EventCallback<LocalHttpServiceEndpoint> OnUse { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public string? Target { get; set; }
    [Parameter] public string? Rel { get; set; }
    [Parameter] public string? OnClientClick { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private RenderFragment StampContent => @<text>
        <span class="edge-http-service-stamp-icon" aria-hidden="true">
            @if (!string.IsNullOrWhiteSpace(Service.FaviconDataUrl))
            {
                <img src="@Service.FaviconDataUrl" alt="" loading="lazy" />
            }
            else
            {
                <span class="edge-http-service-stamp-icon-fallback">@FallbackGlyph</span>
            }
        </span>
        <span class="edge-http-service-stamp-body">
            <strong class="edge-http-service-stamp-title">@PrimaryLabel</strong>
            <span class="edge-http-service-stamp-meta">@HostLabel</span>
            <span class="edge-http-service-stamp-scheme">@Service.Scheme.ToUpperInvariant() · @Service.Port</span>
        </span>
    </text>;

    private LinuxMadeSane.Web.Services.PagePreview? preview;
    private bool loadingPreview;
    private bool disposed;
    private string? previewIdentity;
    private CancellationTokenSource? previewCancellation;
    protected override void OnParametersSet()
    {
        var identity = $"{Service.Scheme}|{Service.Host}|{Service.Port}";
        if (previewIdentity == identity) return;
        CancelPreview();
        preview = null;
        previewIdentity = identity;
    }
    private async Task LoadPreview()
    {
        if (disposed || loadingPreview || preview?.ExpiresUtc > DateTimeOffset.UtcNow || IsBlocked) return;
        CancellationTokenSource? cancellation = null;
        var requestedIdentity = previewIdentity;
        try
        {
            // A completed preview returns synchronously: no spinner, file read or browser launch.
            if (Previews.TryGetCached(Service, out var cached)) { preview = cached; return; }
            loadingPreview = true;
            cancellation = new CancellationTokenSource();
            previewCancellation = cancellation;
            var result = await Previews.GetQueuedAsync(Service, cancellation.Token);
            if (!disposed && requestedIdentity == previewIdentity) preview = result;
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) when (ex is not OutOfMemoryException)
        {
            Logger.LogWarning("Optional homepage preview failed ({ErrorType}); retaining the app dialog", ex.GetType().Name);
            if (!disposed && requestedIdentity == previewIdentity)
                preview = new(null, "Homepage preview unavailable. You can continue using this dialog.", DateTimeOffset.UtcNow.AddMinutes(1));
        }
        finally
        {
            loadingPreview = false;
            if (ReferenceEquals(previewCancellation, cancellation)) previewCancellation = null;
            cancellation?.Dispose();
        }
    }
    private void CancelPreview() => previewCancellation?.Cancel();
    public void Dispose() { disposed = true; CancelPreview(); }
    private bool IsBlocked => Service.Exposure == DiscoveryExposure.UnsafeToExpose;
    private bool IsDisabled => IsBlocked || Disabled;

    private bool HasPoorTitle => LocalHttpServiceDiscoveryRanking.TitleQualityRank(Service.Title) > 0;

    private string HostLabel =>
        FirstNonBlank(Service.Host, Service.IpAddress, Service.DisplayName) ?? Service.Host;

    private bool ShowIpLine =>
        !string.IsNullOrWhiteSpace(Service.IpAddress) &&
        !Service.IpAddress.Equals(HostLabel, StringComparison.OrdinalIgnoreCase);

    private string PrimaryLabel => LocalHttpServiceDiscoveryRanking.PickerLabel(Service);

    private string FallbackGlyph =>
        string.IsNullOrWhiteSpace(PrimaryLabel) ? "?" : char.ToUpperInvariant(PrimaryLabel.Trim()[0]).ToString();

    private string DetailsTitle
    {
        get
        {
            var parts = new List<string>
            {
                Service.Url,
                $"Scheme: {Service.Scheme}",
                $"Port: {Service.Port}",
                $"HTTP: {Service.StatusCode}"
            };

            AddIfPresent(parts, "Host", Service.Host);
            AddIfPresent(parts, "IP", Service.IpAddress);
            AddIfPresent(parts, "Title", Service.Title);
            AddIfPresent(parts, "Server", Service.ServerHeader);
            AddIfPresent(parts, "Scope", Service.Scope);
            return string.Join(" | ", parts);
        }
    }

    private static string? FirstNonBlank(params string?[] values) =>
        values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value))?.Trim();

    private static void AddIfPresent(List<string> parts, string label, string? value)
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            parts.Add($"{label}: {value.Trim()}");
        }
    }

    private Task HandleUseAsync() => IsDisabled ? Task.CompletedTask : OnUse.InvokeAsync(Service);
}
