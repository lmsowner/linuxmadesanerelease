<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The web app transports this portable assembly to the destination's installed runtime. -->
    <UseAppHost>false</UseAppHost>
    <SelfContained>false</SelfContained>
    <ShouldBeValidatedAsExecutableReference>false</ShouldBeValidatedAsExecutableReference>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../LinuxMadeSane.Application/LinuxMadeSane.Application.csproj" />
  </ItemGroup>
</Project>
