{
  "schemaVersion": 1,
  "apps": [
    {
      "id": "vpn-gateway",
      "name": "VPN Gateway",
      "description": "Reusable VPN gateway for apps that need protected internet access.",
      "category": "infrastructure",
      "icon": "vpn",
      "website": "https://github.com/qdm12/gluetun",
      "documentation": "https://github.com/qdm12/gluetun-wiki",
      "imageRepository": "qmcgaw/gluetun",
      "imageTag": "latest",
      "definitionVersion": "6",
      "ports": [],
      "volumes": [
        {
          "id": "config",
          "containerPath": "/gluetun",
          "kind": "configuration",
          "sharedRole": null,
          "readOnly": false,
          "hostOwner": null
        }
      ],
      "environment": {},
      "dependencies": [],
      "healthCheck": {
        "httpPath": null,
        "port": null,
        "dockerCommand": "wget -qO- http://127.0.0.1:9999/ \u003E/dev/null || exit 1",
        "startPeriodSeconds": 20,
        "intervalSeconds": 30,
        "timeoutSeconds": 5,
        "retries": 3
      },
      "configurationSchema": [
        {
          "id": "gateway-name",
          "label": "Gateway name",
          "type": "text",
          "required": false,
          "secret": false,
          "options": null,
          "help": "A label such as ProtonVPN, Mullvad, or NordVPN so apps can select the right gateway."
        },
        {
          "id": "configuration-mode",
          "label": "Configuration method",
          "type": "select",
          "required": true,
          "secret": false,
          "options": [
            "Paste provider config",
            "Guided"
          ],
          "help": "Pasting the configuration file downloaded from your VPN provider is recommended. Guided setup remains available for providers that supply separate credentials."
        },
        {
          "id": "provider",
          "label": "Provider",
          "type": "select",
          "required": true,
          "secret": false,
          "options": [
            "ProtonVPN",
            "NordVPN",
            "Mullvad",
            "Surfshark",
            "Private Internet Access",
            "Custom WireGuard"
          ],
          "help": "These provider names are Gluetun provider profiles; LMS does not implement the VPN protocol."
        },
        {
          "id": "protocol",
          "label": "Protocol",
          "type": "select",
          "required": true,
          "secret": false,
          "options": [
            "WireGuard",
            "OpenVPN"
          ],
          "help": "Choose the protocol supported by your provider credentials."
        },
        {
          "id": "vpn-config",
          "label": "Paste VPN configuration file",
          "type": "secret-textarea",
          "required": true,
          "secret": true,
          "options": null,
          "help": "Paste the complete .ovpn file or WireGuard INI downloaded from your VPN provider. LMS keeps the provider profile as a secret and resolves WireGuard endpoint hostnames each time the gateway starts, because Gluetun requires a literal IP address. When editing an installed gateway, leave this empty to keep its current configuration."
        },
        {
          "id": "port-forwarding",
          "label": "Incoming P2P port",
          "type": "select",
          "required": true,
          "secret": false,
          "options": [
            "Required for qBittorrent/P2P",
            "Off (P2P still works)"
          ],
          "help": "An inbound port improves qBittorrent peer reachability. Proton requires a paid P2P server profile with NAT-PMP enabled; PIA also supports automatic forwarding. Other providers can allow P2P traffic without offering an inbound port."
        },
        {
          "id": "server-countries",
          "label": "Server countries",
          "type": "text",
          "required": false,
          "secret": false,
          "options": null,
          "help": "Optional comma-separated Gluetun server country filter, for example Netherlands, Switzerland."
        },
        {
          "id": "wireguard-private-key",
          "label": "WireGuard private key",
          "type": "secret",
          "required": true,
          "secret": true,
          "options": null,
          "help": "Required for WireGuard. Stored in the LMS secret store."
        },
        {
          "id": "wireguard-addresses",
          "label": "WireGuard addresses",
          "type": "text",
          "required": true,
          "secret": false,
          "options": null,
          "help": "The tunnel address from your provider, for example 10.2.0.2/32."
        },
        {
          "id": "wireguard-public-key",
          "label": "WireGuard server public key",
          "type": "text",
          "required": false,
          "secret": false,
          "options": null,
          "help": "Required for custom WireGuard when your provider does not supply a server profile."
        },
        {
          "id": "wireguard-endpoint-ip",
          "label": "WireGuard endpoint IP",
          "type": "text",
          "required": false,
          "secret": false,
          "options": null,
          "help": "Optional custom WireGuard endpoint IP."
        },
        {
          "id": "wireguard-endpoint-port",
          "label": "WireGuard endpoint port",
          "type": "text",
          "required": false,
          "secret": false,
          "options": null,
          "help": "Optional custom WireGuard endpoint port."
        },
        {
          "id": "wireguard-preshared-key",
          "label": "WireGuard preshared key",
          "type": "secret",
          "required": false,
          "secret": true,
          "options": null,
          "help": null
        },
        {
          "id": "openvpn-username",
          "label": "OpenVPN username",
          "type": "secret",
          "required": true,
          "secret": true,
          "options": null,
          "help": "Required for provider OpenVPN profiles."
        },
        {
          "id": "openvpn-password",
          "label": "OpenVPN password",
          "type": "secret",
          "required": true,
          "secret": true,
          "options": null,
          "help": "Stored in the LMS secret store and never shown again."
        }
      ],
      "supportsDirectNetwork": true,
      "supportsVpnGateway": false,
      "requiresVpnGateway": false,
      "edgeGatewaySupported": true,
      "isInstallable": true,
      "dockerCapabilities": [
        "NET_ADMIN"
      ],
      "dockerDevices": [
        "/dev/net/tun:/dev/net/tun"
      ],
      "isSystemDependency": false,
      "publicUrlEnvironmentVariable": null,
      "exposure": null
    },
    {
      "id": "qbittorrent",
