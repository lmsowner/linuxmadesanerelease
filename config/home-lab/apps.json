        "dockerCommand": null,
        "startPeriodSeconds": 20,
        "intervalSeconds": 30,
        "timeoutSeconds": 5,
        "retries": 3
      },
      "configurationSchema": [
        {
          "id": "network-route",
          "label": "Internet route",
          "type": "select",
          "required": true,
          "secret": false,
          "options": [
            "VPN Gateway (Gluetun)",
            "Direct (no VPN)"
          ],
          "help": "Direct exposes qBittorrent through the deployment network. VPN Gateway routes its traffic through the selected Gluetun gateway."
        },
        {
          "id": "vpn-gateway",
          "label": "VPN gateway",
          "type": "select",
          "required": true,
          "secret": false,
          "options": null,
          "help": "Choose which installed Gluetun gateway carries qBittorrent traffic."
        }
      ],
      "supportsDirectNetwork": true,
      "supportsVpnGateway": true,
      "requiresVpnGateway": false,
      "edgeGatewaySupported": true,
      "isInstallable": true,
      "dockerCapabilities": null,
      "dockerDevices": null,
      "isSystemDependency": false,
      "publicUrlEnvironmentVariable": null,
      "exposure": {
        "scopes": [
          "internal",
          "lan",
          "client",
          "public"
        ],
        "clientAccess": {
          "enabled": true,
          "portName": "web",
          "routing": "subdomain",
          "preferredPath": "",
          "reverseProxy": {
            "basePathSupport": "transparent",
            "stripPathPrefix": true,
            "usePublicHostHeader": true,
            "forwardPathPrefix": true,
            "rewriteSecureCookiesForHttp": false,
            "configuration": null
          },
          "capabilities": {
            "webSockets": false,
            "serverSentEvents": false,
            "streaming": false,
            "rangeRequests": false,
            "uploads": true,
            "longLivedRequests": false,
            "webSocketProbePath": null,
            "serverSentEventsProbePath": null,
            "rangeRequestProbePath": null
          },
          "publicUrlEnvironmentVariable": null
        },
        "additionalClientAccess": null
      }
    },
