[Unit]
Description=Linux Made Sane automatic Community release builder
After=network-online.target linux-made-sane-public-site.service
Wants=network-online.target

[Service]
Type=oneshot
User=__BUILDER_USER__
Group=__BUILDER_GROUP__
EnvironmentFile=__ENV_FILE__
Environment=DOTNET_CLI_HOME=__WORK_ROOT__/dotnet-home
Environment=NUGET_PACKAGES=__WORK_ROOT__/nuget-packages
ExecStart=__EXEC_START__
TimeoutStartSec=2h
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=__WORK_ROOT__ __COMMUNITY_RELEASE_ROOT__
